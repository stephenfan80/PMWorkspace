{
  "id": "autoplan-mode-run-inheritance",
  "title": "自动产品评审继承主入口模式和 run",
  "category": "autoplan",
  "primary_skill": "pm-autoplan",
  "prompt": "用户从 $pm-workspace 路由到 $pm-autoplan 快速成型模式，已有 current_run_id。",
  "expected": {
    "mode": "quick",
    "status": "待确认",
    "must_stop": false,
    "gate": "模式和 run 继承",
    "required_behaviors": [
      "继承主入口模式",
      "复用 current_run_id",
      "直调时才使用 D0",
      "不重新创建 run"
    ],
    "forbidden_behaviors": [
      "覆盖主入口模式",
      "无条件重新 pmw-run start",
      "丢失 run_id"
    ]
  },
  "contract_checks": [
    {
      "path": "pmworkspace-shared/references/autoplan-workflow.md",
      "contains": "入口来自 `$pm-workspace` 时，复用当前 run 和主入口已经判定的模式"
    },
    {
      "path": "pm-autoplan/SKILL.md",
      "contains": "if `$pm-autoplan` was entered from `$pm-workspace`, inherit its mode and run"
    },
    {
      "path": "pm-autoplan/SKILL.md",
      "contains": "复用当前 run，不要重新 `pmw-run start`"
    }
  ]
}
