#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import subprocess
import sys


SCRIPT_DIR = pathlib.Path(__file__).resolve().parent
STATE_DIR = pathlib.Path(os.environ.get("PMW_HOME", str(pathlib.Path.home() / ".pmworkspace"))).expanduser()


def current_slug() -> str:
    env_slug = os.environ.get("PMW_PROJECT_SLUG")
    if env_slug:
        return env_slug
    try:
        return subprocess.check_output([str(SCRIPT_DIR / "pmw-slug")], text=True).strip()
    except Exception:
        return "local-project"


def read_jsonl(path: pathlib.Path) -> list[dict]:
    rows: list[dict] = []
    if not path.exists():
        return rows
    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
        try:
            value = json.loads(line)
        except Exception:
            continue
        if isinstance(value, dict):
            rows.append(value)
    return rows


def latest_visual_baseline() -> dict:
    path = STATE_DIR / "projects" / current_slug() / "artifact-flow.jsonl"
    rows = [row for row in read_jsonl(path) if row.get("kind") == "visual_baseline"]
    return rows[-1] if rows else {}


def has_forbidden_anchor(text: str) -> list[str]:
    checks = [
        ("402 x 874", r"402\s*(?:x|X|×)\s*874"),
        ("W402 x H874", r"W402\s*(?:x|X|×)\s*H874"),
        ("H874", r"\bH874\b"),
        ("标准首屏", r"标准(?:移动端)?首屏"),
        ("最低 H874", r"最低\s*H874"),
    ]
    return [label for label, pattern in checks if re.search(pattern, text, flags=re.I)]


def contains_target_output(text: str) -> bool:
    pixel_pair = r"\d{3,5}\s*(?:x|X|×)\s*(?:>=\s*)?\d{3,5}"
    pixel_width = r"\d{3,5}\s*(?:px|像素|宽)"
    return bool(re.search(rf"(目标输出|目标输出画布|目标输出像素)[^。\n；;]*(?:{pixel_pair}|{pixel_width})", text))


def parse_key_int(text: str, key: str) -> int | None:
    match = re.search(rf"{re.escape(key)}[=：]\s*(\d{{3,5}})", text)
    return int(match.group(1)) if match else None


def parse_target_size(text: str) -> tuple[int | None, int | None]:
    key_width = parse_key_int(text, "target_width") or parse_key_int(text, "目标宽度")
    key_height = parse_key_int(text, "target_height") or parse_key_int(text, "目标高度")
    if key_width or key_height:
        return key_width, key_height
    match = re.search(r"目标输出[^。\n；;]*?(\d{3,5})\s*(?:x|X|×)\s*(?:>=\s*)?(\d{3,5})", text)
    if match:
        return int(match.group(1)), int(match.group(2))
    width_match = re.search(r"目标输出[^。\n；;]*?(\d{3,5})\s*(?:px|像素|宽)", text)
    height_match = re.search(r"(?:高度|高)[^。\n；;]*?(\d{3,5})\s*(?:px|像素)?", text)
    return (
        int(width_match.group(1)) if width_match else None,
        int(height_match.group(1)) if height_match else None,
    )


def parse_reference_size(text: str) -> tuple[int | None, int | None]:
    key_width = parse_key_int(text, "reference_width") or parse_key_int(text, "参考宽度")
    key_height = parse_key_int(text, "reference_height") or parse_key_int(text, "参考高度")
    if key_width or key_height:
        return key_width, key_height
    match = re.search(r"(?:参考截图尺寸|参考尺寸)[^。\n；;]*?(\d{3,5})\s*(?:x|X|×)\s*(\d{3,5})", text)
    if match:
        return int(match.group(1)), int(match.group(2))
    return None, None


def baseline_metrics(baseline: dict) -> dict:
    summary = str(baseline.get("summary") or "")
    reference_width, reference_height = parse_reference_size(summary)
    target_width, target_height = parse_target_size(summary)
    scale_match = re.search(r"(?:scale|倍率)[=：]\s*(\d+)", summary)
    logical_match = re.search(r"(?:logical_width|逻辑宽度)[=：]\s*(\d+)", summary)
    return {
        "reference_width": reference_width,
        "reference_height": reference_height,
        "target_width": target_width,
        "target_height": target_height,
        "scale": int(scale_match.group(1)) if scale_match else None,
        "logical_width": int(logical_match.group(1)) if logical_match else None,
    }


def check_prompt_matches_baseline(prompt: str, baseline: dict) -> list[str]:
    failures: list[str] = []
    if not baseline:
        return failures
    metrics = baseline_metrics(baseline)
    prompt_ref_width, prompt_ref_height = parse_reference_size(prompt)
    prompt_target_width, prompt_target_height = parse_target_size(prompt)
    if metrics["reference_width"] and prompt_ref_width and prompt_ref_width != metrics["reference_width"]:
        failures.append(f"参考截图宽度 {prompt_ref_width} 与 visual_baseline {metrics['reference_width']} 不一致")
    if metrics["reference_height"] and prompt_ref_height and prompt_ref_height != metrics["reference_height"]:
        failures.append(f"参考截图高度 {prompt_ref_height} 与 visual_baseline {metrics['reference_height']} 不一致")
    if metrics["target_width"]:
        if not prompt_target_width:
            failures.append("缺少可校验的目标输出宽度")
        elif prompt_target_width != metrics["target_width"]:
            failures.append(f"目标输出宽度 {prompt_target_width} 与 visual_baseline {metrics['target_width']} 不一致")
    if metrics["target_height"]:
        if not prompt_target_height:
            failures.append("缺少可校验的目标输出高度")
        elif prompt_target_height < metrics["target_height"]:
            failures.append(f"目标输出高度 {prompt_target_height} 低于 visual_baseline {metrics['target_height']}")
    scale = metrics.get("scale")
    if scale and scale > 1:
        scale_pattern = rf"(?:{scale}\s*x|@\s*{scale}\s*x|{scale}\s*倍)"
        if not re.search(scale_pattern, prompt, flags=re.I):
            failures.append(f"缺少 {scale}x 截图倍率说明")
        if not re.search(r"(物理像素|等比|比例)", prompt):
            failures.append("缺少按参考物理像素等比绘制的约束")
    return failures


def run_check(args: argparse.Namespace) -> int:
    prompt = sys.stdin.read()
    baseline = latest_visual_baseline()
    strict = args.visual_baseline or bool(baseline)
    failures: list[str] = []
    if strict:
        forbidden = has_forbidden_anchor(prompt)
        if forbidden:
            failures.append("视觉基线模式禁止出现画布锚点：" + "、".join(forbidden))
        if not re.search(r"(参考截图尺寸|参考尺寸)[^。\n；;]*\d{3,5}\s*(?:x|X|×)\s*\d{3,5}", prompt):
            failures.append("缺少参考截图尺寸")
        if not contains_target_output(prompt):
            failures.append("缺少目标输出画布 / 目标输出像素")
        failures.extend(check_prompt_matches_baseline(prompt, baseline))
        if not (re.search(r"(不|不要|不得|不能|禁止)压缩", prompt) and re.search(r"(字体|字号|文字)", prompt)):
            failures.append("缺少不得压缩字体 / 字号约束")
        if "间距" not in prompt:
            failures.append("缺少不得压缩间距约束")
        if not (
            re.search(r"(不|不得|不能).{0,8}塞进.{0,8}短", prompt)
            or "内容自适应" in prompt
            or re.search(r"高度.{0,8}(增长|自适应|不得低于)", prompt)
        ):
            failures.append("缺少长内容不得塞进短画布 / 高度自适应约束")
    verdict = "通过" if not failures else "失败"
    if args.json:
        print(json.dumps({"verdict": verdict, "strict": strict, "failures": failures}, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print("# PMWorkspace image-2 prompt 检查")
        print("")
        print(f"- Verdict：{verdict}")
        print(f"- 视觉基线模式：{'是' if strict else '否'}")
        if failures:
            print("- 问题：")
            for failure in failures:
                print(f"  - {failure}")
        else:
            print("- 问题：无")
        print("")
    return 0 if not failures else 2


def main() -> int:
    parser = argparse.ArgumentParser(prog="pmw-prototype-prompt-check")
    parser.add_argument("--visual-baseline", action="store_true", help="按线上截图物理长板模式检查")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    return run_check(args)


if __name__ == "__main__":
    raise SystemExit(main())
