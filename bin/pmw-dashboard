#!/usr/bin/env python3
import argparse
import json
import os
import pathlib
import re
import subprocess
from datetime import datetime, timezone
from typing import Optional


SCRIPT_DIR = pathlib.Path(__file__).resolve().parent
STATE_DIR = pathlib.Path(os.environ.get("PMW_HOME", str(pathlib.Path.home() / ".pmworkspace"))).expanduser()
PROJECT_OVERRIDE = ""


def current_slug() -> str:
    if PROJECT_OVERRIDE:
        return PROJECT_OVERRIDE
    env_slug = os.environ.get("PMW_PROJECT_SLUG")
    if env_slug:
        return env_slug
    try:
        return subprocess.check_output([str(SCRIPT_DIR / "pmw-slug")], text=True).strip()
    except Exception:
        return "local-project"


def project_dir() -> pathlib.Path:
    return STATE_DIR / "projects" / current_slug()


def projects_root() -> pathlib.Path:
    return STATE_DIR / "projects"


def resolve_project_identifier(value: str) -> str:
    cleaned = (value or "").strip()
    if not cleaned:
        return ""
    direct = projects_root() / cleaned / "project.json"
    if direct.exists():
        return cleaned
    for path in sorted(projects_root().glob("*/project.json")):
        data = read_json(path)
        if cleaned in {str(data.get("slug") or path.parent.name), str(data.get("display_name") or "")}:
            return str(data.get("slug") or path.parent.name)
    return cleaned


def project_for_run(run_id: str) -> str:
    if not run_id:
        return ""
    for path in sorted(projects_root().glob(f"*/runs/{run_id}.jsonl")):
        return path.parent.parent.name
    return ""


def user_dir() -> pathlib.Path:
    return STATE_DIR / "user"


def read_json(path: pathlib.Path) -> dict:
    if not path.exists():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def read_jsonl(path: pathlib.Path) -> list[dict]:
    rows = []
    if not path.exists():
        return rows
    for line in path.read_text(encoding="utf-8").splitlines():
        try:
            value = json.loads(line)
        except Exception:
            continue
        if isinstance(value, dict):
            rows.append(value)
    return rows


def all_jsonl(pattern: str) -> list[dict]:
    rows = []
    for path in sorted(project_dir().glob(pattern)):
        rows.extend(read_jsonl(path))
    return rows


def read_run(run_id: Optional[str]) -> tuple[str, list[dict]]:
    data = read_json(project_dir() / "project.json")
    chosen = run_id or str(data.get("current_run_id") or data.get("latest_run_id") or "")
    if not chosen:
        runs = sorted((project_dir() / "runs").glob("*.jsonl"))
        chosen = runs[-1].stem if runs else ""
    if not chosen:
        return "", []
    return chosen, read_jsonl(project_dir() / "runs" / f"{chosen}.jsonl")


def latest_brief_summary(path_value: str) -> tuple[str, str]:
    if not path_value:
        return "未记录", "未记录"
    path = pathlib.Path(path_value)
    if not path.exists():
        return path_value, "未读取"
    text = path.read_text(encoding="utf-8", errors="ignore")
    status = "未标注"
    version = "未标注"
    for line in text.splitlines()[:80]:
        stripped = line.strip()
        if "状态" in stripped and status == "未标注":
            status = stripped.replace("#", "").strip()
        if ("版本" in stripped or "简报版本" in stripped) and version == "未标注":
            version = stripped.replace("#", "").strip()
    return f"{path.name}", f"{version}；{status}"


def bullet_or_empty(rows: list[str], empty: str = "暂无") -> list[str]:
    return [f"- {row}" for row in rows] if rows else [f"- {empty}"]


def contains_any(value: str, needles: list[str]) -> bool:
    return any(needle in value for needle in needles)


def latest_event(events: list[dict], needles: list[str], event_types: Optional[set[str]] = None) -> dict:
    for row in reversed(events):
        if event_types and row.get("event") not in event_types:
            continue
        text = f"{row.get('status', '')} {row.get('title', '')} {row.get('summary', '')}"
        if contains_any(text, needles):
            return row
    return {}


def artifact_rows(root: pathlib.Path, kind: Optional[str] = None, limit: Optional[int] = None) -> list[dict]:
    rows = read_jsonl(root / "artifact-flow.jsonl")
    if kind:
        rows = [row for row in rows if row.get("kind") == kind]
    if limit is not None:
        rows = rows[-limit:]
    return rows


def same_path(left: str, right: str) -> bool:
    if not left or not right:
        return False
    try:
        return pathlib.Path(left).expanduser().resolve() == pathlib.Path(right).expanduser().resolve()
    except Exception:
        return left == right


def artifact_location(row: dict) -> str:
    return str(row.get("url") or row.get("path") or "")


def normalize_version(value: str) -> str:
    match = re.search(r"v?\s*([0-9]+)", value or "", flags=re.I)
    return f"v{match.group(1)}" if match else (value or "").strip()


def event_after_file(row: dict, path_value: str) -> bool:
    if not row or not path_value:
        return False
    try:
        event_ts = datetime.fromisoformat(str(row.get("ts") or "").replace("Z", "+00:00"))
        file_ts = datetime.fromtimestamp(pathlib.Path(path_value).stat().st_mtime, timezone.utc)
        return event_ts >= file_ts
    except Exception:
        return True


def latest_browser_evidence(root: pathlib.Path) -> dict:
    rows = artifact_rows(root, "browser_evidence")
    return rows[-1] if rows else {}


def latest_visual_baseline(root: pathlib.Path, run_id: str = "") -> dict:
    if run_id:
        return current_artifact(root, "visual_baseline", run_id)
    rows = artifact_rows(root, "visual_baseline")
    return rows[-1] if rows else {}


def has_target_pixels(row: dict) -> bool:
    text = " ".join(
        str(row.get(key) or "")
        for key in ["status", "title", "summary", "path", "url"]
    )
    return text_has_target_pixels(text)


def text_has_target_pixels(text: str) -> bool:
    if not text:
        return False
    pixel_pair = r"\d{3,5}\s*(?:x|X|×)\s*(?:>=\s*)?\d{3,5}"
    pixel_width = r"\d{3,5}\s*(?:px|像素|宽)"
    target_pattern = rf"(目标输出|目标输出像素|target|Target)[^。\n；;]*(?:{pixel_pair}|{pixel_width})"
    return bool(re.search(target_pattern, text))


def text_has_canvas_anchor(text: str) -> bool:
    return bool(
        re.search(r"402\s*(?:x|X|×)\s*874", text)
        or re.search(r"W402\s*(?:x|X|×)\s*H874", text, flags=re.I)
        or re.search(r"\bH874\b", text, flags=re.I)
        or "标准首屏" in text
        or "最低 H874" in text
    )


def read_text(path_value: str) -> str:
    if not path_value:
        return ""
    path = pathlib.Path(path_value)
    if not path.exists():
        return ""
    return path.read_text(encoding="utf-8", errors="ignore")


def redact_sensitive(value: str) -> str:
    value = re.sub(r"(token=)[^&\s]+", r"\1[redacted]", value)
    value = re.sub(r"(ownerSecret[=: ]*)[^&\s]+", r"\1[redacted]", value)
    value = re.sub(r"(Authorization: Bearer )[A-Za-z0-9._~+/=-]+", r"\1[redacted]", value)
    value = re.sub(r"(x-share-token: )[A-Za-z0-9._~+/=-]+", r"\1[redacted]", value)
    return value


def gate_result(name: str, required: bool, status: str, evidence: str, action: str, passed: bool) -> dict:
    return {
        "name": name,
        "required": required,
        "status": status,
        "evidence": evidence,
        "action": action,
        "passed": passed,
    }


def latest_review(events: list[dict]) -> dict:
    for row in reversed(events):
        if row.get("event") == "review":
            return row
    return {}


def artifact_flow_rows(root: pathlib.Path, limit: int = 10) -> list[str]:
    rows = artifact_rows(root, limit=limit)
    rendered = []
    for row in rows:
        downstream = row.get("next_skill") or []
        if isinstance(downstream, list):
            downstream_text = ", ".join(str(item) for item in downstream if str(item).strip())
        else:
            downstream_text = str(downstream)
        location = artifact_location(row)
        rendered.append(
            f"{redact_sensitive(str(row.get('kind', '产物')))}｜"
            f"{redact_sensitive(str(row.get('status', '')))}｜"
            f"{redact_sensitive(str(row.get('title', '')))}｜"
            f"{redact_sensitive(str(row.get('source_skill', '')))} -> "
            f"{redact_sensitive(downstream_text or '待指定')}｜{redact_sensitive(str(location or '未记录'))}"
        )
    return rendered


def browser_evidence_rows(root: pathlib.Path, limit: int = 5) -> list[str]:
    rendered = []
    for row in artifact_rows(root, "browser_evidence", limit):
        location = artifact_location(row) or "未记录位置"
        rendered.append(
            f"{redact_sensitive(str(row.get('status') or '未记录'))}｜"
            f"{redact_sensitive(str(row.get('title') or '浏览器证据'))}｜"
            f"{redact_sensitive(location)}｜"
            f"{redact_sensitive(str(row.get('summary') or '未记录摘要'))}"
        )
    return rendered


def visual_baseline_rows(root: pathlib.Path, limit: int = 5) -> list[str]:
    rendered = []
    for row in artifact_rows(root, "visual_baseline", limit):
        location = artifact_location(row) or "未记录位置"
        rendered.append(
            f"{redact_sensitive(str(row.get('status') or '未记录'))}｜"
            f"{redact_sensitive(str(row.get('title') or '视觉基线'))}｜"
            f"{redact_sensitive(location)}｜"
            f"{redact_sensitive(str(row.get('summary') or '未记录摘要'))}"
        )
    return rendered


def review_specialist_rows(root: pathlib.Path, limit: int = 10) -> list[str]:
    rows = read_jsonl(root / "review-specialists.jsonl")[-limit:]
    rendered = []
    for row in rows:
        rendered.append(
            f"{redact_sensitive(str(row.get('expert_label') or row.get('expert') or '专家'))}｜"
            f"{redact_sensitive(str(row.get('status') or '未记录'))}｜"
            f"{redact_sensitive(str(row.get('severity') or '未标注'))}｜"
            f"{redact_sensitive(str(row.get('evidence') or '未记录'))}｜"
            f"{redact_sensitive(str(row.get('judgment') or ''))}｜"
            f"{redact_sensitive(str(row.get('action') or ''))}"
        )
    return rendered


def has_non_fiction_boundary(text: str) -> bool:
    lines = text.splitlines()
    for index, line in enumerate(lines):
        if "不可虚构" not in line:
            continue
        window = "\n".join(lines[index : index + 5])
        cleaned = (
            window.replace("#", "")
            .replace("不可虚构项", "")
            .replace("不可虚构", "")
            .strip(" ：:-\n")
        )
        if cleaned and not contains_any(cleaned, ["待补充", "未定义", "暂无", "TBD"]):
            return True
    return False


def extract_brief_status(text: str) -> str:
    for line in text.splitlines()[:120]:
        stripped = line.strip().lstrip("-# ").strip()
        if stripped.startswith("确认状态"):
            return stripped
    return ""


def status_is_aligned(text: str) -> bool:
    return "已对齐" in text and not contains_any(text, ["待确认", "草稿", "缺失门槛", "有漂移", "实质漂移"])


def event_is_confirmed(event: dict) -> bool:
    text = f"{event.get('status', '')} {event.get('summary', '')}"
    return contains_any(text, ["已对齐", "已确认", "已同意", "批准", "用户确认", "用户同意"]) and not contains_any(
        text,
        ["待确认", "需要确认", "准备确认", "需要补充", "需要 PM 拍板", "不同意", "未确认"],
    )


def current_brief_artifact(root: pathlib.Path, brief_path: str, run_id: str) -> dict:
    rows = artifact_rows(root, "product_brief")
    for row in reversed(rows):
        if run_id and row.get("run_id") and row.get("run_id") != run_id:
            continue
        row_path = str(row.get("path") or "")
        if brief_path and row_path and same_path(row_path, brief_path):
            return row
    for row in reversed(rows):
        row_path = str(row.get("path") or "")
        if brief_path and row_path and same_path(row_path, brief_path):
            return row
    return {}


def current_artifact(root: pathlib.Path, kind: str, run_id: str) -> dict:
    rows = artifact_rows(root, kind)
    for row in reversed(rows):
        if run_id and row.get("run_id") == run_id:
            return row
    return {}


def current_board_items(root: pathlib.Path, brief_path: str, brief_version: str, run_id: str) -> list[dict]:
    rows = [r for r in read_jsonl(root / "prototype-board.jsonl") if r.get("record_type", "item") == "item"]
    scoped = []
    for row in rows:
        row_run = str(row.get("run_id") or "")
        row_path = str(row.get("brief_path") or "")
        row_version = str(row.get("brief_version") or "")
        if run_id and row_run:
            if row_run == run_id:
                scoped.append(row)
            continue
        if brief_path and row_path:
            if same_path(row_path, brief_path):
                scoped.append(row)
            continue
        if run_id:
            continue
        if brief_version and row_version:
            if brief_version in row_version:
                scoped.append(row)
            continue
    return scoped


def readiness_target_label(target: str) -> str:
    if target == "prototype":
        return "出图前"
    if target == "handoff":
        return "交付前"
    return "自动判断"


def auto_readiness_target(project: dict, events: list[dict]) -> str:
    latest_status = str(project.get("latest_run_status") or (events[-1].get("status") if events else ""))
    has_review = bool(latest_review(events))
    if "交付" in latest_status or has_review:
        return "handoff"
    return "prototype"


def product_readiness_rows(project: dict, events: list[dict], target: str) -> list[dict]:
    effective_target = auto_readiness_target(project, events) if target == "auto" else target
    root = project_dir()
    run_id = str(events[-1].get("run_id") if events else "")
    brief_path = str(project.get("latest_brief", ""))
    brief_text = read_text(brief_path)
    brief_name, brief_meta = latest_brief_summary(brief_path)
    brief_version = str(project.get("latest_brief_version") or "")
    brief_status = extract_brief_status(brief_text)
    product_brief = current_brief_artifact(root, brief_path, run_id)
    brief_status_text = f"{brief_meta} {brief_status}"
    brief_ready = bool(brief_path) and bool(brief_text) and status_is_aligned(brief_status_text)
    rows = [
        gate_result(
            "产品简报",
            True,
            "已对齐" if brief_ready else ("未记录" if not brief_path else "未达已对齐"),
            "；".join(
                item
                for item in [
                    brief_name if brief_path else "project.json 未记录 latest_brief",
                    f"artifact：{product_brief.get('status')}" if product_brief else "artifact 未记录当前 brief",
                ]
                if item
            ),
            "继续" if brief_ready else "退回 $pm-brief 完成已对齐产品核心信息契约",
            brief_ready,
        )
    ]

    brief_confirm = latest_event(events, ["产品简报确认", "前提确认"], {"gate", "decision"})
    brief_confirm_ready = bool(brief_confirm) and event_is_confirmed(brief_confirm)
    rows.append(
        gate_result(
            "产品简报确认",
            True,
            "已确认" if brief_confirm_ready else ("未记录" if not brief_confirm else brief_confirm.get("status", "待确认")),
            brief_confirm.get("summary") or "当前 run 未记录用户确认产品简报 / 前提确认",
            "继续" if brief_confirm_ready else "先把产品简报 / 关键前提展示给用户确认；确认前不能进入 image-2",
            brief_confirm_ready,
        )
    )

    zoon_url = str(project.get("zoon_url") or "")
    zoon_sync = str(project.get("last_zoon_sync_status") or "")
    zoon_join = str(project.get("last_zoon_join_status") or "")
    zoon_join_error = str(project.get("last_zoon_join_error") or "")
    zoon_event = latest_event(events, ["Zoon", "zoon", "漂移"], {"evidence", "gate"})
    zoon_text = f"{zoon_sync} {zoon_join} {zoon_event.get('status', '')} {zoon_event.get('summary', '')}"
    zoon_required = bool(zoon_url) or zoon_sync in {"synced", "failed"}
    zoon_ready = bool(zoon_url) and zoon_sync == "synced" and not contains_any(
        zoon_text,
        ["DRIFT", "有漂移", "实质漂移", "读取失败", "同步失败", "failed"],
    )
    if not zoon_required:
        zoon_status = "未启用，使用本地简报"
    elif zoon_ready and zoon_join == "joined":
        zoon_status = "已同步且已加入协作态"
    elif zoon_ready and zoon_join == "unsupported":
        zoon_status = "已同步，协作加入不支持"
    elif zoon_ready:
        zoon_status = "已同步且无实质漂移"
    elif zoon_join == "failed":
        zoon_status = "协作加入失败"
    elif not zoon_url:
        zoon_status = "未记录 URL"
    else:
        zoon_status = "未通过"
    zoon_evidence = redact_sensitive(
        "；".join(
            item
            for item in [
                zoon_url or str(project.get("last_zoon_sync_error") or "未记录 Zoon URL；本地 latest_brief 生效"),
                f"协作加入：{zoon_join}" if zoon_join else "",
                f"加入失败：{zoon_join_error}" if zoon_join_error and zoon_join == "failed" else "",
            ]
            if item
        )
    )
    rows.append(
        gate_result(
            "Zoon",
            zoon_required,
            zoon_status,
            zoon_evidence,
            "继续" if (zoon_ready or not zoon_required) else "询问是否同步到 Zoon；若已选择协作，则运行 pmw-zoon sync 并在出图或交付前做漂移检查",
            zoon_ready or not zoon_required,
        )
    )

    browser_evidence = latest_browser_evidence(root)
    if browser_evidence:
        reference_has_visual_source = True
        reference_text = (
            f"{browser_evidence.get('status', '')} "
            f"{browser_evidence.get('title', '')} "
            f"{browser_evidence.get('summary', '')}"
        )
        reference_ready = not contains_any(reference_text, ["缺失", "待补充", "未判断", "失败", "不可访问", "未采集"])
        reference_status = browser_evidence.get("status") or "已记录"
        reference_evidence = (
            f"browser_evidence：{browser_evidence.get('title') or '浏览器证据'}｜"
            f"{artifact_location(browser_evidence) or browser_evidence.get('summary') or '未记录位置'}"
        )
    else:
        reference_event = latest_event(events, ["线上参考", "生产基线", "当前截图", "截图", "录屏"], {"evidence", "gate"})
        reference_has_visual_source = bool(reference_event) and contains_any(
            f"{reference_event.get('title', '')} {reference_event.get('summary', '')}",
            ["生产基线", "当前截图", "截图", "录屏", "视觉基线"],
        )
        reference_text = f"{reference_event.get('status', '')} {reference_event.get('summary', '')}"
        reference_ready = bool(reference_event) and not contains_any(reference_text, ["缺失", "待补充", "未判断", "失败"])
        reference_status = reference_event.get("status") or "未判断"
        reference_evidence = reference_event.get("summary") or "尚未记录线上参考 / 生产基线判断"
    rows.append(
        gate_result(
            "线上参考",
            True,
            redact_sensitive(str(reference_status)),
            redact_sensitive(str(reference_evidence)),
            "继续" if reference_ready else "先判断是否承接线上流程；必要时补截图、录屏或相似状态页",
            reference_ready,
        )
    )

    visual_baseline = latest_visual_baseline(root, run_id)
    visual_text = (
        f"{visual_baseline.get('status', '')} "
        f"{visual_baseline.get('title', '')} "
        f"{visual_baseline.get('summary', '')}"
    )
    visual_required = reference_ready and reference_has_visual_source
    visual_has_target = has_target_pixels(visual_baseline)
    visual_ready = bool(visual_baseline) and visual_has_target and not contains_any(
        visual_text,
        ["缺失", "待补充", "未判断", "失败", "不可访问", "未登记"],
    )
    if not visual_required:
        visual_status = "不适用" if not reference_ready else "未启用"
        visual_evidence = "无已采集线上截图；若是现有功能迭代，线上参考门槛会先阻断"
        visual_action = "继续" if reference_ready else "先补线上参考"
        visual_passed = True
    elif not visual_baseline:
        visual_status = "未登记"
        visual_evidence = "已采集线上参考，但未登记 visual_baseline"
        visual_action = "先登记 visual_baseline：参考图路径、像素尺寸、目标输出像素、字号 / 间距 / 密度基线"
        visual_passed = False
    elif not visual_has_target:
        visual_status = "缺目标输出像素"
        visual_evidence = f"visual_baseline：{visual_baseline.get('title') or '视觉基线'}｜{visual_baseline.get('summary') or artifact_location(visual_baseline) or '未记录目标输出'}"
        visual_action = "补齐目标输出像素；汽车之家生产页通常写 3x 长板，宽度不低于参考截图 95%，优先 1179-1206px"
        visual_passed = False
    else:
        visual_status = visual_baseline.get("status") or "已登记"
        visual_evidence = f"visual_baseline：{visual_baseline.get('title') or '视觉基线'}｜{visual_baseline.get('summary') or artifact_location(visual_baseline) or '已记录'}"
        visual_action = "继续；image-2 prompt 必须写入视觉基线和目标输出像素"
        visual_passed = visual_ready
    rows.append(
        gate_result(
            "视觉基线",
            visual_required,
            redact_sensitive(str(visual_status)),
            redact_sensitive(str(visual_evidence)),
            visual_action,
            visual_passed,
        )
    )

    board = current_board_items(root, brief_path, brief_version, run_id)
    if board:
        binding_failures = []
        normalized_latest_version = normalize_version(brief_version)
        for item in board:
            row_path = str(item.get("brief_path") or "")
            row_version = normalize_version(str(item.get("brief_version") or ""))
            path_ok = bool(row_path and brief_path and same_path(row_path, brief_path))
            version_ok = bool(row_version and normalized_latest_version and row_version == normalized_latest_version)
            if not path_ok or not version_ok:
                binding_failures.append(
                    f"{item.get('scheme') or '未命名'} / {item.get('screen') or '未命名屏幕'}：brief={row_version or '未记录'}，latest={normalized_latest_version or '未记录'}"
                )
        binding_ready = not binding_failures
        binding_status = "已绑定当前 brief" if binding_ready else "绑定旧 brief"
        binding_evidence = f"{len(board)} 个输出单元" if binding_ready else "；".join(binding_failures[:5])
    else:
        binding_ready = True
        binding_status = "暂无输出单元"
        binding_evidence = "尚未登记 prototype-board 输出单元；方案差异门槛会继续判断"
    rows.append(
        gate_result(
            "输出单元绑定",
            bool(board),
            binding_status,
            redact_sensitive(binding_evidence),
            "继续" if binding_ready else "重新用当前 latest brief 登记 prototype-board 输出单元；旧版本输出单元不能放行出图",
            binding_ready,
        )
    )
    if visual_required:
        bad_canvas_rows = []
        for item in board:
            canvas_mode = str(item.get("canvas_mode") or "")
            target_output = str(item.get("target_output_pixels") or "")
            if canvas_mode != "physical_longboard" or not text_has_target_pixels(f"目标输出：{target_output}") or text_has_canvas_anchor(target_output):
                bad_canvas_rows.append(f"{item.get('scheme') or '未命名'} / {item.get('screen') or '未命名屏幕'}")
        canvas_ready = bool(board) and not bad_canvas_rows
        if not board:
            canvas_status = "未登记"
            canvas_evidence = "prototype-board 暂无当前 run 输出单元"
        elif canvas_ready:
            canvas_status = "物理长板已锁定"
            canvas_evidence = f"{len(board)} 个输出单元已使用 canvas_mode=physical_longboard 和 target_output_pixels"
        else:
            canvas_status = "缺物理长板字段"
            canvas_evidence = "未通过：" + "；".join(bad_canvas_rows[:5])
    else:
        canvas_ready = True
        canvas_status = "不适用"
        canvas_evidence = "无线上截图视觉基线；标准首屏模式可按默认移动端画布执行"
    rows.append(
        gate_result(
            "输出画布",
            visual_required,
            canvas_status,
            redact_sensitive(canvas_evidence),
            "继续" if canvas_ready else "当前 run 的每个 prototype-board 输出单元必须写 canvas_mode=physical_longboard 和 target_output_pixels，且不能含 H874 / 标准首屏锚点",
            canvas_ready,
        )
    )

    scheme_event = latest_event(events, ["方案差异", "方案方向", "方案比较板"], {"evidence", "gate", "artifact", "decision"})
    scheme_text = f"{scheme_event.get('status', '')} {scheme_event.get('summary', '')}"
    scheme_ready = bool(board or scheme_event) and not contains_any(scheme_text, ["只换皮", "未通过", "缺失", "待确认"])
    rows.append(
        gate_result(
            "方案差异",
            True,
            "已登记" if board else (scheme_event.get("status") or "未登记"),
            f"{len(board)} 个输出单元" if board else (scheme_event.get("summary") or "prototype-board 暂无方案"),
            "继续" if scheme_ready else "先说明方案在页面结构、信息架构、交互路径、信任表达或关键任务上的差异",
            scheme_ready,
        )
    )

    scheme_confirm = latest_event(events, ["方案方向确认", "方案方向", "原型出图判断"], {"gate", "decision"})
    scheme_confirm_text = f"{scheme_confirm.get('status', '')} {scheme_confirm.get('summary', '')}"
    scheme_confirm_fresh = event_after_file(scheme_confirm, brief_path) if scheme_confirm else False
    scheme_confirm_ready = bool(scheme_confirm) and scheme_confirm_fresh and contains_any(scheme_confirm_text, ["已确认", "已批准", "默认方向已批准", "可出图", "已对齐"]) and not contains_any(
        scheme_confirm_text,
        ["待确认", "需要补充", "不可出图", "缺失", "未批准"],
    )
    rows.append(
        gate_result(
            "方案方向确认",
            True,
            "已确认" if scheme_confirm_ready else ("未记录" if not scheme_confirm else ("已过期" if not scheme_confirm_fresh else scheme_confirm.get("status", "待确认"))),
            scheme_confirm.get("summary") or "当前 run 未记录方案方向确认",
            "继续" if scheme_confirm_ready else "先基于当前 latest brief 重新确认方案方向；未确认前不写 image-2 prompt",
            scheme_confirm_ready,
        )
    )

    board_rows = read_jsonl(root / "prototype-board.jsonl")
    scoped_screens = {(row.get("scheme"), row.get("screen")) for row in board}
    image_failures = []
    for row in board_rows:
        if row.get("record_type") != "image":
            continue
        if run_id and row.get("run_id") and row.get("run_id") != run_id:
            continue
        if scoped_screens and (row.get("scheme"), row.get("screen")) not in scoped_screens:
            continue
        verdict = str(row.get("audit_verdict") or "")
        status = str(row.get("status") or "")
        if verdict and verdict != "通过" or "需要重出" in status:
            failures = row.get("audit_failures") or []
            if isinstance(failures, list):
                failure_text = "；".join(str(item) for item in failures)
            else:
                failure_text = str(failures)
            image_failures.append(f"{row.get('scheme') or '未命名'} / {row.get('screen') or '未命名屏幕'}：{verdict or status} {failure_text}")
    image_audit_required = bool(image_failures)
    rows.append(
        gate_result(
            "原型图片审计",
            image_audit_required,
            "存在需要重出的图片" if image_failures else "暂无失败图片",
            "；".join(image_failures[:5]) if image_failures else "出图后 pmw-prototype-board image 会记录视觉审计结果",
            "重出失败图片；视觉审计失败的图片不能作为交付结果展示" if image_failures else "继续",
            not image_failures,
        )
    )

    board_non_fiction = [str(row.get("non_fiction") or "").strip() for row in board if str(row.get("non_fiction") or "").strip()]
    non_fiction_ready = bool(board_non_fiction or has_non_fiction_boundary(brief_text))
    rows.append(
        gate_result(
            "不可虚构项",
            True,
            "已定义" if non_fiction_ready else "未定义",
            "prototype-board / 产品简报" if non_fiction_ready else "未找到明确不可虚构边界",
            "继续" if non_fiction_ready else "回到 $pm-brief 补齐不能展示的能力、数据、承诺和动作",
            non_fiction_ready,
        )
    )

    data_evidence = current_artifact(root, "data_evidence", run_id)
    data_text = f"{data_evidence.get('status', '')} {data_evidence.get('title', '')} {data_evidence.get('summary', '')}"
    data_ready = bool(data_evidence) and not contains_any(data_text, ["缺失", "待补充", "失败", "不可用"])
    if data_ready:
        data_status = "已佐证"
        data_evidence_text = f"data_evidence：{data_evidence.get('title') or '数据佐证'}｜{data_evidence.get('summary') or artifact_location(data_evidence) or '已记录'}"
        data_action = "继续"
    elif contains_any(brief_text, ["数据不适用", "无需数据佐证", "数据佐证：不适用"]):
        data_status = "不适用"
        data_evidence_text = "产品简报标注数据佐证不适用"
        data_action = "继续"
    else:
        data_status = "未提供，存在未验证风险"
        data_evidence_text = "未登记 data_evidence；原型必须标注假设 / 示例 / 区间，不能展示确定性承诺"
        data_action = "告知用户方案有未验证风险，并写入 brief 风险 / 待验证与原型不可虚构项"
    rows.append(
        gate_result(
            "数据佐证",
            False,
            data_status,
            redact_sensitive(data_evidence_text),
            data_action,
            True,
        )
    )

    review = latest_review(events)
    review_text = f"{review.get('status', '')} {review.get('summary', '')}"
    review_required = effective_target == "handoff"
    review_ready = bool(review) and contains_any(review_text, ["可通过", "可交付"]) and not contains_any(
        review_text,
        ["需要重出", "需要 PM 拍板", "需要补充参考"],
    )
    if not review_required:
        review_status = review.get("status") or "出图前不阻断"
        review_action = "出图后进入 $pm-prototype-review"
        review_passed = True
    else:
        review_status = "可通过" if review_ready else (review.get("status") or "未复审")
        review_action = "继续" if review_ready else "交付前先完成 $pm-prototype-review 并清掉重出 / 拍板 / 补参考项"
        review_passed = review_ready
    rows.append(
        gate_result(
            "复审状态",
            review_required,
            review_status,
            review.get("summary") or "暂无复审记录",
            review_action,
            review_passed,
        )
    )
    return rows


def render_readiness_section(run_id: Optional[str], target: str = "auto", heading_level: str = "#") -> str:
    project = read_json(project_dir() / "project.json")
    chosen_run, events = read_run(run_id)
    effective_target = auto_readiness_target(project, events) if target == "auto" else target
    rows = product_readiness_rows(project, events, effective_target)
    blockers = [row for row in rows if row["required"] and not row["passed"]]
    if blockers:
        verdict = "NOT_READY"
        verdict_cn = "不可出图" if effective_target == "prototype" else "不可交付"
        next_action = blockers[0]["action"]
    else:
        verdict = "READY_FOR_PROTOTYPE" if effective_target == "prototype" else "READY_FOR_HANDOFF"
        verdict_cn = "可出图" if effective_target == "prototype" else "可交付"
        next_action = "继续进入下一步"

    lines = [
        f"{heading_level} PMWorkspace 产品准备度仪表盘",
        "",
        f"- 目标：{readiness_target_label(effective_target)}",
        f"- 当前 run：{chosen_run or '暂无'}",
        f"- Verdict：{verdict_cn}（{verdict}）",
        f"- 下一步：{next_action}",
        "",
        "| 门槛 | Required | 状态 | 证据 | 行动 |",
        "|---|---|---|---|---|",
    ]
    for row in rows:
        required = "YES" if row["required"] else "no"
        values = [row["name"], required, row["status"], row["evidence"], row["action"]]
        lines.append("| " + " | ".join(str(value).replace("|", "/") for value in values) + " |")
    lines.append("")
    return "\n".join(lines)


def readiness_verdict(project: dict, events: list[dict], target: str) -> tuple[str, str, str, str, list[dict]]:
    effective_target = auto_readiness_target(project, events) if target == "auto" else target
    rows = product_readiness_rows(project, events, effective_target)
    blockers = [row for row in rows if row["required"] and not row["passed"]]
    if blockers:
        verdict_cn = "不可出图" if effective_target == "prototype" else "不可交付"
        next_action = blockers[0]["action"]
        reason = f"{blockers[0]['name']}：{blockers[0]['status']}"
    else:
        verdict_cn = "可出图" if effective_target == "prototype" else "可交付"
        next_action = "继续进入下一步"
        reason = "关键门槛已通过"
    return effective_target, verdict_cn, reason, next_action, rows


def render_readiness_summary(run_id: Optional[str], target: str = "auto") -> str:
    project = read_json(project_dir() / "project.json")
    chosen_run, events = read_run(run_id)
    effective_target, verdict_cn, reason, next_action, _rows = readiness_verdict(project, events, target)
    lines = [
        "# 产品准备度",
        "",
        f"- 目标：{readiness_target_label(effective_target)}",
        f"- 结论：{verdict_cn}",
        f"- 原因：{reason}",
        f"- 下一步：{next_action}",
    ]
    if os.environ.get("PMW_DEBUG_OUTPUT") == "true":
        lines.append(f"- 调试：run={chosen_run or '暂无'}，project={current_slug()}")
    lines.append("")
    return "\n".join(lines)


def render_status(run_id: Optional[str]) -> str:
    root = project_dir()
    project = read_json(root / "project.json")
    chosen_run, events = read_run(run_id)
    latest_status = project.get("latest_run_status") or (events[-1].get("status") if events else "暂无")
    brief_name, brief_meta = latest_brief_summary(str(project.get("latest_brief", "")))
    decisions = read_jsonl(root / "decisions.jsonl")[-5:]
    questions = read_jsonl(root / "questions.jsonl")[-5:]
    board = current_board_items(root, str(project.get("latest_brief", "")), str(project.get("latest_brief_version") or ""), chosen_run)
    board_scores = {}
    for row in read_jsonl(root / "prototype-board.jsonl"):
        if row.get("record_type") == "score":
            board_scores[row.get("scheme", "")] = row
    prototypes = all_jsonl("prototypes/*.jsonl")
    reviews = [e for e in events if e.get("event") == "review"]
    evidence = [e for e in events if e.get("event") == "evidence"]
    artifacts = [e for e in events if e.get("event") == "artifact"]
    artifact_flow = artifact_flow_rows(root)
    browser_evidence = browser_evidence_rows(root)
    visual_baselines = visual_baseline_rows(root)
    review_specialists = review_specialist_rows(root)
    run_decisions = [e for e in events if e.get("event") == "decision"]
    tuning = read_jsonl(root / "question-tuning.jsonl")[-5:]
    delivery_facts = (read_jsonl(user_dir() / "delivery-facts.jsonl") + read_jsonl(root / "delivery-facts.jsonl"))[-8:]

    lines = [
        "# PMWorkspace 证据状态页",
        "",
        f"- 项目：{project.get('display_name') or pathlib.Path.cwd().name}",
        f"- 技术标识：{project.get('slug') or current_slug()}",
        f"- 当前 run：{chosen_run or '暂无'}",
        f"- 当前状态：{latest_status}",
        f"- 生成时间：{datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}",
        "",
        render_readiness_section(run_id, "auto", "##").rstrip(),
        "",
        "## 产品简报与 Zoon",
        "",
        f"- 最新简报：{brief_name}",
        f"- 简报状态：{brief_meta}",
        f"- Zoon URL：{redact_sensitive(str(project.get('zoon_url') or '未记录'))}",
        f"- Zoon 同步状态：{project.get('last_zoon_sync_status') or '未记录'}",
        f"- 最近 Zoon 同步：{project.get('last_zoon_sync_at') or '未记录'}",
        f"- Zoon 同步本地副本：{project.get('last_zoon_sync_brief') or '未记录'}",
        f"- Zoon 同步失败原因：{project.get('last_zoon_sync_error') or '无'}",
        f"- Zoon 协作加入状态：{project.get('last_zoon_join_status') or '未记录'}",
        f"- 最近 Zoon 协作加入：{project.get('last_zoon_join_at') or '未记录'}",
        f"- Zoon 协作加入失败原因：{redact_sensitive(str(project.get('last_zoon_join_error') or '无'))}",
        "",
        "## 证据与门槛",
        "",
    ]
    lines.extend(bullet_or_empty([f"{r.get('status', '')}｜{r.get('title', '')}：{r.get('summary', '')}" for r in evidence]))
    lines.extend(["", "## 浏览器证据", ""])
    lines.extend(bullet_or_empty(browser_evidence))
    lines.extend(["", "## 视觉基线", ""])
    lines.extend(bullet_or_empty(visual_baselines))
    lines.extend(["", "## 决策与问题", ""])
    decision_rows = [f"{r.get('status', '')}｜{r.get('title', '')}：{r.get('summary', '')}" for r in run_decisions]
    decision_rows.extend([f"{r.get('title', r.get('question_id', ''))}：{r.get('body') or r.get('summary') or r.get('user_choice') or ''}" for r in decisions + questions])
    lines.extend(bullet_or_empty(decision_rows))
    lines.extend(["", "## 原型与方案板", ""])
    board_rows = [
        f"{r.get('scheme', '未命名')} / {r.get('screen', '未命名屏幕')}｜{board_scores.get(r.get('scheme', ''), {}).get('score', '未评分')}｜brief {r.get('brief_version', '未标注')}"
        for r in board[-10:]
    ]
    manifest_rows = [f"{r.get('scheme', r.get('方案名', '原型项'))}｜{r.get('screen', r.get('屏幕任务', ''))}" for r in prototypes[-10:]]
    lines.extend(bullet_or_empty(board_rows + manifest_rows))
    lines.extend(["", "## 复审结论", ""])
    lines.extend(bullet_or_empty([f"{r.get('status', '')}｜{r.get('title', '')}：{r.get('summary', '')}" for r in reviews]))
    lines.extend(["", "## 可插拔复审专家", ""])
    lines.extend(bullet_or_empty(review_specialists))
    lines.extend(["", "## 产物流动", ""])
    lines.extend(bullet_or_empty(artifact_flow))
    lines.extend(["", "## 产物清单", ""])
    lines.extend(bullet_or_empty([f"{r.get('status', '')}｜{r.get('title', '')}：{r.get('summary', '')}" for r in artifacts]))
    lines.extend(["", "## 交付资产", ""])
    lines.extend(
        bullet_or_empty(
            [
                f"{r.get('fact_type', '交付事实')}｜{r.get('target', '')}｜{r.get('scope', '')}｜{r.get('note', '')}"
                for r in delivery_facts
            ]
        )
    )
    lines.extend(["", "## 问题偏好", ""])
    lines.extend(bullet_or_empty([f"{r.get('dimension', '')}：{r.get('policy', '')}｜{r.get('reason', '')}" for r in tuning]))
    return "\n".join(lines) + "\n"


def render_status_summary(run_id: Optional[str]) -> str:
    root = project_dir()
    project = read_json(root / "project.json")
    chosen_run, events = read_run(run_id)
    latest_status = project.get("latest_run_status") or (events[-1].get("status") if events else "暂无")
    brief_name, brief_meta = latest_brief_summary(str(project.get("latest_brief", "")))
    target, verdict_cn, reason, next_action, _rows = readiness_verdict(project, events, "auto")
    artifact_count = len(read_jsonl(root / "artifact-flow.jsonl"))
    board_count = len(current_board_items(root, str(project.get("latest_brief", "")), str(project.get("latest_brief_version") or ""), chosen_run))
    review = latest_review(events)
    zoon_sync_status = str(project.get("last_zoon_sync_status") or "")
    if zoon_sync_status == "synced":
        zoon_summary = "已同步"
    elif zoon_sync_status == "disabled":
        zoon_summary = "未启用，使用本地简报"
    else:
        zoon_summary = zoon_sync_status or "未记录"
    lines = [
        "# PMWorkspace 状态摘要",
        "",
        f"- 项目：{project.get('display_name') or pathlib.Path.cwd().name}",
        f"- 当前状态：{latest_status}",
        f"- 产品简报：{brief_name}（{brief_meta}）",
        f"- Zoon：{zoon_summary}",
        f"- 准备度：{readiness_target_label(target)}，{verdict_cn}，{reason}",
        f"- 下一步：{next_action}",
        f"- 产物记录：{artifact_count} 条；方案单元：{board_count} 个；复审：{review.get('status') or '未记录'}",
    ]
    if os.environ.get("PMW_DEBUG_OUTPUT") == "true":
        lines.append(f"- 调试：run={chosen_run or '暂无'}，project={current_slug()}")
    lines.append("")
    lines.append("需要完整审计表时，运行 `pmw-dashboard status --details`。")
    lines.append("")
    return "\n".join(lines)


def main() -> int:
    global PROJECT_OVERRIDE
    parser = argparse.ArgumentParser(prog="pmw-dashboard")
    sub = parser.add_subparsers(dest="command", required=True)
    status = sub.add_parser("status")
    status.add_argument("--project")
    status.add_argument("--run")
    status.add_argument("--details", action="store_true")
    readiness = sub.add_parser("readiness")
    readiness.add_argument("--project")
    readiness.add_argument("--run")
    readiness.add_argument("--target", choices=["auto", "prototype", "handoff"], default="auto")
    readiness.add_argument("--details", action="store_true")
    args = parser.parse_args()
    if getattr(args, "project", None):
        PROJECT_OVERRIDE = resolve_project_identifier(args.project)
    elif getattr(args, "run", None):
        PROJECT_OVERRIDE = project_for_run(args.run)
    if args.command == "status":
        print(render_status(args.run) if args.details else render_status_summary(args.run), end="")
        return 0
    if args.command == "readiness":
        print(render_readiness_section(args.run, args.target) if args.details else render_readiness_summary(args.run, args.target), end="")
        return 0
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
