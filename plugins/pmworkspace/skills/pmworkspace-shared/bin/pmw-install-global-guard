#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import pathlib
import sys


START = "<!-- PMW-GLOBAL-GUARD:START -->"
END = "<!-- PMW-GLOBAL-GUARD:END -->"

GUARD_BLOCK = f"""{START}
## PMWorkspace / AI 产品工作站全局入口守卫

这条规则优先于普通 image-2 原型输出规则。

只要用户请求包含 `AI 产品工作站`、`PMWorkspace`、`PMW`、`方案及原型`，或同时包含产品方案 / 产品原型 / 出图意图与汽车之家、AutoDesign、独号、线索、询价、查价、经销商、转化率、新能源车系页、排行榜、搜索、首页弹窗等 PMW 信号，必须先运行本机 PMW trigger guard：

```bash
_PMW_BIN="$HOME/.agents/plugins/plugins/pmworkspace/skills/pmworkspace-shared/bin"
"$_PMW_BIN/pmw-trigger-guard" --text "<本轮用户原话和材料摘要>" --skill pm-workspace --json
```

如果 `pmw_required=true`，下一步必须运行：

```bash
"$_PMW_BIN/pmw-controller" intake --goal "<本轮产品目标>" --materials "<本轮用户材料摘要>" --skill pm-workspace --product-path "待判断" --depth deep --stage intake --json
"$_PMW_BIN/pmw-controller" next --json
```

如果上述命令不能运行，必须停止，并说明：`PMW runtime 未接管当前任务，已阻断普通方案输出和出图`。不能继续普通产品分析，不能读数据后直接给方案，不能调用 imagegen，不能用 HTML / 线框图替代。
{END}"""


def install_guard(text: str) -> tuple[str, str]:
    if START in text and END in text:
        before, rest = text.split(START, 1)
        _, after = rest.split(END, 1)
        updated = before.rstrip() + "\n\n" + GUARD_BLOCK + after
        return updated, "updated"

    lines = text.splitlines()
    if lines and lines[0].strip() == "# AGENTS":
        updated = "\n".join([lines[0], "", GUARD_BLOCK, *lines[1:]]).rstrip() + "\n"
        return updated, "installed"

    updated = (GUARD_BLOCK + "\n\n" + text).rstrip() + "\n"
    return updated, "installed"


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pmw-install-global-guard")
    parser.add_argument(
        "--path",
        default="~/.codex/AGENTS.md",
        help="Codex global AGENTS.md path. Defaults to ~/.codex/AGENTS.md.",
    )
    parser.add_argument("--check", action="store_true", help="Check whether the current file has the exact guard block.")
    parser.add_argument("--json", action="store_true")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    path = pathlib.Path(args.path).expanduser()
    text = path.read_text(encoding="utf-8") if path.exists() else "# AGENTS\n"
    updated, status = install_guard(text)
    current = text == updated

    payload = {
        "path": str(path),
        "status": "current" if current else status,
        "changed": not current,
        "has_guard": START in updated and END in updated,
    }

    if args.check:
        if args.json:
            print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
        elif current:
            print(f"PMW_GLOBAL_GUARD current {path}")
        else:
            print(f"PMW_GLOBAL_GUARD drift {path}", file=sys.stderr)
        return 0 if current else 1

    if not current:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(updated, encoding="utf-8")

    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print(f"PMW_GLOBAL_GUARD {payload['status']} {path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
