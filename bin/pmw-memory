#!/usr/bin/env python3
import argparse
import json
import os
import pathlib
import re
import subprocess
import sys
from datetime import datetime, timezone


SCRIPT_DIR = pathlib.Path(__file__).resolve().parent
STATE_DIR = pathlib.Path(os.environ.get("PMW_HOME", str(pathlib.Path.home() / ".pmworkspace"))).expanduser()

FEEDBACK_TYPES = {"preference", "product-cognition", "pmworkspace-improvement"}
GLOBAL_SCOPES = {"同类场景可复用", "个人全局偏好", "PMWorkspace 进化候选"}
PROJECT_SCOPES = {"本项目", "仅本项目"}


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def slug() -> str:
    env_slug = os.environ.get("PMW_PROJECT_SLUG")
    if env_slug:
        return env_slug
    try:
        return subprocess.check_output([str(SCRIPT_DIR / "pmw-slug")], text=True).strip()
    except Exception:
        return "local-project"


def project_dir() -> pathlib.Path:
    path = STATE_DIR / "projects" / slug()
    path.mkdir(parents=True, exist_ok=True)
    return path


def user_dir() -> pathlib.Path:
    path = STATE_DIR / "user"
    path.mkdir(parents=True, exist_ok=True)
    return path


def append_jsonl(path: pathlib.Path, row: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")


def read_jsonl(path: pathlib.Path) -> list[dict]:
    rows = []
    if not path.exists():
        return rows
    for line in path.read_text(encoding="utf-8").splitlines():
        try:
            value = json.loads(line)
        except Exception:
            continue
        if isinstance(value, dict):
            rows.append(value)
    return rows


def redact_text(text: str) -> str:
    value = text
    value = re.sub(r"(?i)(token|api[_-]?key|cookie|ownerSecret|authorization)\s*[:=]\s*[\w./+=:-]+", r"\1=[已脱敏]", value)
    value = re.sub(r"(?i)https?://\S*(token|ownerSecret|secret|key|auth)\S*", "[含敏感参数的 URL 已脱敏]", value)
    value = re.sub(r"(?i)(bearer\s+)[\w./+=:-]+", r"\1[已脱敏]", value)
    return value.strip()


def safe_fragment(value: str) -> str:
    cleaned = re.sub(r"[/:\\\s]+", "-", value.strip())
    cleaned = re.sub(r"[^A-Za-z0-9._\-\u4e00-\u9fff]", "", cleaned)
    return cleaned.strip("-") or "feedback"


def describe(row: dict) -> str:
    note = str(row.get("note", "") or row.get("observation", "")).strip()
    scenario = str(row.get("scenario", "")).strip()
    target = str(row.get("target", "")).strip()
    scope = str(row.get("scope", "")).strip()
    source = str(row.get("source", "")).strip()
    confidence = str(row.get("confidence", "")).strip()
    meta = " / ".join(part for part in [scenario, target, scope, source, confidence] if part)
    if note and meta:
        return f"{note}（{meta}）"
    return note or meta


def feedback_path(feedback_type: str, scope: str) -> pathlib.Path:
    root = project_dir() if scope in PROJECT_SCOPES else user_dir()
    if feedback_type == "preference":
        return root / "taste-profile.jsonl"
    if feedback_type == "product-cognition":
        return root / "product-cognition.jsonl"
    return root / "pmworkspace-improvements.jsonl"


def command_add_learning(args: argparse.Namespace) -> int:
    note = redact_text(" ".join(args.note).strip())
    if not note:
        return 1
    append_jsonl(project_dir() / "learnings.jsonl", {"ts": now(), "note": note})
    print(project_dir() / "learnings.jsonl")
    return 0


def command_add_feedback(args: argparse.Namespace) -> int:
    feedback_type = args.type
    if feedback_type not in FEEDBACK_TYPES:
        print(f"未知反馈类型：{feedback_type}", file=sys.stderr)
        return 1
    note = redact_text(args.note or " ".join(args.note_positional).strip())
    if not note:
        print("add-feedback 需要 --note 或正文。", file=sys.stderr)
        return 1
    scope = args.scope
    if feedback_type == "pmworkspace-improvement" and scope == "本项目":
        scope = "PMWorkspace 进化候选"
    row = {
        "ts": now(),
        "type": feedback_type,
        "action": args.action,
        "note": note,
        "scenario": redact_text(args.scenario),
        "target": redact_text(args.target),
        "scope": scope,
        "source": args.source,
        "confidence": str(args.confidence),
    }
    path = feedback_path(feedback_type, scope)
    append_jsonl(path, row)
    print(path)
    return 0


def command_draft_github_feedback(args: argparse.Namespace) -> int:
    title = redact_text(args.title)
    observation = redact_text(args.observation or " ".join(args.observation_positional).strip())
    if not observation:
        print("draft-github-feedback 需要 --observation 或正文。", file=sys.stderr)
        return 1
    affected_skill = redact_text(args.affected_skill)
    suggested_rule = redact_text(args.suggested_rule)
    suggested_eval = redact_text(args.suggested_eval)
    source = redact_text(args.source)
    ts = now()
    draft_dir = user_dir() / "pmworkspace-feedback-drafts"
    draft_dir.mkdir(parents=True, exist_ok=True)
    path = draft_dir / f"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}-{safe_fragment(title)}.md"
    body = f"""# {title}

## 反馈来源
- 来源：{source}
- 时间：{ts}

## 脱敏观察
{observation}

## 影响的技能
{affected_skill}

## 建议规则
{suggested_rule}

## 建议 eval
{suggested_eval}

## 隐私检查
- 不包含真实项目名、客户资料、截图内容、Zoon 正文、token、cookie、ownerSecret、内部 URL 或未脱敏 PRD。
- 这是本地待审稿，不会自动提交 GitHub、issue 或 PR。
"""
    path.write_text(body, encoding="utf-8")
    append_jsonl(
        user_dir() / "pmworkspace-improvements.jsonl",
        {
            "ts": ts,
            "type": "pmworkspace-improvement",
            "note": observation,
            "scenario": "",
            "target": affected_skill,
            "scope": "PMWorkspace 进化候选",
            "source": source,
            "confidence": str(args.confidence),
            "draft": str(path),
        },
    )
    print(path)
    return 0


def command_search(args: argparse.Namespace) -> int:
    query = " ".join(args.query).strip().lower()
    if not query:
        return 1
    root = project_dir()
    uroot = user_dir()
    rows = (
        read_jsonl(root / "learnings.jsonl")
        + read_jsonl(root / "taste-profile.jsonl")
        + read_jsonl(root / "product-cognition.jsonl")
        + read_jsonl(uroot / "taste-profile.jsonl")
        + read_jsonl(uroot / "product-cognition.jsonl")
        + read_jsonl(uroot / "pmworkspace-improvements.jsonl")
    )
    matches = []
    for row in rows:
        text = json.dumps(row, ensure_ascii=False).lower()
        if query in text:
            matches.append(row)
    for row in matches[-10:]:
        print(json.dumps(row, ensure_ascii=False, sort_keys=True))
    return 0


def command_taste_summary(_: argparse.Namespace) -> int:
    project_rows = read_jsonl(project_dir() / "taste-profile.jsonl")
    user_rows = read_jsonl(user_dir() / "taste-profile.jsonl")
    rows = user_rows + project_rows
    if not rows:
        print("偏好记忆：暂无")
        return 0
    approved = [r for r in rows if str(r.get("action", "")).lower() in {"approved", "accept", "喜欢", "通过"}]
    rejected = [r for r in rows if str(r.get("action", "")).lower() in {"rejected", "reject", "不喜欢", "拒绝"}]
    print("偏好记忆：")
    print(f"- 个人全局偏好：{len(user_rows)} 条")
    print(f"- 当前项目偏好：{len(project_rows)} 条")
    if approved:
        print("- 最近喜欢：" + "；".join(describe(r) for r in approved[-3:] if describe(r)))
    if rejected:
        print("- 最近拒绝：" + "；".join(describe(r) for r in rejected[-3:] if describe(r)))
    return 0


def command_summary(_: argparse.Namespace) -> int:
    root = project_dir()
    learnings = read_jsonl(root / "learnings.jsonl")
    tastes = read_jsonl(root / "taste-profile.jsonl")
    decisions = read_jsonl(root / "decisions.jsonl")
    print("PMWorkspace 项目记忆：")
    print(f"- 产品学习：{len(learnings)} 条")
    print(f"- 偏好反馈：{len(tastes)} 条")
    print(f"- 已记录决策：{len(decisions)} 条")
    if learnings:
        print("- 最近学习：" + "；".join(str(r.get("note", "")).strip() for r in learnings[-3:] if r.get("note")))
    if decisions:
        print("- 最近决策：" + "；".join(str(r.get("title", "")).strip() for r in decisions[-3:] if r.get("title")))
    return 0


def command_user_summary(_: argparse.Namespace) -> int:
    root = project_dir()
    uroot = user_dir()
    global_tastes = read_jsonl(uroot / "taste-profile.jsonl")
    project_tastes = read_jsonl(root / "taste-profile.jsonl")
    cognition = read_jsonl(uroot / "product-cognition.jsonl")
    improvements = read_jsonl(uroot / "pmworkspace-improvements.jsonl")
    print("PMWorkspace 用户记忆：")
    print("- 说明：以下是个人全局记忆 + 当前项目记忆；只能作为推荐来源，不能覆盖当前 brief、Zoon、反指标、不可虚构项或线上参考门槛。")
    print(f"- 个人全局偏好：{len(global_tastes)} 条")
    print(f"- 当前项目偏好：{len(project_tastes)} 条")
    print(f"- 产品认知：{len(cognition)} 条")
    print(f"- PMWorkspace 进化候选：{len(improvements)} 条")
    if global_tastes or project_tastes:
        recent = (global_tastes + project_tastes)[-3:]
        print("- 基于过往偏好：" + "；".join(describe(r) for r in recent if describe(r)))
    if cognition:
        print("- 最近产品认知：" + "；".join(describe(r) for r in cognition[-3:] if describe(r)))
    if improvements:
        print("- 最近进化候选：" + "；".join(describe(r) for r in improvements[-3:] if describe(r)))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pmw-memory")
    sub = parser.add_subparsers(dest="command", required=True)

    add_learning = sub.add_parser("add-learning")
    add_learning.add_argument("note", nargs="+")
    add_learning.set_defaults(func=command_add_learning)

    search = sub.add_parser("search")
    search.add_argument("query", nargs="+")
    search.set_defaults(func=command_search)

    summary = sub.add_parser("summary")
    summary.set_defaults(func=command_summary)

    taste_summary = sub.add_parser("taste-summary")
    taste_summary.set_defaults(func=command_taste_summary)

    user_summary = sub.add_parser("user-summary")
    user_summary.set_defaults(func=command_user_summary)

    add_feedback = sub.add_parser("add-feedback")
    add_feedback.add_argument("--type", required=True, choices=sorted(FEEDBACK_TYPES))
    add_feedback.add_argument("--note", default="")
    add_feedback.add_argument("--action", default="approved")
    add_feedback.add_argument("--scenario", default="")
    add_feedback.add_argument("--target", default="")
    add_feedback.add_argument("--scope", default="个人全局偏好")
    add_feedback.add_argument("--source", default="用户反馈")
    add_feedback.add_argument("--confidence", default="0.4")
    add_feedback.add_argument("note_positional", nargs="*")
    add_feedback.set_defaults(func=command_add_feedback)

    draft = sub.add_parser("draft-github-feedback")
    draft.add_argument("--title", default="PMWorkspace 反馈回流")
    draft.add_argument("--source", default="用户反馈")
    draft.add_argument("--observation", default="")
    draft.add_argument("--affected-skill", default="$pm-prototype-review")
    draft.add_argument("--suggested-rule", default="待用户确认后再写入 PMWorkspace 规则。")
    draft.add_argument("--suggested-eval", default="待用户确认后补充 eval fixture。")
    draft.add_argument("--confidence", default="0.4")
    draft.add_argument("observation_positional", nargs="*")
    draft.set_defaults(func=command_draft_github_feedback)

    return parser


def main() -> int:
    args = build_parser().parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
