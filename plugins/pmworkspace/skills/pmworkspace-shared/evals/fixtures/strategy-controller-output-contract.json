{
  "id": "strategy-controller-output-contract",
  "title": "策略审查必须结论先行并把策略取舍控制器写入审计",
  "category": "pm-strategy-review",
  "primary_skill": "pm-strategy-review",
  "prompt": "使用 $pm-strategy-review 审查这个产品方向，重点看范围、价值交换和风险。",
  "expected": {
    "mode": "deep",
    "status": "待确认",
    "must_stop": false,
    "gate": "产品方向审查控制器",
    "required_behaviors": [
      "先输出策略审查结论",
      "输出我建议",
      "输出路径对比",
      "输出最大策略矛盾",
      "输出范围模式",
      "输出进入产品简报的写法",
      "内部记录前提挑战、现状替代、不做推演和路径对比",
      "内部记录产品动作、策略取舍和本周期验证",
      "输出当前 D",
      "内部记录下一技能和证据状态"
    ],
    "forbidden_behaviors": [
      "只输出审美建议",
      "默认展开策略取舍控制面板",
      "省略内部来源门槛",
      "省略内部下一技能"
    ]
  },
  "contract_checks": [
    {
      "path": "pmworkspace-shared/references/adversarial-review.md",
      "contains": "## 产品方向审查控制器"
    },
    {
      "path": "pmworkspace-shared/references/adversarial-review.md",
      "contains": "每次必须输出：`我不赞成什么 / 我建议什么 / 为什么 / 本周期怎么验证 / 当前 D`"
    },
    {
      "path": "pm-strategy-review/SKILL.md",
      "contains": "策略审查结论："
    },
    {
      "path": "pm-strategy-review/SKILL.md",
      "contains": "- 路径对比："
    },
    {
      "path": "pm-strategy-review/SKILL.md",
      "contains": "- 最大策略矛盾："
    },
    {
      "path": "pm-strategy-review/SKILL.md",
      "contains": "- 范围模式：扩大模式 / 选择性扩大模式 / 保持模式 / 收缩模式 / 转向模式"
    },
    {
      "path": "pm-strategy-review/SKILL.md",
      "contains": "- 进入产品简报的写法："
    },
    {
      "path": "pm-strategy-review/SKILL.md",
      "contains": "内部产品方向审查控制面板（默认不展示，写入审计）："
    },
    {
      "path": "pm-strategy-review/SKILL.md",
      "contains": "- 下一技能："
    }
  ]
}
