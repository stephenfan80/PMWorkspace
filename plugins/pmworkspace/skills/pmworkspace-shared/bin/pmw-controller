def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def now_fragment() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def current_slug() -> str:
    env_slug = os.environ.get("PMW_PROJECT_SLUG", "").strip()
    if env_slug:
        return env_slug
    try:
        return subprocess.check_output([str(SCRIPT_DIR / "pmw-slug")], text=True).strip()
    except Exception:
        return "local-project"


def project_dir() -> pathlib.Path:
    path = STATE_DIR / "projects" / current_slug()
    path.mkdir(parents=True, exist_ok=True)
    (path / "runs").mkdir(parents=True, exist_ok=True)
    return path


def project_path() -> pathlib.Path:
    return project_dir() / "project.json"


def read_json(path: pathlib.Path) -> dict[str, Any]:
    if not path.exists():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def read_jsonl(path: pathlib.Path) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    if not path.exists():
        return rows
    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
        try:
            value = json.loads(line)
        except Exception:
            continue
        if isinstance(value, dict):
            rows.append(value)
    return rows


def append_jsonl(path: pathlib.Path, row: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")


def write_project(data: dict[str, Any]) -> None:
    data["slug"] = current_slug()
    data["updated_at"] = now()
    project_path().write_text(json.dumps(data, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    try:
        (STATE_DIR / "current-project").write_text(str(data["slug"]) + "\n", encoding="utf-8")
    except Exception:
        pass


def read_project() -> dict[str, Any]:
    data = read_json(project_path())
    data.setdefault("slug", current_slug())
    return data


def normalize_mode(value: str) -> str:
    return "deep"


def contains_hint(text: str, hints: list[str]) -> bool:
    lowered = text.lower()
    return any(hint.lower() in lowered for hint in hints)


def route_authority(goal: str, materials: str, product_path: str, depth: str) -> tuple[str, str, list[str]]:
    """Runtime routing guard.

    Skills can suggest product path and depth, but the controller owns runtime
    ambiguity detection. It should not hard-code a business domain. When a user
    says "new tool" while also asking to move an existing business metric, the
    safe next action is a product-path decision, not an automatic prototype.
    """
    raw_text = "\n".join([goal or "", materials or "", product_path or ""])
    resolved_path = (product_path or "").strip() or "全新功能"
    resolved_depth = normalize_mode(depth)
    reasons: list[str] = []

    explicit_existing_signal = contains_hint(raw_text, EXPLICIT_EXISTING_HINTS)
    new_build_signal = contains_hint(raw_text, NEW_BUILD_HINTS)
    business_metric_signal = contains_hint(raw_text, BUSINESS_METRIC_HINTS)
    auto_design_signal = contains_hint(raw_text, AUTO_DESIGN_HINTS)
    deep_signal = contains_hint(raw_text, DEEP_DELIVERY_HINTS) or business_metric_signal

    if explicit_existing_signal and ("已有" not in resolved_path and "迭代" not in resolved_path):
        resolved_path = "已有功能迭代"
        reasons.append("命中明确的现有/线上/迭代信号，产品路径由 skill 建议改判为已有功能迭代")
    if auto_design_signal and business_metric_signal and not new_build_signal and not explicit_existing_signal:
        resolved_path = "已有功能迭代"
        reasons.append("命中汽车之家/线索转化业务信号，默认判定为已有功能迭代，需要线上/设计基线确认")
    if new_build_signal and business_metric_signal and not explicit_existing_signal:
        reasons.append("同时命中新工具表述和业务指标优化信号，需要先确认产品路径，不能把方向选择当作产品简报对齐")
    if deep_signal and resolved_depth != "deep":
        resolved_depth = "deep"
        reasons.append("命中业务指标/生产/交付风险信号，对齐深度保持 deep")

    return resolved_path, resolved_depth, reasons


def is_terminal_status(value: str) -> bool:
    return any(token in (value or "") for token in TERMINAL_STATUS_TOKENS)


def digest_for(goal: str, materials: str, product_path: str, depth: str) -> str:
    payload = "\n".join(
        [
            goal.strip(),
            materials.strip(),
            product_path.strip(),
            normalize_mode(depth),
        ]
    )
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()[:16]


def start_run(skill: str, mode: str, goal: str) -> str:
    command = [
        str(SCRIPT_DIR / "pmw-run"),
        "start",
        "--skill",
        skill or "pm-workspace",
        "--mode",
        normalize_mode(mode),
        "--goal",
        goal or "PMWorkspace task",
    ]
    result = subprocess.run(command, text=True, capture_output=True, check=False)
    if result.returncode != 0:
        raise SystemExit(result.stderr or result.stdout or "pmw-run start failed")
    return result.stdout.strip().splitlines()[-1]


def run_file(run_id: str) -> pathlib.Path:
    return project_dir() / "runs" / f"{run_id}.jsonl"


def append_event(
    event: str,
    run_id: str,
    status: str,
    title: str,
    summary: str,
    project: dict[str, Any],
    extra: dict[str, Any] | None = None,
) -> dict[str, Any]:
    row = {
        "ts": now(),
        "event": event,
        "run_id": run_id,
        "status": status,
        "title": title,
        "summary": summary,
    }
    row.update(extra or {})
    rt.stamp_row(row, rt.resolve_context(project))
    append_jsonl(run_file(run_id), row)
    return row


def task_context(project: dict[str, Any]) -> dict[str, str]:
    context = {
        "task_digest": str(project.get("current_task_digest") or ""),
        "input_revision": str(project.get("current_input_revision") or ""),
        "controller_verdict": str(project.get("last_controller_verdict") or ""),
    }
    context["run_id"] = str(project.get("current_run_id") or "")
    return context


def current_run_is_active(project: dict[str, Any]) -> bool:
    run_id = str(project.get("current_run_id") or "")
    if not run_id:
        return False
    if is_terminal_status(str(project.get("latest_run_status") or "")):
        return False
    return run_file(run_id).exists()


def reference_required(project: dict[str, Any]) -> bool:
    product_path = str(project.get("current_product_path") or "")
    goal = str(project.get("current_task_goal") or "")
    raw_text = "\n".join([product_path, goal])
    return "已有" in product_path or "迭代" in product_path or contains_hint(raw_text, EXPLICIT_EXISTING_HINTS)


def route_confirmation_required(project: dict[str, Any]) -> bool:
    product_path = str(project.get("current_product_path") or "")
    reasons = [str(item) for item in project.get("controller_route_reasons") or []]
    if latest_confirm(project, "path"):
        return False
    if "已有" in product_path or "迭代" in product_path:
        return False
    return any("需要先确认产品路径" in reason for reason in reasons)


def current_reference_artifact(project: dict[str, Any]) -> dict[str, Any]:
    return current_artifact("visual_baseline", project) or current_artifact("browser_evidence", project)


def event_matches_current_task(row: dict[str, Any], project: dict[str, Any]) -> bool:
    return rt.row_matches_context(row, rt.resolve_context(project))


def artifact_rows(kind: str = "") -> list[dict[str, Any]]:
    rows = read_jsonl(project_dir() / "artifact-flow.jsonl")
    if kind:
        rows = [row for row in rows if row.get("kind") == kind]
    return rows


def current_artifact(kind: str, project: dict[str, Any]) -> dict[str, Any]:
    context = rt.resolve_context(project)
    for row in reversed(artifact_rows(kind)):
        if rt.row_matches_context(row, context):
            return row
    return {}


def board_items(project: dict[str, Any]) -> list[dict[str, Any]]:
    context = rt.resolve_context(project)
    rows = [row for row in read_jsonl(project_dir() / "prototype-board.jsonl") if row.get("record_type", "item") == "item"]
    scoped = []
    for row in rows:
        if rt.row_matches_context(row, context):
            scoped.append(row)
    return scoped


def prototype_review_passed(row: dict[str, Any]) -> bool:
    if not row:
        return False
    text = f"{row.get('status', '')} {row.get('title', '')} {row.get('summary', '')}"
    passed = any(token in text for token in ["可通过", "可交付"])
    blocked = any(token in text for token in ["需要重出", "需要 PM 拍板", "需要补充参考", "未复审", "待确认", "未确认"])
    return passed and not blocked


def handoff_artifacts_ready(project: dict[str, Any]) -> tuple[bool, str]:
    manifest = current_artifact("prototype_manifest", project)
    if not manifest:
        return False, "HANDOFF_ARTIFACTS_REQUIRED: 当前 revision 缺少 prototype_manifest，不能进入交付。"
    review = current_artifact("prototype_review", project)
    if not review:
        return False, "HANDOFF_ARTIFACTS_REQUIRED: 当前 revision 缺少 prototype_review=可通过，不能进入交付。"
    if not prototype_review_passed(review):
        return False, "HANDOFF_ARTIFACTS_REQUIRED: 当前 revision 的 prototype_review 不是可通过 / 可交付，或仍有需要重出、PM 拍板、补参考项。"
    return True, "当前 revision 已绑定 prototype_manifest 和可通过的 prototype_review。"


def latest_event(project: dict[str, Any], needles: list[str]) -> dict[str, Any]:
    run_id = str(project.get("current_run_id") or "")
    for row in reversed(read_jsonl(run_file(run_id))):
        if not event_matches_current_task(row, project):
            continue
        text = f"{row.get('status', '')} {row.get('title', '')} {row.get('summary', '')}"
        if any(needle in text for needle in needles):
            return row
    return {}


def confirmed_status(row: dict[str, Any]) -> bool:
    return rt.event_is_confirmed(row)


def latest_confirm(project: dict[str, Any], kind: str) -> dict[str, Any]:
    run_id = str(project.get("current_run_id") or "")
    title = CONFIRM_TITLES.get(kind, kind)
    for row in reversed(read_jsonl(run_file(run_id))):
        if row.get("event") != "controller_confirm":
            continue
        if not event_matches_current_task(row, project):
            continue
        subject = str(row.get("confirm_subject") or "")
        if (subject == kind or row.get("title") == title) and confirmed_status(row):
            return row
    return {}


BRIEF_BOUNDARY_GROUPS = [
    ("目标用户", ["目标用户", "目标人群", "用户"]),
    ("核心问题", ["核心问题", "真实问题", "用户痛点", "当前损失"]),
    ("推荐方案", ["推荐方案", "推荐路径", "方案"]),
    ("原型范围", ["原型范围", "本轮原型", "输出范围"]),
    ("本轮不做", ["本轮不做", "范围外", "不做"]),
    ("主目标", ["主目标", "目标指标", "成功指标"]),
    ("反指标", ["反指标", "护栏指标"]),
    ("不可虚构项", ["不可虚构", "不可承诺", "不能承诺"]),
]


def brief_text(path_value: str) -> str:
    path = pathlib.Path(path_value)
    return path.read_text(encoding="utf-8", errors="ignore") if path.exists() else ""


def first_missing_boundary(text: str) -> str:
    for label, tokens in BRIEF_BOUNDARY_GROUPS:
        if not contains_hint(text, tokens):
            return f"缺少{label}"
    return ""


def brief_boundary_check(project: dict[str, Any], path_value: str) -> tuple[bool, str, str]:
    text = brief_text(path_value)
    if not text.strip():
        return False, "简报文件为空或不可读取", text
    missing = first_missing_boundary(text)
    if missing:
        return False, missing, text
    if reference_required(project) and not current_reference_artifact(project):
        return False, "缺线上/视觉基线，不能锁定为原型事实源", text
    risky = contains_hint(text, ["价格", "补贴", "库存", "金融", "利率", "置换", "真实成交", "报价"])
    if risky and not contains_hint(text, ["不可承诺", "不可虚构", "不能承诺", "需核验", "待核验"]):
        return False, "有价格/交易承诺风险，但缺少不可承诺边界", text
    return True, "", text


def current_product_brief_artifact(project: dict[str, Any], brief_path: str, brief_version: str) -> dict[str, Any]:
    context = rt.resolve_context(project)
    for row in reversed(artifact_rows("product_brief")):
        if not rt.row_matches_context(row, context):
            continue
        if str(row.get("path") or "") == brief_path and str(row.get("brief_version") or "") == brief_version:
            return row
    return {}


def product_brief_artifact_id(run_id: str, context: dict[str, str], brief_path: str, brief_version: str) -> str:
    raw = "|".join(["brief_lock", run_id, context.get("task_digest", ""), context.get("input_revision", ""), brief_path, brief_version])
    return f"{now_fragment()}-product-brief-{hashlib.sha256(raw.encode('utf-8')).hexdigest()[:8]}"


def ensure_locked_brief_artifact(project: dict[str, Any], lock: dict[str, Any], summary: str = "") -> tuple[str, bool]:
    brief_path = str(lock.get("brief_path") or project.get("latest_brief") or "")
    brief_version = str(lock.get("brief_version") or project.get("latest_brief_version") or "v1")
    existing = current_product_brief_artifact(project, brief_path, brief_version)
    if existing:
        return str(existing.get("artifact_id") or ""), False
    context = rt.resolve_context(project)
    run_id = str(context.get("run_id") or project.get("current_run_id") or "")
    artifact_id = product_brief_artifact_id(run_id, context, brief_path, brief_version)
    row: dict[str, Any] = {
        "ts": now(),
        "artifact_id": artifact_id,
        "kind": "product_brief",
        "title": "已锁定产品简报",
        "status": "已锁定",
        "source_skill": "pm-brief",
        "path": brief_path,
        "url": "",
        "summary": summary or str(lock.get("summary") or "产品简报已锁定，是当前原型事实源。"),
        "pm_judgment_summary": "由 brief_lock 自动登记。",
        "product_homework": "",
        "upstream": ["autoplan", "product_direction", "strategy"],
        "next_skill": ["pm-prototype-shotgun"],
        "brief_version": brief_version,
        "idempotency_key": "|".join(["brief_lock", run_id, context.get("task_digest", ""), context.get("input_revision", ""), brief_path, brief_version]),
    }
    rt.stamp_row(row, context)
    append_jsonl(project_dir() / "artifact-flow.jsonl", row)
    return artifact_id, True


def task_text(project: dict[str, Any]) -> str:
    pieces = [
        str(project.get("current_task_goal") or ""),
        str(project.get("current_task_materials") or ""),
        str(project.get("current_product_path") or ""),
        str(project.get("requested_product_path") or ""),
        "\n".join(str(item) for item in project.get("controller_route_reasons") or []),
    ]
    return "\n".join(pieces)


def design_spec_required(project: dict[str, Any]) -> bool:
    if str(project.get("design_spec_required") or "").lower() in {"true", "1", "yes"}:
        return True
    return contains_hint(task_text(project), AUTO_DESIGN_HINTS)


def design_spec_current_status(project: dict[str, Any]) -> str:
    if latest_confirm(project, "design_spec") or str(project.get("design_spec_status") or "") == "已确认":
        return "已确认"
    if design_spec_required(project):
        return "待确认"
    return "不适用"


def early_design_spec_decision(project: dict[str, Any]) -> dict[str, Any]:
    if not design_spec_required(project) or design_spec_current_status(project) == "已确认":
        return {}
    return {
        "status": "待确认",
        **AUTO_DESIGN_DECISION,
    }


def strategy_review_required(project: dict[str, Any]) -> bool:
    return contains_hint(task_text(project), BUSINESS_METRIC_HINTS) or contains_hint(task_text(project), DEEP_DELIVERY_HINTS)


def candidate_context(project: dict[str, Any]) -> dict[str, Any]:
    digest = str(project.get("current_task_digest") or "")
    revision = str(project.get("current_input_revision") or "")
    run_id = str(project.get("current_run_id") or "")
    candidates = []
    for row in artifact_rows():
        same_run = not run_id or row.get("run_id") == run_id
        same_digest = not digest or str(row.get("task_digest") or "") == digest
        same_revision = not revision or str(row.get("input_revision") or "") == revision
        if same_run and same_digest and same_revision:
            continue
        candidates.append(str(row.get("kind") or row.get("artifact_kind") or "artifact"))
    board_candidates = 0
    for row in read_jsonl(project_dir() / "prototype-board.jsonl"):
        if row.get("record_type", "item") != "item":
            continue
        same_run = not run_id or row.get("run_id") == run_id
        same_digest = not digest or str(row.get("task_digest") or "") == digest
        same_revision = not revision or str(row.get("input_revision") or "") == revision
        if not (same_run and same_digest and same_revision):
            board_candidates += 1
    summary = {
        "status": "历史资产：可参考，不可放行" if candidates or board_candidates else "未发现历史资产",
        "artifact_kinds": sorted(set(candidates))[:12],
        "prototype_board_items": board_candidates,
        "adopted": bool(latest_confirm(project, "adopt_history")),
    }
    return summary


def workflow_stage(action: str) -> str:
    return WORKFLOW_STAGES.get(action, "intake")


def allowed_next_skill(action: str) -> str:
    return NEXT_SKILLS.get(action, "$pm-workspace")


def user_visible_action(action: str) -> str:
    mapping = {
        "D_REQUIRED": "请用户拍板产品路径 D",
        "GOAL_MODE_REQUIRED": "确认工作目标模式",
        "AUTOPLAN_REQUIRED": "进入自动产品评审，输出最早门槛",
        "NEEDS_BASELINE": "补充线上/设计基线或确认按缺口推进",
        "PRODUCT_DIRECTION_REQUIRED": "进入产品方向审查内核",
        "STRATEGY_REVIEW_REQUIRED": "进入策略 / 范围审查",
        "WRITE_PENDING_BRIEF": "生成待确认产品简报",
        "ASK_CONFIRMATION": "确认当前 revision 产品简报关键前提",
        "BRIEF_PENDING": "把产品简报对齐到已确认状态",
        "DESIGN_SPEC_REQUIRED": "确认本轮原型设计规范目标",
        "REGISTER_PROTOTYPE_UNITS": "登记 prototype-board 输出单元",
        "ALLOW_IMAGE_PROMPT": "可申请单图 image-2 出图许可证",
        "ALLOW_HANDOFF": "可进入产品交付",
        "BLOCKED": "重新进入 PMW intake",
    }
    return mapping.get(action, action)


def required_user_action(action: str, reason: str) -> str:
    if action == "ALLOW_IMAGE_PROMPT":
        return "无需新的用户动作；先签发每张图的一次性 image_permit_id。"
    if action == "GOAL_MODE_REQUIRED":
        return "让用户在验证价值 / 优化线上指标 / 业务评审 / 设计评审 / 研发交付中确认本轮工作目标。"
    if action == "DESIGN_SPEC_REQUIRED":
        return "让用户确认使用汽车之家 AutoDesign、用户提供的 Figma/截图/线上页面，或改用 PMW 推荐的其他 UI 规范。"
    if action == "REGISTER_PROTOTYPE_UNITS":
        project = read_project()
        lock = rt.latest_brief_lock(project)
        mode = rt.image_output_mode_from_lock(lock)
        expected = rt.expected_output_units(mode)
        return f"按已对齐 brief 登记 {expected} 个完整页面输出单元；当前出图模式：{rt.image_output_mode_label(mode)}。"
    return reason


def capability_flags(action: str) -> dict[str, bool]:
    return {
        "can_write_brief": action == "WRITE_PENDING_BRIEF",
        "can_register_prototype_units": action in {"REGISTER_PROTOTYPE_UNITS", "ALLOW_IMAGE_PROMPT"},
        "can_issue_image_permit": action == "ALLOW_IMAGE_PROMPT",
        "can_handoff": action == "ALLOW_HANDOFF",
    }


ACTION_SUBJECTS = {
    "D_REQUIRED": "path",
    "GOAL_MODE_REQUIRED": "goal_mode",
    "AUTOPLAN_REQUIRED": "autoplan",
    "PRODUCT_DIRECTION_REQUIRED": "product_direction",
    "STRATEGY_REVIEW_REQUIRED": "strategy",
    "WRITE_PENDING_BRIEF": "brief",
    "ASK_CONFIRMATION": "brief",
    "BRIEF_PENDING": "brief",
    "DESIGN_SPEC_REQUIRED": "design_spec",
    "REGISTER_PROTOTYPE_UNITS": "prototype_units",
    "NEEDS_BASELINE": "visual_baseline",
    "RECOVERY_REQUIRED": "recovery",
}


def pending_gate(project: dict[str, Any], action: str, reason: str) -> dict[str, Any]:
    subject = ACTION_SUBJECTS.get(action, "")
    if not subject:
        return {}
    context = rt.resolve_context(project)
    return {
        "pending_gate_id": rt.gate_id(subject, context),
        "expected_subject": subject,
        "subject_revision": context.get("input_revision", ""),
        "expected_action": action,
        "required_user_action": required_user_action(action, reason),
    }


def workflow_payload(project: dict[str, Any], action: str, reason: str) -> dict[str, Any]:
    payload = {
        "workflow_stage": workflow_stage(action),
        "allowed_next_skill": allowed_next_skill(action),
        "allowed_user_visible_action": user_visible_action(action),
        "stop": action in STOP_ACTIONS,
        "first_blocker": "" if action == "ALLOW_IMAGE_PROMPT" else reason,
        "required_user_action": required_user_action(action, reason),
        "candidate_context": candidate_context(project),
        "design_spec_required": design_spec_required(project),
        "design_spec_status": design_spec_current_status(project),
        "early_design_spec_decision": early_design_spec_decision(project),
        **capability_flags(action),
    }
    payload.update(pending_gate(project, action, reason))
    return payload


def action_from_state(project: dict[str, Any]) -> tuple[str, str]:
    if not current_run_is_active(project):
        return "BLOCKED", "当前没有本轮 active run，或当前 run 已结束；先运行 pmw-controller intake。"
    if not str(project.get("current_task_digest") or ""):
        return "BLOCKED", "当前任务缺少 task_digest；先运行 pmw-controller intake。"
    if route_confirmation_required(project):
        return "D_REQUIRED", "本轮同时出现“新工具/新功能”和“业务指标优化”信号，需要先确认产品路径：是已有线上链路迭代、全新独立工具，还是经销商/销售侧承接工具。方向 A/B/C 不能替代产品简报对齐。"
    if not latest_confirm(project, "goal_mode"):
        return "GOAL_MODE_REQUIRED", "还没有确认本轮工作目标模式；需要先确认是验证价值、优化线上指标、业务评审、设计评审还是研发交付。"
    if not latest_confirm(project, "autoplan"):
        return "AUTOPLAN_REQUIRED", "入口之后必须先完成自动产品评审，输出当前最早门槛、理由、补齐后解锁项和下一技能。"
    if not latest_confirm(project, "product_direction"):
        return "PRODUCT_DIRECTION_REQUIRED", "还没有完成产品方向审查内核；数据分析、历史材料或方案方向选择不能替代“为什么做、赢在哪里、不做会怎样”的产品判断。"
    if strategy_review_required(project) and not latest_confirm(project, "strategy"):
        return "STRATEGY_REVIEW_REQUIRED", "本轮涉及指标、线索、交易、承诺或实验口径，需要完成策略 / 范围审查并记录当前 D。"
    latest_brief = str(project.get("latest_brief") or "")
    if not latest_brief:
        return "WRITE_PENDING_BRIEF", "本轮还没有产品简报。"
    brief_lock = rt.latest_brief_lock(project)
    lock_status = str(brief_lock.get("lock_status") or brief_lock.get("status") or "")
    if lock_status == "needs_relock":
        return "ASK_CONFIRMATION", "简报被实质修改，需要重新锁定；只需确认受影响边界，不需要重跑全流程。"
    if lock_status == "blocked":
        return "BRIEF_PENDING", f"简报边界未通过：{brief_lock.get('first_blocker') or brief_lock.get('summary') or '需要补齐关键边界'}"
    if not rt.brief_lock_is_locked(brief_lock):
        return "ASK_CONFIRMATION", "产品简报待用户确认；方向选择不能替代产品简报对齐；用户确认没有问题后，运行 pmw-controller lock-brief 一次性锁定简报。"
    ensure_locked_brief_artifact(project, brief_lock)
    if design_spec_required(project) and not latest_confirm(project, "design_spec"):
        return "DESIGN_SPEC_REQUIRED", "命中汽车之家 / AutoDesign / 线索转化相关信号，出图前必须确认本轮设计规范目标；默认推荐汽车之家 AutoDesign，但允许用户选择截图/Figma/线上基线或其他规范。"
    items = board_items(project)
    if not items:
        mode = rt.image_output_mode_from_lock(brief_lock)
        expected = rt.expected_output_units(mode)
        return "REGISTER_PROTOTYPE_UNITS", f"产品简报已对齐，当前是{rt.image_output_mode_label(mode)}，需要登记 {expected} 个完整页面输出单元。"
    return "ALLOW_IMAGE_PROMPT", "本轮已有已绑定输出单元，可继续运行出图前 readiness。"


def command_intake(args: argparse.Namespace) -> int:
    project = read_project()
    requested_mode = normalize_mode(args.depth)
    requested_product_path = args.product_path
    resolved_product_path, mode, route_reasons = route_authority(args.goal, args.materials, requested_product_path, requested_mode)
    task_digest = digest_for(args.goal, args.materials, resolved_product_path, mode)
    active = current_run_is_active(project)
    same_task = str(project.get("current_task_digest") or "") == task_digest
    if args.force_new or not active or not same_task:
        run_id = start_run(args.skill, mode, args.goal)
        input_revision = f"{now_fragment()}-{task_digest[:8]}"
        intake_status = "新建本轮 run"
    else:
        run_id = str(project.get("current_run_id") or project.get("latest_run_id") or "")
        input_revision = str(project.get("current_input_revision") or f"{now_fragment()}-{task_digest[:8]}")
        intake_status = "复用本轮 run"
    project = read_project()
    project["current_run_id"] = run_id
    project["latest_run_id"] = run_id
    project["latest_run_status"] = "已开始"
    project["current_task_digest"] = task_digest
    project["current_input_revision"] = input_revision
    project["current_task_goal"] = args.goal
    project["current_task_materials"] = args.materials
    project["current_stage"] = args.stage or args.skill
    project["current_product_path"] = resolved_product_path
    project["current_execution_depth"] = mode
    project["requested_product_path"] = requested_product_path
    project["requested_execution_depth"] = requested_mode
    project["controller_route_reasons"] = route_reasons
    project["design_spec_required"] = design_spec_required(project)
    project["design_spec_status"] = "待确认" if project["design_spec_required"] else "不适用"
    project["last_controller_verdict"] = intake_status
    action, reason = action_from_state(project)
    project["allowed_next_action"] = action
    write_project(project)
    append_event(
        "task_intake",
        run_id,
        intake_status,
        "PMW 任务入口",
        f"goal={args.goal}；materials={args.materials or '未提供'}；product_path={resolved_product_path}；depth={mode}；route_reasons={'；'.join(route_reasons) or '无'}；action={action}；reason={reason}",
        project,
    )
    payload = {
        "ok": True,
        "run_id": run_id,
        "task_digest": task_digest,
        "input_revision": input_revision,
        "status": intake_status,
        "allowed_next_action": action,
        "reason": reason,
        "requested_product_path": requested_product_path,
        "requested_execution_depth": requested_mode,
        "current_product_path": resolved_product_path,
        "current_execution_depth": mode,
        "route_reasons": route_reasons,
        "image_allowed": action == "ALLOW_IMAGE_PROMPT",
        **workflow_payload(project, action, reason),
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else f"{action} {run_id} {input_revision}")
    return 0


def command_next(args: argparse.Namespace) -> int:
    project = read_project()
    action, reason = action_from_state(project)
    project["allowed_next_action"] = action
    project["last_controller_verdict"] = reason
    write_project(project)
    payload = {
        "allowed_next_action": action,
        "reason": reason,
        "image_allowed": action == "ALLOW_IMAGE_PROMPT",
        **workflow_payload(project, action, reason),
        **task_context(project),
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else f"{action}: {reason}")
    return 0 if action not in {"BLOCKED"} else 2


def dashboard_preflight(target: str, run_id: str = "") -> dict[str, Any]:
    command = [str(SCRIPT_DIR / "pmw-dashboard"), "readiness", "--target", target, "--json"]
    if run_id:
        command.extend(["--run", run_id])
    result = subprocess.run(command, text=True, capture_output=True, check=False)
    if result.returncode not in {0, 1} and not result.stdout:
        return {"ready": False, "reason": result.stderr or "pmw-dashboard failed", "next_action": "BLOCKED"}
    try:
        payload = json.loads(result.stdout)
        return payload if isinstance(payload, dict) else {}
    except Exception:
        return {"ready": False, "reason": result.stdout or result.stderr or "pmw-dashboard returned non-json", "next_action": "BLOCKED"}


def command_preflight(args: argparse.Namespace) -> int:
    project = read_project()
    action, action_reason = action_from_state(project)
    run_id = str(project.get("current_run_id") or "")
    payload = {"ready": action == "WRITE_PENDING_BRIEF", "reason": action_reason, "next_action": action} if args.target == "brief" else dashboard_preflight(args.target, run_id)
    ready = bool(payload.get("ready")) and action != "BLOCKED"
    if args.target == "prototype" and action not in {"ALLOW_IMAGE_PROMPT"}:
        ready = False
        first_blocker = action
        next_action = action
        reason = action_reason
    elif args.target == "handoff":
        controller_ready, controller_reason = handoff_artifacts_ready(project)
        if not controller_ready:
            ready = False
            first_blocker = "HANDOFF_ARTIFACTS_REQUIRED"
            next_action = action if action != "BLOCKED" else "BLOCKED"
            reason = controller_reason
        else:
            first_blocker = str(payload.get("first_blocker") or payload.get("reason") or "")
            next_action = str(payload.get("next_action") or ("ALLOW_HANDOFF" if ready else "BLOCKED"))
            reason = str(payload.get("reason") or controller_reason)
    else:
        first_blocker = str(payload.get("first_blocker") or payload.get("reason") or "")
        next_action = str(payload.get("next_action") or ("ALLOW_IMAGE_PROMPT" if ready else "BLOCKED"))
        reason = str(payload.get("reason") or action_reason)
    verdict = "ALLOW_IMAGE_PROMPT" if ready and args.target == "prototype" else ("ALLOW_HANDOFF" if ready and args.target == "handoff" else next_action)
    fingerprint = rt.fingerprint([args.target, first_blocker, reason, project.get("current_task_digest", ""), project.get("current_input_revision", "")])
    failure_state = dict(project.get("preflight_failure_budget") or {})
    target_state = dict(failure_state.get(args.target) or {})
    if ready:
        failure_state.pop(args.target, None)
        failure_count = 0
    elif target_state.get("fingerprint") == fingerprint:
        failure_count = int(target_state.get("count") or 0) + 1
        failure_state[args.target] = {"fingerprint": fingerprint, "count": failure_count, "first_seen_at": target_state.get("first_seen_at") or now()}
    else:
        failure_count = 1
        failure_state[args.target] = {"fingerprint": fingerprint, "count": failure_count, "first_seen_at": now()}
    recovery_required = (not ready) and failure_count >= 2
    if recovery_required:
        verdict = "RECOVERY_REQUIRED"
        next_action = "RECOVERY_REQUIRED"
    project["allowed_next_action"] = verdict
    project["last_controller_verdict"] = reason
    project["preflight_failure_budget"] = failure_state
    write_project(project)
    if run_id:
        append_event(
            "preflight_verdict",
            run_id,
            "通过" if ready else "阻断",
            f"{args.target} preflight",
            f"verdict={verdict}；reason={reason}",
            project,
        )
    result_payload = {
        "ready": ready,
        "target": args.target,
        "verdict": verdict,
        "reason": reason,
        "first_blocker": first_blocker,
        "next_action": next_action,
        "failure_fingerprint": fingerprint,
        "failure_count": failure_count,
        "recovery_required": recovery_required,
        "diagnostics": payload.get("diagnostics", {}),
        **workflow_payload(project, verdict if ready else next_action, reason),
        **task_context(project),
    }
    print(json.dumps(result_payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else f"{verdict}: {reason}")
    return 0 if ready else 2


CONFIRM_TITLES = {
    "path": "产品路径确认",
    "goal_mode": "工作目标模式确认",
    "autoplan": "自动产品评审",
    "product_direction": "产品方向审查",
    "strategy": "策略审查",
    "design_spec": "设计规范目标确认",
    "brief": "产品简报确认",
    "adopt_history": "历史资产沿用确认",
    "scheme_direction": "方案方向确认",
}


GOAL_MODES = {"验证价值", "优化线上指标", "业务评审", "设计评审", "研发交付"}
PRODUCT_PATHS = {"全新功能", "已有功能迭代", "待确认"}


def missing_tokens(text: str, tokens: list[str]) -> list[str]:
    return [token for token in tokens if token not in text]


def validate_confirm_payload(kind: str, value: str, summary: str) -> str:
    text = f"{value}\n{summary}".strip()
    if kind in {"autoplan", "product_direction", "strategy", "brief", "adopt_history"} and len(summary.strip()) < 16:
        return f"{CONFIRM_TITLES.get(kind, kind)} 不能只写空确认；summary 需要记录本轮判断和证据边界。"
    if kind == "path" and value not in PRODUCT_PATHS:
        return "产品路径确认必须使用：全新功能 / 已有功能迭代 / 待确认。"
    if kind == "goal_mode" and value not in GOAL_MODES:
        return "工作目标模式必须使用：验证价值 / 优化线上指标 / 业务评审 / 设计评审 / 研发交付。"
    if kind == "autoplan":
        missing = missing_tokens(text, ["我建议", "当前最早门槛", "下一技能"])
        if missing:
            return "自动产品评审确认缺少字段：" + "、".join(missing)
    if kind == "product_direction":
        missing = missing_tokens(text, ["前提", "现状替代", "当前损失", "PM 判断"])
        if missing:
            return "产品方向审查确认缺少字段：" + "、".join(missing)
    if kind == "strategy":
        missing = missing_tokens(text, ["范围模式", "最大策略矛盾", "策略 D"])
        if missing:
            return "策略审查确认缺少字段：" + "、".join(missing)
    if kind == "design_spec" and not value:
        return "设计规范确认必须写 value，例如：汽车之家 AutoDesign / 用户截图视觉基线 / PMW 默认任务型产品 UI 基线。"
    if kind == "brief":
        if "关键前提" not in text and "按标注假设推进" not in text and "已对齐" not in text:
            return "产品简报确认必须说明关键前提已确认，或用户批准按标注假设推进。"
    if kind == "adopt_history":
        if "沿用" not in text or ("重新 stamp" not in text and "重新stamp" not in text):
            return "历史资产沿用确认必须说明沿用范围，并承诺重新 stamp 当前 run/task/revision。"
    return ""


def status_for_confirm_state(state: str, fallback: str = "已确认") -> str:
    if state == "confirmed":
        return fallback if fallback else "已确认"
    if state == "rejected":
        return "已拒绝"
    return "待确认"


def append_controller_confirm(
    project: dict[str, Any],
    run_id: str,
    kind: str,
    value: str,
    summary: str,
    status: str,
    confirm_state: str = "confirmed",
    gate_id: str = "",
) -> dict[str, Any]:
    title = CONFIRM_TITLES.get(kind, kind)
    context = rt.resolve_context(project)
    event_id = f"evt_{rt.now_fragment()}_{hashlib.sha256((run_id + kind + summary).encode('utf-8')).hexdigest()[:8]}"
    return append_event(
        "controller_confirm",
        run_id,
        status_for_confirm_state(confirm_state, status),
        title,
        summary,
        project,
        {
            "event_id": event_id,
            "value": value,
            "confirm_state": confirm_state,
            "confirm_subject": kind,
            "subject_revision": context.get("input_revision", ""),
            "gate_id": gate_id or rt.gate_id(kind, context),
            "confirmed_by_event_id": event_id,
        },
    )


def command_confirm(args: argparse.Namespace) -> int:
    project = read_project()
    run_id = str(project.get("current_run_id") or "")
    if not run_id or not run_file(run_id).exists():
        print("当前没有 active run；先运行 pmw-controller intake。", file=sys.stderr)
        return 2
    title = CONFIRM_TITLES.get(args.kind, args.kind)
    value = str(args.value or "").strip()
    summary = str(args.summary or "").strip() or value or "已确认"
    if error := validate_confirm_payload(args.kind, value, summary):
        print(f"CONFIRM_PAYLOAD_INVALID: {error}", file=sys.stderr)
        return 2
    if args.kind == "path" and value:
        project["current_product_path"] = value
    if args.kind == "goal_mode" and value:
        project["current_goal_mode"] = value
    if args.kind == "design_spec":
        project["design_spec_status"] = "已确认"
        project["design_spec_target"] = value or "汽车之家 AutoDesign"
    if args.kind == "adopt_history":
        project["history_adoption_status"] = "已确认"
    project["last_controller_verdict"] = f"{title}：{summary}"
    append_controller_confirm(project, run_id, args.kind, value, summary, args.status, "confirmed")
    action, reason = action_from_state(project)
    project["allowed_next_action"] = action
    write_project(project)
    payload = {
        "ok": True,
        "kind": args.kind,
        "title": title,
        "value": value,
        "status": args.status,
        "allowed_next_action": action,
        "reason": reason,
        **workflow_payload(project, action, reason),
        **task_context(project),
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else f"{title}: {summary}")
    return 0


def command_answer(args: argparse.Namespace) -> int:
    project = read_project()
    run_id = str(project.get("current_run_id") or "")
    if not run_id or not run_file(run_id).exists():
        print("ANSWER_BLOCKED: 当前没有 active run；短回复不能创建新任务，请先运行 pmw-controller intake。", file=sys.stderr)
        return 2
    action, reason = action_from_state(project)
    gate = pending_gate(project, action, reason)
    if not gate:
        print("AMBIGUOUS_ANSWER: 当前没有唯一 pending gate，短回复不能被自动归因。", file=sys.stderr)
        return 2
    requested_gate = str(args.gate_id or "current")
    current_gate_id = str(gate.get("pending_gate_id") or "")
    if requested_gate not in {"", "current", current_gate_id}:
        print(f"ANSWER_GATE_MISMATCH: expected {current_gate_id}, got {requested_gate}", file=sys.stderr)
        return 2
    subject = str(gate.get("expected_subject") or "")
    if subject not in CONFIRM_TITLES:
        print(f"AMBIGUOUS_ANSWER: 当前 gate={subject} 不能用 answer 确认，请使用对应 artifact/board 命令。", file=sys.stderr)
        return 2
    value = str(args.value or "").strip()
    summary = str(args.summary or "").strip() or value or "用户确认当前 gate。"
    confirm_state = str(args.confirm_state or "confirmed")
    append_controller_confirm(
        project,
        run_id,
        subject,
        value,
        summary,
        status_for_confirm_state(confirm_state),
        confirm_state,
        current_gate_id,
    )
    if subject == "path" and value:
        project["current_product_path"] = value
    if subject == "goal_mode" and value:
        project["current_goal_mode"] = value
    if subject == "design_spec" and confirm_state == "confirmed":
        project["design_spec_status"] = "已确认"
        project["design_spec_target"] = value or "汽车之家 AutoDesign"
    action, reason = action_from_state(project)
    project["allowed_next_action"] = action
    project["last_controller_verdict"] = reason
    write_project(project)
    payload = {
        "ok": True,
        "kind": subject,
        "gate_id": current_gate_id,
        "confirm_state": confirm_state,
        "allowed_next_action": action,
        "reason": reason,
        **workflow_payload(project, action, reason),
        **task_context(project),
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else f"{subject}: {confirm_state}")
    return 0


def command_stamp(args: argparse.Namespace) -> int:
    project = read_project()
    payload = {
        "kind": args.kind,
        "path": args.path,
        **task_context(project),
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    return 0


def append_artifact_row(row: dict[str, Any]) -> None:
    append_jsonl(project_dir() / "artifact-flow.jsonl", row)


def bool_arg(value: str) -> bool:
    return str(value or "").strip().lower() in {"1", "true", "yes", "y", "已确认", "确认"}


def command_lock_brief(args: argparse.Namespace) -> int:
    project = read_project()
    run_id = str(project.get("current_run_id") or "")
    if not run_id or not run_file(run_id).exists():
        print("LOCK_BRIEF_BLOCKED: 当前没有 active run；先运行 pmw-controller intake。", file=sys.stderr)
        return 2
    brief_path = str(pathlib.Path(args.brief_path).expanduser())
    brief_version = str(args.brief_version or "").strip() or "v1"
    summary = str(args.summary or "").strip() or "用户确认候选产品简报没有问题。"
    image_output_mode = rt.normalize_image_output_mode(
        str(getattr(args, "image_output_mode", "") or ""),
        summary,
        locked=True,
    )
    expected_output_units = rt.expected_output_units(image_output_mode)
    if hasattr(args, "user_confirmed") and not bool_arg(str(args.user_confirmed)):
        print("LOCK_BRIEF_BLOCKED: 产品简报还未获得用户确认，不能锁定。", file=sys.stderr)
        return 2
    project["latest_brief"] = brief_path
    project["latest_brief_version"] = brief_version
    project["last_controller_verdict"] = "产品简报待锁定"
    write_project(project)
    project = read_project()
    context = rt.resolve_context(project)
    ok, blocker, text = brief_boundary_check(project, brief_path)
    if not ok:
        lock_id = f"lock_{now_fragment()}_{hashlib.sha256((brief_path + blocker).encode('utf-8')).hexdigest()[:8]}"
        append_event(
            "brief_lock",
            run_id,
            "blocked",
            "产品简报锁定",
            f"简报边界未通过：{blocker}",
            project,
            {
                "lock_id": lock_id,
                "lock_status": "blocked",
                "brief_path": brief_path,
                "brief_version": brief_version,
                "brief_fingerprint": rt.brief_fingerprint(text),
                "first_blocker": blocker,
                "user_confirmed": True,
                "image_output_mode": image_output_mode,
                "expected_output_units": expected_output_units,
            },
        )
        project["brief_lock_status"] = "blocked"
        project["last_controller_verdict"] = f"简报边界未通过：{blocker}"
        write_project(project)
        payload = {
            "ok": False,
            "brief_path": brief_path,
            "brief_version": brief_version,
            "brief_lock_status": "blocked",
            "first_blocker": blocker,
            "reason": f"简报边界未通过：{blocker}",
            **workflow_payload(project, "BRIEF_PENDING", f"简报边界未通过：{blocker}"),
            **task_context(project),
        }
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else f"BRIEF_LOCK_BLOCKED: {blocker}")
        return 2
    existing_lock = rt.latest_brief_lock(project)
    existing_mode = rt.image_output_mode_from_lock(existing_lock) if existing_lock else ""
    if (
        rt.brief_lock_is_locked(existing_lock)
        and str(existing_lock.get("brief_path") or "") == brief_path
        and str(existing_lock.get("brief_version") or "") == brief_version
        and existing_mode == image_output_mode
    ):
        lock_id = str(existing_lock.get("lock_id") or "")
        lock_created = False
    else:
        lock_id = f"lock_{now_fragment()}_{hashlib.sha256((brief_path + brief_version + context.get('input_revision', '')).encode('utf-8')).hexdigest()[:8]}"
        append_event(
            "brief_lock",
            run_id,
            "locked",
            "产品简报锁定",
            summary,
            project,
            {
                "lock_id": lock_id,
                "lock_status": "locked",
                "brief_path": brief_path,
                "brief_version": brief_version,
                "brief_fingerprint": rt.brief_fingerprint(text),
                "user_confirmed": True,
                "image_output_mode": image_output_mode,
                "expected_output_units": expected_output_units,
            },
        )
        lock_created = True
    project["brief_lock_status"] = "locked"
    project["image_output_mode"] = image_output_mode
    project["expected_output_units"] = expected_output_units
    project["last_controller_verdict"] = "简报已锁定，可进入原型"
    write_project(project)
    project = read_project()
    lock = rt.latest_brief_lock(project)
    artifact_id, artifact_created = ensure_locked_brief_artifact(project, lock or {"brief_path": brief_path, "brief_version": brief_version, "summary": summary}, summary)
    action, reason = action_from_state(project)
    project["allowed_next_action"] = action
    project["last_controller_verdict"] = reason
    write_project(project)
    payload = {
        "ok": True,
        "brief_path": brief_path,
        "brief_version": brief_version,
        "brief_lock_id": lock_id,
        "brief_lock_status": "locked",
        "image_output_mode": image_output_mode,
        "image_output_mode_label": rt.image_output_mode_label(image_output_mode),
        "expected_output_units": expected_output_units,
        "artifact_id": artifact_id,
        "created": lock_created or artifact_created,
        "artifact_created": artifact_created,
        "allowed_next_action": action,
        "reason": reason,
        **workflow_payload(project, action, reason),
        **task_context(project),
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else artifact_id)
    return 0


def command_confirm_brief(args: argparse.Namespace) -> int:
    args.user_confirmed = "true"
    return command_lock_brief(args)


def command_modify_brief(args: argparse.Namespace) -> int:
    project = read_project()
    run_id = str(project.get("current_run_id") or "")
    if not run_id or not run_file(run_id).exists():
        print("MODIFY_BRIEF_BLOCKED: 当前没有 active run；先运行 pmw-controller intake。", file=sys.stderr)
        return 2
    brief_path = str(pathlib.Path(args.brief_path).expanduser()) if args.brief_path else str(project.get("latest_brief") or "")
    brief_version = str(args.brief_version or project.get("latest_brief_version") or "v1")
    change_type = str(args.change_type or "editorial")
    summary = str(args.summary or "").strip() or "记录产品简报修改。"
    if brief_path:
        project["latest_brief"] = brief_path
    project["latest_brief_version"] = brief_version
    lock_status = "needs_relock" if change_type == "boundary_change" else str(project.get("brief_lock_status") or "locked")
    row = append_event(
        "brief_change",
        run_id,
        "needs_relock" if change_type == "boundary_change" else "recorded",
        "产品简报修改",
        summary,
        project,
        {
            "change_type": change_type,
            "lock_status": lock_status,
            "brief_path": brief_path,
            "brief_version": brief_version,
        },
    )
    if change_type == "boundary_change":
        project["brief_lock_status"] = "needs_relock"
        project["last_controller_verdict"] = "简报被实质修改，需要重新锁定"
    else:
        project["last_controller_verdict"] = "简报非边界修改已记录，锁定态保持"
    write_project(project)
    action, reason = action_from_state(read_project())
    payload = {
        "ok": True,
        "change_type": change_type,
        "brief_lock_status": lock_status,
        "event_id": row.get("event_id", ""),
        "allowed_next_action": action,
        "reason": reason,
        **workflow_payload(read_project(), action, reason),
        **task_context(read_project()),
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else f"{change_type}: {lock_status}")
    return 0


def append_board_row(row: dict[str, Any]) -> None:
    append_jsonl(project_dir() / "prototype-board.jsonl", row)


def command_adopt_history(args: argparse.Namespace) -> int:
    project = read_project()
    if not current_run_is_active(project):
        print("当前没有 active run；先运行 pmw-controller intake。", file=sys.stderr)
        return 2
    if not latest_confirm(project, "adopt_history"):
        print("ADOPT_HISTORY_BLOCKED: 旧资产默认只能参考；先让用户确认沿用范围并记录 adopt_history。", file=sys.stderr)
        return 2
    digest = str(project.get("current_task_digest") or "")
    revision = str(project.get("current_input_revision") or "")
    run_id = str(project.get("current_run_id") or "")
    if args.kind == "prototype_board":
        candidates = []
        for row in read_jsonl(project_dir() / "prototype-board.jsonl"):
            if row.get("record_type", "item") != "item":
                continue
            if args.scheme and row.get("scheme") != args.scheme:
                continue
            if args.screen and row.get("screen") != args.screen:
                continue
            if row.get("run_id") == run_id and row.get("task_digest") == digest and row.get("input_revision") == revision:
                continue
            candidates.append(row)
        if not candidates:
            print("ADOPT_HISTORY_NOT_FOUND: 没有找到可沿用的旧 prototype-board item。", file=sys.stderr)
            return 2
        source = candidates[-1]
        adopted = dict(source)
        adopted.update(
            {
                "ts": now(),
                "run_id": run_id,
                "task_digest": digest,
                "input_revision": revision,
                "controller_verdict": project.get("last_controller_verdict", ""),
                "adopted_context": True,
                "adopted_from_run_id": source.get("run_id", ""),
                "adopted_from_task_digest": source.get("task_digest", ""),
                "adopted_from_input_revision": source.get("input_revision", ""),
            }
        )
        append_board_row(adopted)
        payload = {"ok": True, "adopted_kind": args.kind, "scheme": adopted.get("scheme", ""), "screen": adopted.get("screen", ""), **task_context(project)}
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else "ADOPTED")
        return 0
    candidates = []
    for row in artifact_rows(args.kind):
        if args.artifact_id and row.get("artifact_id") != args.artifact_id:
            continue
        if args.path and row.get("path") != args.path:
            continue
        if row.get("run_id") == run_id and row.get("task_digest") == digest and row.get("input_revision") == revision:
            continue
        candidates.append(row)
    if not candidates:
        print("ADOPT_HISTORY_NOT_FOUND: 没有找到可沿用的旧 artifact。", file=sys.stderr)
        return 2
    source = candidates[-1]
    adopted = dict(source)
    source_id = str(source.get("artifact_id") or f"{source.get('kind', args.kind)}-{source.get('ts', '')}")
    adopted.update(
        {
            "ts": now(),
            "artifact_id": f"{now_fragment()}-{args.kind}-adopted-{hashlib.sha256(source_id.encode('utf-8')).hexdigest()[:6]}",
            "run_id": run_id,
            "task_digest": digest,
            "input_revision": revision,
            "controller_verdict": project.get("last_controller_verdict", ""),
            "adopted_context": True,
            "adopted_from_artifact_id": source.get("artifact_id", ""),
            "adopted_from_run_id": source.get("run_id", ""),
            "adopted_from_task_digest": source.get("task_digest", ""),
            "adopted_from_input_revision": source.get("input_revision", ""),
        }
    )
    append_artifact_row(adopted)
    payload = {"ok": True, "adopted_kind": args.kind, "artifact_id": adopted.get("artifact_id", ""), **task_context(project)}
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else str(adopted.get("artifact_id", "")))
    return 0


def parse_variant_roles(value: str) -> list[str]:
    return [item.strip() for item in re.split(r"[,，/、\s]+", value or "") if item.strip()]


def operation_output_units(expected: int, roles: list[str]) -> int:
    if expected > 0:
        return max(1, min(expected, 12))
    if roles:
        return max(1, min(len(roles), 12))
    return 1


def edit_contract_conflict(edit_scope: str, preserve_scope: str) -> str:
    edit = re.sub(r"\s+", "", edit_scope or "")
    preserve = re.sub(r"\s+", "", preserve_scope or "")
    if not edit or not preserve:
        return ""
    if edit == preserve:
        return "修改区域和保留区域完全相同。"
    if len(edit) >= 4 and edit in preserve:
        return "修改区域被写入保留区域。"
    return ""


def operation_block_payload(args: argparse.Namespace, project: dict[str, Any], blocker: str, reason: str) -> dict[str, Any]:
    return {
        "ok": False,
        "operation_type": args.operation_type,
        "operation_status": "blocked",
        "operation_blocker": blocker,
        "first_blocker": blocker,
        "reason": reason,
        "may_run_intake": False,
        "must_not_run_intake": True,
        "allowed_next_action": "OPERATION_BLOCKED",
        **task_context(project),
    }


def command_continue_operation(args: argparse.Namespace) -> int:
    project = read_project()
    run_id = str(project.get("current_run_id") or "")
    if not run_id or not run_file(run_id).exists():
        payload = operation_block_payload(args, project, "OPERATION_CONTEXT_MISSING", "找不到 active run；流程内操作不能创建新 intake。")
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else payload["reason"])
        return 2
    context = rt.resolve_context(project)
    parent = rt.resolve_parent_context(project)
    operation_type = str(args.operation_type or "").strip()
    summary = str(args.summary or "").strip() or f"继续 PMW 操作：{operation_type}"
    source_image = str(args.source_image or "").strip()
    edit_scope = str(args.edit_scope or "").strip()
    preserve_scope = str(args.preserve_scope or "").strip()
    boundary_change = bool_arg(str(args.boundary_change or "false"))
    roles = parse_variant_roles(str(args.variant_roles or ""))
    expected_units = operation_output_units(int(args.expected_output_units or 0), roles)
    while len(roles) < expected_units:
        roles.append(f"variant_{len(roles) + 1}")

    if operation_type == "prototype_revision":
        if not source_image:
            payload = operation_block_payload(args, project, "OPERATION_SOURCE_IMAGE_REQUIRED", "原型局部修改缺 source_image；不能签发 image permit。")
            print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else payload["reason"])
            return 2
        if not edit_scope:
            payload = operation_block_payload(args, project, "OPERATION_EDIT_SCOPE_REQUIRED", "原型局部修改缺 edit_scope；需要说明只改哪里。")
            print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else payload["reason"])
            return 2
        if conflict := edit_contract_conflict(edit_scope, preserve_scope):
            payload = operation_block_payload(args, project, "OPERATION_EDIT_PRESERVE_CONFLICT", conflict)
            print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else payload["reason"])
            return 2
        lock = rt.latest_brief_lock(project)
        if not rt.brief_lock_is_locked(lock):
            payload = operation_block_payload(args, project, "OPERATION_CONTEXT_MISSING", "当前任务缺 locked brief；原型修改不能继承未锁定产品事实。")
            print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else payload["reason"])
            return 2
        if not str(project.get("design_spec_target") or "").strip() and design_spec_required(project):
            payload = operation_block_payload(args, project, "OPERATION_CONTEXT_MISSING", "当前任务缺设计规范目标；需先确认一次，然后后续修改继承。")
            print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else payload["reason"])
            return 2
    if boundary_change:
        append_event(
            "brief_change",
            run_id,
            "needs_relock",
            "原型反馈改变产品边界",
            summary,
            project,
            {
                "change_type": "boundary_change",
                "lock_status": "needs_relock",
                "brief_path": str(project.get("latest_brief") or ""),
                "brief_version": str(project.get("latest_brief_version") or "v1"),
                "source_operation_type": operation_type,
            },
        )
        project["brief_lock_status"] = "needs_relock"
        project["last_controller_verdict"] = "原型反馈改变产品承诺或范围，需要重新锁定 brief"

    operation_id = rt.operation_id(operation_type, context, summary)
    lock = rt.latest_brief_lock(project)
    visual_baseline = current_artifact("visual_baseline", project)
    operation_status = "brief_relock_required" if boundary_change else "ready_for_image_permit" if operation_type == "prototype_revision" else "recorded"
    row = append_event(
        "operation",
        run_id,
        operation_status,
        "PMW 操作续跑",
        summary,
        project,
        {
            "operation_id": operation_id,
            "operation_type": operation_type,
            "operation_status": operation_status,
            "parent_run_id": parent.get("parent_run_id", ""),
            "parent_task_digest": parent.get("parent_task_digest", ""),
            "parent_input_revision": parent.get("parent_input_revision", ""),
            "parent_artifact_id": str(args.artifact_id or ""),
            "source_image": source_image,
            "source_image_id": source_image,
            "edit_scope": edit_scope,
            "preserve_scope": preserve_scope,
            "boundary_change": boundary_change,
            "expected_output_units": expected_units,
            "variant_roles": roles,
            "inherited_context": {
                "brief_lock_id": str(lock.get("lock_id") or ""),
                "design_spec_target": str(project.get("design_spec_target") or ("汽车之家 AutoDesign" if design_spec_required(project) else "")),
                "visual_baseline_id": str(visual_baseline.get("artifact_id") or visual_baseline.get("path") or ""),
            },
            "may_run_intake": False,
            "must_not_run_intake": True,
        },
    )
    project["current_operation_id"] = operation_id
    project["current_operation_type"] = operation_type
    project["current_operation_status"] = operation_status
    project["last_controller_verdict"] = f"operation={operation_type}；status={operation_status}"
    write_project(project)
    action, reason = action_from_state(read_project())
    payload = {
        "ok": not boundary_change,
        "event": "operation",
        "operation_id": operation_id,
        "operation_type": operation_type,
        "operation_status": operation_status,
        "parent_run_id": parent.get("parent_run_id", ""),
        "parent_task_digest": parent.get("parent_task_digest", ""),
        "parent_input_revision": parent.get("parent_input_revision", ""),
        "source_image": source_image,
        "edit_scope": edit_scope,
        "preserve_scope": preserve_scope,
        "boundary_change": boundary_change,
        "expected_output_units": expected_units,
        "variant_roles": roles,
        "inherited_context": row.get("inherited_context", {}),
        "allowed_next_action": "BRIEF_RELOCK_REQUIRED" if boundary_change else "OPERATION_IMAGE_PERMIT_READY" if operation_type == "prototype_revision" else action,
        "reason": "这会改变产品承诺，需要重新锁 brief。" if boundary_change else reason,
        "may_run_intake": False,
        "must_not_run_intake": True,
        **task_context(read_project()),
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else operation_id)
    return 2 if boundary_change else 0


CAPABILITY_KEYS = {
    "write_brief": "can_write_brief",
    "register_prototype_units": "can_register_prototype_units",
    "issue_image_permit": "can_issue_image_permit",
    "handoff": "can_handoff",
}


def command_assert(args: argparse.Namespace) -> int:
    project = read_project()
    if args.capability == "handoff":
        payload = dashboard_preflight("handoff")
        controller_ready, controller_reason = handoff_artifacts_ready(project)
        ready = bool(payload.get("ready")) and controller_ready
        reason = str(payload.get("reason") or payload.get("first_blocker") or "handoff preflight blocked") if controller_ready else controller_reason
        result = {
            "ok": ready,
            "capability": args.capability,
            "reason": "" if ready else reason,
            "can_handoff": ready,
            **task_context(project),
        }
        print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True) if args.json else ("OK" if ready else reason))
        return 0 if ready else 2
    action, reason = action_from_state(project)
    flags = capability_flags(action)
    key = CAPABILITY_KEYS[args.capability]
    ok = bool(flags.get(key))
    payload = {
        "ok": ok,
        "capability": args.capability,
        "allowed_next_action": action,
        "reason": "" if ok else reason,
        **workflow_payload(project, action, reason),
        **task_context(project),
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else ("OK" if ok else reason))
    return 0 if ok else 2


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pmw-controller")
    sub = parser.add_subparsers(dest="command", required=True)

    intake = sub.add_parser("intake")
    intake.add_argument("--goal", required=True)
    intake.add_argument("--materials", default="")
    intake.add_argument("--skill", default="pm-workspace")
    intake.add_argument("--product-path", default="待判断")
    intake.add_argument("--depth", default="deep")
    intake.add_argument("--stage", default="")
    intake.add_argument("--force-new", action="store_true")
    intake.add_argument("--json", action="store_true")
    intake.set_defaults(func=command_intake)

    next_cmd = sub.add_parser("next")
    next_cmd.add_argument("--json", action="store_true")
    next_cmd.set_defaults(func=command_next)

    preflight = sub.add_parser("preflight")
    preflight.add_argument("--target", choices=["prototype", "handoff", "brief"], required=True)
    preflight.add_argument("--json", action="store_true")
    preflight.set_defaults(func=command_preflight)

    assert_cmd = sub.add_parser("assert")
    assert_cmd.add_argument("--capability", choices=sorted(CAPABILITY_KEYS), required=True)
    assert_cmd.add_argument("--json", action="store_true")
    assert_cmd.set_defaults(func=command_assert)

    confirm = sub.add_parser("confirm")
    confirm.add_argument(
        "--kind",
        choices=[
            "path",
            "goal_mode",
            "autoplan",
            "product_direction",
            "strategy",
            "design_spec",
            "brief",
            "adopt_history",
            "scheme_direction",
        ],
        required=True,
    )
    confirm.add_argument("--value", default="")
    confirm.add_argument("--summary", default="")
    confirm.add_argument("--status", default="已确认")
    confirm.add_argument("--json", action="store_true")
    confirm.set_defaults(func=command_confirm)

    answer = sub.add_parser("answer")
    answer.add_argument("--gate-id", default="current")
    answer.add_argument("--value", default="")
    answer.add_argument("--summary", default="")
    answer.add_argument("--confirm-state", choices=["confirmed", "pending", "rejected"], default="confirmed")
    answer.add_argument("--json", action="store_true")
    answer.set_defaults(func=command_answer)

    confirm_brief = sub.add_parser("confirm-brief")
    confirm_brief.add_argument("--brief-path", required=True)
    confirm_brief.add_argument("--brief-version", required=True)
    confirm_brief.add_argument("--summary", default="")
    confirm_brief.add_argument("--json", action="store_true")
    confirm_brief.set_defaults(func=command_confirm_brief)

    lock_brief = sub.add_parser("lock-brief")
    lock_brief.add_argument("--brief-path", required=True)
    lock_brief.add_argument("--brief-version", required=True)
    lock_brief.add_argument("--user-confirmed", default="false")
    lock_brief.add_argument("--image-output-mode", choices=["", "auto", "three_page_exploration", "three_page_experiment", "single_page_confirmed"], default="")
    lock_brief.add_argument("--summary", default="")
    lock_brief.add_argument("--json", action="store_true")
    lock_brief.set_defaults(func=command_lock_brief)

    modify_brief = sub.add_parser("modify-brief")
    modify_brief.add_argument("--brief-path", default="")
    modify_brief.add_argument("--brief-version", default="")
    modify_brief.add_argument("--change-type", choices=["editorial", "non_boundary_addition", "boundary_change"], default="editorial")
    modify_brief.add_argument("--summary", default="")
    modify_brief.add_argument("--json", action="store_true")
    modify_brief.set_defaults(func=command_modify_brief)

    continue_operation = sub.add_parser("continue-operation")
    continue_operation.add_argument(
        "--operation-type",
        choices=[
            "attach_evidence",
            "modify_brief",
            "prototype_plan",
            "prototype_revision",
            "prototype_review",
            "prototype_regenerate",
            "handoff_continue",
        ],
        required=True,
    )
    continue_operation.add_argument("--summary", default="")
    continue_operation.add_argument("--source-image", default="")
    continue_operation.add_argument("--artifact-id", default="")
    continue_operation.add_argument("--edit-scope", default="")
    continue_operation.add_argument("--preserve-scope", default="")
    continue_operation.add_argument("--boundary-change", default="false")
    continue_operation.add_argument("--expected-output-units", type=int, default=0)
    continue_operation.add_argument("--variant-roles", default="")
    continue_operation.add_argument("--json", action="store_true")
    continue_operation.set_defaults(func=command_continue_operation)

    stamp = sub.add_parser("stamp")
    stamp.add_argument("--kind", required=True)
    stamp.add_argument("--path", default="")
    stamp.set_defaults(func=command_stamp)

    adopt = sub.add_parser("adopt-history")
    adopt.add_argument("--kind", required=True)
    adopt.add_argument("--artifact-id", default="")
    adopt.add_argument("--path", default="")
    adopt.add_argument("--scheme", default="")
    adopt.add_argument("--screen", default="")
    adopt.add_argument("--json", action="store_true")
    adopt.set_defaults(func=command_adopt_history)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
