{
  "id": "security-redaction-default-output",
  "title": "项目状态、dashboard 和产物流动默认脱敏",
  "category": "pm-workspace-runtime",
  "primary_skill": "pm-workspace",
  "prompt": "用户查看项目状态，但没有明确要求本地调试 raw 输出。",
  "expected": {
    "mode": "maintenance",
    "status": "可检查",
    "must_stop": false,
    "gate": "默认脱敏输出",
    "required_behaviors": [
      "pmw-project show 默认脱敏",
      "只有 --raw 才输出未脱敏本地项目 JSON",
      "dashboard 默认脱敏 Zoon token 和 ownerSecret",
      "artifact-flow 默认脱敏敏感字段"
    ],
    "forbidden_behaviors": [
      "默认输出真实 token",
      "默认输出 ownerSecret",
      "默认输出 Authorization header"
    ]
  },
  "contract_checks": [
    {
      "path": "bin/pmw-project",
      "contains": "raw = \"--raw\" in sys.argv[2:]"
    },
    {
      "path": "bin/pmw-project",
      "contains": "output = data if raw else redact_value(data)"
    },
    {
      "path": "bin/pmw-dashboard",
      "contains": "def redact_sensitive"
    },
    {
      "path": "bin/pmw-artifact",
      "contains": "def redact_sensitive"
    },
    {
      "path": "pmworkspace-shared/references/product-readiness-dashboard.md",
      "contains": "不得暴露 `token`、`ownerSecret`、Authorization header 或 API 原始响应内部信息"
    }
  ]
}
