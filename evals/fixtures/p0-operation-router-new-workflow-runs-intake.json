{
  "id": "p0-operation-router-new-workflow-runs-intake",
  "title": "P0：新产品任务才路由到 intake",
  "category": "pm-workspace-runtime",
  "primary_skill": "pm-workspace",
  "prompt": "用户说“帮我思考一个方案，针对提升汽车之家新能源独号转化率的方案及原型”时，Operation Router 必须允许 intake。",
  "expected": {
    "mode": "deep",
    "status": "可检查",
    "must_stop": true,
    "gate": "operation router",
    "required_behaviors": [
      "router 输出 new_product_workflow",
      "required_controller_command 是 pmw-controller intake",
      "may_run_intake=true"
    ],
    "forbidden_behaviors": [
      "新产品任务被误判成流程内 operation",
      "router 缺失时继续普通方案输出"
    ]
  },
  "contract_checks": [
    {
      "path": "bin/pmw-operation-router",
      "contains": "new_product_workflow"
    }
  ],
  "command_checks": [
    {
      "command": [
        "bash",
        "-lc",
        "tmp=$(mktemp -d); export PMW_HOME=\"$tmp\" PMW_PROJECT_SLUG=router-new; bin/pmw-operation-router classify --text '帮我思考一个方案，针对提升汽车之家新能源独号转化率的方案及原型' --json"
      ],
      "exit_code": 0,
      "contains": [
        "\"operation_type\": \"new_product_workflow\"",
        "\"required_controller_command\": \"pmw-controller intake\"",
        "\"may_run_intake\": true"
      ]
    }
  ]
}
