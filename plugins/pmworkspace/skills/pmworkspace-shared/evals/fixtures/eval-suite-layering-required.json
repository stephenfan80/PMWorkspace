{
  "id": "eval-suite-layering-required",
  "title": "eval 必须提供 smoke / core / full 三层运行入口",
  "category": "eval-system",
  "primary_skill": "pm-workspace",
  "prompt": "维护者面对两百多个 eval，需要先跑主链路、再跑核心四动作、发布前再跑全量。",
  "expected": {
    "mode": "maintenance",
    "status": "可检查",
    "must_stop": false,
    "gate": "eval 分层运行",
    "required_behaviors": [
      "pmw-eval 支持 --suite smoke",
      "pmw-eval 支持 --suite core",
      "pmw-eval 支持 --suite full",
      "bin/pmw-eval run 默认仍等于 full",
      "smoke 和 core 清单保存在 evals/suites",
      "README 和 eval 文档说明什么时候跑哪一层",
      "发布清单要求 full"
    ],
    "forbidden_behaviors": [
      "删除全量默认行为",
      "让 smoke 取代发布前 full",
      "把 suite 清单复制成第二套 fixture 内容"
    ]
  },
  "contract_checks": [
    {
      "path": "bin/pmw-eval",
      "contains": "def load_suite_ids"
    },
    {
      "path": "evals/README.md",
      "contains": "bin/pmw-eval run --suite smoke"
    },
    {
      "path": "evals/suites/smoke.txt",
      "contains": "pmworkspace-welcome-homepage"
    },
    {
      "path": "evals/suites/core.txt",
      "contains": "handoff-controller-output-contract"
    },
    {
      "path": "evals/README.md",
      "contains": "## 三层检查"
    },
    {
      "path": "pmworkspace-shared/references/pm-eval-system.md",
      "contains": "## 运行分层"
    },
    {
      "path": "README.zh-CN.md",
      "contains": "`smoke` 用于日常小改"
    },
    {
      "path": "docs/codex-plugin-submission.md",
      "contains": "bin/pmw-eval run --suite full"
    }
  ],
  "command_checks": [
    {
      "command": ["bin/pmw-eval", "run", "--suite", "smoke", "--json"],
      "contains": ["\"suite\": \"smoke\"", "\"failed\": 0"]
    },
    {
      "command": ["bin/pmw-eval", "list", "--suite", "core", "--json"],
      "contains": ["\"suite\": \"core\"", "\"count\""]
    }
  ]
}
