{
  "id": "screenshot-reference-only-no-autogen",
  "title": "只提供截图时不能自动生成完整方案",
  "category": "screenshot-feedback",
  "primary_skill": "pm-workspace",
  "prompt": "用户上传一张当前页面截图并说参考这个页面。",
  "expected": {
    "mode": "deep",
    "status": "待确认",
    "must_stop": true,
    "gate": "截图只更新视觉基线",
    "required_behaviors": [
      "提取视觉基线",
      "更新线上参考状态",
      "继续产品对齐"
    ],
    "forbidden_behaviors": [
      "自动产出完整 md 方案",
      "自动生成 HTML",
      "自动生成原型图"
    ]
  },
  "contract_checks": [
    {
      "path": "pm-workspace/SKILL.md",
      "contains": "用户提供截图或线上参考时，只更新视觉基线和线上参考状态"
    },
    {
      "path": "pmworkspace-shared/references/pm-eval-system.md",
      "contains": "截图反馈：用户只提供截图时，只更新视觉基线，不自动产出完整方案或原型图。"
    }
  ]
}
