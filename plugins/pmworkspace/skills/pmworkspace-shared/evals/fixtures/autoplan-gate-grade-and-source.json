{
  "id": "autoplan-gate-grade-and-source",
  "title": "自动产品评审最早门槛必须标注等级和来源",
  "category": "autoplan",
  "primary_skill": "pm-autoplan",
  "prompt": "自动评审发现线上参考缺失或用户承诺口径未决，需要解释为什么停。",
  "expected": {
    "mode": "deep",
    "status": "待确认",
    "must_stop": true,
    "gate": "门槛等级和来源",
    "required_behaviors": [
      "输出门槛等级",
      "输出门槛来源",
      "区分阻断、高风险、可自动采用和可延后",
      "说明为什么影响下一步"
    ],
    "forbidden_behaviors": [
      "只写当前门槛",
      "不说明来源",
      "把历史偏好当作阻断事实"
    ]
  },
  "contract_checks": [
    {
      "path": "pmworkspace-shared/references/autoplan-workflow.md",
      "contains": "## 门槛等级"
    },
    {
      "path": "pmworkspace-shared/references/autoplan-workflow.md",
      "contains": "`阻断`：不处理就不能继续"
    },
    {
      "path": "pmworkspace-shared/references/autoplan-workflow.md",
      "contains": "`高风险`：可能影响用户承诺、数据真实性、隐私、交易、线索、合规、实验口径或交付验收"
    },
    {
      "path": "pm-autoplan/SKILL.md",
      "contains": "always declare `门槛等级`"
    },
    {
      "path": "pm-autoplan/SKILL.md",
      "contains": "- 门槛来源："
    }
  ]
}
