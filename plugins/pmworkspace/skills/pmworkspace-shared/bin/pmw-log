#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
STATE_DIR="${PMW_HOME:-$HOME/.pmworkspace}"
SLUG="${PMW_PROJECT_SLUG:-$("$SCRIPT_DIR/pmw-slug")}"
PROJECT_DIR="$STATE_DIR/projects/$SLUG"
EVENT="${1:-}"

mkdir -p "$PROJECT_DIR/briefs" "$PROJECT_DIR/briefs/audit" "$PROJECT_DIR/prototypes" "$PROJECT_DIR/handoffs" "$STATE_DIR/analytics"

json_escape() {
  sed 's/\\/\\\\/g; s/"/\\"/g'
}

redact_sensitive() {
  sed -E \
    -e 's/(token=)[^&[:space:]]+/\1[redacted]/g' \
    -e 's/(Authorization: Bearer )[[:alnum:]_.~+\/=-]+/\1[redacted]/g' \
    -e 's/(x-share-token: )[[:alnum:]_.~+\/=-]+/\1[redacted]/g' \
    -e 's/(ownerSecret[=: ]*)[^&[:space:]]+/\1[redacted]/g'
}

safe_fragment() {
  local value
  value="$(printf '%s' "$1" | tr ' ' '-' | sed 's#[/:]#-#g; s#[[:cntrl:]]##g; s#^-*##; s#-*$##')"
  printf '%s' "${value:-asset}"
}

version_number_from_file() {
  local file="$1"
  [ -f "$file" ] || return 0
  sed -nE 's/.*(产品简报版本|版本)[：:][[:space:]]*v?([0-9]+).*/\2/p' "$file" | head -n 1
}

latest_project_brief_version_number() {
  local project_json="$PROJECT_DIR/project.json"
  [ -f "$project_json" ] || return 0
  sed -nE 's/.*"latest_brief_version"[[:space:]]*:[[:space:]]*"v?([0-9]+)".*/\1/p' "$project_json" | head -n 1
}

normalize_existing_version_line() {
  local file="$1"
  local version="$2"
  local tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/pmw-brief-version.XXXXXX")"
  awk -v version="$version" '
    BEGIN { done=0 }
    !done && $0 ~ /(产品简报版本|版本)[：:][[:space:]]*v?[0-9]+/ {
      sub(/v?[0-9]+/, version)
      done=1
    }
    { print }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
}

current_run_id() {
  local project_json="$PROJECT_DIR/project.json"
  [ -f "$project_json" ] || return 0
  python3 - "$project_json" <<'PY'
import json, sys
try:
    data = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    data = {}
print(data.get("current_run_id") or data.get("latest_run_id") or "")
PY
}

brief_declares_aligned() {
  local file="$1"
  grep -Eq '确认状态[：:][[:space:]]*已对齐' "$file"
}

run_has_brief_confirmation() {
  local run_id="$1"
  local run_file="$PROJECT_DIR/runs/$run_id.jsonl"
  local project_json="$PROJECT_DIR/project.json"
  [ -n "$run_id" ] && [ -f "$run_file" ] || return 1
  python3 - "$run_file" "$project_json" <<'PY'
import json, sys

def confirmed(row):
    text = f"{row.get('status', '')} {row.get('summary', '')}"
    positive = any(token in text for token in ["已对齐", "已确认", "已同意", "批准", "用户确认", "用户同意"])
    negative = any(token in text for token in ["待确认", "需要确认", "准备确认", "需要补充", "需要 PM 拍板", "不同意", "未确认"])
    return positive and not negative

try:
    project = json.load(open(sys.argv[2], encoding="utf-8"))
except Exception:
    project = {}
digest = str(project.get("current_task_digest") or "")
revision = str(project.get("current_input_revision") or "")
ok = False
with open(sys.argv[1], encoding="utf-8") as handle:
    for line in handle:
        try:
            row = json.loads(line)
        except Exception:
            continue
        if digest and str(row.get("task_digest") or "") != digest:
            continue
        if revision and str(row.get("input_revision") or "") != revision:
            continue
        title = str(row.get("title", ""))
        if row.get("event") not in {"gate", "decision"}:
            continue
        if ("产品简报确认" in title or "前提确认" in title) and confirmed(row):
            ok = True
sys.exit(0 if ok else 1)
PY
}

require_readiness() {
  local target="$1"
  local expected="$2"
  local has_controller_task="false"
  if [ -f "$PROJECT_DIR/project.json" ]; then
    has_controller_task="$(python3 - "$PROJECT_DIR/project.json" <<'PY'
import json, sys
try:
    data=json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    data={}
print("true" if (data.get("current_task_digest") or data.get("current_input_revision")) else "false")
PY
)"
  fi
  if [ "$has_controller_task" = "true" ] && [ -x "$SCRIPT_DIR/pmw-controller" ]; then
    local controller_report
    controller_report="$(mktemp "${TMPDIR:-/tmp}/pmw-controller-preflight.XXXXXX")"
    if ! "$SCRIPT_DIR/pmw-controller" preflight --target "$target" --json >"$controller_report" 2>&1; then
      echo "READINESS_GATE_BLOCKED: CONTROLLER_PREFLIGHT_BLOCKED: controller 未放行「${expected}」，不能写入正式 ${target} 产物。" >&2
      cat "$controller_report" >&2
      rm -f "$controller_report" 2>/dev/null || true
      return 2
    fi
    if ! python3 - "$controller_report" "$target" <<'PY'
import json
import sys

path, target = sys.argv[1], sys.argv[2]
try:
    data = json.load(open(path, encoding="utf-8"))
except Exception:
    sys.exit(1)
ready = bool(data.get("ready"))
if target == "prototype":
    ready = ready and bool(data.get("can_issue_image_permit"))
elif target == "handoff":
    ready = ready and bool(data.get("can_handoff"))
sys.exit(0 if ready else 1)
PY
    then
      echo "READINESS_GATE_BLOCKED: CONTROLLER_CAPABILITY_BLOCKED: controller 能力位未放行正式 ${target} 产物。" >&2
      cat "$controller_report" >&2
      rm -f "$controller_report" 2>/dev/null || true
      return 2
    fi
    rm -f "$controller_report" 2>/dev/null || true
    return 0
  fi
  if [ ! -x "$SCRIPT_DIR/pmw-dashboard" ]; then
    echo "READINESS_DASHBOARD_UNAVAILABLE: 缺少 pmw-dashboard，不能写入正式 ${target} 产物。" >&2
    return 2
  fi
  local report
  report="$(mktemp "${TMPDIR:-/tmp}/pmw-readiness.XXXXXX")"
  if ! "$SCRIPT_DIR/pmw-dashboard" readiness --target "$target" --json >"$report" 2>&1; then
    echo "READINESS_DASHBOARD_FAILED: 产品准备度检查运行失败，不能写入正式 ${target} 产物。" >&2
    cat "$report" >&2
    rm -f "$report" 2>/dev/null || true
    return 2
  fi
  if ! python3 - "$report" "$expected" <<'PY'
import json
import sys

path, expected = sys.argv[1], sys.argv[2]
try:
    data = json.load(open(path, encoding="utf-8"))
except Exception:
    sys.exit(1)
ready = bool(data.get("ready")) and str(data.get("verdict_cn") or "") == expected
sys.exit(0 if ready else 1)
PY
  then
    echo "READINESS_GATE_BLOCKED: 产品准备度未达到「${expected}」，不能写入正式 ${target} 产物。若只是过程记录，请使用 --draft 保存草稿。" >&2
    "$SCRIPT_DIR/pmw-dashboard" readiness --target "$target" >&2 || true
    rm -f "$report" 2>/dev/null || true
    return 2
  fi
  rm -f "$report" 2>/dev/null || true
  return 0
}

require_controller_capability() {
  local capability="$1"
  local has_controller_task="false"
  if [ -f "$PROJECT_DIR/project.json" ]; then
    has_controller_task="$(python3 - "$PROJECT_DIR/project.json" <<'PY'
import json, sys
try:
    data=json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    data={}
print("true" if (data.get("current_task_digest") or data.get("current_input_revision")) else "false")
PY
)"
  fi
  if [ "$has_controller_task" != "true" ]; then
    return 0
  fi
  if [ ! -x "$SCRIPT_DIR/pmw-controller" ]; then
    echo "CONTROLLER_UNAVAILABLE: 缺少 pmw-controller，不能确认 ${capability} 能力位。" >&2
    return 2
  fi
  local report
  report="$(mktemp "${TMPDIR:-/tmp}/pmw-controller-capability.XXXXXX")"
  if ! "$SCRIPT_DIR/pmw-controller" assert --capability "$capability" --json >"$report" 2>&1; then
    echo "CONTROLLER_CAPABILITY_BLOCKED: controller 未放行 ${capability}。" >&2
    cat "$report" >&2
    rm -f "$report" 2>/dev/null || true
    return 2
  fi
  rm -f "$report" 2>/dev/null || true
  return 0
}

validate_prototype_manifest_permits() {
  local file="$1"
  python3 - "$file" <<'PY'
import json
import sys

path = sys.argv[1]
bad = []
with open(path, encoding="utf-8", errors="ignore") as handle:
    for lineno, line in enumerate(handle, 1):
        text = line.strip()
        if not text:
            continue
        try:
            row = json.loads(text)
        except Exception:
            continue
        if not isinstance(row, dict):
            continue
        record_type = str(row.get("record_type") or "")
        if record_type != "image":
            continue
        permit = str(row.get("image_permit_id") or "")
        status = str(row.get("image_permit_status") or "")
        if not permit or status == "legacy_audit_only":
            bad.append(f"line {lineno}: image 缺少正式 image_permit_id")
if bad:
    print("PROTOTYPE_MANIFEST_PERMIT_BLOCKED: " + "；".join(bad), file=sys.stderr)
    sys.exit(2)
PY
}

extract_md_section() {
  local file="$1"
  shift || true
  [ -f "$file" ] || return 0
  python3 - "$file" "$@" <<'PY'
import re
import sys

path = sys.argv[1]
headings = {item.strip() for item in sys.argv[2:] if item.strip()}
if not headings:
    raise SystemExit(0)

capturing = False
lines = []
with open(path, encoding="utf-8", errors="ignore") as handle:
    for raw in handle:
        match = re.match(r"^\s*#{2,6}\s+(.+?)\s*$", raw)
        if match:
            heading = match.group(1).strip()
            if capturing:
                break
            capturing = heading in headings
            continue
        if capturing:
            lines.append(raw.rstrip())

text = "\n".join(lines).strip()
print(text)
PY
}

compact_text() {
  tr '\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^[[:space:]]*//; s/[[:space:]]*$//' | redact_sensitive
}

ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

case "$EVENT" in
  usage)
    skill="${2:-pm-workspace}"
    printf '{"ts":"%s","skill":"%s","project":"%s"}\n' "$ts" "$skill" "$SLUG" >> "$STATE_DIR/analytics/usage.jsonl"
    ;;
  decision)
    shift || true
    title="${1:-decision}"
    [ "$#" -gt 0 ] && shift || true
    body="${1:-}"
    [ "$#" -gt 0 ] && shift || true
    pm_judgment_summary=""
    product_homework=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --pm-judgment-summary)
          pm_judgment_summary="${2:-}"; shift 2 ;;
        --product-homework)
          product_homework="${2:-}"; shift 2 ;;
        *)
          echo "unknown decision option: $1" >&2; exit 1 ;;
      esac
    done
    run_id="$(current_run_id || true)"
    printf '{"ts":"%s","run_id":"%s","title":"%s","body":"%s","pm_judgment_summary":"%s","product_homework":"%s"}\n' \
      "$ts" \
      "$(printf '%s' "$run_id" | json_escape)" \
      "$(printf '%s' "$title" | json_escape)" \
      "$(printf '%s' "$body" | compact_text | json_escape)" \
      "$(printf '%s' "$pm_judgment_summary" | compact_text | json_escape)" \
      "$(printf '%s' "$product_homework" | compact_text | json_escape)" >> "$PROJECT_DIR/decisions.jsonl"
    ;;
  brief)
    shift || true
    name="brief"
    if [ "$#" -gt 0 ] && [ "${1#--}" = "$1" ]; then
      name="$1"
      shift
    fi
    pm_judgment_summary=""
    product_homework=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --pm-judgment-summary)
          pm_judgment_summary="${2:-}"; shift 2 ;;
        --product-homework)
          product_homework="${2:-}"; shift 2 ;;
        *)
          echo "unknown brief option: $1" >&2; exit 1 ;;
      esac
    done
    file="$PROJECT_DIR/briefs/$(date -u +%Y%m%dT%H%M%SZ)-$(safe_fragment "$name").md"
    audit_file="$PROJECT_DIR/briefs/audit/$(date -u +%Y%m%dT%H%M%SZ)-$(safe_fragment "$name")-audit.md"
    input_file="$(mktemp "${TMPDIR:-/tmp}/pmw-brief-input.XXXXXX")"
    business_file="$(mktemp "${TMPDIR:-/tmp}/pmw-brief-business.XXXXXX")"
    trap 'rm -f "$input_file" "$business_file" 2>/dev/null || true' EXIT
    cat > "$input_file"
    if [ -z "$pm_judgment_summary" ]; then
      pm_judgment_summary="$(extract_md_section "$input_file" "PM 判断摘要" | compact_text)"
    fi
    if [ -z "$product_homework" ]; then
      product_homework="$(extract_md_section "$input_file" "产品作业" "待验证项与产品作业" "下一步产品作业" | compact_text)"
    fi
    brief_aligned="false"
    if brief_declares_aligned "$input_file"; then
      echo "BRIEF_LOCK_REQUIRED: Markdown 中的已对齐只作为用户可见状态；机器放行必须等待用户确认后运行 pmw-controller lock-brief。" >&2
    fi
    previous_version_number="$(latest_project_brief_version_number || true)"
    input_version_number="$(version_number_from_file "$input_file" || true)"
    if [ -n "$previous_version_number" ]; then
      brief_version="v$((previous_version_number + 1))"
    elif [ -n "$input_version_number" ]; then
      brief_version="v$input_version_number"
    else
      brief_version="v1"
    fi
    normalize_existing_version_line "$input_file" "$brief_version"
    awk '
      /^##[[:space:]]+(产品简报门槛|支持信息|审计|审计附录|PMWorkspace|请 PM 补充或拍板)/ { skip=1 }
      /^##[[:space:]]+产品核心信息/ { skip=0 }
      !skip { print }
    ' "$input_file" > "$business_file"
    normalize_existing_version_line "$business_file" "$brief_version"

    # Local-first, Zoon-optional: always keep the business brief and full audit
    # copy locally. Publish to Zoon only after alignment and explicit opt-in/config.
    sync_on_brief="${PMW_ZOON_SYNC_ON_BRIEF:-$("$SCRIPT_DIR/pmw-config" get zoon_sync_on_brief 2>/dev/null || echo false)}"
    sync_status=""
    sync_detail=""
    zoon_url=""
    join_status=""
    join_detail=""
    if [ "$sync_on_brief" != "false" ] && [ "$brief_aligned" != "true" ]; then
      sync_status="disabled"
      sync_detail="Zoon sync deferred until product brief is aligned"
      printf 'ZOON_SYNC_DEFERRED_UNTIL_ALIGNED=true\n' >&2
    elif [ "$sync_on_brief" != "false" ] && [ -x "$SCRIPT_DIR/pmw-zoon" ]; then
      sync_err="$(mktemp "${TMPDIR:-/tmp}/pmw-zoon-sync.XXXXXX")"
      if zoon_url="$(PMW_ZOON_DEFER_PROJECT_UPDATE=1 "$SCRIPT_DIR/pmw-zoon" sync --title "产品设计简报：$name" --brief "$business_file" 2>"$sync_err")"; then
        sync_status="synced"
        join_status="$(sed -n 's/^ZOON_JOIN_STATUS=//p' "$sync_err" | tail -n 1)"
        join_detail="$(sed -n 's/^ZOON_JOIN_DETAIL=//p' "$sync_err" | tail -n 1)"
        printf 'ZOON_URL=%s\n' "$zoon_url" >&2
        printf 'ZOON_SYNC_ORDER=explicit-online-sync\n' >&2
        [ -n "$join_status" ] && printf 'ZOON_JOIN_STATUS=%s\n' "$join_status" >&2
      else
        sync_status="failed"
        join_status="$(sed -n 's/^ZOON_JOIN_STATUS=//p' "$sync_err" | tail -n 1)"
        join_detail="$(sed -n 's/^ZOON_JOIN_DETAIL=//p' "$sync_err" | tail -n 1)"
        sync_detail="$(tr '\n' ' ' < "$sync_err" 2>/dev/null | sed 's/[[:space:]]*$//' | redact_sensitive)"
        printf 'ZOON_SYNC_FAILED=%s\n' "${sync_detail:-unknown}" >&2
        [ -n "$join_status" ] && printf 'ZOON_JOIN_STATUS=%s\n' "$join_status" >&2
      fi
      rm -f "$sync_err" 2>/dev/null || true
    elif [ "$sync_on_brief" = "false" ]; then
      sync_status="disabled"
      sync_detail="Zoon sync disabled; using local brief"
      printf 'ZOON_SYNC_DISABLED=true\n' >&2
    else
      sync_status="failed"
      sync_detail="pmw-zoon unavailable"
      printf 'ZOON_SYNC_FAILED=%s\n' "$sync_detail" >&2
    fi
    cp "$business_file" "$file"
    cp "$input_file" "$audit_file"
    "$SCRIPT_DIR/pmw-project" set-latest-brief "$file" "$brief_version" >/dev/null 2>&1 || true
    case "$sync_status" in
      synced)
        "$SCRIPT_DIR/pmw-project" set-zoon-sync "$zoon_url" "$file" "$brief_version" >/dev/null 2>&1 || true
        [ -n "$join_status" ] && "$SCRIPT_DIR/pmw-project" set-zoon-join "$join_status" "$join_detail" >/dev/null 2>&1 || true
        ;;
      failed)
        "$SCRIPT_DIR/pmw-project" set-zoon-sync-failed "${sync_detail:-unknown}" "$file" "$brief_version" >/dev/null 2>&1 || true
        [ -n "$join_status" ] && "$SCRIPT_DIR/pmw-project" set-zoon-join "$join_status" "$join_detail" >/dev/null 2>&1 || true
        ;;
      disabled)
        "$SCRIPT_DIR/pmw-project" set-zoon-sync-disabled "$file" "$brief_version" >/dev/null 2>&1 || true
        ;;
    esac
    if [ -x "$SCRIPT_DIR/pmw-artifact" ]; then
      if [ "$brief_aligned" = "true" ]; then
        artifact_status="已对齐"
        artifact_next_skill="pm-prototype-shotgun,pm-handoff"
        artifact_summary="业务简报版本：${brief_version}；业务简报已对齐并保存，审计副本已保存，Zoon 同步状态：${sync_status}"
      else
        artifact_status="待确认"
        artifact_next_skill="pm-brief"
        artifact_summary="业务简报版本：${brief_version}；业务简报待确认，仅作为草稿事实源，不能进入原型或交付，Zoon 同步状态：${sync_status}"
      fi
      "$SCRIPT_DIR/pmw-artifact" add \
        --kind product_brief \
        --title "$name" \
        --status "$artifact_status" \
        --source-skill pm-brief \
        --path "$file" \
        --url "$zoon_url" \
        --summary "$artifact_summary" \
        --pm-judgment-summary "$pm_judgment_summary" \
        --product-homework "$product_homework" \
        --upstream "decision,question,strategy_review" \
        --next-skill "$artifact_next_skill" >/dev/null 2>&1 || true
    fi
    rm -f "$input_file" "$business_file" 2>/dev/null || true
    trap - EXIT
    echo "$file"
    ;;
  discovery)
    shift || true
    dimension=""
    source="对话"
    summary=""
    confidence="confirmed"
    pm_judgment_summary=""
    product_homework=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --dimension)
          dimension="${2:-}"; shift 2 ;;
        --source)
          source="${2:-}"; shift 2 ;;
        --summary)
          summary="${2:-}"; shift 2 ;;
        --confidence)
          confidence="${2:-}"; shift 2 ;;
        --pm-judgment-summary)
          pm_judgment_summary="${2:-}"; shift 2 ;;
        --product-homework)
          product_homework="${2:-}"; shift 2 ;;
        *)
          echo "unknown discovery option: $1" >&2; exit 1 ;;
      esac
    done
    if [ -z "$dimension" ] || [ -z "$summary" ]; then
      echo "usage: pmw-log discovery --dimension <id> --source <source> --summary <text> [--confidence confirmed|assumed]" >&2
      exit 1
    fi
    case "$confidence" in
      confirmed|assumed|rejected) ;;
      *) echo "confidence must be confirmed, assumed, or rejected" >&2; exit 1 ;;
    esac
    mkdir -p "$PROJECT_DIR"
    run_id="$(current_run_id || true)"
    printf '{"ts":"%s","run_id":"%s","dimension":"%s","source":"%s","summary":"%s","confidence":"%s","pm_judgment_summary":"%s","product_homework":"%s"}\n' \
      "$ts" \
      "$(printf '%s' "$run_id" | json_escape)" \
      "$(printf '%s' "$dimension" | json_escape)" \
      "$(printf '%s' "$source" | json_escape)" \
      "$(printf '%s' "$summary" | compact_text | json_escape)" \
      "$(printf '%s' "$confidence" | json_escape)" \
      "$(printf '%s' "$pm_judgment_summary" | compact_text | json_escape)" \
      "$(printf '%s' "$product_homework" | compact_text | json_escape)" >> "$PROJECT_DIR/discovery.jsonl"
    echo "$PROJECT_DIR/discovery.jsonl"
    ;;
  question)
    question_id="${2:-D1}"
    title="${3:-}"
    recommended="${4:-}"
    user_choice="${5:-}"
    summary="${6:-}"
    run_id="$(current_run_id || true)"
    printf '{"ts":"%s","run_id":"%s","question_id":"%s","title":"%s","recommended":"%s","user_choice":"%s","summary":"%s"}\n' \
      "$ts" \
      "$(printf '%s' "$run_id" | json_escape)" \
      "$(printf '%s' "$question_id" | json_escape)" \
      "$(printf '%s' "$title" | json_escape)" \
      "$(printf '%s' "$recommended" | json_escape)" \
      "$(printf '%s' "$user_choice" | json_escape)" \
      "$(printf '%s' "$summary" | json_escape)" >> "$PROJECT_DIR/questions.jsonl"
    echo "$PROJECT_DIR/questions.jsonl"
    ;;
  prototype)
    shift || true
    batch="batch"
    if [ "$#" -gt 0 ] && [ "${1#--}" = "$1" ]; then
      batch="$1"
      shift
    fi
    pm_judgment_summary=""
    product_homework=""
    draft="false"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --draft)
          draft="true"; shift ;;
        --pm-judgment-summary)
          pm_judgment_summary="${2:-}"; shift 2 ;;
        --product-homework)
          product_homework="${2:-}"; shift 2 ;;
        *) 
          echo "unknown prototype option: $1" >&2; exit 1 ;;
      esac
    done
    if [ "$draft" != "true" ]; then
      require_readiness prototype "可出图" || exit 2
    fi
    manifest="$PROJECT_DIR/prototypes/$(date -u +%Y%m%dT%H%M%SZ)-$(safe_fragment "$batch").jsonl"
    manifest_input="$(mktemp "${TMPDIR:-/tmp}/pmw-prototype-manifest.XXXXXX")"
    cat > "$manifest_input"
    if [ "$draft" != "true" ]; then
      validate_prototype_manifest_permits "$manifest_input" || exit 2
    fi
    cat "$manifest_input" >> "$manifest"
    rm -f "$manifest_input" 2>/dev/null || true
    if [ -x "$SCRIPT_DIR/pmw-artifact" ]; then
      if [ "$draft" = "true" ]; then
        artifact_status="待确认草稿"
        artifact_summary="原型草稿清单已保存；未通过出图前 readiness，不能作为下游正式原型复审依据"
        artifact_next_skill="pm-prototype-shotgun"
      else
        artifact_status="已保存"
        artifact_summary="原型清单已保存，可供原型复审读取"
        artifact_next_skill="pm-prototype-review"
      fi
      "$SCRIPT_DIR/pmw-artifact" add \
        --kind prototype_manifest \
        --title "$batch" \
        --status "$artifact_status" \
        --source-skill pm-prototype-shotgun \
        --path "$manifest" \
        --summary "$artifact_summary" \
        --pm-judgment-summary "$pm_judgment_summary" \
        --product-homework "$product_homework" \
        --upstream "product_brief,prototype_board" \
        --next-skill "$artifact_next_skill" >/dev/null 2>&1 || true
    fi
    echo "$manifest"
    ;;
  handoff)
    shift || true
    name="handoff"
    if [ "$#" -gt 0 ] && [ "${1#--}" = "$1" ]; then
      name="$1"
      shift
    fi
    artifact_kind="handoff"
    pm_judgment_summary=""
    product_homework=""
    draft="false"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --draft)
          draft="true"; shift ;;
        --artifact-kind)
          artifact_kind="${2:-}"; shift 2 ;;
        --pm-judgment-summary)
          pm_judgment_summary="${2:-}"; shift 2 ;;
        --product-homework)
          product_homework="${2:-}"; shift 2 ;;
        *)
          echo "unknown handoff option: $1" >&2; exit 1 ;;
      esac
    done
    case "$artifact_kind" in
      handoff|product_design_doc) ;;
      *) echo "artifact kind must be handoff or product_design_doc" >&2; exit 1 ;;
    esac
    if [ "$draft" != "true" ]; then
      require_readiness handoff "可交付" || exit 2
    fi
    file="$PROJECT_DIR/handoffs/$(date -u +%Y%m%dT%H%M%SZ)-$(safe_fragment "$name").md"
    cat > "$file"
    if [ -z "$pm_judgment_summary" ]; then
      pm_judgment_summary="$(extract_md_section "$file" "PM 判断摘要" "产品判断演进" | compact_text)"
    fi
    if [ -z "$product_homework" ]; then
      product_homework="$(extract_md_section "$file" "产品作业" "下一步产品作业" "待验证项与产品作业" | compact_text)"
    fi
    if [ -x "$SCRIPT_DIR/pmw-artifact" ]; then
      next_skill="document-release,ship,qa"
      summary="交付稿已保存，可供文档同步、发布准备或研发协作读取"
      if [ "$artifact_kind" = "product_design_doc" ]; then
        next_skill="pm-handoff,document-release"
        summary="产品设计文档已保存，可供后续评审、研发交付或继续迭代读取"
      fi
      status="已保存"
      if [ "$draft" = "true" ]; then
        next_skill="pm-handoff"
        status="待确认草稿"
        summary="交付草稿已保存；未通过交付前 readiness，不能作为下游正式交付依据"
      fi
      "$SCRIPT_DIR/pmw-artifact" add \
        --kind "$artifact_kind" \
        --title "$name" \
        --status "$status" \
        --source-skill pm-handoff \
        --path "$file" \
        --summary "$summary" \
        --pm-judgment-summary "$pm_judgment_summary" \
        --product-homework "$product_homework" \
        --upstream "product_brief,prototype_review,delivery_facts" \
        --next-skill "$next_skill" >/dev/null 2>&1 || true
    fi
    echo "$file"
    ;;
  taste)
    action="${2:-approved}"
    note="${3:-}"
    scenario=""
    target=""
    scope="本项目"
    source="用户反馈"
    confidence="0.4"
    if [ "$#" -ge 3 ]; then
      shift 3
    else
      set --
    fi
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --scenario)
          scenario="${2:-}"
          shift
          [ "$#" -gt 0 ] && shift
          ;;
        --target)
          target="${2:-}"
          shift
          [ "$#" -gt 0 ] && shift
          ;;
        --scope)
          scope="${2:-}"
          shift
          [ "$#" -gt 0 ] && shift
          ;;
        --source)
          source="${2:-}"
          shift
          [ "$#" -gt 0 ] && shift
          ;;
        --confidence)
          confidence="${2:-}"
          shift
          [ "$#" -gt 0 ] && shift
          ;;
        *)
          echo "Unknown taste option: $1" >&2
          exit 1
          ;;
      esac
    done
    profile="$PROJECT_DIR/taste-profile.jsonl"
    printf '{"ts":"%s","action":"%s","note":"%s","scenario":"%s","target":"%s","scope":"%s","source":"%s","confidence":"%s"}\n' \
      "$ts" \
      "$(printf '%s' "$action" | json_escape)" \
      "$(printf '%s' "$note" | json_escape)" \
      "$(printf '%s' "$scenario" | json_escape)" \
      "$(printf '%s' "$target" | json_escape)" \
      "$(printf '%s' "$scope" | json_escape)" \
      "$(printf '%s' "$source" | json_escape)" \
      "$(printf '%s' "$confidence" | json_escape)" >> "$profile"
    echo "$profile"
    ;;
  *)
    echo "Usage: pmw-log {usage|decision|brief|question|prototype|handoff|taste} ..." >&2
    exit 1
    ;;
esac
