    {
      "path": "pm-jobs/SKILL.md",
      "contains": "- 当前任务："
    },
    {
      "path": "pm-jobs/SKILL.md",
      "contains": "内部产品方向审查控制面板（默认不展示，写入审计）："
    },
    {
      "path": "pmworkspace-shared/references/pm-eval-system.md",
      "contains": "用户可见输出必须展示工作方式卡片和产品方向审查任务"
    }
  ]
}
