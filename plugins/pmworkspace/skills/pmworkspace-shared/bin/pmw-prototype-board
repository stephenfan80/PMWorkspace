#!/usr/bin/env python3
import argparse
import json
import os
import pathlib
import subprocess
from datetime import datetime, timezone


SCRIPT_DIR = pathlib.Path(__file__).resolve().parent
STATE_DIR = pathlib.Path(os.environ.get("PMW_HOME", str(pathlib.Path.home() / ".pmworkspace"))).expanduser()
DEFAULT_PRESERVE_REGIONS = "状态栏、顶部导航、车系头图、车型切换、tab、底部吸底 CTA"
LEGACY_PRODUCT_PATH_KEY = "product" + "_hypothesis"


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def current_slug() -> str:
    env_slug = os.environ.get("PMW_PROJECT_SLUG")
    if env_slug:
        return env_slug
    try:
        return subprocess.check_output([str(SCRIPT_DIR / "pmw-slug")], text=True).strip()
    except Exception:
        return "local-project"


def project_dir() -> pathlib.Path:
    path = STATE_DIR / "projects" / current_slug()
    path.mkdir(parents=True, exist_ok=True)
    return path


def read_json(path: pathlib.Path) -> dict:
    if not path.exists():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def project_meta() -> dict:
    return read_json(project_dir() / "project.json")


def current_task_context() -> tuple[str, str, str]:
    data = project_meta()
    return (
        str(data.get("current_task_digest") or ""),
        str(data.get("current_input_revision") or ""),
        str(data.get("last_controller_verdict") or ""),
    )


def current_run_id() -> str:
    data = project_meta()
    return str(data.get("current_run_id") or data.get("latest_run_id") or "")


def current_brief_path() -> str:
    return str(project_meta().get("latest_brief") or "")


def board_path() -> pathlib.Path:
    return project_dir() / "prototype-board.jsonl"


def artifact_log() -> pathlib.Path:
    return project_dir() / "artifact-flow.jsonl"


def read_jsonl(path: pathlib.Path) -> list[dict]:
    rows: list[dict] = []
    if not path.exists():
        return rows
    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
        try:
            value = json.loads(line)
        except Exception:
            continue
        if isinstance(value, dict):
            rows.append(value)
    return rows


def append_row(row: dict) -> None:
    path = board_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")


def read_rows() -> list[dict]:
    return read_jsonl(board_path())


def artifact_location(row: dict) -> str:
    return str(row.get("path") or row.get("url") or "")


def parse_key_int(text: str, key: str):
    import re

    match = re.search(rf"{re.escape(key)}[=：]\s*(\d{{3,5}})", text)
    return int(match.group(1)) if match else None


def parse_target_size(text: str):
    import re

    key_width = parse_key_int(text, "target_width") or parse_key_int(text, "目标宽度")
    key_height = parse_key_int(text, "target_height") or parse_key_int(text, "目标高度")
    if key_width or key_height:
        return key_width, key_height
    match = re.search(r"目标输出[^。\n；;]*?(\d{3,5})\s*(?:x|X|×)\s*(?:>=\s*)?(\d{3,5})", text)
    if match:
        return int(match.group(1)), int(match.group(2))
    width_match = re.search(r"目标输出[^。\n；;]*?(\d{3,5})\s*(?:px|像素|宽)", text)
    height_match = re.search(r"(?:高度|高)[^。\n；;]*?(\d{3,5})\s*(?:px|像素)?", text)
    return (
        int(width_match.group(1)) if width_match else None,
        int(height_match.group(1)) if height_match else None,
    )


def target_mismatch(item: dict, baseline: dict) -> str:
    baseline_width, baseline_height = parse_target_size(str(baseline.get("summary") or ""))
    if not baseline_width and not baseline_height:
        return ""
    item_width, item_height = parse_target_size(f"目标输出：{item.get('target_output_pixels') or ''}")
    if baseline_width and item_width != baseline_width:
        return f"输出单元目标宽度 {item_width or '未记录'} 与 visual_baseline {baseline_width} 不一致"
    if baseline_height and (item_height is None or item_height < baseline_height):
        return f"输出单元目标高度 {item_height or '未记录'} 低于 visual_baseline {baseline_height}"
    return ""


def latest_visual_baseline(run_id: str = "") -> dict:
    rows = [row for row in read_jsonl(artifact_log()) if row.get("kind") == "visual_baseline"]
    if run_id:
        for row in reversed(rows):
            if row.get("run_id") == run_id:
                return row
    return rows[-1] if rows else {}


def latest_item(run_id: str, scheme: str, screen: str) -> dict:
    digest, revision, _verdict = current_task_context()
    for row in reversed(read_rows()):
        if row.get("record_type", "item") != "item":
            continue
        if row.get("scheme") != scheme or row.get("screen") != screen:
            continue
        row_run = str(row.get("run_id") or "")
        if run_id and row_run and row_run != run_id:
            continue
        if digest and str(row.get("task_digest") or "") != digest:
            continue
        if revision and str(row.get("input_revision") or "") != revision:
            continue
        return row
    return {}


def audit_image(image: str, reference: str) -> tuple[int, dict, str]:
    if not pathlib.Path(image).expanduser().exists():
        return 2, {"verdict": "需要重出", "failures": ["生成图不是可读取的本地文件，无法完成视觉审计"]}, ""
    if not pathlib.Path(reference).expanduser().exists():
        return 2, {"verdict": "需要补充参考", "failures": ["视觉基线参考图不是可读取的本地文件"]}, ""
    result = subprocess.run(
        [str(SCRIPT_DIR / "pmw-image-audit"), "audit", "--image", image, "--reference", reference, "--json"],
        text=True,
        capture_output=True,
        check=False,
    )
    try:
        payload = json.loads(result.stdout)
    except Exception:
        payload = {"verdict": "需要重出", "failures": [result.stderr.strip() or result.stdout.strip() or "视觉审计输出不可解析"]}
    return result.returncode, payload if isinstance(payload, dict) else {}, result.stderr


def command_add(args: argparse.Namespace) -> int:
    required_fields = {
        "product_path": "product path",
        "behavior_assumption": "behavior assumption",
        "current_loss": "current loss",
        "tradeoff": "tradeoff",
    }
    missing = [label for field, label in required_fields.items() if not str(getattr(args, field, "")).strip()]
    if missing:
        print(
            "missing required product path fields: " + ", ".join(missing),
            file=os.sys.stderr,
        )
        return 2
    if str(args.design_score).strip():
        try:
            score_value = int(str(args.design_score).strip())
        except ValueError:
            print("design score must be an integer from 0 to 10", file=os.sys.stderr)
            return 2
        if score_value < 0 or score_value > 10:
            print("design score must be an integer from 0 to 10", file=os.sys.stderr)
            return 2
    run_id = args.run or current_run_id()
    brief_path = args.brief_path or current_brief_path()
    task_digest, input_revision, controller_verdict = current_task_context()
    baseline = latest_visual_baseline(run_id)
    generation_mode = args.generation_mode or ("screenshot_edit" if baseline else "redraw")
    base_image = args.base_image
    if generation_mode == "screenshot_edit" and not base_image:
        base_image = artifact_location(baseline)
    preserve_regions = args.preserve_regions
    if generation_mode == "screenshot_edit" and not preserve_regions:
        preserve_regions = DEFAULT_PRESERVE_REGIONS
    row = {
        "ts": now(),
        "record_type": "item",
        "run_id": run_id,
        "brief_path": brief_path,
        "scheme": args.scheme,
        "screen": args.screen,
        "brief_version": args.brief_version,
        "main_goal": args.goal,
        "anti_metric": args.anti_metric,
        "non_fiction": args.non_fiction,
        "canvas_mode": args.canvas_mode,
        "target_output_pixels": args.target_output_pixels,
        "generation_mode": generation_mode,
        "base_image": base_image,
        "edit_scope": args.edit_scope,
        "preserve_regions": preserve_regions,
        "product_path": args.product_path,
        "behavior_assumption": args.behavior_assumption,
        "current_loss": args.current_loss,
        "tradeoff": args.tradeoff,
        "prototype_thinking": args.prototype_thinking,
        "information_architecture": args.information_architecture,
        "user_problem_fit": args.user_problem_fit,
        "anti_metric_protection": args.anti_metric_protection,
        "baseline_problem": args.baseline_problem,
        "changed_regions": args.changed_regions,
        "why_better_than_current": args.why_better_than_current,
        "baseline_preservation": args.baseline_preservation,
        "design_score": args.design_score,
        "design_gap": args.design_gap,
        "ten_out_of_ten_standard": args.ten_out_of_ten_standard,
        "prompt_design_fix": args.prompt_design_fix,
        "anti_ai_slop_constraints": args.anti_ai_slop_constraints,
        "state_coverage": args.state_coverage,
        "first_second_third_hierarchy": args.first_second_third_hierarchy,
        "unresolved_design_decision": args.unresolved_design_decision,
        "design_spec_target": args.design_spec_target,
        "design_system_profile": args.design_system_profile,
        "platform_pattern": args.platform_pattern,
        "inspiration_sources": args.inspiration_sources,
        "inspiration_patterns": args.inspiration_patterns,
        "no_copy_boundary": args.no_copy_boundary,
        "image": args.image,
        "status": args.status,
        "task_digest": task_digest,
        "input_revision": input_revision,
        "controller_verdict": controller_verdict,
    }
    append_row(row)
    print(board_path())
    return 0


def command_score(args: argparse.Namespace) -> int:
    if args.score < 1 or args.score > 5:
        print("score must be 1-5", file=os.sys.stderr)
        return 1
    row = {
        "ts": now(),
        "record_type": "score",
        "run_id": args.run or current_run_id(),
        "scheme": args.scheme,
        "screen": args.screen,
        "score": args.score,
        "note": args.note,
        "status": args.status,
    }
    task_digest, input_revision, controller_verdict = current_task_context()
    row.update(
        {
            "task_digest": task_digest,
            "input_revision": input_revision,
            "controller_verdict": controller_verdict,
        }
    )
    append_row(row)
    print(board_path())
    return 0


def command_image(args: argparse.Namespace) -> int:
    run_id = args.run or current_run_id()
    item = latest_item(run_id, args.scheme, args.screen)
    if not item:
        print(
            "PROTOTYPE_IMAGE_UNBOUND: 当前 run / task revision 没有匹配的 prototype-board 输出单元；图片只能作为对话附件，不能登记为 PMW 原型产物。",
            file=os.sys.stderr,
        )
        return 2
    baseline = latest_visual_baseline(run_id)
    audit_payload: dict = {}
    audit_exit = 0
    audit_note = ""
    if baseline:
        if item.get("canvas_mode") != "physical_longboard":
            audit_exit = 2
            audit_payload = {
                "verdict": "需要重出",
                "failures": [
                    "当前 run 有 visual_baseline，但输出单元未登记 canvas_mode=physical_longboard，不能把图片作为交付结果展示"
                ],
            }
        elif mismatch := target_mismatch(item, baseline):
            audit_exit = 2
            audit_payload = {
                "verdict": "需要重出",
                "failures": [
                    f"{mismatch}，不能把图片作为交付结果展示"
                ],
            }
        else:
            reference = artifact_location(baseline)
            audit_exit, audit_payload, audit_note = audit_image(args.image, reference)
    audit_verdict = str(audit_payload.get("verdict") or "")
    status = args.status
    if audit_verdict and audit_verdict != "通过":
        status = "需要重出"
    row = {
        "ts": now(),
        "record_type": "image",
        "run_id": run_id,
        "scheme": args.scheme,
        "screen": args.screen,
        "image": args.image,
        "status": status,
        "note": args.note,
    }
    task_digest, input_revision, controller_verdict = current_task_context()
    row.update(
        {
            "task_digest": task_digest,
            "input_revision": input_revision,
            "controller_verdict": controller_verdict,
        }
    )
    if audit_payload:
        row.update(
            {
                "audit_verdict": audit_verdict,
                "image_width": audit_payload.get("image_width"),
                "image_height": audit_payload.get("image_height"),
                "target_width": audit_payload.get("target_width"),
                "target_height": audit_payload.get("target_height"),
                "audit_failures": audit_payload.get("failures") or [],
                "audit_note": audit_note.strip(),
            }
        )
    append_row(row)
    print(board_path())
    return 0 if audit_exit == 0 else 2


def command_list(_args: argparse.Namespace) -> int:
    rows = read_rows()
    items = [r for r in rows if r.get("record_type", "item") == "item"]
    images = {}
    scores = {}
    for row in rows:
        key = (row.get("scheme", ""), row.get("screen", ""))
        scheme_key = (row.get("scheme", ""), "")
        if row.get("record_type") == "image":
            images[key] = row
        if row.get("record_type") == "score":
            scores[key if row.get("screen") else scheme_key] = row
    print("# 原型方案比较板")
    print("")
    if not items:
        print("暂无方案。")
        return 0
    print("| 方案 | 屏幕任务 | brief 版本 | 主目标 | 反指标 | 不可虚构 | 产品路径 | 设计评分 | 主要设计差距 | 10/10 原型标准 | prompt 设计修正 | 状态覆盖 | 第一眼 / 第二眼 / 第三眼 | 反 AI 模板味约束 | 未决设计选择 | 设计规范目标 | 设计系统 / 平台配置 | 平台模式 | 灵感来源 | 灵感模式 | 禁止照搬项 | 用户行为假设 | 当前损失 | 牺牲项 | 原型思考 | 信息架构 | 用户问题解决逻辑 | 反指标保护 | 生产基线问题 | 改动区域 | 为什么优于当前线上 | 保留 / 删除边界 | 画布模式 | 生成模式 | 编辑范围 | 保留区域 | 目标输出像素 | 图片 | 评分 | 状态 |")
    print("|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|")
    for item in items:
        key = (item.get("scheme", ""), item.get("screen", ""))
        scheme_key = (item.get("scheme", ""), "")
        image_row = images.get(key, {})
        score = scores.get(key) or scores.get(scheme_key, {})
        score_text = str(score.get("score", "未评分"))
        if score.get("note"):
            score_text += f"：{score.get('note')}"
        status = score.get("status") or image_row.get("status") or item.get("status") or "计划生成"
        if image_row.get("audit_verdict") and image_row.get("audit_verdict") != "通过":
            status = f"{status}（视觉审计：{image_row.get('audit_verdict')}）"
        values = [
            item.get("scheme", ""),
            item.get("screen", ""),
            item.get("brief_version", ""),
            item.get("main_goal", ""),
            item.get("anti_metric", ""),
            item.get("non_fiction", ""),
            item.get("product_path") or item.get(LEGACY_PRODUCT_PATH_KEY, ""),
            item.get("design_score") or "未记录",
            item.get("design_gap") or "未记录",
            item.get("ten_out_of_ten_standard") or "未记录",
            item.get("prompt_design_fix") or "未记录",
            item.get("state_coverage") or "未记录",
            item.get("first_second_third_hierarchy") or "未记录",
            item.get("anti_ai_slop_constraints") or "未记录",
            item.get("unresolved_design_decision") or "未记录",
            item.get("design_spec_target") or "未记录",
            item.get("design_system_profile") or "未记录",
            item.get("platform_pattern") or "未记录",
            item.get("inspiration_sources") or "未记录",
            item.get("inspiration_patterns") or "未记录",
            item.get("no_copy_boundary") or "未记录",
            item.get("behavior_assumption", ""),
            item.get("current_loss", ""),
            item.get("tradeoff", ""),
            item.get("prototype_thinking", ""),
            item.get("information_architecture", ""),
            item.get("user_problem_fit", ""),
            item.get("anti_metric_protection", ""),
            item.get("baseline_problem") or "未记录",
            item.get("changed_regions") or "未记录",
            item.get("why_better_than_current") or "未记录",
            item.get("baseline_preservation") or "未记录",
            item.get("canvas_mode", ""),
            item.get("generation_mode", ""),
            item.get("edit_scope", ""),
            item.get("preserve_regions", ""),
            item.get("target_output_pixels", ""),
            image_row.get("image") or item.get("image", ""),
            score_text,
            status,
        ]
        print("| " + " | ".join(str(v).replace("|", "/") for v in values) + " |")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pmw-prototype-board")
    sub = parser.add_subparsers(dest="command", required=True)

    add = sub.add_parser("add")
    add.add_argument("--scheme", required=True)
    add.add_argument("--screen", required=True)
    add.add_argument("--brief-version", required=True)
    add.add_argument("--goal", default="")
    add.add_argument("--anti-metric", default="")
    add.add_argument("--non-fiction", default="")
    add.add_argument("--canvas-mode", choices=["", "standard_first_screen", "physical_longboard"], default="")
    add.add_argument("--target-output-pixels", default="")
    add.add_argument("--generation-mode", choices=["", "screenshot_edit", "redraw"], default="")
    add.add_argument("--base-image", default="")
    add.add_argument("--edit-scope", default="")
    add.add_argument("--preserve-regions", default="")
    add.add_argument("--product-path", required=True)
    add.add_argument("--behavior-assumption", required=True)
    add.add_argument("--current-loss", required=True)
    add.add_argument("--tradeoff", required=True)
    add.add_argument("--prototype-thinking", default="")
    add.add_argument("--information-architecture", default="")
    add.add_argument("--user-problem-fit", default="")
    add.add_argument("--anti-metric-protection", default="")
    add.add_argument("--baseline-problem", default="")
    add.add_argument("--changed-regions", default="")
    add.add_argument("--why-better-than-current", default="")
    add.add_argument("--baseline-preservation", default="")
    add.add_argument("--design-score", default="")
    add.add_argument("--design-gap", default="")
    add.add_argument("--ten-out-of-ten-standard", default="")
    add.add_argument("--prompt-design-fix", default="")
    add.add_argument("--anti-ai-slop-constraints", default="")
    add.add_argument("--state-coverage", default="")
    add.add_argument("--first-second-third-hierarchy", default="")
    add.add_argument("--unresolved-design-decision", default="")
    add.add_argument("--design-spec-target", default="")
    add.add_argument("--design-system-profile", default="")
    add.add_argument("--platform-pattern", default="")
    add.add_argument("--inspiration-sources", default="")
    add.add_argument("--inspiration-patterns", default="")
    add.add_argument("--no-copy-boundary", default="")
    add.add_argument("--image", default="")
    add.add_argument("--status", default="计划生成")
    add.add_argument("--run")
    add.add_argument("--brief-path")
    add.set_defaults(func=command_add)

    score = sub.add_parser("score")
    score.add_argument("--scheme", required=True)
    score.add_argument("--screen", default="")
    score.add_argument("--score", required=True, type=int)
    score.add_argument("--note", required=True)
    score.add_argument("--status", default="待选择")
    score.add_argument("--run")
    score.set_defaults(func=command_score)

    image = sub.add_parser("image")
    image.add_argument("--scheme", required=True)
    image.add_argument("--screen", required=True)
    image.add_argument("--image", required=True)
    image.add_argument("--status", default="已生成")
    image.add_argument("--note", default="")
    image.add_argument("--run")
    image.set_defaults(func=command_image)

    listing = sub.add_parser("list")
    listing.set_defaults(func=command_list)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
