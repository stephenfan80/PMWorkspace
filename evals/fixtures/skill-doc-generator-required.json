{
  "id": "skill-doc-generator-required",
  "title": "SKILL.md 共享契约必须由 pmw-gen-skill-docs 生成并检查",
  "category": "skill-doc-generator",
  "primary_skill": "pm-workspace",
  "prompt": "维护 PMWorkspace skill 文档时，需要像 gstack 一样通过生成器统一 preamble、输出字段和共享门槛，防止 SKILL.md 手写漂移。",
  "expected": {
    "mode": "maintenance",
    "status": "可检查",
    "must_stop": false,
    "gate": "Skill 文档生成契约",
    "required_behaviors": [
      "提供 pmw-gen-skill-docs 命令",
      "manifest 记录每个 pm skill 的前置检查、共享协议和输出字段",
      "SKILL.md 包含生成契约区块",
      "check 可以发现生成区块或正文契约漂移",
      "eval 分类映射到文档生成维护"
    ],
    "forbidden_behaviors": [
      "只在 README 口头说明生成体系",
      "让每个 SKILL.md 继续完全手写共享门槛",
      "缺少可执行检查命令"
    ]
  },
  "contract_checks": [
    {
      "path": "bin/pmw-gen-skill-docs",
      "contains": "PMW-GENERATED-CONTRACT:START"
    },
    {
      "path": "bin/pmw-gen-skill-docs",
      "contains": "write"
    },
    {
      "path": "bin/pmw-gen-skill-docs",
      "contains": "check"
    },
    {
      "path": "pmworkspace-shared/skill-docs/skill-docs.manifest.json",
      "contains": "\"pm-prototype-review\""
    },
    {
      "path": "pmworkspace-shared/skill-docs/skill-docs.manifest.json",
      "contains": "\"output_fields\""
    },
    {
      "path": "pmworkspace-shared/references/skill-doc-template-system.md",
      "contains": "manifest 是共享契约源头"
    },
    {
      "path": "pm-workspace/SKILL.md",
      "contains": "PMW-GENERATED-CONTRACT:START"
    },
    {
      "path": "pm-prototype-review/SKILL.md",
      "contains": "PMWorkspace 生成契约"
    },
    {
      "path": "pmworkspace-shared/references/pm-workbench-map.md",
      "contains": "`skill-doc-generator`"
    },
    {
      "path": "pmworkspace-shared/references/pm-eval-system.md",
      "contains": "`skill-doc-generator`"
    },
    {
      "path": "README.zh-CN.md",
      "contains": "pmw-gen-skill-docs"
    }
  ]
}
