#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
STATE_DIR="${PMW_HOME:-$HOME/.pmworkspace}"
SLUG="${PMW_PROJECT_SLUG:-$("$SCRIPT_DIR/pmw-slug")}"
PROJECT_DIR="$STATE_DIR/projects/$SLUG"
EVENT="${1:-}"

mkdir -p "$PROJECT_DIR/briefs" "$PROJECT_DIR/prototypes" "$PROJECT_DIR/handoffs" "$STATE_DIR/analytics"

json_escape() {
  sed 's/\\/\\\\/g; s/"/\\"/g'
}

redact_sensitive() {
  sed -E \
    -e 's/(token=)[^&[:space:]]+/\1[redacted]/g' \
    -e 's/(Authorization: Bearer )[[:alnum:]_.~+\/=-]+/\1[redacted]/g' \
    -e 's/(x-share-token: )[[:alnum:]_.~+\/=-]+/\1[redacted]/g' \
    -e 's/(ownerSecret[=: ]*)[^&[:space:]]+/\1[redacted]/g'
}

safe_fragment() {
  local value
  value="$(printf '%s' "$1" | tr ' ' '-' | sed 's#[/:]#-#g; s#[[:cntrl:]]##g; s#^-*##; s#-*$##')"
  printf '%s' "${value:-asset}"
}

ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

case "$EVENT" in
  usage)
    skill="${2:-pm-workspace}"
    printf '{"ts":"%s","skill":"%s","project":"%s"}\n' "$ts" "$skill" "$SLUG" >> "$STATE_DIR/analytics/usage.jsonl"
    ;;
  decision)
    title="${2:-decision}"
    body="${3:-}"
    printf '{"ts":"%s","title":"%s","body":"%s"}\n' "$ts" "$(printf '%s' "$title" | json_escape)" "$(printf '%s' "$body" | json_escape)" >> "$PROJECT_DIR/decisions.jsonl"
    ;;
  brief)
    name="${2:-brief}"
    file="$PROJECT_DIR/briefs/$(date -u +%Y%m%dT%H%M%SZ)-$(safe_fragment "$name").md"
    input_file="$(mktemp "${TMPDIR:-/tmp}/pmw-brief-input.XXXXXX")"
    trap 'rm -f "$input_file" 2>/dev/null || true' EXIT
    cat > "$input_file"

    # Zoon-first, local-backed: publish online before recording the local audit copy.
    sync_on_brief="${PMW_ZOON_SYNC_ON_BRIEF:-$("$SCRIPT_DIR/pmw-config" get zoon_sync_on_brief 2>/dev/null || echo true)}"
    sync_status=""
    sync_detail=""
    zoon_url=""
    join_status=""
    join_detail=""
    if [ "$sync_on_brief" != "false" ] && [ -x "$SCRIPT_DIR/pmw-zoon" ]; then
      sync_err="$(mktemp "${TMPDIR:-/tmp}/pmw-zoon-sync.XXXXXX")"
      if zoon_url="$(PMW_ZOON_DEFER_PROJECT_UPDATE=1 "$SCRIPT_DIR/pmw-zoon" sync --title "产品设计简报：$name" --brief "$input_file" 2>"$sync_err")"; then
        sync_status="synced"
        join_status="$(sed -n 's/^ZOON_JOIN_STATUS=//p' "$sync_err" | tail -n 1)"
        join_detail="$(sed -n 's/^ZOON_JOIN_DETAIL=//p' "$sync_err" | tail -n 1)"
        printf 'ZOON_URL=%s\n' "$zoon_url" >&2
        printf 'ZOON_SYNC_ORDER=online-first\n' >&2
        [ -n "$join_status" ] && printf 'ZOON_JOIN_STATUS=%s\n' "$join_status" >&2
      else
        sync_status="failed"
        join_status="$(sed -n 's/^ZOON_JOIN_STATUS=//p' "$sync_err" | tail -n 1)"
        join_detail="$(sed -n 's/^ZOON_JOIN_DETAIL=//p' "$sync_err" | tail -n 1)"
        sync_detail="$(tr '\n' ' ' < "$sync_err" 2>/dev/null | sed 's/[[:space:]]*$//' | redact_sensitive)"
        printf 'ZOON_SYNC_FAILED=%s\n' "${sync_detail:-unknown}" >&2
        [ -n "$join_status" ] && printf 'ZOON_JOIN_STATUS=%s\n' "$join_status" >&2
      fi
      rm -f "$sync_err" 2>/dev/null || true
    elif [ "$sync_on_brief" = "false" ]; then
      sync_status="disabled"
      sync_detail="Zoon sync disabled"
      printf 'ZOON_SYNC_DISABLED=true\n' >&2
    else
      sync_status="failed"
      sync_detail="pmw-zoon unavailable"
      printf 'ZOON_SYNC_FAILED=%s\n' "$sync_detail" >&2
    fi
    cp "$input_file" "$file"
    "$SCRIPT_DIR/pmw-project" set-latest-brief "$file" >/dev/null 2>&1 || true
    case "$sync_status" in
      synced)
        "$SCRIPT_DIR/pmw-project" set-zoon-sync "$zoon_url" "$file" >/dev/null 2>&1 || true
        [ -n "$join_status" ] && "$SCRIPT_DIR/pmw-project" set-zoon-join "$join_status" "$join_detail" >/dev/null 2>&1 || true
        ;;
      failed)
        "$SCRIPT_DIR/pmw-project" set-zoon-sync-failed "${sync_detail:-unknown}" "$file" >/dev/null 2>&1 || true
        [ -n "$join_status" ] && "$SCRIPT_DIR/pmw-project" set-zoon-join "$join_status" "$join_detail" >/dev/null 2>&1 || true
        ;;
      disabled)
        "$SCRIPT_DIR/pmw-project" set-zoon-sync-disabled "$file" >/dev/null 2>&1 || true
        ;;
    esac
    if [ -x "$SCRIPT_DIR/pmw-artifact" ]; then
      "$SCRIPT_DIR/pmw-artifact" add \
        --kind product_brief \
        --title "$name" \
        --status "$sync_status" \
        --source-skill pm-brief \
        --path "$file" \
        --url "$zoon_url" \
        --summary "产品简报已保存，Zoon 同步状态：$sync_status" \
        --upstream "decision,question,strategy_review" \
        --next-skill "pm-prototype-shotgun,pm-handoff" >/dev/null 2>&1 || true
    fi
    rm -f "$input_file" 2>/dev/null || true
    trap - EXIT
    echo "$file"
    ;;
  question)
    question_id="${2:-D1}"
    title="${3:-}"
    recommended="${4:-}"
    user_choice="${5:-}"
    summary="${6:-}"
    printf '{"ts":"%s","question_id":"%s","title":"%s","recommended":"%s","user_choice":"%s","summary":"%s"}\n' \
      "$ts" \
      "$(printf '%s' "$question_id" | json_escape)" \
      "$(printf '%s' "$title" | json_escape)" \
      "$(printf '%s' "$recommended" | json_escape)" \
      "$(printf '%s' "$user_choice" | json_escape)" \
      "$(printf '%s' "$summary" | json_escape)" >> "$PROJECT_DIR/questions.jsonl"
    echo "$PROJECT_DIR/questions.jsonl"
    ;;
  prototype)
    batch="${2:-batch}"
    manifest="$PROJECT_DIR/prototypes/$(date -u +%Y%m%dT%H%M%SZ)-$(safe_fragment "$batch").jsonl"
    cat >> "$manifest"
    if [ -x "$SCRIPT_DIR/pmw-artifact" ]; then
      "$SCRIPT_DIR/pmw-artifact" add \
        --kind prototype_manifest \
        --title "$batch" \
        --status "已保存" \
        --source-skill pm-prototype-shotgun \
        --path "$manifest" \
        --summary "原型清单已保存，可供原型复审读取" \
        --upstream "product_brief,prototype_board" \
        --next-skill "pm-prototype-review" >/dev/null 2>&1 || true
    fi
    echo "$manifest"
    ;;
  handoff)
    name="${2:-handoff}"
    file="$PROJECT_DIR/handoffs/$(date -u +%Y%m%dT%H%M%SZ)-$(safe_fragment "$name").md"
    cat > "$file"
    if [ -x "$SCRIPT_DIR/pmw-artifact" ]; then
      "$SCRIPT_DIR/pmw-artifact" add \
        --kind handoff \
        --title "$name" \
        --status "已保存" \
        --source-skill pm-handoff \
        --path "$file" \
        --summary "交付稿已保存，可供文档同步、发布准备或研发协作读取" \
        --upstream "product_brief,prototype_review,delivery_facts" \
        --next-skill "document-release,ship,qa" >/dev/null 2>&1 || true
    fi
    echo "$file"
    ;;
  taste)
    action="${2:-approved}"
    note="${3:-}"
    scenario=""
    target=""
    scope="本项目"
    source="用户反馈"
    confidence="0.4"
    if [ "$#" -ge 3 ]; then
      shift 3
    else
      set --
    fi
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --scenario)
          scenario="${2:-}"
          shift
          [ "$#" -gt 0 ] && shift
          ;;
        --target)
          target="${2:-}"
          shift
          [ "$#" -gt 0 ] && shift
          ;;
        --scope)
          scope="${2:-}"
          shift
          [ "$#" -gt 0 ] && shift
          ;;
        --source)
          source="${2:-}"
          shift
          [ "$#" -gt 0 ] && shift
          ;;
        --confidence)
          confidence="${2:-}"
          shift
          [ "$#" -gt 0 ] && shift
          ;;
        *)
          echo "Unknown taste option: $1" >&2
          exit 1
          ;;
      esac
    done
    profile="$PROJECT_DIR/taste-profile.jsonl"
    printf '{"ts":"%s","action":"%s","note":"%s","scenario":"%s","target":"%s","scope":"%s","source":"%s","confidence":"%s"}\n' \
      "$ts" \
      "$(printf '%s' "$action" | json_escape)" \
      "$(printf '%s' "$note" | json_escape)" \
      "$(printf '%s' "$scenario" | json_escape)" \
      "$(printf '%s' "$target" | json_escape)" \
      "$(printf '%s' "$scope" | json_escape)" \
      "$(printf '%s' "$source" | json_escape)" \
      "$(printf '%s' "$confidence" | json_escape)" >> "$profile"
    echo "$profile"
    ;;
  *)
    echo "Usage: pmw-log {usage|decision|brief|question|prototype|handoff|taste} ..." >&2
    exit 1
    ;;
esac
