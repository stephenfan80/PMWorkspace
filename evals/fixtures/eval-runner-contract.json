{
  "id": "eval-runner-contract",
  "title": "pmw-eval 必须提供列表、运行和 JSON 输出",
  "category": "eval-system",
  "primary_skill": "pm-workspace",
  "prompt": "维护者运行 PMWorkspace eval，验证第一阶段规则契约。",
  "expected": {
    "mode": "maintenance",
    "status": "可检查",
    "must_stop": false,
    "gate": "eval 工具可用",
    "required_behaviors": [
      "支持 list",
      "支持 run",
      "支持 run --fixture",
      "支持 --json",
      "输出分类摘要"
    ],
    "forbidden_behaviors": [
      "依赖 pytest",
      "调用真实 image-2",
      "调用 LLM-as-judge"
    ]
  },
  "contract_checks": [
    {
      "path": "bin/pmw-eval",
      "contains": "run_cmd.add_argument(\"--fixture\")"
    },
    {
      "path": "bin/pmw-eval",
      "contains": "category_summary"
    },
    {
      "path": "pmworkspace-shared/references/pm-eval-system.md",
      "contains": "第一版只测规则和输出契约，不跑真实 image-2，也不做美感判断。"
    }
  ]
}
