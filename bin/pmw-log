#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
STATE_DIR="${PMW_HOME:-$HOME/.pmworkspace}"
SLUG="${PMW_PROJECT_SLUG:-$("$SCRIPT_DIR/pmw-slug")}"
PROJECT_DIR="$STATE_DIR/projects/$SLUG"
EVENT="${1:-}"

mkdir -p "$PROJECT_DIR/briefs" "$PROJECT_DIR/prototypes" "$STATE_DIR/analytics"

json_escape() {
  sed 's/\\/\\\\/g; s/"/\\"/g'
}

safe_fragment() {
  local value
  value="$(printf '%s' "$1" | tr ' ' '-' | sed 's#[/:]#-#g; s#[[:cntrl:]]##g; s#^-*##; s#-*$##')"
  printf '%s' "${value:-asset}"
}

ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

case "$EVENT" in
  usage)
    skill="${2:-pm-workspace}"
    printf '{"ts":"%s","skill":"%s","project":"%s"}\n' "$ts" "$skill" "$SLUG" >> "$STATE_DIR/analytics/usage.jsonl"
    ;;
  decision)
    title="${2:-decision}"
    body="${3:-}"
    printf '{"ts":"%s","title":"%s","body":"%s"}\n' "$ts" "$(printf '%s' "$title" | json_escape)" "$(printf '%s' "$body" | json_escape)" >> "$PROJECT_DIR/decisions.jsonl"
    ;;
  brief)
    name="${2:-brief}"
    file="$PROJECT_DIR/briefs/$(date -u +%Y%m%dT%H%M%SZ)-$(safe_fragment "$name").md"
    cat > "$file"
    "$SCRIPT_DIR/pmw-project" set-latest-brief "$file" >/dev/null 2>&1 || true
    echo "$file"
    ;;
  question)
    question_id="${2:-D1}"
    title="${3:-}"
    recommended="${4:-}"
    user_choice="${5:-}"
    summary="${6:-}"
    printf '{"ts":"%s","question_id":"%s","title":"%s","recommended":"%s","user_choice":"%s","summary":"%s"}\n' \
      "$ts" \
      "$(printf '%s' "$question_id" | json_escape)" \
      "$(printf '%s' "$title" | json_escape)" \
      "$(printf '%s' "$recommended" | json_escape)" \
      "$(printf '%s' "$user_choice" | json_escape)" \
      "$(printf '%s' "$summary" | json_escape)" >> "$PROJECT_DIR/questions.jsonl"
    echo "$PROJECT_DIR/questions.jsonl"
    ;;
  prototype)
    batch="${2:-batch}"
    manifest="$PROJECT_DIR/prototypes/$(date -u +%Y%m%dT%H%M%SZ)-$(safe_fragment "$batch").jsonl"
    cat >> "$manifest"
    echo "$manifest"
    ;;
  taste)
    action="${2:-approved}"
    note="${3:-}"
    profile="$PROJECT_DIR/taste-profile.jsonl"
    printf '{"ts":"%s","action":"%s","note":"%s"}\n' "$ts" "$action" "$(printf '%s' "$note" | json_escape)" >> "$profile"
    echo "$profile"
    ;;
  *)
    echo "Usage: pmw-log {usage|decision|brief|question|prototype|taste} ..." >&2
    exit 1
    ;;
esac
