#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import subprocess
import sys
from datetime import datetime, timezone
from typing import Optional


SCRIPT_DIR = pathlib.Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

import pmw_runtime as rt

STATE_DIR = pathlib.Path(os.environ.get("PMW_HOME", str(pathlib.Path.home() / ".pmworkspace"))).expanduser()
PROJECT_OVERRIDE = ""
ACTIVE_CONTEXT: dict | None = None


def current_slug() -> str:
    if PROJECT_OVERRIDE:
        return PROJECT_OVERRIDE
    env_slug = os.environ.get("PMW_PROJECT_SLUG")
    if env_slug:
        return env_slug
    try:
        return subprocess.check_output([str(SCRIPT_DIR / "pmw-slug")], text=True).strip()
    except Exception:
        return "local-project"


def project_dir() -> pathlib.Path:
    return STATE_DIR / "projects" / current_slug()


def projects_root() -> pathlib.Path:
    return STATE_DIR / "projects"


def resolve_project_identifier(value: str) -> str:
    cleaned = (value or "").strip()
    if not cleaned:
        return ""
    direct = projects_root() / cleaned / "project.json"
    if direct.exists():
        return cleaned
    for path in sorted(projects_root().glob("*/project.json")):
        data = read_json(path)
        if cleaned in {str(data.get("slug") or path.parent.name), str(data.get("display_name") or "")}:
            return str(data.get("slug") or path.parent.name)
    return cleaned


def project_for_run(run_id: str) -> str:
    if not run_id:
        return ""
    for path in sorted(projects_root().glob(f"*/runs/{run_id}.jsonl")):
        return path.parent.parent.name
    return ""


def user_dir() -> pathlib.Path:
    return STATE_DIR / "user"


def read_json(path: pathlib.Path) -> dict:
    if not path.exists():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def read_jsonl(path: pathlib.Path) -> list[dict]:
    rows = []
    if not path.exists():
        return rows
    for line in path.read_text(encoding="utf-8").splitlines():
        try:
            value = json.loads(line)
        except Exception:
            continue
        if isinstance(value, dict):
            rows.append(value)
    return rows


def all_jsonl(pattern: str) -> list[dict]:
    rows = []
    for path in sorted(project_dir().glob(pattern)):
        rows.extend(read_jsonl(path))
    return rows


def read_run(run_id: Optional[str]) -> tuple[str, list[dict]]:
    data = read_json(project_dir() / "project.json")
    chosen = run_id or str(data.get("current_run_id") or data.get("latest_run_id") or "")
    if not chosen:
        runs = sorted((project_dir() / "runs").glob("*.jsonl"))
        chosen = runs[-1].stem if runs else ""
    if not chosen:
        return "", []
    return chosen, read_jsonl(project_dir() / "runs" / f"{chosen}.jsonl")


TERMINAL_STATUS_TOKENS = [
    "已完成",
    "可交付",
    "可进入原型复审",
    "已结束",
    "DONE",
    "complete",
]


def is_terminal_status(value: str) -> bool:
    return any(token in (value or "") for token in TERMINAL_STATUS_TOKENS)


def active_run_id(project: dict) -> str:
    if ACTIVE_CONTEXT:
        if ACTIVE_CONTEXT.get("context_source") == "project_current" and is_terminal_status(str(project.get("latest_run_status") or "")):
            return ""
        return str(ACTIVE_CONTEXT.get("run_id") or "")
    run_id = str(project.get("current_run_id") or "")
    if not run_id:
        return ""
    if is_terminal_status(str(project.get("latest_run_status") or "")):
        return ""
    return run_id


def task_context(project: dict) -> tuple[str, str]:
    if ACTIVE_CONTEXT:
        return str(ACTIVE_CONTEXT.get("task_digest") or ""), str(ACTIVE_CONTEXT.get("input_revision") or "")
    return str(project.get("current_task_digest") or ""), str(project.get("current_input_revision") or "")


def row_matches_task(row: dict, project: dict) -> bool:
    context = ACTIVE_CONTEXT or rt.resolve_context(project)
    return rt.row_matches_context(row, context)


def task_is_controller_active(project: dict) -> bool:
    digest, revision = task_context(project)
    return bool(digest or revision)


def latest_brief_summary(path_value: str) -> tuple[str, str]:
    if not path_value:
        return "未记录", "未记录"
    path = pathlib.Path(path_value)
    if not path.exists():
        return path_value, "未读取"
    text = path.read_text(encoding="utf-8", errors="ignore")
    status = "未标注"
    version = "未标注"
    for line in text.splitlines()[:80]:
        stripped = line.strip()
        if "状态" in stripped and status == "未标注":
            status = stripped.replace("#", "").strip()
        if ("版本" in stripped or "简报版本" in stripped) and version == "未标注":
            version = stripped.replace("#", "").strip()
    return f"{path.name}", f"{version}；{status}"


def bullet_or_empty(rows: list[str], empty: str = "暂无") -> list[str]:
    return [f"- {row}" for row in rows] if rows else [f"- {empty}"]


def contains_any(value: str, needles: list[str]) -> bool:
    return any(needle in value for needle in needles)


def latest_event(events: list[dict], needles: list[str], event_types: Optional[set[str]] = None) -> dict:
    for row in reversed(events):
        if event_types and row.get("event") not in event_types:
            continue
        text = f"{row.get('status', '')} {row.get('title', '')} {row.get('summary', '')}"
        if contains_any(text, needles):
            return row
    return {}


def artifact_rows(root: pathlib.Path, kind: Optional[str] = None, limit: Optional[int] = None) -> list[dict]:
    rows = read_jsonl(root / "artifact-flow.jsonl")
    if kind:
        rows = [row for row in rows if row.get("kind") == kind]
    if limit is not None:
        rows = rows[-limit:]
    return rows


def same_path(left: str, right: str) -> bool:
    if not left or not right:
        return False
    try:
        return pathlib.Path(left).expanduser().resolve() == pathlib.Path(right).expanduser().resolve()
    except Exception:
        return left == right


def artifact_location(row: dict) -> str:
    return str(row.get("url") or row.get("path") or "")


def normalize_version(value: str) -> str:
    match = re.search(r"v?\s*([0-9]+)", value or "", flags=re.I)
    return f"v{match.group(1)}" if match else (value or "").strip()


def event_after_file(row: dict, path_value: str) -> bool:
    if not row or not path_value:
        return False
    try:
        event_ts = datetime.fromisoformat(str(row.get("ts") or "").replace("Z", "+00:00"))
        file_ts = datetime.fromtimestamp(pathlib.Path(path_value).stat().st_mtime, timezone.utc)
        return event_ts >= file_ts
    except Exception:
        return True


def latest_browser_evidence(root: pathlib.Path) -> dict:
    rows = artifact_rows(root, "browser_evidence")
    return rows[-1] if rows else {}


def latest_visual_baseline(root: pathlib.Path, run_id: str = "", project: Optional[dict] = None) -> dict:
    if run_id:
        return current_artifact(root, "visual_baseline", run_id, project)
    rows = artifact_rows(root, "visual_baseline")
    return rows[-1] if rows else {}


def has_target_pixels(row: dict) -> bool:
    text = " ".join(
        str(row.get(key) or "")
        for key in ["status", "title", "summary", "path", "url"]
    )
    return text_has_target_pixels(text)


def text_has_target_pixels(text: str) -> bool:
    if not text:
        return False
    pixel_pair = r"\d{3,5}\s*(?:x|X|×)\s*(?:>=\s*)?\d{3,5}"
    pixel_width = r"\d{3,5}\s*(?:px|像素|宽)"
    target_pattern = rf"(目标输出|目标输出像素|target|Target)[^。\n；;]*(?:{pixel_pair}|{pixel_width})"
    return bool(re.search(target_pattern, text))


def text_has_canvas_anchor(text: str) -> bool:
    return bool(
        re.search(r"402\s*(?:x|X|×)\s*874", text)
        or re.search(r"W402\s*(?:x|X|×)\s*H874", text, flags=re.I)
        or re.search(r"\bH874\b", text, flags=re.I)
        or "标准首屏" in text
        or "最低 H874" in text
    )


def parse_key_int(text: str, key: str) -> Optional[int]:
    match = re.search(rf"{re.escape(key)}[=：]\s*(\d{{3,5}})", text)
    return int(match.group(1)) if match else None


def parse_target_size(text: str) -> tuple[Optional[int], Optional[int]]:
    key_width = parse_key_int(text, "target_width") or parse_key_int(text, "目标宽度")
    key_height = parse_key_int(text, "target_height") or parse_key_int(text, "目标高度")
    if key_width or key_height:
        return key_width, key_height
    match = re.search(r"目标输出[^。\n；;]*?(\d{3,5})\s*(?:x|X|×)\s*(?:>=\s*)?(\d{3,5})", text)
    if match:
        return int(match.group(1)), int(match.group(2))
    width_match = re.search(r"目标输出[^。\n；;]*?(\d{3,5})\s*(?:px|像素|宽)", text)
    height_match = re.search(r"(?:高度|高)[^。\n；;]*?(\d{3,5})\s*(?:px|像素)?", text)
    return (
        int(width_match.group(1)) if width_match else None,
        int(height_match.group(1)) if height_match else None,
    )


def baseline_target_size(row: dict) -> tuple[Optional[int], Optional[int]]:
    return parse_target_size(str(row.get("summary") or ""))


def target_matches_baseline(target_text: str, baseline: dict) -> tuple[bool, str]:
    baseline_width, baseline_height = baseline_target_size(baseline)
    if not baseline_width and not baseline_height:
        return True, ""
    full_target_text = f"目标输出：{target_text}"
    target_width, target_height = parse_target_size(full_target_text)
    if baseline_width and target_width != baseline_width:
        return False, f"目标宽度 {target_width or '未记录'} 与 visual_baseline {baseline_width} 不一致"
    adaptive_height = any(token in full_target_text for token in ["内容自适应长图", "高度可随内容增长", "高度随内容增长", "可随内容增长"])
    if baseline_height and not adaptive_height and (target_height is None or target_height < baseline_height):
        return False, f"目标高度 {target_height or '未记录'} 低于 visual_baseline {baseline_height}"
    return True, ""


def screenshot_edit_status(item: dict, baseline: dict) -> tuple[bool, str]:
    mode = str(item.get("generation_mode") or "")
    if not mode:
        return False, "缺 generation_mode"
    if mode == "redraw":
        return False, "视觉基线下默认禁止 redraw；有线上截图时必须以线上截图为底做 screenshot_edit，不能 redraw 重画整页"
    if mode != "screenshot_edit":
        return False, f"generation_mode={mode} 不支持"
    base_image = str(item.get("base_image") or "")
    baseline_image = artifact_location(baseline)
    if not base_image:
        return False, "缺 base_image"
    if baseline_image and not same_path(base_image, baseline_image):
        return False, "base_image 与 visual_baseline 参考图不一致"
    if not str(item.get("edit_scope") or "").strip():
        return False, "缺 edit_scope"
    if not str(item.get("preserve_regions") or "").strip():
        return False, "缺 preserve_regions"
    return True, ""


SCREENSHOT_ANALYSIS_FIELDS = [
    ("baseline_information_architecture", "线上截图信息架构"),
    ("baseline_browse_path", "用户浏览路径"),
    ("baseline_task_path", "用户完成任务路径"),
]


def screenshot_analysis_status(item: dict) -> tuple[bool, str]:
    for key, label in SCREENSHOT_ANALYSIS_FIELDS:
        value = str(item.get(key) or "").strip()
        if not value:
            return False, f"缺{label}"
        if contains_any(value, ["待补充", "未定义", "不明确", "TBD", "未判断", "不适用"]):
            return False, f"{label}待补充"
    analysis_text = " ".join(str(item.get(key) or "") for key, _label in SCREENSHOT_ANALYSIS_FIELDS)
    if contains_any(analysis_text, ["照着改", "直接改", "随便改", "重画整页", "重新设计整页"]):
        return False, "线上截图分析不能跳过路径判断或要求重画整页"
    return True, ""


def screenshot_same_base_status(items: list[dict], expected_output_units: int, output_mode_label: str) -> tuple[bool, str]:
    if not items:
        return False, "prototype-board 暂无当前 run 输出单元"
    base_images = {str(item.get("base_image") or "").strip() for item in items}
    base_images.discard("")
    if len(items) >= expected_output_units and len(base_images) == 1:
        return True, f"{len(items)} 个完整页面输出单元使用同一张 base_image 做 {output_mode_label} A/B/C 局部实验"
    if not base_images:
        return False, "缺 base_image"
    if len(base_images) > 1:
        return False, f"发现 {len(base_images)} 个 base_image；有线上截图时三页实验必须围绕同一张线上截图做 A/B/C 局部实验"
    return False, f"{len(items)} 个完整页面输出单元；{output_mode_label} 要求 {expected_output_units} 个同源截图实验版本"


BASELINE_CHANGE_FIELDS = [
    ("baseline_problem", "生产基线问题"),
    ("changed_regions", "改动区域"),
    ("why_better_than_current", "为什么优于当前线上"),
    ("baseline_preservation", "保留 / 删除边界"),
]


def baseline_change_status(item: dict) -> tuple[bool, str]:
    for key, label in BASELINE_CHANGE_FIELDS:
        value = str(item.get(key) or "").strip()
        if not value:
            return False, f"缺{label}"
        if contains_any(value, ["待补充", "未定义", "不明确", "TBD", "未判断"]):
            return False, f"{label}待补充"
    proof_text = " ".join(str(item.get(key) or "") for key, _label in BASELINE_CHANGE_FIELDS)
    if contains_any(proof_text, ["感觉更好", "更高级", "更现代", "更好看", "换个风格"]):
        return False, "改动证明不能只写审美判断"
    return True, ""


DESIGN_COMPLETENESS_FIELDS = [
    ("design_gap", "主要设计差距"),
    ("ten_out_of_ten_standard", "10/10 原型标准"),
    ("prompt_design_fix", "prompt 设计修正"),
    ("anti_ai_slop_constraints", "反 AI 模板味约束"),
    ("state_coverage", "状态覆盖"),
    ("first_second_third_hierarchy", "第一眼 / 第二眼 / 第三眼"),
]


DESIGN_SPEC_FIELDS = [
    ("design_spec_target", "设计规范目标"),
    ("design_system_profile", "设计系统 / 平台配置"),
    ("platform_pattern", "平台模式"),
    ("inspiration_sources", "灵感来源"),
    ("inspiration_patterns", "灵感模式摘要"),
    ("no_copy_boundary", "禁止照搬项"),
]


def design_completeness_status(item: dict) -> tuple[bool, str]:
    score_text = str(item.get("design_score") or "").strip()
    if not score_text:
        return False, "缺设计评分"
    try:
        score = int(score_text)
    except ValueError:
        return False, "设计评分不是 0-10 整数"
    if score < 0 or score > 10:
        return False, "设计评分超出 0-10"
    for key, label in DESIGN_COMPLETENESS_FIELDS:
        if not str(item.get(key) or "").strip():
            return False, f"缺{label}"
    return True, ""


def design_spec_status(item: dict) -> tuple[bool, str]:
    for key, label in DESIGN_SPEC_FIELDS:
        value = str(item.get(key) or "").strip()
        if not value:
            return False, f"缺{label}"
        if contains_any(value, ["待补充", "未定义", "不明确", "TBD"]):
            return False, f"{label}待补充"
    copied_text = " ".join(str(item.get(key) or "") for key, _label in DESIGN_SPEC_FIELDS)
    if contains_any(copied_text, ["照抄", "复制截图", "复制图片", "复制文案", "直接复制", "完全复刻"]):
        return False, "灵感来源存在照搬风险"
    return True, ""


def read_text(path_value: str) -> str:
    if not path_value:
        return ""
    path = pathlib.Path(path_value)
    if not path.exists():
        return ""
    return path.read_text(encoding="utf-8", errors="ignore")


def discovery_gate_payload(target: str, run_id: str, brief_path: str = "") -> dict:
    command = [str(SCRIPT_DIR / "pmw-discovery-gate"), "check", "--target", target, "--json"]
    if run_id:
        command.extend(["--run", run_id])
    if brief_path:
        command.extend(["--brief", brief_path])
    try:
        result = subprocess.run(command, text=True, capture_output=True, check=False)
    except Exception:
        return {}
    try:
        return json.loads(result.stdout)
    except Exception:
        return {}


def summarize_queue(values: list, limit: int = 5) -> str:
    cleaned = [str(item).strip() for item in values if str(item).strip()]
    if not cleaned:
        return "无"
    shown = cleaned[:limit]
    suffix = f"；另有 {len(cleaned) - limit} 项" if len(cleaned) > limit else ""
    return "；".join(shown) + suffix


def discovery_alignment_summary(payload: dict) -> tuple[str, str, str, str, str, str, str, str]:
    if not payload:
        return (
            "未运行",
            "未读取产品发现门槛",
            "先读取当前 run / brief，再判断产品信息缺口",
            "暂无",
            "暂无",
            "先建立产品作业卡：当前判断、证据边界、关键缺口队列、PMW 产品建议、PMW 信息架构建议和用户作业",
            "先建立产品作业卡：当前判断、证据边界、关键缺口队列、PMW 产品建议、PMW 信息架构建议和用户作业",
            "先建立产品作业卡：当前判断、证据边界、关键缺口队列、PMW 产品建议、PMW 信息架构建议和用户作业",
        )
    missing = payload.get("missing_dimensions") or []
    covered = payload.get("covered_dimensions") or {}
    covered_labels = [str(item.get("label") or key) for key, item in covered.items()]
    missing_labels = [str(item.get("label") or item.get("dimension") or "") for item in missing]
    queue_items = payload.get("gap_queue_items") or []
    queue_labels = [str(item.get("label") or "") for item in queue_items if isinstance(item, dict)]
    if not queue_labels:
        queue_labels = [str(item) for item in (payload.get("gap_queue") or []) if str(item)]
    d_count = payload.get("directional_decisions_count", 0)
    d_required = payload.get("required_directional_decisions", 0)
    if payload.get("passed"):
        status = f"已对齐，覆盖 {len(covered_labels)} 个核心维度，方向性 D {d_count}/{d_required}"
        gap = "无"
        gap_queue = "无"
        user_action = "继续进入当前准备度门槛"
        product_advice = "保持产品作业卡随新截图、数据或 Zoon 变更更新"
        ia_advice = "保持信息架构建议与最新 visual baseline、brief 和反指标同步"
    else:
        if queue_labels:
            gap = str(payload.get("current_blocker") or queue_labels[0])
        elif missing_labels:
            gap = missing_labels[0]
        elif d_count < d_required:
            gap = f"方向性 D 不足（{d_count}/{d_required}）"
        else:
            gap = "产品发现深度不足"
        gap_queue = summarize_queue(queue_labels)
        status = f"需要补齐：{gap}"
        homework_queue = payload.get("product_homework_queue") or []
        if not homework_queue and payload.get("product_homework"):
            homework_queue = [payload.get("product_homework")]
        user_action = summarize_queue(homework_queue) if homework_queue else str(payload.get("next_question") or "回到产品方向审查，处理产品作业卡的当前主阻断")
        product_advice_queue = payload.get("pmw_product_advice_queue") or []
        if not product_advice_queue and payload.get("pmw_product_advice"):
            product_advice_queue = [payload.get("pmw_product_advice")]
        if not product_advice_queue and payload.get("pmw_advice"):
            product_advice_queue = [payload.get("pmw_advice")]
        product_advice = summarize_queue(product_advice_queue) if product_advice_queue else "先说明为什么该缺口影响真实问题、当前替代、反指标或原型可信度，再让用户补材料或拍板"
        ia_advice_queue = payload.get("pmw_ia_advice_queue") or []
        if not ia_advice_queue and payload.get("pmw_ia_advice"):
            ia_advice_queue = [payload.get("pmw_ia_advice")]
        ia_advice = summarize_queue(ia_advice_queue) if ia_advice_queue else "把当前主阻断映射到页面主路径、信息层级、信任证据和行动入口，再决定原型结构"
    covered_text = "、".join(covered_labels[:5]) if covered_labels else "暂无"
    return status, gap, user_action, covered_text, gap_queue, product_advice, ia_advice, str(payload.get("next_question") or "")


def redact_sensitive(value: str) -> str:
    value = re.sub(r"(token=)[^&\s]+", r"\1[redacted]", value)
    value = re.sub(r"(ownerSecret[=: ]*)[^&\s]+", r"\1[redacted]", value)
    value = re.sub(r"(Authorization: Bearer )[A-Za-z0-9._~+/=-]+", r"\1[redacted]", value)
    value = re.sub(r"(x-share-token: )[A-Za-z0-9._~+/=-]+", r"\1[redacted]", value)
    return value


def gate_result(name: str, required: bool, status: str, evidence: str, action: str, passed: bool) -> dict:
    return {
        "name": name,
        "required": required,
        "status": status,
        "evidence": evidence,
        "action": action,
        "passed": passed,
    }


def latest_review(events: list[dict]) -> dict:
    for row in reversed(events):
        if row.get("event") == "review":
            return row
    return {}


def latest_capability_review(events: list[dict], root: pathlib.Path, run_id: str) -> dict:
    event = latest_event(
        events,
        ["研发可行性反问", "功能能力与研发依赖", "能力依赖审查"],
        {"gate", "decision"},
    )
    if event:
        return event
    event = latest_event(
        events,
        ["研发可行性反问", "功能能力与研发依赖", "能力依赖审查"],
        {"artifact", "evidence"},
    )
    if event:
        return event
    for kind in ["handoff", "product_design_doc"]:
        row = current_artifact(root, kind, run_id)
        text = f"{row.get('status', '')} {row.get('title', '')} {row.get('summary', '')}"
        if row and contains_any(text, ["研发可行性反问", "功能能力与研发依赖", "能力依赖审查"]):
            return {
                "event": "artifact",
                "status": row.get("status") or "已登记",
                "title": row.get("title") or kind,
                "summary": row.get("summary") or artifact_location(row),
            }
    return {}


def capability_review_ready(row: dict) -> bool:
    if not row:
        return False
    if row.get("event") not in {"gate", "decision"}:
        return False
    text = f"{row.get('status', '')} {row.get('title', '')} {row.get('summary', '')}"
    if contains_any(text, ["需要 PM 拍板", "退回策略审查", "未完成", "未登记", "未审查"]):
        return False
    status = str(row.get("status") or "")
    if contains_any(status, ["已完成", "已审查", "可交付", "可留待补充"]):
        return True
    return False


def artifact_flow_rows(root: pathlib.Path, limit: int = 10) -> list[str]:
    rows = artifact_rows(root, limit=limit)
    rendered = []
    for row in rows:
        downstream = row.get("next_skill") or []
        if isinstance(downstream, list):
            downstream_text = ", ".join(str(item) for item in downstream if str(item).strip())
        else:
            downstream_text = str(downstream)
        location = artifact_location(row)
        rendered.append(
            f"{redact_sensitive(str(row.get('kind', '产物')))}｜"
            f"{redact_sensitive(str(row.get('status', '')))}｜"
            f"{redact_sensitive(str(row.get('title', '')))}｜"
            f"{redact_sensitive(str(row.get('source_skill', '')))} -> "
            f"{redact_sensitive(downstream_text or '待指定')}｜{redact_sensitive(str(location or '未记录'))}"
        )
    return rendered


def browser_evidence_rows(root: pathlib.Path, limit: int = 5) -> list[str]:
    rendered = []
    for row in artifact_rows(root, "browser_evidence", limit):
        location = artifact_location(row) or "未记录位置"
        rendered.append(
            f"{redact_sensitive(str(row.get('status') or '未记录'))}｜"
            f"{redact_sensitive(str(row.get('title') or '浏览器证据'))}｜"
            f"{redact_sensitive(location)}｜"
            f"{redact_sensitive(str(row.get('summary') or '未记录摘要'))}"
        )
    return rendered


def visual_baseline_rows(root: pathlib.Path, limit: int = 5) -> list[str]:
    rendered = []
    for row in artifact_rows(root, "visual_baseline", limit):
        location = artifact_location(row) or "未记录位置"
        rendered.append(
            f"{redact_sensitive(str(row.get('status') or '未记录'))}｜"
            f"{redact_sensitive(str(row.get('title') or '视觉基线'))}｜"
            f"{redact_sensitive(location)}｜"
            f"{redact_sensitive(str(row.get('summary') or '未记录摘要'))}"
        )
    return rendered


def review_specialist_rows(root: pathlib.Path, limit: int = 10) -> list[str]:
    rows = read_jsonl(root / "review-specialists.jsonl")[-limit:]
    rendered = []
    for row in rows:
        rendered.append(
            f"{redact_sensitive(str(row.get('expert_label') or row.get('expert') or '专家'))}｜"
            f"{redact_sensitive(str(row.get('status') or '未记录'))}｜"
            f"{redact_sensitive(str(row.get('severity') or '未标注'))}｜"
            f"{redact_sensitive(str(row.get('evidence') or '未记录'))}｜"
            f"{redact_sensitive(str(row.get('judgment') or ''))}｜"
            f"{redact_sensitive(str(row.get('action') or ''))}"
        )
    return rendered


def has_non_fiction_boundary(text: str) -> bool:
    lines = text.splitlines()
    for index, line in enumerate(lines):
        if "不可虚构" not in line:
            continue
        window = "\n".join(lines[index : index + 5])
        cleaned = (
            window.replace("#", "")
            .replace("不可虚构项", "")
            .replace("不可虚构", "")
            .strip(" ：:-\n")
        )
        if cleaned and not contains_any(cleaned, ["待补充", "未定义", "暂无", "TBD"]):
            return True
    return False


def extract_brief_status(text: str) -> str:
    return rt.extract_brief_status_line(text)


def status_is_aligned(text: str) -> bool:
    return rt.brief_is_aligned(text)


def event_is_confirmed(event: dict) -> bool:
    return rt.event_is_confirmed(event)


def current_brief_artifact(root: pathlib.Path, brief_path: str, run_id: str, project: Optional[dict] = None) -> dict:
    rows = artifact_rows(root, "product_brief")
    for row in reversed(rows):
        if run_id and row.get("run_id") and row.get("run_id") != run_id:
            continue
        if project and not row_matches_task(row, project):
            continue
        row_path = str(row.get("path") or "")
        if brief_path and row_path and same_path(row_path, brief_path):
            return row
    for row in reversed(rows):
        if project and not row_matches_task(row, project):
            continue
        row_path = str(row.get("path") or "")
        if brief_path and row_path and same_path(row_path, brief_path):
            return row
    return {}


def current_artifact(root: pathlib.Path, kind: str, run_id: str, project: Optional[dict] = None) -> dict:
    rows = artifact_rows(root, kind)
    for row in reversed(rows):
        if run_id and row.get("run_id") == run_id:
            if project and not row_matches_task(row, project):
                continue
            return row
    return {}


def current_board_items(root: pathlib.Path, brief_path: str, brief_version: str, run_id: str, project: Optional[dict] = None) -> list[dict]:
    rows = [r for r in read_jsonl(root / "prototype-board.jsonl") if r.get("record_type", "item") == "item"]
    scoped = []
    for row in rows:
        if project and not row_matches_task(row, project):
            continue
        row_run = str(row.get("run_id") or "")
        row_path = str(row.get("brief_path") or "")
        row_version = str(row.get("brief_version") or "")
        if run_id and row_run:
            if row_run == run_id:
                scoped.append(row)
            continue
        if brief_path and row_path:
            if same_path(row_path, brief_path):
                scoped.append(row)
            continue
        if run_id:
            continue
        if brief_version and row_version:
            if brief_version in row_version:
                scoped.append(row)
            continue
    return scoped


def readiness_target_label(target: str) -> str:
    if target == "prototype":
        return "出图前"
    if target == "handoff":
        return "交付前"
    return "自动判断"


def auto_readiness_target(project: dict, events: list[dict]) -> str:
    latest_status = str(project.get("latest_run_status") or (events[-1].get("status") if events else ""))
    has_review = bool(latest_review(events))
    if "交付" in latest_status or has_review:
        return "handoff"
    return "prototype"


def product_readiness_rows(project: dict, events: list[dict], target: str) -> list[dict]:
    effective_target = auto_readiness_target(project, events) if target == "auto" else target
    root = project_dir()
    run_id = active_run_id(project)
    if run_id:
        events = read_jsonl(root / "runs" / f"{run_id}.jsonl")
    else:
        events = []
    brief_path = str(project.get("latest_brief", ""))
    brief_text = read_text(brief_path)
    brief_name, brief_meta = latest_brief_summary(brief_path)
    brief_version = str(project.get("latest_brief_version") or "")
    product_brief = current_brief_artifact(root, brief_path, run_id, project)
    brief_lock = rt.latest_brief_lock(project)
    lock_status = str(brief_lock.get("lock_status") or brief_lock.get("status") or "")
    controller_active = task_is_controller_active(project)
    legacy_brief_ready = (not controller_active) and bool(brief_path) and bool(brief_text) and status_is_aligned(brief_text)
    brief_ready = (bool(brief_path) and rt.brief_lock_is_locked(brief_lock)) or legacy_brief_ready
    digest, revision = task_context(project)
    current_task_ready = bool(run_id) and (not controller_active or (bool(digest) and bool(revision)))
    if controller_active and not current_task_ready:
        current_task_status = "未通过"
        current_task_evidence = "current_task_digest / current_input_revision 缺失，或当前 run 已结束；旧简报可参考，不可放行"
    elif controller_active:
        current_task_status = "已绑定"
        digest, revision = task_context(project)
        current_task_evidence = f"run={run_id}；task={digest}；revision={revision}"
    elif run_id:
        current_task_status = "legacy active run"
        current_task_evidence = "当前项目未启用 controller task revision；保持兼容，但新 PMW 入口应先运行 pmw-controller intake"
    else:
        current_task_status = "无 active run"
        current_task_evidence = "project.json 没有可用 current_run_id，或 latest_run_status 已是终态；旧简报可参考，不可放行"
    brief_current_ok = current_task_ready and brief_ready
    if not brief_path:
        brief_status_label = "简报未产出"
        brief_action = "进入 $pm-brief 产出候选简报"
    elif lock_status == "needs_relock":
        brief_status_label = "简报被实质修改，需要重新锁定"
        brief_action = "只确认受影响边界，然后运行 pmw-controller lock-brief"
    elif lock_status == "blocked":
        brief_status_label = f"简报边界未通过：{brief_lock.get('first_blocker') or '需要补齐关键边界'}"
        brief_action = "补齐这一个边界后重新 lock-brief"
    elif brief_current_ok and legacy_brief_ready and not rt.brief_lock_is_locked(brief_lock):
        brief_status_label = "已对齐（legacy 兼容）"
        brief_action = "继续；新 PMW run 应使用 brief_lock"
    elif brief_current_ok:
        brief_status_label = "简报已锁定，可进入原型"
        brief_action = "继续"
    else:
        brief_status_label = "简报待用户确认"
        brief_action = "把候选简报和待确认问题给用户确认；确认后运行 pmw-controller lock-brief"
    rows = [
        gate_result(
            "当前任务",
            True,
            current_task_status,
            current_task_evidence,
            "继续" if current_task_ready else "先运行 pmw-controller intake 创建 / 绑定本轮 run；旧 run 只能作为参考",
            current_task_ready,
        ),
        gate_result(
            "产品简报",
            True,
            brief_status_label,
            "；".join(
                item
                for item in [
                    brief_name if brief_path else "project.json 未记录 latest_brief",
                    f"brief_lock：{lock_status or '未记录'}",
                    f"artifact：{product_brief.get('status')}" if product_brief else "artifact 可由 lock 自动修复" if brief_ready else "artifact 未记录当前 brief",
                ]
                if item
            ),
            brief_action,
            brief_current_ok,
        )
    ]

    brief_confirm = latest_event(events, ["产品简报确认", "前提确认"], {"gate", "decision"})
    if brief_confirm and controller_active and not row_matches_task(brief_confirm, project):
        brief_confirm = {}
    brief_confirm_ready = brief_current_ok or (bool(brief_confirm) and event_is_confirmed(brief_confirm))
    rows.append(
        gate_result(
            "产品简报确认",
            True,
            "已确认" if brief_confirm_ready else ("未记录" if not brief_confirm else brief_confirm.get("status", "待确认")),
            brief_lock.get("summary") or brief_confirm.get("summary") or "当前 run 未记录 brief_lock；确认前不能进入 image-2",
            "继续" if brief_confirm_ready else "先把候选简报给用户确认，再运行 lock-brief 一次性锁定",
            brief_confirm_ready,
        )
    )

    zoon_url = str(project.get("zoon_url") or "")
    zoon_sync = str(project.get("last_zoon_sync_status") or "")
    zoon_join = str(project.get("last_zoon_join_status") or "")
    zoon_join_error = str(project.get("last_zoon_join_error") or "")
    zoon_event = latest_event(events, ["Zoon", "zoon", "漂移"], {"evidence", "gate"})
    zoon_text = f"{zoon_sync} {zoon_join} {zoon_event.get('status', '')} {zoon_event.get('summary', '')}"
    zoon_required = bool(zoon_url) or zoon_sync in {"synced", "failed"}
    zoon_ready = bool(zoon_url) and zoon_sync == "synced" and not contains_any(
        zoon_text,
        ["DRIFT", "有漂移", "实质漂移", "读取失败", "同步失败", "failed"],
    )
    if not zoon_required:
        zoon_status = "未启用，使用本地简报"
    elif zoon_ready and zoon_join == "joined":
        zoon_status = "已同步且已加入协作态"
    elif zoon_ready and zoon_join == "unsupported":
        zoon_status = "已同步，协作加入不支持"
    elif zoon_ready:
        zoon_status = "已同步且无实质漂移"
    elif zoon_join == "failed":
        zoon_status = "协作加入失败"
    elif not zoon_url:
        zoon_status = "未记录 URL"
    else:
        zoon_status = "未通过"
    zoon_evidence = redact_sensitive(
        "；".join(
            item
            for item in [
                zoon_url or str(project.get("last_zoon_sync_error") or "未记录 Zoon URL；本地 latest_brief 生效"),
                f"协作加入：{zoon_join}" if zoon_join else "",
                f"加入失败：{zoon_join_error}" if zoon_join_error and zoon_join == "failed" else "",
            ]
            if item
        )
    )
    rows.append(
        gate_result(
            "Zoon",
            zoon_required,
            zoon_status,
            zoon_evidence,
            "继续" if (zoon_ready or not zoon_required) else "询问是否同步到 Zoon；若已选择协作，则运行 pmw-zoon sync 并在出图或交付前做漂移检查",
            zoon_ready or not zoon_required,
        )
    )

    browser_evidence = latest_browser_evidence(root)
    if browser_evidence:
        reference_has_visual_source = True
        reference_text = (
            f"{browser_evidence.get('status', '')} "
            f"{browser_evidence.get('title', '')} "
            f"{browser_evidence.get('summary', '')}"
        )
        reference_ready = not contains_any(reference_text, ["缺失", "待补充", "未判断", "失败", "不可访问", "未采集"])
        reference_status = browser_evidence.get("status") or "已记录"
        reference_evidence = (
            f"browser_evidence：{browser_evidence.get('title') or '浏览器证据'}｜"
            f"{artifact_location(browser_evidence) or browser_evidence.get('summary') or '未记录位置'}"
        )
    else:
        reference_event = latest_event(events, ["线上参考", "生产基线", "当前截图", "截图", "关键节点截图"], {"evidence", "gate"})
        if reference_event and controller_active and not row_matches_task(reference_event, project):
            reference_event = {}
        reference_has_visual_source = bool(reference_event) and contains_any(
            f"{reference_event.get('title', '')} {reference_event.get('summary', '')}",
            ["生产基线", "当前截图", "截图", "关键节点截图", "视觉基线"],
        )
        reference_text = f"{reference_event.get('status', '')} {reference_event.get('summary', '')}"
        reference_ready = bool(reference_event) and not contains_any(reference_text, ["缺失", "待补充", "未判断", "失败"])
        reference_status = reference_event.get("status") or "未判断"
        reference_evidence = reference_event.get("summary") or "尚未记录线上参考 / 生产基线判断"
    rows.append(
        gate_result(
            "线上参考",
            True,
            redact_sensitive(str(reference_status)),
            redact_sensitive(str(reference_evidence)),
            "继续" if reference_ready else "先判断是否承接线上流程；必要时补截图、关键节点截图或相似状态页",
            reference_ready,
        )
    )

    visual_baseline = latest_visual_baseline(root, run_id, project)
    visual_text = (
        f"{visual_baseline.get('status', '')} "
        f"{visual_baseline.get('title', '')} "
        f"{visual_baseline.get('summary', '')}"
    )
    visual_required = reference_ready and reference_has_visual_source
    visual_has_target = has_target_pixels(visual_baseline)
    visual_ready = bool(visual_baseline) and visual_has_target and not contains_any(
        visual_text,
        ["缺失", "待补充", "未判断", "失败", "不可访问", "未登记"],
    )
    if not visual_required:
        visual_status = "不适用" if not reference_ready else "未启用"
        visual_evidence = "无已采集线上截图；若是现有功能迭代，线上参考门槛会先阻断"
        visual_action = "继续" if reference_ready else "先补线上参考"
        visual_passed = True
    elif not visual_baseline:
        visual_status = "未登记"
        visual_evidence = "已采集线上参考，但未登记 visual_baseline"
        visual_action = "先登记 visual_baseline：参考图路径、像素尺寸、目标输出像素、字号 / 间距 / 密度基线"
        visual_passed = False
    elif not visual_has_target:
        visual_status = "缺目标输出像素"
        visual_evidence = f"visual_baseline：{visual_baseline.get('title') or '视觉基线'}｜{visual_baseline.get('summary') or artifact_location(visual_baseline) or '未记录目标输出'}"
        visual_action = "补齐目标输出像素；默认使用参考截图物理像素，显式 override 时必须同步等比缩放字号、间距和组件"
        visual_passed = False
    else:
        visual_status = visual_baseline.get("status") or "已登记"
        visual_evidence = f"visual_baseline：{visual_baseline.get('title') or '视觉基线'}｜{visual_baseline.get('summary') or artifact_location(visual_baseline) or '已记录'}"
        visual_action = "继续；image-2 prompt 必须写入视觉基线和目标输出像素"
        visual_passed = visual_ready
    rows.append(
        gate_result(
            "视觉基线",
            visual_required,
            redact_sensitive(str(visual_status)),
            redact_sensitive(str(visual_evidence)),
            visual_action,
            visual_passed,
        )
    )

    board = current_board_items(root, brief_path, brief_version, run_id, project)
    if not current_task_ready:
        board = []
    if board:
        binding_failures = []
        normalized_latest_version = normalize_version(brief_version)
        for item in board:
            row_path = str(item.get("brief_path") or "")
            row_version = normalize_version(str(item.get("brief_version") or ""))
            path_ok = bool(row_path and brief_path and same_path(row_path, brief_path))
            version_ok = bool(row_version and normalized_latest_version and row_version == normalized_latest_version)
            if not path_ok or not version_ok:
                binding_failures.append(
                    f"{item.get('scheme') or '未命名'} / {item.get('screen') or '未命名屏幕'}：brief={row_version or '未记录'}，latest={normalized_latest_version or '未记录'}"
                )
        binding_ready = not binding_failures
        binding_status = "已绑定当前 brief" if binding_ready else "绑定旧 brief"
        binding_evidence = f"{len(board)} 个输出单元" if binding_ready else "；".join(binding_failures[:5])
    else:
        binding_ready = True
        binding_status = "暂无输出单元"
        binding_evidence = "尚未登记 prototype-board 输出单元；方案差异门槛会继续判断"
    rows.append(
        gate_result(
            "输出单元绑定",
            bool(board),
            binding_status,
            redact_sensitive(binding_evidence),
            "继续" if binding_ready else "重新用当前 latest brief 登记 prototype-board 输出单元；旧版本输出单元不能放行出图",
            binding_ready,
        )
    )
    if visual_required:
        bad_canvas_rows = []
        for item in board:
            canvas_mode = str(item.get("canvas_mode") or "")
            target_output = str(item.get("target_output_pixels") or "")
            target_ok, target_failure = target_matches_baseline(target_output, visual_baseline)
            if canvas_mode != "physical_longboard" or not text_has_target_pixels(f"目标输出：{target_output}") or text_has_canvas_anchor(target_output) or not target_ok:
                suffix = f"（{target_failure}）" if target_failure else ""
                bad_canvas_rows.append(f"{item.get('scheme') or '未命名'} / {item.get('screen') or '未命名屏幕'}{suffix}")
        canvas_ready = bool(board) and not bad_canvas_rows
        if not board:
            canvas_status = "未登记"
            canvas_evidence = "prototype-board 暂无当前 run 输出单元"
        elif canvas_ready:
            canvas_status = "物理长板已锁定"
            canvas_evidence = f"{len(board)} 个输出单元已使用 canvas_mode=physical_longboard 和 target_output_pixels"
        else:
            canvas_status = "缺物理长板字段"
            canvas_evidence = "未通过：" + "；".join(bad_canvas_rows[:5])
    else:
        canvas_ready = True
        canvas_status = "不适用"
        canvas_evidence = "无线上截图视觉基线；标准首屏模式可按默认移动端画布执行"
    rows.append(
        gate_result(
            "输出画布",
            visual_required,
            canvas_status,
            redact_sensitive(canvas_evidence),
            "继续" if canvas_ready else "当前 run 的每个 prototype-board 输出单元必须写 canvas_mode=physical_longboard，并让 target_output_pixels 与 visual_baseline 目标像素一致，且不能含 H874 / 标准首屏锚点",
            canvas_ready,
        )
    )

    image_output_mode = rt.image_output_mode_from_lock(brief_lock, locked=brief_ready)
    expected_output_units = rt.expected_output_units(image_output_mode)
    output_mode_label = rt.image_output_mode_label(image_output_mode)

    if visual_required:
        edit_failures = []
        for item in board:
            edit_ok, edit_failure = screenshot_edit_status(item, visual_baseline)
            if not edit_ok:
                edit_failures.append(
                    f"{item.get('scheme') or '未命名'} / {item.get('screen') or '未命名屏幕'}（{edit_failure}）"
                )
        edit_ready = bool(board) and not edit_failures
        if not board:
            edit_status = "未登记"
            edit_evidence = "prototype-board 暂无当前 run 输出单元"
        elif edit_ready:
            edit_status = "已锁定截图编辑模式"
            edit_evidence = f"{len(board)} 个输出单元已记录 generation_mode / base_image / edit_scope / preserve_regions"
        else:
            edit_status = "截图编辑字段不完整"
            edit_evidence = "未通过：" + "；".join(edit_failures[:5])
    else:
        edit_ready = True
        edit_status = "不适用"
        edit_evidence = "无线上截图视觉基线；可按 redraw 或标准首屏模式执行"
    rows.append(
        gate_result(
            "截图编辑模式",
            visual_required,
            edit_status,
            redact_sensitive(edit_evidence),
            "继续" if edit_ready else "有线上截图时必须以线上截图为底做 screenshot_edit；输出单元必须绑定 base_image、edit_scope 和 preserve_regions，不得 redraw 重画整页",
            edit_ready,
        )
    )

    if visual_required and image_output_mode in {"three_page_exploration", "three_page_experiment"}:
        same_base_ready, same_base_evidence = screenshot_same_base_status(board, expected_output_units, output_mode_label)
        same_base_status = "同源截图实验" if same_base_ready else "截图实验基线不一致"
    else:
        same_base_ready = True
        same_base_status = "不适用"
        same_base_evidence = "单页主方案或无线上截图视觉基线，不要求三页同源 A/B/C 实验"
    rows.append(
        gate_result(
            "截图同源实验",
            visual_required and image_output_mode in {"three_page_exploration", "three_page_experiment"},
            same_base_status,
            redact_sensitive(same_base_evidence),
            "继续" if same_base_ready else "有线上截图时，三页实验必须使用同一张 base_image；三张完整页面只改各自局部模块，未调整区域保持与线上截图一致",
            same_base_ready,
        )
    )

    if visual_required:
        screenshot_analysis_failures = []
        for item in board:
            analysis_ok, analysis_failure = screenshot_analysis_status(item)
            if not analysis_ok:
                screenshot_analysis_failures.append(
                    f"{item.get('scheme') or '未命名'} / {item.get('screen') or '未命名屏幕'}：{analysis_failure}"
                )
        screenshot_analysis_ready = bool(board) and not screenshot_analysis_failures
        if not board:
            screenshot_analysis_status_text = "未登记"
            screenshot_analysis_evidence = "prototype-board 暂无当前 run 输出单元"
        elif screenshot_analysis_ready:
            screenshot_analysis_status_text = "已分析"
            screenshot_analysis_evidence = f"{len(board)} 个输出单元已记录线上截图信息架构、用户浏览路径和用户完成任务路径"
        else:
            screenshot_analysis_status_text = "缺路径分析"
            screenshot_analysis_evidence = "未通过：" + "；".join(screenshot_analysis_failures[:5])
    else:
        screenshot_analysis_ready = True
        screenshot_analysis_status_text = "不适用"
        screenshot_analysis_evidence = "无线上截图视觉基线；新概念页按产品简报和设计规范目标判断"
    rows.append(
        gate_result(
            "线上截图路径分析",
            visual_required,
            screenshot_analysis_status_text,
            redact_sensitive(screenshot_analysis_evidence),
            "继续" if screenshot_analysis_ready else "先分析线上截图的信息架构、用户浏览路径和用户完成任务路径；再写局部 edit_scope，未调整区域必须与线上截图保持对齐",
            screenshot_analysis_ready,
        )
    )

    if visual_required:
        baseline_change_failures = []
        for item in board:
            change_ok, change_failure = baseline_change_status(item)
            if not change_ok:
                baseline_change_failures.append(
                    f"{item.get('scheme') or '未命名'} / {item.get('screen') or '未命名屏幕'}：{change_failure}"
                )
        baseline_change_ready = bool(board) and not baseline_change_failures
        if not board:
            baseline_change_status_text = "未登记"
            baseline_change_evidence = "prototype-board 暂无当前 run 输出单元"
        elif baseline_change_ready:
            baseline_change_status_text = "已证明"
            baseline_change_evidence = f"{len(board)} 个输出单元已记录生产基线问题、改动区域、为什么优于当前线上和保留 / 删除边界"
        else:
            baseline_change_status_text = "缺改动证明"
            baseline_change_evidence = "未通过：" + "；".join(baseline_change_failures[:5])
    else:
        baseline_change_ready = True
        baseline_change_status_text = "不适用"
        baseline_change_evidence = "无线上截图视觉基线；新概念页按产品简报和设计规范目标判断"
    rows.append(
        gate_result(
            "生产基线改动证明",
            visual_required,
            baseline_change_status_text,
            redact_sensitive(baseline_change_evidence),
            "继续" if baseline_change_ready else "先拆解当前线上方案：哪里真的有问题、只改哪些区域、为什么新方案会优于当前线上、哪些区域必须保留；证明不成立就不出图",
            baseline_change_ready,
        )
    )

    scheme_event = latest_event(events, ["方案差异", "方案方向", "方案比较板"], {"evidence", "gate", "artifact", "decision"})
    if scheme_event and controller_active and not row_matches_task(scheme_event, project):
        scheme_event = {}
    scheme_text = f"{scheme_event.get('status', '')} {scheme_event.get('summary', '')}"
    page_meta_failures = []
    for item in board:
        for key, label in [
            ("output_mode", "出图模式"),
            ("page_variant_role", "页面实验角色"),
            ("experiment_hypothesis", "实验假设"),
        ]:
            if not str(item.get(key) or "").strip():
                page_meta_failures.append(f"{item.get('scheme') or '未命名'} / {item.get('screen') or '未命名屏幕'}：缺{label}")
    enough_pages = len(board) >= expected_output_units
    event_only_handoff_ready = (
        not board
        and effective_target == "handoff"
        and bool(scheme_event)
        and event_is_confirmed(scheme_event)
    )
    scheme_ready = (
        event_only_handoff_ready
        or (
            bool(board or scheme_event)
            and enough_pages
            and not page_meta_failures
            and not contains_any(scheme_text, ["只换皮", "未通过", "缺失", "待确认"])
        )
    )
    if board and enough_pages and not page_meta_failures:
        scheme_status = f"已登记（{output_mode_label}）"
        scheme_evidence = f"{len(board)} 个完整页面输出单元；当前模式要求 {expected_output_units} 个"
    elif event_only_handoff_ready:
        scheme_status = scheme_event.get("status") or "已登记"
        scheme_evidence = scheme_event.get("summary") or "交付阶段沿用已登记方案差异事件"
    elif board and not enough_pages:
        scheme_status = "页面输出单元不足"
        scheme_evidence = f"{len(board)} 个完整页面输出单元；{output_mode_label} 要求 {expected_output_units} 个"
    elif board and page_meta_failures:
        scheme_status = "页面实验字段不完整"
        scheme_evidence = "；".join(page_meta_failures[:5])
    else:
        scheme_status = scheme_event.get("status") or "未登记"
        scheme_evidence = scheme_event.get("summary") or f"prototype-board 暂无页面输出单元；当前模式：{output_mode_label}，要求 {expected_output_units} 个"
    rows.append(
        gate_result(
            "方案差异",
            True,
            scheme_status,
            scheme_evidence,
            "继续" if scheme_ready else f"先按 {output_mode_label} 登记 {expected_output_units} 个完整页面输出单元；每个单元是一张独立页面，差异来自局部模块策略、信息层级、信任表达或任务路径，不接受页面内三方案拼图",
            scheme_ready,
        )
    )

    design_failures = []
    for item in board:
        design_ok, design_failure = design_completeness_status(item)
        if not design_ok:
            design_failures.append(
                f"{item.get('scheme') or '未命名'} / {item.get('screen') or '未命名屏幕'}：{design_failure}"
            )
    design_required = effective_target == "prototype" or bool(board)
    design_ready = (not design_required) or (bool(board) and not design_failures)
    if not board:
        design_status = "未登记" if design_required else "不适用"
        design_evidence = "prototype-board 暂无当前 run 输出单元"
    elif design_ready:
        design_status = "已完成"
        design_evidence = f"{len(board)} 个输出单元已记录设计评分、10/10 标准、prompt 修正、状态覆盖和反模板味约束"
    else:
        design_status = "字段不完整"
        design_evidence = "未通过：" + "；".join(design_failures[:5])
    rows.append(
        gate_result(
            "原型设计完整度",
            design_required,
            design_status,
            redact_sensitive(design_evidence),
            "继续" if design_ready else "先为当前 run 的每个 prototype-board 输出单元补齐设计评分、10/10 原型标准、prompt 设计修正、状态覆盖和反 AI 模板味约束",
            design_ready,
        )
    )

    design_spec_failures = []
    for item in board:
        spec_ok, spec_failure = design_spec_status(item)
        if not spec_ok:
            design_spec_failures.append(
                f"{item.get('scheme') or '未命名'} / {item.get('screen') or '未命名屏幕'}：{spec_failure}"
            )
    design_spec_required = effective_target == "prototype" or bool(board)
    design_spec_fields_ready = (not design_spec_required) or (bool(board) and not design_spec_failures)
    design_spec_confirm = latest_event(events, ["设计规范目标确认", "设计规范目标卡", "设计规范目标"], {"gate", "decision"})
    if design_spec_confirm and controller_active and not row_matches_task(design_spec_confirm, project):
        design_spec_confirm = {}
    design_spec_confirm_text = f"{design_spec_confirm.get('status', '')} {design_spec_confirm.get('summary', '')}"
    design_spec_confirm_fresh = event_after_file(design_spec_confirm, brief_path) if design_spec_confirm else False
    design_spec_confirm_ready = (not design_spec_required) or (
        bool(design_spec_confirm)
        and design_spec_confirm_fresh
        and contains_any(design_spec_confirm_text, ["已确认", "已批准", "默认假设已批准", "按默认假设继续", "可出图", "已对齐"])
        and not contains_any(design_spec_confirm_text, ["待确认", "需要补充", "不可出图", "缺失", "未批准", "未确认"])
    )
    design_spec_ready = design_spec_fields_ready and design_spec_confirm_ready
    if not board:
        design_spec_status_text = "未登记" if design_spec_required else "不适用"
        design_spec_evidence = "prototype-board 暂无当前 run 输出单元"
    elif design_spec_ready:
        targets = sorted({str(item.get("design_spec_target") or "未记录") for item in board})
        profiles = sorted({str(item.get("design_system_profile") or "未记录") for item in board})
        design_spec_status_text = "已确认"
        design_spec_evidence = f"{len(board)} 个输出单元；目标：{', '.join(targets[:3])}；配置：{', '.join(profiles[:3])}；确认：{design_spec_confirm.get('summary') or design_spec_confirm.get('status')}"
    else:
        confirm_failure = ""
        if not design_spec_confirm:
            confirm_failure = "缺设计规范目标确认"
        elif not design_spec_confirm_fresh:
            confirm_failure = "设计规范目标确认已过期"
        elif not design_spec_confirm_ready:
            confirm_failure = "设计规范目标未确认"
        failures = design_spec_failures[:5]
        if confirm_failure:
            failures.append(confirm_failure)
        design_spec_status_text = "字段不完整" if design_spec_failures else "待确认"
        design_spec_evidence = "未通过：" + "；".join(failures)
    rows.append(
        gate_result(
            "设计规范目标",
            design_spec_required,
            design_spec_status_text,
            redact_sensitive(design_spec_evidence),
            "继续" if design_spec_ready else "先给用户设计规范目标卡，或确认使用 AutoDesign / 平台模式库 / PMW 默认假设；确认后写入设计系统、灵感来源、禁止照搬项和版权边界",
            design_spec_ready,
        )
    )

    scheme_confirm = latest_event(events, ["方案方向确认", "方案方向", "原型出图判断"], {"gate", "decision"})
    if scheme_confirm and controller_active and not row_matches_task(scheme_confirm, project):
        scheme_confirm = {}
    scheme_confirm_text = f"{scheme_confirm.get('status', '')} {scheme_confirm.get('summary', '')}"
    scheme_confirm_fresh = event_after_file(scheme_confirm, brief_path) if scheme_confirm else False
    scheme_confirm_ready = bool(scheme_confirm) and scheme_confirm_fresh and contains_any(scheme_confirm_text, ["已确认", "已批准", "默认方向已批准", "可出图", "已对齐"]) and not contains_any(
        scheme_confirm_text,
        ["待确认", "需要补充", "不可出图", "缺失", "未批准"],
    )
    rows.append(
        gate_result(
            "方案方向确认",
            True,
            "已确认" if scheme_confirm_ready else ("未记录" if not scheme_confirm else ("已过期" if not scheme_confirm_fresh else scheme_confirm.get("status", "待确认"))),
            scheme_confirm.get("summary") or "当前 run 未记录方案方向确认",
            "继续" if scheme_confirm_ready else "先基于当前 latest brief 重新确认方案方向；未确认前不写 image-2 prompt",
            scheme_confirm_ready,
        )
    )

    board_rows = read_jsonl(root / "prototype-board.jsonl")
    scoped_screens = {(row.get("scheme"), row.get("screen")) for row in board}
    image_failures = []
    for row in board_rows:
        if row.get("record_type") != "image":
            continue
        if run_id and row.get("run_id") and row.get("run_id") != run_id:
            continue
        if controller_active and not row_matches_task(row, project):
            continue
        if scoped_screens and (row.get("scheme"), row.get("screen")) not in scoped_screens:
            continue
        verdict = str(row.get("audit_verdict") or "")
        status = str(row.get("status") or "")
        if verdict and verdict != "通过" or "需要重出" in status:
            failures = row.get("audit_failures") or []
            if isinstance(failures, list):
                failure_text = "；".join(str(item) for item in failures)
            else:
                failure_text = str(failures)
            image_failures.append(f"{row.get('scheme') or '未命名'} / {row.get('screen') or '未命名屏幕'}：{verdict or status} {failure_text}")
    image_audit_required = bool(image_failures)
    rows.append(
        gate_result(
            "原型图片审计",
            image_audit_required,
            "存在需要重出的图片" if image_failures else "暂无失败图片",
            "；".join(image_failures[:5]) if image_failures else "出图后 pmw-prototype-board image 会记录视觉审计结果",
            "重出失败图片；视觉审计失败的图片不能作为交付结果展示" if image_failures else "继续",
            not image_failures,
        )
    )

    board_non_fiction = [str(row.get("non_fiction") or "").strip() for row in board if str(row.get("non_fiction") or "").strip()]
    non_fiction_ready = bool(board_non_fiction or has_non_fiction_boundary(brief_text))
    rows.append(
        gate_result(
            "不可虚构项",
            True,
            "已定义" if non_fiction_ready else "未定义",
            "prototype-board / 产品简报" if non_fiction_ready else "未找到明确不可虚构边界",
            "继续" if non_fiction_ready else "回到 $pm-brief 补齐不能展示的能力、数据、承诺和动作",
            non_fiction_ready,
        )
    )

    data_evidence = current_artifact(root, "data_evidence", run_id, project)
    data_text = f"{data_evidence.get('status', '')} {data_evidence.get('title', '')} {data_evidence.get('summary', '')}"
    data_ready = bool(data_evidence) and not contains_any(data_text, ["缺失", "待补充", "失败", "不可用"])
    if data_ready:
        data_status = "已佐证"
        data_evidence_text = f"data_evidence：{data_evidence.get('title') or '数据佐证'}｜{data_evidence.get('summary') or artifact_location(data_evidence) or '已记录'}"
        data_action = "继续"
    elif contains_any(brief_text, ["数据不适用", "无需数据佐证", "数据佐证：不适用"]):
        data_status = "不适用"
        data_evidence_text = "产品简报标注数据佐证不适用"
        data_action = "继续"
    else:
        data_status = "未提供，存在未验证风险"
        data_evidence_text = "未登记 data_evidence；原型必须标注假设 / 示例 / 区间，不能展示确定性承诺"
        data_action = "告知用户方案有未验证风险，并写入 brief 风险 / 待验证与原型不可虚构项"
    rows.append(
        gate_result(
            "数据佐证",
            False,
            data_status,
            redact_sensitive(data_evidence_text),
            data_action,
            True,
        )
    )

    review = latest_review(events)
    review_text = f"{review.get('status', '')} {review.get('summary', '')}"
    review_required = effective_target == "handoff"
    review_ready = bool(review) and contains_any(review_text, ["可通过", "可交付"]) and not contains_any(
        review_text,
        ["需要重出", "需要 PM 拍板", "需要补充参考"],
    )
    if not review_required:
        review_status = review.get("status") or "出图前不阻断"
        review_action = "出图后进入 $pm-prototype-review"
        review_passed = True
    else:
        review_status = "可通过" if review_ready else (review.get("status") or "未复审")
        review_action = "继续" if review_ready else "交付前先完成 $pm-prototype-review 并清掉重出 / 拍板 / 补参考项"
        review_passed = review_ready
    rows.append(
        gate_result(
            "复审状态",
            review_required,
            review_status,
            review.get("summary") or "暂无复审记录",
            review_action,
            review_passed,
        )
    )

    capability_review = latest_capability_review(events, root, run_id)
    capability_review_required = effective_target == "handoff"
    capability_review_passed = True
    if capability_review_required:
        capability_review_passed = capability_review_ready(capability_review)
    if not capability_review_required:
        capability_status = capability_review.get("status") or "出图前不阻断"
        capability_evidence = capability_review.get("summary") or "仅交付前 required"
        capability_action = "出图后进入 $pm-handoff 时再做能力依赖审查"
    elif capability_review_passed:
        capability_status = capability_review.get("status") or "已完成"
        capability_evidence = capability_review.get("summary") or "功能能力与研发依赖已审查"
        capability_action = "继续"
    elif capability_review:
        capability_status = capability_review.get("status") or "未通过"
        capability_evidence = capability_review.get("summary") or "能力依赖审查存在未决项"
        capability_action = "如果缺口影响承诺或验收，先完成当前 D；如果能力前提不成立，退回 $pm-strategy-review；普通缺口可留待补充"
    else:
        capability_status = "未完成"
        capability_evidence = "当前 run 未记录研发可行性反问 / 功能能力与研发依赖审查"
        capability_action = "先在 $pm-handoff 建立功能能力与研发依赖表；普通缺口可待补充，影响承诺或验收的缺口转当前 D"
    rows.append(
        gate_result(
            "研发可行性反问",
            capability_review_required,
            capability_status,
            capability_evidence,
            capability_action,
            capability_review_passed,
        )
    )
    return rows


def render_readiness_section(run_id: Optional[str], target: str = "auto", heading_level: str = "#") -> str:
    global ACTIVE_CONTEXT
    project = read_json(project_dir() / "project.json")
    chosen_run, events = read_run(run_id)
    ACTIVE_CONTEXT = rt.resolve_context(project, chosen_run if run_id else None)
    effective_target = auto_readiness_target(project, events) if target == "auto" else target
    rows = product_readiness_rows(project, events, effective_target)
    blockers = [row for row in rows if row["required"] and not row["passed"]]
    if blockers:
        verdict = "NOT_READY"
        verdict_cn = "不可出图" if effective_target == "prototype" else "不可交付"
        next_action = blockers[0]["action"]
    else:
        verdict = "READY_FOR_PROTOTYPE" if effective_target == "prototype" else "READY_FOR_HANDOFF"
        verdict_cn = "可出图" if effective_target == "prototype" else "可交付"
        next_action = "继续进入下一步"

    lines = [
        f"{heading_level} PMWorkspace 产品准备度仪表盘",
        "",
        f"- 目标：{readiness_target_label(effective_target)}",
        f"- 当前 run：{chosen_run or '暂无'}",
        f"- Verdict：{verdict_cn}（{verdict}）",
        f"- 下一步：{next_action}",
        "",
        "| 门槛 | Required | 状态 | 证据 | 行动 |",
        "|---|---|---|---|---|",
    ]
    for row in rows:
        required = "YES" if row["required"] else "no"
        values = [row["name"], required, row["status"], row["evidence"], row["action"]]
        lines.append("| " + " | ".join(str(value).replace("|", "/") for value in values) + " |")
    lines.append("")
    return "\n".join(lines)


READINESS_GATE_GUIDANCE: dict[str, tuple[str, str]] = {
    "当前任务": (
