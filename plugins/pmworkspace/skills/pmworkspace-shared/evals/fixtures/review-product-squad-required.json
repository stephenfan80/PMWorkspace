      "角色结论独立暴露盲区",
      "用最高严重度合并成行动结论"
    ],
    "forbidden_behaviors": [
      "只用一个 PM 视角包办所有判断",
      "只写角色名称不写短结论",
      "用平均分覆盖硬违规",
      "把未决安全、发布或工程责任靠改图解决"
    ]
  },
