{
  "id": "examples-realistic-anonymized-style-required",
  "title": "examples 必须提供真实匿名风格的完整产品资产样例",
  "category": "public-docs",
  "primary_skill": "pm-workspace",
  "prompt": "用户想照着 examples 学会如何组织 PMW 的完整产品资产流。",
  "expected": {
    "mode": "maintenance",
    "status": "可检查",
    "must_stop": false,
    "gate": "真实匿名风格资产样例库",
    "required_behaviors": [
      "四个 asset-flow 样例都按 product_brief -> visual_baseline -> prototype_manifest -> prototype_review -> handoff 展示",
      "每个样例 README 都说明匿名背景、用户输入材料、资产流、关键 PM 判断和脱敏边界",
      "product_brief 必须有证据状态，区分已确认、假设和待补充",
      "prototype_manifest 必须读取上游 brief 和 visual_baseline",
      "prototype_review 必须检查上游一致性",
      "handoff 必须读取上游来源，并保留待补充项、不可虚构边界和验收口径",
      "没有生产截图的新想法和 PRD 交付样例也要保留 visual_baseline 资产位"
    ],
    "forbidden_behaviors": [
      "新想法和 PRD 交付样例跳过 visual_baseline",
      "样例只写结果不写输入材料和证据边界",
      "handoff 脱离 brief / baseline / manifest / review 自行编造接口、埋点或验收",
      "把公开样例写成真实客户、真实截图或内部数据"
    ]
  },
