{
  "id": "strategy-scope-modes-required",
  "title": "策略审查必须显式选择范围模式",
  "category": "pm-strategy-review",
  "primary_skill": "pm-strategy-review",
  "prompt": "事实已经清楚，但方向可能太大，也可能没有抓住真实价值，请做策略审查。",
  "expected": {
    "mode": "deep",
    "status": "待确认",
    "must_stop": false,
    "gate": "范围模式",
    "required_behaviors": [
      "选择一个范围模式",
      "区分扩大模式、保持模式、收缩模式或转向模式",
      "说明范围模式和最大策略矛盾的关系",
      "说明该模式如何影响范围、价值交换、反指标和不可虚构边界",
      "把范围模式带入产品简报交接"
    ],
    "forbidden_behaviors": [
      "只写扩大、保持、收缩或转向标签",
      "省略范围模式",
      "静默扩大范围或增加承诺",
      "缺事实时强行转向"
    ]
  },
  "contract_checks": [
    {
      "path": "pmworkspace-shared/references/adversarial-review.md",
      "contains": "## 范围模式"
    },
    {
      "path": "pmworkspace-shared/references/adversarial-review.md",
      "contains": "扩大模式"
    },
    {
      "path": "pmworkspace-shared/references/adversarial-review.md",
      "contains": "保持模式"
    },
    {
      "path": "pmworkspace-shared/references/adversarial-review.md",
      "contains": "收缩模式"
    },
    {
      "path": "pmworkspace-shared/references/adversarial-review.md",
      "contains": "转向模式"
    },
    {
      "path": "pmworkspace-shared/references/adversarial-review.md",
      "contains": "每轮必须输出一个 `范围模式`"
    },
    {
      "path": "pm-strategy-review/SKILL.md",
      "contains": "- 范围模式：扩大模式 / 保持模式 / 收缩模式 / 转向模式"
    },
    {
      "path": "pmworkspace-shared/references/pm-eval-system.md",
      "contains": "策略审查：必须显式选择范围模式"
