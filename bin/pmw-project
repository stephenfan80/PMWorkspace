#!/usr/bin/env python3
import json
import os
import pathlib
import re
import subprocess
import sys
from datetime import datetime, timezone


SCRIPT_DIR = pathlib.Path(__file__).resolve().parent
STATE_DIR = pathlib.Path(os.environ.get("PMW_HOME", str(pathlib.Path.home() / ".pmworkspace"))).expanduser()


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def current_slug() -> str:
    env_slug = os.environ.get("PMW_PROJECT_SLUG")
    if env_slug:
        return env_slug
    try:
        return subprocess.check_output([str(SCRIPT_DIR / "pmw-slug")], text=True).strip()
    except Exception:
        return "local-project"


def fallback_name() -> str:
    env_name = os.environ.get("PMW_PROJECT_NAME", "").strip()
    if env_name:
        return env_name
    try:
        root = subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True, stderr=subprocess.DEVNULL).strip()
        name = pathlib.Path(root).name.strip()
    except Exception:
        name = pathlib.Path.cwd().name.strip()
    if not name or name.startswith("project-"):
        return "未命名项目"
    return name


def project_paths():
    slug = current_slug()
    project_dir = STATE_DIR / "projects" / slug
    return slug, project_dir, project_dir / "project.json"


def read_project(path: pathlib.Path, slug: str) -> dict:
    if path.exists():
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                data.setdefault("slug", slug)
                return data
        except Exception:
            pass
    return {"slug": slug}


def write_project(path: pathlib.Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    data["updated_at"] = now()
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def usage() -> int:
    print(
        "Usage: pmw-project {get-name|set-name|link-zoon|set-latest-brief|set-zoon-sync|set-zoon-sync-failed|set-zoon-sync-disabled|set-zoon-join|show} ...",
        file=sys.stderr,
    )
    return 1


def redact_sensitive(value: str) -> str:
    value = re.sub(r"(token=)[^&\s]+", r"\1[redacted]", value)
    value = re.sub(r"(Authorization: Bearer )[A-Za-z0-9._~+/=-]+", r"\1[redacted]", value)
    value = re.sub(r"(x-share-token: )[A-Za-z0-9._~+/=-]+", r"\1[redacted]", value)
    value = re.sub(r"(ownerSecret[=: ]*)[^&\s]+", r"\1[redacted]", value)
    return value[:500]


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    slug, _project_dir, path = project_paths()
    data = read_project(path, slug)

    if command == "get-name":
        print(str(data.get("display_name") or fallback_name()))
        return 0

    if command == "set-name":
        name = " ".join(sys.argv[2:]).strip()
        if not name:
            print("Usage: pmw-project set-name <中文项目名>", file=sys.stderr)
            return 1
        data["display_name"] = name
        write_project(path, data)
        print(name)
        return 0

    if command == "link-zoon":
        url = sys.argv[2].strip() if len(sys.argv) > 2 else ""
        if not url:
            print("Usage: pmw-project link-zoon <Zoon URL>", file=sys.stderr)
            return 1
        data["zoon_url"] = url
        data.setdefault("display_name", fallback_name())
        write_project(path, data)
        print(url)
        return 0

    if command == "set-latest-brief":
        latest = sys.argv[2].strip() if len(sys.argv) > 2 else ""
        if not latest:
            print("Usage: pmw-project set-latest-brief <path>", file=sys.stderr)
            return 1
        data["latest_brief"] = latest
        data.setdefault("display_name", fallback_name())
        write_project(path, data)
        print(latest)
        return 0

    if command == "set-zoon-sync":
        url = sys.argv[2].strip() if len(sys.argv) > 2 else ""
        latest = sys.argv[3].strip() if len(sys.argv) > 3 else ""
        if not url:
            print("Usage: pmw-project set-zoon-sync <Zoon URL> [brief path]", file=sys.stderr)
            return 1
        data["zoon_url"] = url
        data["last_zoon_sync_at"] = now()
        data["last_zoon_sync_status"] = "synced"
        data.pop("last_zoon_sync_error", None)
        if latest:
            data["last_zoon_sync_brief"] = latest
        data.setdefault("display_name", fallback_name())
        write_project(path, data)
        print(url)
        return 0

    if command == "set-zoon-sync-failed":
        reason = sys.argv[2].strip() if len(sys.argv) > 2 else "unknown"
        latest = sys.argv[3].strip() if len(sys.argv) > 3 else ""
        data["last_zoon_sync_at"] = now()
        data["last_zoon_sync_status"] = "failed"
        data["last_zoon_sync_error"] = redact_sensitive(reason or "unknown")
        if latest:
            data["last_zoon_sync_brief"] = latest
        data.setdefault("display_name", fallback_name())
        write_project(path, data)
        print(data["last_zoon_sync_error"])
        return 0

    if command == "set-zoon-sync-disabled":
        latest = sys.argv[2].strip() if len(sys.argv) > 2 else ""
        data["last_zoon_sync_at"] = now()
        data["last_zoon_sync_status"] = "disabled"
        data.pop("last_zoon_sync_error", None)
        if latest:
            data["last_zoon_sync_brief"] = latest
        data.setdefault("display_name", fallback_name())
        write_project(path, data)
        print("disabled")
        return 0

    if command == "set-zoon-join":
        status = sys.argv[2].strip() if len(sys.argv) > 2 else ""
        reason = " ".join(sys.argv[3:]).strip() if len(sys.argv) > 3 else ""
        if status not in {"joined", "failed", "unsupported"}:
            print("Usage: pmw-project set-zoon-join <joined|failed|unsupported> [reason]", file=sys.stderr)
            return 1
        data["last_zoon_join_at"] = now()
        data["last_zoon_join_status"] = status
        if status == "joined":
            data.pop("last_zoon_join_error", None)
        elif reason:
            data["last_zoon_join_error"] = redact_sensitive(reason)
        else:
            data["last_zoon_join_error"] = status
        data.setdefault("display_name", fallback_name())
        write_project(path, data)
        print(status)
        return 0

    if command == "show":
        data.setdefault("display_name", fallback_name())
        data.setdefault("slug", slug)
        print(json.dumps(data, ensure_ascii=False, indent=2, sort_keys=True))
        return 0

    return usage()


if __name__ == "__main__":
    raise SystemExit(main())
