    "待补充",
]
DIMENSION_TEXT_SOURCES = {"候选产品简报", "最新产品简报"}


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def current_slug() -> str:
    env_slug = os.environ.get("PMW_PROJECT_SLUG")
    if env_slug:
        return env_slug
    try:
        return subprocess.check_output([str(SCRIPT_DIR / "pmw-slug")], text=True).strip()
    except Exception:
        return "local-project"


def project_dir() -> pathlib.Path:
    return STATE_DIR / "projects" / current_slug()


def read_json(path: pathlib.Path) -> dict:
    if not path.exists():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def read_jsonl(path: pathlib.Path) -> list[dict]:
    rows: list[dict] = []
    if not path.exists():
        return rows
    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
        try:
            value = json.loads(line)
        except Exception:
            continue
        if isinstance(value, dict):
            rows.append(value)
    return rows


def current_run_id() -> str:
    project = read_json(project_dir() / "project.json")
    return str(project.get("current_run_id") or project.get("latest_run_id") or "")


def read_run_events(run_id: str) -> list[dict]:
    if not run_id:
        return []
    return read_jsonl(project_dir() / "runs" / f"{run_id}.jsonl")


def row_matches_run(row: dict, run_id: str) -> bool:
    row_run = str(row.get("run_id") or "")
    return not run_id or not row_run or row_run == run_id


def read_text(path_value: str) -> str:
    if not path_value:
        return ""
    path = pathlib.Path(path_value).expanduser()
    if not path.exists():
        return ""
    return path.read_text(encoding="utf-8", errors="ignore")


def useful_text(value: str) -> bool:
    cleaned = re.sub(r"[\s#：:|`>*_\-]+", "", value or "")
    if len(cleaned) < 4:
        return False
    return not any(token.lower() in cleaned.lower() for token in PLACEHOLDER_TOKENS)


def declares_gap_for_dimension(text: str, dimension: str) -> bool:
    if not text:
        return False
    spec = DIMENSIONS[dimension]
    label = spec["label"]
    anchors = [label, *spec["section_keywords"]]
    segments = [segment for segment in re.split(r"[\n。；;]", text) if segment.strip()]
    if any(contains_any(segment, GAP_COVERAGE_TOKENS) and contains_any(segment, anchors) for segment in segments):
        return True
    negative_prefixes = ["缺少", "缺失", "未提供", "未确认", "待确认", "未补齐"]
    for segment in segments:
        for anchor in anchors:
            if not anchor:
                continue
            pattern = rf"({'|'.join(map(re.escape, negative_prefixes))}).{{0,12}}{re.escape(anchor)}|{re.escape(anchor)}.{{0,12}}({'|'.join(map(re.escape, negative_prefixes))})"
            if re.search(pattern, segment):
                return True
    return False


def section_has_content(text: str, section_keywords: list[str]) -> bool:
    lines = text.splitlines()
    for index, line in enumerate(lines):
        if not any(keyword in line for keyword in section_keywords):
            continue
        if not re.search(r"(^|\s)#|：|:", line):
            continue
        window: list[str] = []
        for next_line in lines[index : min(len(lines), index + 10)]:
            if next_line.startswith("## ") and window:
                break
            window.append(next_line)
        body = "\n".join(window)
        body = re.sub(r"^#+\s*.*$", "", body, flags=re.M)
        for keyword in section_keywords:
            body = body.replace(keyword, "")
        if useful_text(body):
            return True
    return False


def text_covers_dimension(text: str, dimension: str) -> bool:
    spec = DIMENSIONS[dimension]
    if declares_gap_for_dimension(text, dimension):
        return False
    if section_has_content(text, spec["section_keywords"]):
        return True
    if not useful_text(text):
        return False
    keyword_hits = sum(1 for keyword in spec["keywords"] if keyword.lower() in text.lower())
    return keyword_hits >= 2


def collect_evidence_texts(args: argparse.Namespace, run_id: str) -> list[tuple[str, str]]:
    root = project_dir()
    texts: list[tuple[str, str]] = []
    if args.brief:
        texts.append(("候选产品简报", read_text(args.brief)))
    project = read_json(root / "project.json")
    latest_brief = str(project.get("latest_brief") or "")
    if latest_brief and latest_brief != args.brief:
        texts.append(("最新产品简报", read_text(latest_brief)))
    for row in read_jsonl(root / "discovery.jsonl"):
        if not row_matches_run(row, run_id):
            continue
        parts = [row.get("dimension"), row.get("source"), row.get("summary"), row.get("confidence")]
        texts.append(("产品发现记录", " ".join(str(part or "") for part in parts)))
    for row in read_run_events(run_id):
        parts = [row.get("event"), row.get("status"), row.get("title"), row.get("summary")]
        texts.append(("当前 run", " ".join(str(part or "") for part in parts)))
    for path_name in ["questions.jsonl", "decisions.jsonl", "artifact-flow.jsonl"]:
        for row in read_jsonl(root / path_name):
            if not row_matches_run(row, run_id):
                continue
            parts = [row.get(key) for key in sorted(row)]
            texts.append((path_name, " ".join(str(part or "") for part in parts)))
    return [(source, text) for source, text in texts if text.strip()]


def combined_evidence_text(args: argparse.Namespace, run_id: str) -> str:
    return "\n".join(text for _source, text in collect_evidence_texts(args, run_id))


def contains_any(text: str, terms: list[str]) -> bool:
    return any(term.lower() in text.lower() for term in terms)


def has_real_url_or_image_reference(text: str) -> bool:
    if re.search(r"https?://[^\s)）>]+", text):
        return True
    return bool(re.search(r"[/~][^\s)）>]+?\.(?:png|jpe?g|webp|gif|fig|figma)\b", text, flags=re.I))


def artifact_rows(run_id: str) -> list[dict]:
    return [row for row in read_jsonl(project_dir() / "artifact-flow.jsonl") if row_matches_run(row, run_id)]


def artifact_is_available(row: dict) -> bool:
    text = " ".join(str(row.get(key) or "") for key in ["kind", "title", "status", "path", "url", "summary"])
    if contains_any(text, BASELINE_NEGATIVE_TERMS + ["待补充", "未采集", "失败"]):
        return False
    if str(row.get("kind") or "") == "visual_baseline":
        return bool(str(row.get("path") or row.get("url") or row.get("summary") or "").strip())
    if str(row.get("kind") or "") == "browser_evidence":
        return bool(str(row.get("path") or row.get("url") or row.get("summary") or "").strip())
    return False


def artifact_is_online_baseline(row: dict) -> bool:
    if not artifact_is_available(row):
        return False
    kind = str(row.get("kind") or "")
    if kind == "visual_baseline":
        return True
    row_text = " ".join(str(row.get(key) or "") for key in ["kind", "title", "status", "path", "url", "summary"])
    return kind == "browser_evidence" and not contains_any(row_text, COMPETITOR_BASELINE_TERMS)


def has_online_baseline(args: argparse.Namespace, run_id: str, text: str) -> bool:
    if any(artifact_is_online_baseline(row) for row in artifact_rows(run_id)):
        return True
    if contains_any(text, ONLINE_BASELINE_PROVIDED_TERMS) and not contains_any(text, BASELINE_NEGATIVE_TERMS):
        return True
    no_reference_confirmed = contains_any(text, NO_REFERENCE_CONFIRMED_TERMS)
    hard_existing_signal = contains_any(text, HARD_ONLINE_BASELINE_TERMS)
    if no_reference_confirmed and not hard_existing_signal:
        return True
    for line in text.splitlines():
        if (
            has_real_url_or_image_reference(line)
            and contains_any(line, ONLINE_BASELINE_TERMS)
            and not contains_any(line, COMPETITOR_BASELINE_TERMS + BASELINE_NEGATIVE_TERMS)
        ):
            return True
    return False


def has_competitor_material(run_id: str, text: str) -> bool:
    for row in artifact_rows(run_id):
        row_text = " ".join(str(row.get(key) or "") for key in ["kind", "title", "status", "path", "url", "summary"])
        if contains_any(row_text, COMPETITOR_BASELINE_TERMS) and artifact_is_available(row):
            return True
    if contains_any(text, ["竞品参考：已提供", "竞品参考: 已提供", "竞品截图已提供"]):
        return True
    return contains_any(text, COMPETITOR_BASELINE_TERMS) and has_real_url_or_image_reference(text)


def brief_declares_aligned(path_value: str) -> bool:
    text = read_text(path_value)
    return bool(re.search(r"确认状态[：:]\s*已对齐", text))


def baseline_state(args: argparse.Namespace, run_id: str) -> dict:
    text = combined_evidence_text(args, run_id)
    online_required = contains_any(text, ONLINE_BASELINE_TERMS)
    competitor_requested = contains_any(text, COMPETITOR_BASELINE_TERMS)
    online_provided = has_online_baseline(args, run_id, text)
    competitor_provided = has_competitor_material(run_id, text)
    online_missing = online_required and not online_provided
    competitor_missing = competitor_requested and not competitor_provided
    aligned_brief = brief_declares_aligned(args.brief)
    blocks_target = False
    if args.target == "alignment":
        blocks_target = online_missing or competitor_missing
    elif args.target == "prototype":
        blocks_target = online_missing
    elif args.target == "brief":
        blocks_target = online_missing and aligned_brief
    status = "不适用"
    if online_required:
        status = "已提供线上参考" if online_provided else "缺失待补充"
    competitor_status = "不适用"
    if competitor_requested:
        competitor_status = "已提供竞品参考" if competitor_provided else "待补充"
    return {
        "online_baseline_required": online_required,
        "online_baseline_status": status,
        "online_baseline_missing": online_missing,
        "competitor_baseline_requested": competitor_requested,
        "competitor_baseline_status": competitor_status,
        "competitor_baseline_missing": competitor_missing,
        "brief_declares_aligned": aligned_brief,
        "baseline_blocks_target": blocks_target,
        "can_save_pending_brief": bool(args.target == "brief" and online_missing and not aligned_brief),
    }


def explicit_discovery_dimensions(run_id: str) -> dict[str, list[str]]:
    covered: dict[str, list[str]] = {dimension: [] for dimension in DIMENSIONS}
    for row in read_jsonl(project_dir() / "discovery.jsonl"):
        if not row_matches_run(row, run_id):
            continue
        dimension = str(row.get("dimension") or "")
        confidence = str(row.get("confidence") or "")
        if dimension in covered and confidence == "confirmed" and useful_text(str(row.get("summary") or "")):
            covered[dimension].append(str(row.get("source") or "discovery ledger"))
    return covered


def covered_dimensions(args: argparse.Namespace, run_id: str) -> dict[str, list[str]]:
    covered = explicit_discovery_dimensions(run_id)
    for source, text in collect_evidence_texts(args, run_id):
        if source not in DIMENSION_TEXT_SOURCES:
            continue
        for dimension in DIMENSIONS:
            if covered[dimension]:
                continue
            if text_covers_dimension(text, dimension):
                covered[dimension].append(source)
    return covered


def event_is_confirmed(row: dict) -> bool:
    question_id = str(row.get("question_id") or "")
    if question_id:
        choice = str(row.get("user_choice") or "").strip()
        cleaned_choice = re.sub(r"[\s#：:|`>*_\-]+", "", choice)
        if not cleaned_choice or any(token.lower() in cleaned_choice.lower() for token in PLACEHOLDER_TOKENS):
            return False
        text = f"{choice} {row.get('status', '')} {row.get('summary', '')}"
        return not any(token in text for token in NEGATIVE_TOKENS)

    text = f"{row.get('status', '')} {row.get('summary', '')} {row.get('body', '')} {row.get('user_choice', '')}"
    if any(token in text for token in NEGATIVE_TOKENS):
        return False
    if any(token in text for token in CONFIRMED_TOKENS):
        return True
    if row.get("event") == "decision":
        return useful_text(str(row.get("summary") or row.get("body") or ""))
    return "body" in row and useful_text(str(row.get("body") or ""))


def looks_like_directional_decision(row: dict) -> bool:
    question_id = str(row.get("question_id") or "").strip()
    if question_id.upper().startswith("D"):
        return True
    title = str(row.get("title") or "").strip()
    summary = str(row.get("summary") or row.get("body") or "").strip()
    text = f"{title} {summary}"
    if re.search(r"(^|[\s#：:|`>*_\-])D\d*([\s#：:|`>*_\-]|$)", title, flags=re.I):
        return True
    return contains_any(
        text,
        [
            "方向性 D",
            "D 豁免原因",
            "D豁免原因",
            "PM 拍板",
            "PM拍板",
            "拍板",
            "取舍",
            "方案方向确认",
            "范围确认",
            "承诺确认",
            "价值交换确认",
            "实验口径确认",
        ],
    )


def count_directional_decisions(run_id: str) -> tuple[int, bool]:
    rows: list[dict] = []
    root = project_dir()
    rows.extend(row for row in read_jsonl(root / "questions.jsonl") if row_matches_run(row, run_id))
    rows.extend(row for row in read_jsonl(root / "decisions.jsonl") if row_matches_run(row, run_id))
    rows.extend(read_run_events(run_id))
    count = 0
    exemption = False
    seen: set[str] = set()
    for row in rows:
        text = " ".join(str(row.get(key) or "") for key in sorted(row))
        if "D 豁免原因" in text or "D豁免原因" in text:
            exemption = True
        if not looks_like_directional_decision(row) or not event_is_confirmed(row):
            continue
        question_id = str(row.get("question_id") or "")
        fingerprint = f"{row.get('title') or question_id}:{row.get('summary') or row.get('body') or row.get('user_choice')}"
        if fingerprint in seen:
            continue
        seen.add(fingerprint)
        count += 1
    return count, exemption


def build_payload(args: argparse.Namespace) -> dict:
    run_id = args.run or current_run_id()
    covered = covered_dimensions(args, run_id)
    missing = [dimension for dimension, sources in covered.items() if not sources]
    decision_count, d_exemption = count_directional_decisions(run_id)
    baseline = baseline_state(args, run_id)
    needs_decisions = args.target in {"brief", "alignment"}
    decision_ready = decision_count >= args.min_decisions or (d_exemption and args.allow_d_exemption)
    passed = not missing and (decision_ready or not needs_decisions) and not baseline["baseline_blocks_target"]
    next_dimension = missing[0] if missing else ""
    next_question = DIMENSIONS[next_dimension]["question"] if next_dimension else (
        "D：请拍板产品定位 / 范围、价值交换 / 信任承诺或数据承诺 / 转化动作中的下一个方向性取舍。"
        if not decision_ready and needs_decisions
        else ""
    )
    missing_labels = [DIMENSIONS[dimension]["label"] for dimension in missing]
    gap_queue_items = [
        {
            "dimension": dimension,
            "label": DIMENSIONS[dimension]["label"],
            "is_current_blocker": dimension == next_dimension,
            "pmw_product_advice": PMW_PRODUCT_ADVICE[dimension],
            "pmw_ia_advice": PMW_IA_ADVICE[dimension],
            "product_homework": PRODUCT_HOMEWORK[dimension],
        }
        for dimension in missing
    ]
    if not missing and not decision_ready and needs_decisions:
        missing_labels = [f"方向性 D 不足（{decision_count}/{args.min_decisions}）"]
        gap_queue_items = [
            {
                "dimension": "directional_decision",
                "label": missing_labels[0],
                "is_current_blocker": True,
                "pmw_product_advice": D_PRODUCT_ADVICE,
                "pmw_ia_advice": D_IA_ADVICE,
                "product_homework": D_HOMEWORK,
            }
        ]
    elif missing and not decision_ready and needs_decisions:
        d_label = f"方向性 D 不足（{decision_count}/{args.min_decisions}）"
        missing_labels.append(d_label)
        gap_queue_items.append(
            {
                "dimension": "directional_decision",
                "label": d_label,
                "is_current_blocker": False,
                "pmw_product_advice": D_PRODUCT_ADVICE,
                "pmw_ia_advice": D_IA_ADVICE,
                "product_homework": D_HOMEWORK,
            }
        )
    if baseline["online_baseline_missing"] or baseline["competitor_baseline_missing"]:
        homework_parts = []
        if baseline["online_baseline_missing"]:
            homework_parts.append(ONLINE_BASELINE_HOMEWORK)
        if baseline["competitor_baseline_missing"]:
            homework_parts.append(COMPETITOR_BASELINE_HOMEWORK)
        baseline_item = {
            "dimension": "online_competitor_baseline",
            "label": "线上 / 竞品基线",
            "is_current_blocker": bool(baseline["baseline_blocks_target"] or not gap_queue_items),
            "pmw_product_advice": BASELINE_PRODUCT_ADVICE,
            "pmw_ia_advice": BASELINE_IA_ADVICE,
            "product_homework": " ".join(homework_parts),
        }
        if baseline_item["is_current_blocker"]:
            for item in gap_queue_items:
                item["is_current_blocker"] = False
        gap_queue_items.insert(0, baseline_item)
        missing_labels.insert(0, baseline_item["label"])
    current_item = gap_queue_items[0] if gap_queue_items else {}
    payload = {
        "checked_at": now(),
        "run_id": run_id,
        "target": args.target,
        "verdict": "passed" if passed else "blocked",
        "passed": passed,
        "covered_dimensions": {
            dimension: {"label": DIMENSIONS[dimension]["label"], "sources": sources}
            for dimension, sources in covered.items()
            if sources
        },
        "missing_dimensions": [
            {"dimension": dimension, "label": DIMENSIONS[dimension]["label"]}
            for dimension in missing
        ],
        "directional_decisions_count": decision_count,
        "required_directional_decisions": args.min_decisions if needs_decisions else 0,
        "d_exemption": d_exemption,
        "next_question": next_question,
        "current_blocker": current_item.get("label", ""),
        "gap_queue": missing_labels,
        "gap_queue_items": gap_queue_items,
        "product_homework": current_item.get("product_homework", ""),
        "product_homework_queue": [item["product_homework"] for item in gap_queue_items],
        "pmw_product_advice": current_item.get("pmw_product_advice", ""),
        "pmw_product_advice_queue": [item["pmw_product_advice"] for item in gap_queue_items],
        "pmw_ia_advice": current_item.get("pmw_ia_advice", ""),
        "pmw_ia_advice_queue": [item["pmw_ia_advice"] for item in gap_queue_items],
        "pmw_advice": current_item.get("pmw_product_advice", ""),
    }
    payload.update(baseline)
    return payload


def render_markdown(payload: dict) -> str:
    covered = payload["covered_dimensions"]
    missing = payload["missing_dimensions"]
    lines = [
        "# PMWorkspace 产品发现门槛",
        "",
        f"- Verdict：{'通过' if payload['passed'] else '阻断'}（{payload['verdict']}）",
        f"- 当前 run：{payload['run_id'] or '暂无'}",
        f"- 方向性 D：{payload['directional_decisions_count']} / {payload['required_directional_decisions']}",
        f"- 线上参考：{payload.get('online_baseline_status', '不适用')}",
        f"- 竞品参考：{payload.get('competitor_baseline_status', '不适用')}",
        "",
        "## 已覆盖维度",
    ]
    if covered:
        for item in covered.values():
            lines.append(f"- {item['label']}：{', '.join(item['sources'])}")
    else:
        lines.append("- 暂无")
    lines.extend(["", "## 缺失维度"])
    if missing:
        for item in missing:
            lines.append(f"- {item['label']}")
    else:
        lines.append("- 无")
    queue = payload.get("gap_queue") or []
    queue_items = payload.get("gap_queue_items") or []
    lines.extend(["", "## 关键缺口队列"])
    if queue_items:
        for item in queue_items:
            marker = "当前主阻断" if item.get("is_current_blocker") else "后续缺口"
            lines.append(f"- {item.get('label', '')}（{marker}）")
    elif queue:
        for item in queue:
            lines.append(f"- {item}")
    else:
        lines.append("- 无")
    if queue_items:
        lines.extend(["", "## PMW 产品建议"])
        for item in queue_items:
            lines.append(f"- {item.get('label', '')}：{item.get('pmw_product_advice', '')}")
        lines.extend(["", "## PMW 信息架构建议"])
        for item in queue_items:
            lines.append(f"- {item.get('label', '')}：{item.get('pmw_ia_advice', '')}")
        lines.extend(["", "## 产品作业队列"])
        for item in queue_items:
            lines.append(f"- {item.get('label', '')}：{item.get('product_homework', '')}")
    else:
        if payload.get("pmw_product_advice") or payload.get("pmw_advice"):
            lines.extend(["", "## PMW 产品建议", f"- {payload.get('pmw_product_advice') or payload.get('pmw_advice')}"])
        if payload.get("pmw_ia_advice"):
            lines.extend(["", "## PMW 信息架构建议", f"- {payload['pmw_ia_advice']}"])
        if payload.get("product_homework"):
            lines.extend(["", "## 产品作业队列", f"- {payload['product_homework']}"])
    if payload.get("next_question"):
        lines.extend(["", "## 下一轮", f"- {payload['next_question']}"])
    lines.append("")
    return "\n".join(lines)


def command_check(args: argparse.Namespace) -> int:
    payload = build_payload(args)
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print(render_markdown(payload), end="")
    return 0 if payload["passed"] else 2


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pmw-discovery-gate")
    sub = parser.add_subparsers(dest="command", required=True)
    check = sub.add_parser("check")
    check.add_argument("--target", choices=["brief", "alignment", "prototype"], default="brief")
    check.add_argument("--brief", default="")
    check.add_argument("--run", default="")
    check.add_argument("--min-decisions", type=int, default=2)
    check.add_argument("--allow-d-exemption", action="store_true")
    check.add_argument("--json", action="store_true")
    check.set_defaults(func=command_check)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
