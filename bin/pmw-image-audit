#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import math
import os
import pathlib
import re
import struct
import subprocess
import sys
from typing import Optional


SCRIPT_DIR = pathlib.Path(__file__).resolve().parent
STATE_DIR = pathlib.Path(os.environ.get("PMW_HOME", str(pathlib.Path.home() / ".pmworkspace"))).expanduser()


class ImageSizeError(RuntimeError):
    pass


def read_size(path_value: str) -> tuple[int, int]:
    path = pathlib.Path(path_value).expanduser()
    data = path.read_bytes()
    if data.startswith(b"\x89PNG\r\n\x1a\n") and len(data) >= 24:
        width, height = struct.unpack(">II", data[16:24])
        return int(width), int(height)
    if data[:3] == b"GIF" and len(data) >= 10:
        width, height = struct.unpack("<HH", data[6:10])
        return int(width), int(height)
    if data.startswith(b"BM") and len(data) >= 26:
        width, height = struct.unpack("<ii", data[18:26])
        return int(abs(width)), int(abs(height))
    if data.startswith(b"\xff\xd8"):
        return jpeg_size(data)
    if data.startswith(b"RIFF") and data[8:12] == b"WEBP":
        return webp_size(data)
    raise ImageSizeError(f"无法读取图片尺寸：{path}")


def jpeg_size(data: bytes) -> tuple[int, int]:
    offset = 2
    while offset < len(data):
        if data[offset] != 0xFF:
            offset += 1
            continue
        while offset < len(data) and data[offset] == 0xFF:
            offset += 1
        if offset >= len(data):
            break
        marker = data[offset]
        offset += 1
        if marker in {0xD8, 0xD9, 0x01} or 0xD0 <= marker <= 0xD7:
            continue
        if offset + 2 > len(data):
            break
        segment_length = struct.unpack(">H", data[offset : offset + 2])[0]
        if segment_length < 2:
            break
        segment_start = offset + 2
        segment_end = offset + segment_length
        if marker in {
            0xC0,
            0xC1,
            0xC2,
            0xC3,
            0xC5,
            0xC6,
            0xC7,
            0xC9,
            0xCA,
            0xCB,
            0xCD,
            0xCE,
            0xCF,
        }:
            if segment_start + 5 > len(data):
                break
            height, width = struct.unpack(">HH", data[segment_start + 1 : segment_start + 5])
            return int(width), int(height)
        offset = segment_end
    raise ImageSizeError("无法读取 JPEG 尺寸")


def webp_size(data: bytes) -> tuple[int, int]:
    chunk = data[12:16]
    if chunk == b"VP8X" and len(data) >= 30:
        width = 1 + int.from_bytes(data[24:27], "little")
        height = 1 + int.from_bytes(data[27:30], "little")
        return width, height
    if chunk == b"VP8L" and len(data) >= 25:
        bits = int.from_bytes(data[21:25], "little")
        width = (bits & 0x3FFF) + 1
        height = ((bits >> 14) & 0x3FFF) + 1
        return width, height
    if chunk == b"VP8 " and len(data) >= 30:
        start = data.find(b"\x9d\x01\x2a", 20)
        if start != -1 and start + 7 <= len(data):
            width, height = struct.unpack("<HH", data[start + 3 : start + 7])
            return int(width & 0x3FFF), int(height & 0x3FFF)
    raise ImageSizeError("无法读取 WebP 尺寸")


def scaled_height(reference_width: int, reference_height: int, target_width: int) -> int:
    if reference_width <= 0:
        return reference_height
    return int(math.ceil(reference_height * (target_width / reference_width)))


def fmt_px(width: int, height: int) -> str:
    return f"{width} x {height}"


def current_slug() -> str:
    env_slug = os.environ.get("PMW_PROJECT_SLUG")
    if env_slug:
        return env_slug
    try:
        return subprocess.check_output([str(SCRIPT_DIR / "pmw-slug")], text=True).strip()
    except Exception:
        return "local-project"


def read_jsonl(path: pathlib.Path) -> list[dict]:
    rows: list[dict] = []
    if not path.exists():
        return rows
    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
        try:
            value = json.loads(line)
        except Exception:
            continue
        if isinstance(value, dict):
            rows.append(value)
    return rows


def latest_visual_baseline() -> dict:
    path = STATE_DIR / "projects" / current_slug() / "artifact-flow.jsonl"
    rows = [row for row in read_jsonl(path) if row.get("kind") == "visual_baseline"]
    return rows[-1] if rows else {}


def same_path(left: str, right: str) -> bool:
    if not left or not right:
        return False
    try:
        return pathlib.Path(left).expanduser().resolve() == pathlib.Path(right).expanduser().resolve()
    except Exception:
        return left == right


def parse_target_size(text: str) -> tuple[Optional[int], Optional[int]]:
    match = re.search(r"目标输出[^0-9]*(\d{3,5})\s*(?:x|X|×)\s*(?:>=\s*)?(\d{3,5})", text)
    if match:
        return int(match.group(1)), int(match.group(2))
    width_match = re.search(r"目标输出[^0-9]*(\d{3,5})\s*(?:px|像素|宽)", text)
    height_match = re.search(r"(?:高度|高)[^0-9]*(\d{3,5})\s*(?:px|像素)?", text)
    return (
        int(width_match.group(1)) if width_match else None,
        int(height_match.group(1)) if height_match else None,
    )


def register_visual_baseline(args: argparse.Namespace, reference_width: int, reference_height: int, target_width: int, target_height: int) -> int:
    summary = (
        f"参考图={args.reference}；参考尺寸={fmt_px(reference_width, reference_height)}；"
        f"逻辑宽度推断={args.logical_width}px；目标输出={fmt_px(target_width, target_height)}；"
        "优先级=线上截图高于 AutoDesign 泛化 token；"
        "字号/间距/组件密度=按参考截图的导航标题、车型标题、价格数字、CTA、标签、辅助文字和底部栏层级执行；"
        "约束=高度按内容自然增长，不压缩中文字体、图表坐标轴、卡片间距或底部 CTA。"
    )
    cmd = [
        str(SCRIPT_DIR / "pmw-artifact"),
        "add",
        "--kind",
        "visual_baseline",
        "--title",
        args.title,
        "--status",
        "已登记",
        "--source-skill",
        args.source_skill,
        "--path",
        args.reference,
        "--summary",
        summary,
        "--upstream",
        "browser_evidence",
        "--next-skill",
        "pm-prototype-shotgun,pm-prototype-review,pm-handoff",
    ]
    if args.run:
        cmd.extend(["--run", args.run])
    subprocess.check_call(cmd)
    return 0


def command_baseline(args: argparse.Namespace) -> int:
    reference_width, reference_height = read_size(args.reference)
    target_width = args.target_width or max(reference_width, args.preferred_width, args.logical_width * 3)
    target_height = args.target_height or scaled_height(reference_width, reference_height, target_width)
    payload = {
        "verdict": "已生成视觉基线",
        "reference": args.reference,
        "reference_width": reference_width,
        "reference_height": reference_height,
        "logical_width": args.logical_width,
        "target_width": target_width,
        "target_height": target_height,
        "priority": "线上截图高于 AutoDesign 泛化 token",
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print("# PMWorkspace 视觉基线")
        print("")
        print(f"- 参考图：{args.reference}")
        print(f"- 参考尺寸：{fmt_px(reference_width, reference_height)}")
        print(f"- 逻辑宽度推断：{args.logical_width}px")
        print(f"- 目标输出：{fmt_px(target_width, target_height)}")
        print("- 参考优先级：线上截图高于 AutoDesign 泛化 token")
        print("- 关键约束：高度按内容自然增长，不压缩中文字体、图表坐标轴、卡片间距或底部 CTA")
        print("")
    if args.register:
        return register_visual_baseline(args, reference_width, reference_height, target_width, target_height)
    return 0


def command_audit(args: argparse.Namespace) -> int:
    image_width, image_height = read_size(args.image)
    reference_width, reference_height = read_size(args.reference)
    baseline = latest_visual_baseline()
    baseline_reference = str(baseline.get("path") or "")
    if same_path(baseline_reference, args.reference):
        baseline_target_width, baseline_target_height = parse_target_size(str(baseline.get("summary") or ""))
    else:
        baseline_target_width, baseline_target_height = None, None
    target_width = args.target_width or baseline_target_width or reference_width
    target_height = args.target_height or (
        scaled_height(reference_width, reference_height, target_width) if args.target_width else reference_height
    )
    if not args.target_height and baseline_target_height:
        target_height = baseline_target_height
    width_threshold = max(reference_width * args.min_ratio, target_width * args.min_ratio)
    height_threshold = max(reference_height * args.min_ratio, target_height * args.min_ratio)
    failures: list[str] = []
    if image_width < width_threshold:
        failures.append(f"宽度 {image_width} < {target_width} * {args.min_ratio:g}")
    if image_height < height_threshold:
        failures.append(f"高度 {image_height} < {target_height} * {args.min_ratio:g}")
    verdict = "通过" if not failures else "需要重出"
    payload = {
        "verdict": verdict,
        "image": args.image,
        "reference": args.reference,
        "image_width": image_width,
        "image_height": image_height,
        "reference_width": reference_width,
        "reference_height": reference_height,
        "target_width": target_width,
        "target_height": target_height,
        "min_ratio": args.min_ratio,
        "width_threshold": width_threshold,
        "height_threshold": height_threshold,
        "failures": failures,
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print("# PMWorkspace 图片视觉审计")
        print("")
        print(f"- Verdict：{verdict}")
        print(f"- 生成图：{fmt_px(image_width, image_height)}｜{args.image}")
        print(f"- 参考图：{fmt_px(reference_width, reference_height)}｜{args.reference}")
        print(f"- 目标输出：{fmt_px(target_width, target_height)}")
        print(f"- 尺寸门槛：宽度 >= {target_width} * {args.min_ratio:g}；高度 >= {target_height} * {args.min_ratio:g}")
        if failures:
            print(f"- 原因：{'；'.join(failures)}")
        else:
            print("- 原因：尺寸达到参考长板基线，进入 AutoDesign 专家复审")
        print("")
        print("| 项目 | 生成图 | 参考/目标 | 门槛 | 结论 |")
        print("|---|---|---|---|---|")
        width_result = "通过" if image_width >= width_threshold else "失败"
        height_result = "通过" if image_height >= height_threshold else "失败"
        print(f"| 宽度 | {image_width} | {target_width} | >= {target_width} * {args.min_ratio:g} | {width_result} |")
        print(f"| 高度 | {image_height} | {target_height} | >= {target_height} * {args.min_ratio:g} | {height_result} |")
        print("")
    return 0 if verdict == "通过" else 2


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pmw-image-audit")
    sub = parser.add_subparsers(dest="command", required=True)

    baseline = sub.add_parser("baseline")
    baseline.add_argument("--reference", required=True)
    baseline.add_argument("--logical-width", type=int, default=402)
    baseline.add_argument("--preferred-width", type=int, default=1206)
    baseline.add_argument("--target-width", type=int)
    baseline.add_argument("--target-height", type=int)
    baseline.add_argument("--title", default="线上截图视觉基线")
    baseline.add_argument("--source-skill", default="pm-brief")
    baseline.add_argument("--run", default="")
    baseline.add_argument("--register", action="store_true")
    baseline.add_argument("--json", action="store_true")
    baseline.set_defaults(func=command_baseline)

    audit = sub.add_parser("audit")
    audit.add_argument("--image", required=True)
    audit.add_argument("--reference", required=True)
    audit.add_argument("--target-width", type=int)
    audit.add_argument("--target-height", type=int)
    audit.add_argument("--min-ratio", type=float, default=float(os.environ.get("PMW_IMAGE_AUDIT_MIN_RATIO", "0.95")))
    audit.add_argument("--json", action="store_true")
    audit.set_defaults(func=command_audit)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        return args.func(args)
    except (OSError, ImageSizeError, subprocess.CalledProcessError) as exc:
        print(f"pmw-image-audit: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
