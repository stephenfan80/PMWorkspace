#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import subprocess
import sys
from datetime import datetime, timezone
from typing import Any

import pmw_runtime as rt


SCRIPT_DIR = pathlib.Path(__file__).resolve().parent
STATE_DIR = pathlib.Path(os.environ.get("PMW_HOME", str(pathlib.Path.home() / ".pmworkspace"))).expanduser()


def current_slug() -> str:
    env_slug = os.environ.get("PMW_PROJECT_SLUG", "").strip()
    if env_slug:
        return env_slug
    try:
        return subprocess.check_output([str(SCRIPT_DIR / "pmw-slug")], text=True).strip()
    except Exception:
        return "local-project"


def project_dir() -> pathlib.Path:
    return STATE_DIR / "projects" / current_slug()


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_json(path: pathlib.Path) -> dict[str, Any]:
    if not path.exists():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def read_jsonl(path: pathlib.Path) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    if not path.exists():
        return rows
    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
        try:
            value = json.loads(line)
        except Exception:
            continue
        if isinstance(value, dict):
            rows.append(value)
    return rows


def append_jsonl(path: pathlib.Path, row: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")


def current_board_items(project: dict[str, Any], run_id: str = "") -> list[dict[str, Any]]:
    context = rt.resolve_context(project, run_id or None)
    rows = [row for row in read_jsonl(project_dir() / "prototype-board.jsonl") if row.get("record_type", "item") == "item"]
    scoped = []
    for row in rows:
        if rt.row_matches_context(row, context):
            scoped.append(row)
    return scoped


def current_board_item(project: dict[str, Any], scheme: str, screen: str, run_id: str = "") -> dict[str, Any]:
    for row in reversed(current_board_items(project, run_id)):
        if row.get("scheme") == scheme and row.get("screen") == screen:
            return row
    return {}


def permit_rows() -> list[dict[str, Any]]:
    return read_jsonl(project_dir() / "image-permits.jsonl")


def permit_used(permit_id: str) -> bool:
    for row in permit_rows():
        if row.get("record_type") == "permit_use" and row.get("image_permit_id") == permit_id:
            return True
    return False


def validate_permit(project: dict[str, Any], permit_id: str, scheme: str, screen: str) -> tuple[bool, str, dict[str, Any]]:
    if not permit_id:
        return False, "IMAGEGEN_BLOCKED_BEFORE_PERMIT: 缺少 image_permit_id；不能写 image-2 prompt 或调用 imagegen。", {}
    matches = [row for row in permit_rows() if row.get("record_type") == "permit" and row.get("image_permit_id") == permit_id]
    if not matches:
        return False, "IMAGEGEN_BLOCKED_BEFORE_PERMIT: image_permit_id 不存在或不属于当前项目。", {}
    permit = matches[-1]
    if permit_used(permit_id):
        return False, "IMAGEGEN_BLOCKED_BEFORE_PERMIT: image_permit_id 已使用；每张图必须重新签发。", permit
    context = rt.resolve_context(project, str(permit.get("run_id") or project.get("current_run_id") or ""))
    expected = {
        "run_id": context.get("run_id", ""),
        "task_digest": context.get("task_digest", ""),
        "input_revision": context.get("input_revision", ""),
        "scheme": scheme,
        "screen": screen,
    }
    operation = rt.latest_operation(project, "prototype_revision")
    if operation and permit.get("operation_id"):
        expected["operation_id"] = str(operation.get("operation_id") or "")
    for key, value in expected.items():
        if value and str(permit.get(key) or "") != str(value):
            return False, f"IMAGEGEN_BLOCKED_BEFORE_PERMIT: image_permit_id 与当前 {key} 不匹配。", permit
    return True, "", permit


def controller_preflight(run_id: str = "") -> tuple[int, dict[str, Any], str]:
    if run_id:
        command = [str(SCRIPT_DIR / "pmw-dashboard"), "readiness", "--target", "prototype", "--run", run_id, "--json"]
    else:
        command = [str(SCRIPT_DIR / "pmw-controller"), "preflight", "--target", "prototype", "--json"]
    result = subprocess.run(
        command,
        text=True,
        capture_output=True,
        check=False,
    )
    try:
        payload = json.loads(result.stdout)
    except Exception:
        payload = {"ready": False, "reason": result.stdout or result.stderr or "controller preflight failed"}
    return result.returncode, payload if isinstance(payload, dict) else {}, result.stderr


def operation_preflight(project: dict[str, Any], run_id: str = "") -> dict[str, Any]:
    operation = rt.latest_operation(project, "prototype_revision")
    if not operation:
        return {}
    context = rt.resolve_context(project, run_id or None)
    failures: list[str] = []
    if not rt.operation_matches_context(operation, context):
        failures.append("OPERATION_PERMIT_MISMATCH: 当前 operation 与 run/task/revision 不匹配")
    if str(operation.get("operation_status") or "") != "ready_for_image_permit":
        failures.append("OPERATION_NOT_READY: 当前 operation 还没有 ready_for_image_permit")
    if not str(operation.get("source_image") or "").strip():
        failures.append("OPERATION_SOURCE_IMAGE_REQUIRED: 缺 source_image")
    if not str(operation.get("edit_scope") or "").strip():
        failures.append("OPERATION_EDIT_SCOPE_REQUIRED: 缺 edit_scope")
    if not str(operation.get("preserve_scope") or "").strip():
        failures.append("OPERATION_PRESERVE_SCOPE_REQUIRED: 缺 preserve_scope")
    if operation.get("boundary_change"):
        failures.append("OPERATION_BOUNDARY_CHANGE_REQUIRES_BRIEF_RELOCK: 产品承诺或范围变化必须回到 brief relock")
    lock = rt.latest_brief_lock(project)
    if not rt.brief_lock_is_locked(lock):
        failures.append("OPERATION_CONTEXT_MISSING: 缺 locked brief")
    inherited = operation.get("inherited_context") if isinstance(operation.get("inherited_context"), dict) else {}
    if not str(inherited.get("design_spec_target") or project.get("design_spec_target") or "").strip():
        failures.append("OPERATION_CONTEXT_MISSING: 缺 design_spec")
    expected_units = rt.operation_expected_units(operation, 1)
    return {
        "operation_mode": True,
        "ready": not failures,
        "verdict": "ALLOW_IMAGE_PROMPT" if not failures else "BLOCKED",
        "first_blocker": failures[0] if failures else "",
        "failures": failures,
        "output_units": expected_units,
        "expected_output_units": expected_units,
        "image_output_mode": "prototype_revision",
        "image_output_mode_label": "原型局部修改",
        "operation_id": operation.get("operation_id", ""),
        "operation_type": operation.get("operation_type", ""),
        "variant_roles": rt.operation_variant_roles(operation),
        "source_image": operation.get("source_image", ""),
        "edit_scope": operation.get("edit_scope", ""),
        "preserve_scope": operation.get("preserve_scope", ""),
        "run_id": context.get("run_id", ""),
        "task_digest": context.get("task_digest", ""),
        "input_revision": context.get("input_revision", ""),
    }


def evaluate_preflight(project: dict[str, Any], run_id: str = "") -> dict[str, Any]:
    project = read_json(project_dir() / "project.json")
    context = rt.resolve_context(project, run_id or None)
    operation_payload = operation_preflight(project, run_id)
    if operation_payload:
        return operation_payload
    exit_code, payload, stderr = controller_preflight(run_id)
    items = current_board_items(project, run_id)
    lock = rt.latest_brief_lock(project)
    image_output_mode = rt.image_output_mode_from_lock(lock)
    expected_units = rt.expected_output_units(image_output_mode)
    mode_label = rt.image_output_mode_label(image_output_mode)
    failures = []
    if exit_code != 0 or not payload.get("ready"):
        failures.append(str(payload.get("reason") or stderr or "prototype preflight blocked"))
    if not items:
        failures.append("当前 run 没有已绑定 prototype-board 输出单元")
    if len(items) < expected_units:
        failures.append(f"{mode_label} 要求 {expected_units} 个完整页面输出单元；当前只有 {len(items)} 个。只有 brief_lock.image_output_mode=single_page_confirmed 才允许 1 个页面。")
    allowed = not failures
    return {
        "ready": allowed,
        "verdict": "ALLOW_IMAGE_PROMPT" if allowed else "BLOCKED",
        "first_blocker": failures[0] if failures else "",
        "failures": failures,
        "output_units": len(items),
        "expected_output_units": expected_units,
        "image_output_mode": image_output_mode,
        "image_output_mode_label": mode_label,
        "run_id": context.get("run_id", ""),
        "task_digest": context.get("task_digest", ""),
        "input_revision": context.get("input_revision", ""),
        "diagnostics": payload.get("diagnostics", {}),
    }


def command_check(args: argparse.Namespace) -> int:
    project = read_json(project_dir() / "project.json")
    result_payload = evaluate_preflight(project, args.run)
    print(json.dumps(result_payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else result_payload["verdict"])
    return 0 if result_payload["ready"] else 2


def command_issue_permit(args: argparse.Namespace) -> int:
    project = read_json(project_dir() / "project.json")
    context = rt.resolve_context(project, args.run or None)
    result_payload = evaluate_preflight(project, args.run)
    item = current_board_item(project, args.scheme, args.screen, args.run)
    operation_mode = bool(result_payload.get("operation_mode"))
    failures = list(result_payload.get("failures") or [])
    if not item and not operation_mode:
        failures.append("当前 run / task revision 没有匹配的 prototype-board 输出单元，不能签发图片许可证")
    if failures:
        blocked = {
            **result_payload,
            "ready": False,
            "verdict": "BLOCKED",
            "first_blocker": failures[0],
            "failures": failures,
            "scheme": args.scheme,
            "screen": args.screen,
        }
        print(json.dumps(blocked, ensure_ascii=False, indent=2, sort_keys=True) if args.json else "BLOCKED")
        return 2
    seed = "|".join(
        [
            now(),
            str(context.get("run_id") or ""),
            str(context.get("task_digest") or ""),
            str(context.get("input_revision") or ""),
            args.scheme,
            args.screen,
        ]
    )
    permit_id = "imgp_" + hashlib.sha256(seed.encode("utf-8")).hexdigest()[:20]
    row = {
        "ts": now(),
        "record_type": "permit",
        "image_permit_id": permit_id,
        "run_id": context.get("run_id", ""),
        "task_digest": context.get("task_digest", ""),
        "input_revision": context.get("input_revision", ""),
        "scheme": args.scheme,
        "screen": args.screen,
        "operation_id": result_payload.get("operation_id", ""),
        "operation_type": result_payload.get("operation_type", ""),
        "output_mode": (item.get("output_mode") if item else "") or result_payload.get("image_output_mode", ""),
        "page_variant_role": (item.get("page_variant_role") if item else "") or args.screen,
        "experiment_hypothesis": (item.get("experiment_hypothesis") if item else "") or result_payload.get("edit_scope", ""),
        "brief_version": (item.get("brief_version") if item else "") or project.get("latest_brief_version", ""),
        "design_spec_target": (item.get("design_spec_target") if item else "") or project.get("design_spec_target", ""),
        "task_digest_source": "operation" if operation_mode else "current_revision",
        "status": "issued",
        "expires_after_use": True,
    }
    append_jsonl(project_dir() / "image-permits.jsonl", row)
    payload = {
        "ready": True,
        "verdict": "IMAGE_PERMIT_ISSUED",
        **row,
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else permit_id)
    return 0


def command_assert_imagegen(args: argparse.Namespace) -> int:
    project = read_json(project_dir() / "project.json")
    result_payload = evaluate_preflight(project, args.run)
    item = current_board_item(project, args.scheme, args.screen, args.run)
    operation_mode = bool(result_payload.get("operation_mode"))
    failures = list(result_payload.get("failures") or [])
    if not item and not operation_mode:
        failures.append("当前 run / task revision 没有匹配的 prototype-board 输出单元，不能写 image-2 prompt 或调用 imagegen")
    permit_ok, permit_error, permit = validate_permit(project, args.image_permit_id, args.scheme, args.screen)
    if not permit_ok:
        failures.append(permit_error)
    ready = not failures
    payload = {
        **result_payload,
        "ready": ready,
        "verdict": "IMAGEGEN_ALLOWED" if ready else "IMAGEGEN_BLOCKED_BEFORE_PERMIT",
        "first_blocker": failures[0] if failures else "",
        "failures": failures,
        "scheme": args.scheme,
        "screen": args.screen,
        "image_permit_id": args.image_permit_id,
        "permit": permit if ready else {},
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else payload["verdict"])
    return 0 if ready else 2


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pmw-image-preflight")
    sub = parser.add_subparsers(dest="command", required=True)
    check = sub.add_parser("check")
    check.add_argument("--run", default="")
    check.add_argument("--json", action="store_true")
    check.set_defaults(func=command_check)
    permit = sub.add_parser("issue-permit")
    permit.add_argument("--scheme", required=True)
    permit.add_argument("--screen", required=True)
    permit.add_argument("--run", default="")
    permit.add_argument("--json", action="store_true")
    permit.set_defaults(func=command_issue_permit)
    assert_imagegen = sub.add_parser("assert-imagegen")
    assert_imagegen.add_argument("--scheme", required=True)
    assert_imagegen.add_argument("--screen", required=True)
    assert_imagegen.add_argument("--image-permit-id", default="")
    assert_imagegen.add_argument("--run", default="")
    assert_imagegen.add_argument("--json", action="store_true")
    assert_imagegen.set_defaults(func=command_assert_imagegen)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
