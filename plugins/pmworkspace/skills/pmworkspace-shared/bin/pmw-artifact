#!/usr/bin/env python3
from __future__ import annotations
import argparse
import json
import os
import pathlib
import re
import subprocess
import uuid
from datetime import datetime, timezone
from typing import Optional


SCRIPT_DIR = pathlib.Path(__file__).resolve().parent
STATE_DIR = pathlib.Path(os.environ.get("PMW_HOME", str(pathlib.Path.home() / ".pmworkspace"))).expanduser()
PROJECT_OVERRIDE = ""


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def now_fragment() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def current_slug() -> str:
    if PROJECT_OVERRIDE:
        return PROJECT_OVERRIDE
    env_slug = os.environ.get("PMW_PROJECT_SLUG")
    if env_slug:
        return env_slug
    try:
        return subprocess.check_output([str(SCRIPT_DIR / "pmw-slug")], text=True).strip()
    except Exception:
        return "local-project"


def project_dir() -> pathlib.Path:
    return STATE_DIR / "projects" / current_slug()


def projects_root() -> pathlib.Path:
    return STATE_DIR / "projects"


def resolve_project_identifier(value: str) -> str:
    cleaned = (value or "").strip()
    if not cleaned:
        return ""
    if (projects_root() / cleaned / "project.json").exists():
        return cleaned
    for path in sorted(projects_root().glob("*/project.json")):
        data = read_json(path)
        if cleaned in {str(data.get("slug") or path.parent.name), str(data.get("display_name") or "")}:
            return str(data.get("slug") or path.parent.name)
    return cleaned


def artifact_log() -> pathlib.Path:
    return project_dir() / "artifact-flow.jsonl"


def read_json(path: pathlib.Path) -> dict:
    if not path.exists():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def read_jsonl(path: pathlib.Path) -> list[dict]:
    rows: list[dict] = []
    if not path.exists():
        return rows
    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
        try:
            value = json.loads(line)
        except Exception:
            continue
        if isinstance(value, dict):
            rows.append(value)
    return rows


def redact_sensitive(value: Optional[str]) -> str:
    if not value:
        return ""
    text = str(value)
    text = re.sub(r"(token=)[^&\s]+", r"\1[redacted]", text)
    text = re.sub(r"(ownerSecret[=: ]*)[^&\s]+", r"\1[redacted]", text)
    text = re.sub(r"(Authorization: Bearer )[A-Za-z0-9._~+/=-]+", r"\1[redacted]", text)
    text = re.sub(r"(api[_-]?key[=: ]*)[^&\s]+", r"\1[redacted]", text, flags=re.I)
    return text


def slugify(value: str) -> str:
    text = re.sub(r"[^A-Za-z0-9._-]+", "-", value.strip().lower()).strip("-._")
    return text or "artifact"


def split_values(values: list[str]) -> list[str]:
    result: list[str] = []
    for value in values:
        for item in str(value).split(","):
            cleaned = item.strip()
            if cleaned:
                result.append(cleaned)
    return result


def current_run_id() -> str:
    project = read_json(project_dir() / "project.json")
    return str(project.get("current_run_id") or project.get("latest_run_id") or "")


def current_project() -> dict:
    return read_json(project_dir() / "project.json")


def current_task_context() -> tuple[str, str, str]:
    project = current_project()
    return (
        str(project.get("current_task_digest") or ""),
        str(project.get("current_input_revision") or ""),
        str(project.get("last_controller_verdict") or ""),
    )


def append_row(row: dict) -> None:
    path = artifact_log()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")


def status_is_nonformal(status: str) -> bool:
    return any(token in status for token in ["草稿", "待确认", "未对齐", "基于假设", "待补充"])


def event_is_confirmed(row: dict) -> bool:
    text = f"{row.get('status', '')} {row.get('summary', '')} {row.get('body', '')} {row.get('user_choice', '')}"
    positive = any(token in text for token in ["已对齐", "已确认", "已同意", "批准", "用户确认", "用户同意"])
    negative = any(token in text for token in ["待确认", "需要确认", "准备确认", "需要补充", "需要 PM 拍板", "不同意", "未确认"])
    return positive and not negative


def event_matches_current_task(row: dict) -> bool:
    digest, revision, _verdict = current_task_context()
    if not digest and not revision:
        return True
    return str(row.get("task_digest") or "") == digest and str(row.get("input_revision") or "") == revision


def run_has_brief_confirmation() -> bool:
    run_id = current_run_id()
    if not run_id:
        return False
    run_file = project_dir() / "runs" / f"{run_id}.jsonl"
    for row in read_jsonl(run_file):
        if row.get("event") not in {"gate", "decision"}:
            continue
        if not event_matches_current_task(row):
            continue
        title = str(row.get("title") or "")
        if ("产品简报确认" in title or "前提确认" in title) and event_is_confirmed(row):
            return True
    return False


def next_skills(args: argparse.Namespace) -> set[str]:
    result: set[str] = set()
    for value in args.next_skill:
        for item in str(value).split(","):
            cleaned = item.strip()
            if cleaned:
                result.add(cleaned)
    return result


def validate_nonformal_next_skill(kind: str, skills: set[str]) -> None:
    forbidden_by_kind = {
        "product_brief": {"pm-prototype-shotgun", "pm-handoff"},
        "prototype_manifest": {"pm-prototype-review"},
        "handoff": {"document-release", "ship", "qa"},
        "product_design_doc": {"document-release", "ship", "qa"},
    }
    forbidden = forbidden_by_kind.get(kind, set()) & skills
    if forbidden:
        raise SystemExit(
            "ARTIFACT_GATE_BLOCKED: 非正式产物不能指向正式下游："
            + ", ".join(sorted(forbidden))
        )


def dashboard_ready(target: str, expected: str) -> tuple[bool, str]:
    controller = SCRIPT_DIR / "pmw-controller"
    project = current_project()
    has_controller_task = bool(project.get("current_task_digest") or project.get("current_input_revision"))
    if has_controller_task and controller.exists() and os.access(controller, os.X_OK):
        command = [str(controller), "preflight", "--target", target, "--json"]
        result = subprocess.run(command, text=True, capture_output=True, check=False)
        try:
            payload = json.loads(result.stdout)
        except Exception:
            return False, result.stdout or result.stderr or "pmw-controller preflight returned non-json"
        if result.returncode == 0 and bool(payload.get("ready")):
            if target == "prototype" and not bool(payload.get("can_issue_image_permit")):
                return False, "controller can_issue_image_permit=false"
            if target == "handoff" and not bool(payload.get("can_handoff")):
                return False, "controller can_handoff=false"
            return True, ""
        reason = str(payload.get("reason") or payload.get("first_blocker") or result.stderr or "")
        next_action = str(payload.get("next_action") or payload.get("allowed_next_action") or "")
        return False, "；".join(part for part in [reason, next_action] if part)
    command = [str(SCRIPT_DIR / "pmw-dashboard"), "readiness", "--target", target, "--json"]
    result = subprocess.run(command, text=True, capture_output=True, check=False)
    if result.returncode != 0:
        return False, result.stderr or result.stdout or "pmw-dashboard readiness failed"
    try:
        payload = json.loads(result.stdout)
    except Exception:
        return False, result.stdout or "pmw-dashboard readiness returned non-json output"
    if bool(payload.get("ready")) and str(payload.get("verdict_cn") or "") == expected:
        return True, ""
    reason = str(payload.get("reason") or "")
    next_action = str(payload.get("next_action") or "")
    return False, "；".join(part for part in [reason, next_action] if part)


def controller_capability(capability: str) -> tuple[bool, str]:
    project = current_project()
    if not (project.get("current_task_digest") or project.get("current_input_revision")):
        return True, ""
    controller = SCRIPT_DIR / "pmw-controller"
    if not (controller.exists() and os.access(controller, os.X_OK)):
        return False, "缺少 pmw-controller"
    result = subprocess.run(
        [str(controller), "assert", "--capability", capability, "--json"],
        text=True,
        capture_output=True,
        check=False,
    )
    try:
        payload = json.loads(result.stdout)
    except Exception:
        return False, result.stdout or result.stderr or "pmw-controller assert returned non-json"
    if result.returncode == 0 and bool(payload.get("ok")):
        return True, ""
    return False, str(payload.get("reason") or payload.get("first_blocker") or result.stderr or "")


def discovery_gate_ready(brief_path: str) -> tuple[bool, str]:
    if not brief_path:
        return False, "缺少 brief path"
    command = [str(SCRIPT_DIR / "pmw-discovery-gate"), "check", "--target", "brief", "--brief", brief_path, "--json"]
    result = subprocess.run(command, text=True, capture_output=True, check=False)
    if result.returncode == 0:
        return True, ""
    return False, result.stdout or result.stderr or "pmw-discovery-gate blocked"


def validate_formal_artifact_gate(args: argparse.Namespace) -> None:
    kind = args.kind.strip()
    status = args.status.strip()
    if status_is_nonformal(status):
        validate_nonformal_next_skill(kind, next_skills(args))
        return
    if kind == "product_brief" and "已对齐" in status:
        ok, detail = controller_capability("write_brief")
        if not ok:
            raise SystemExit(f"ARTIFACT_GATE_BLOCKED: product_brief 声明已对齐，但 controller 未放行 can_write_brief。{detail}")
        if not run_has_brief_confirmation():
            raise SystemExit("ARTIFACT_GATE_BLOCKED: product_brief 声明已对齐，但当前 run 未记录产品简报确认 / 前提确认。")
        ok, detail = discovery_gate_ready(args.path)
        if not ok:
            raise SystemExit(f"ARTIFACT_GATE_BLOCKED: product_brief 声明已对齐，但产品发现门槛未通过。{detail}")
    readiness_targets = {
        "prototype_manifest": ("prototype", "可出图"),
        "handoff": ("handoff", "可交付"),
        "product_design_doc": ("handoff", "可交付"),
    }
    if kind in readiness_targets:
        target, expected = readiness_targets[kind]
        ok, detail = dashboard_ready(target, expected)
        if not ok:
            raise SystemExit(f"ARTIFACT_GATE_BLOCKED: {kind} 是正式产物，但 readiness 未达到「{expected}」。{detail}")


def md_cell(value: object) -> str:
    if isinstance(value, list):
        text = ", ".join(str(item) for item in value if str(item).strip())
    else:
        text = str(value or "")
    return redact_sensitive(text).replace("|", "/").replace("\n", " ").strip() or "未记录"


def location(row: dict) -> str:
    return str(row.get("url") or row.get("path") or "")


def command_add(args: argparse.Namespace) -> int:
    validate_formal_artifact_gate(args)
    run_id = args.run or current_run_id()
    task_digest, input_revision, controller_verdict = current_task_context()
    row = {
        "ts": now(),
        "artifact_id": f"{now_fragment()}-{slugify(args.kind)}-{uuid.uuid4().hex[:6]}",
        "kind": args.kind.strip(),
        "title": redact_sensitive(args.title.strip()),
        "status": redact_sensitive(args.status.strip()),
        "source_skill": args.source_skill.strip(),
        "path": redact_sensitive(args.path),
        "url": redact_sensitive(args.url),
        "summary": redact_sensitive(args.summary),
        "pm_judgment_summary": redact_sensitive(args.pm_judgment_summary),
        "product_homework": redact_sensitive(args.product_homework),
        "upstream": split_values(args.upstream),
        "next_skill": split_values(args.next_skill),
        "run_id": run_id,
        "task_digest": task_digest,
        "input_revision": input_revision,
        "controller_verdict": controller_verdict,
    }
    append_row(row)
    print(row["artifact_id"])
    return 0


def command_latest(args: argparse.Namespace) -> int:
    rows = read_jsonl(artifact_log())
    if args.kind:
        rows = [row for row in rows if row.get("kind") == args.kind]
    if not rows:
        return 1
    print(json.dumps(rows[-1], ensure_ascii=False, indent=2, sort_keys=True))
    return 0


def command_list(args: argparse.Namespace) -> int:
    rows = read_jsonl(artifact_log())
    if args.kind:
        rows = [row for row in rows if row.get("kind") == args.kind]
    rows = rows[-args.limit :]
    print("# PMWorkspace 产物流动清单")
    print("")
    if not rows:
        print("- 暂无产物流动记录")
        return 0
    print("| 时间 | 产物类型 | 状态 | 标题 | 来源 | 下游 | 位置 |")
    print("|---|---|---|---|---|---|---|")
    for row in rows:
        print(
            "| "
            + " | ".join(
                [
                    md_cell(row.get("ts")),
                    md_cell(row.get("kind")),
                    md_cell(row.get("status")),
                    md_cell(row.get("title")),
                    md_cell(row.get("source_skill")),
                    md_cell(row.get("next_skill")),
                    md_cell(location(row)),
                ]
            )
            + " |"
        )
    return 0


def command_flow(args: argparse.Namespace) -> int:
    rows = read_jsonl(artifact_log())
    latest = rows[-args.limit :]
    print("# PMWorkspace 产物流动清单")
    print("")
    print(f"- 项目：{current_slug()}")
    print(f"- 记录文件：{artifact_log()}")
    print(f"- 记录数：{len(rows)}")
    print("")
    if not args.details:
        if not latest:
            print("- 暂无产物流动记录")
            return 0
        last = latest[-1]
        print(f"- 最近产物：{md_cell(last.get('kind'))} / {md_cell(last.get('title'))}")
        print(f"- 状态：{md_cell(last.get('status'))}")
        print(f"- 下游：{md_cell(last.get('next_skill'))}")
        print("")
        print("需要完整产物流动表时，运行 `pmw-artifact flow --details`。")
        return 0
    if not latest:
        print("- 暂无产物流动记录")
        return 0
    print("| 时间 | 本轮产物 | 上游产物 | 下游可读 | 状态 | 位置 |")
    print("|---|---|---|---|---|---|")
    for row in latest:
        print(
            "| "
            + " | ".join(
                [
                    md_cell(row.get("ts")),
                    md_cell(f"{row.get('kind', '')} / {row.get('title', '')}"),
                    md_cell(row.get("upstream")),
                    md_cell(row.get("next_skill")),
                    md_cell(row.get("status")),
                    md_cell(location(row)),
                ]
            )
            + " |"
        )
    return 0


def main() -> int:
    global PROJECT_OVERRIDE
    parser = argparse.ArgumentParser(prog="pmw-artifact")
    parser.add_argument("--project")
    sub = parser.add_subparsers(dest="command", required=True)

    add = sub.add_parser("add")
    add.add_argument("--kind", required=True)
    add.add_argument("--title", required=True)
    add.add_argument("--status", required=True)
    add.add_argument("--source-skill", required=True)
    add.add_argument("--path", default="")
    add.add_argument("--url", default="")
    add.add_argument("--summary", default="")
    add.add_argument("--pm-judgment-summary", default="")
    add.add_argument("--product-homework", default="")
    add.add_argument("--upstream", action="append", default=[])
    add.add_argument("--next-skill", action="append", default=[])
    add.add_argument("--run", default="")

    latest = sub.add_parser("latest")
    latest.add_argument("--kind")

    list_cmd = sub.add_parser("list")
    list_cmd.add_argument("--kind")
    list_cmd.add_argument("--limit", type=int, default=12)

    flow = sub.add_parser("flow")
    flow.add_argument("--limit", type=int, default=12)
    flow.add_argument("--details", action="store_true")

    args = parser.parse_args()
    if args.project:
        PROJECT_OVERRIDE = resolve_project_identifier(args.project)
    if args.command == "add":
        return command_add(args)
    if args.command == "latest":
        return command_latest(args)
    if args.command == "list":
        return command_list(args)
    if args.command == "flow":
        return command_flow(args)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
