{
  "id": "p0-operation-router-prototype-revision-no-intake",
  "title": "P0：基于当前图修改不得重新 intake",
  "category": "pm-workspace-runtime",
  "primary_skill": "pm-prototype-shotgun",
  "prompt": "用户说“在这个图的基础上修改，不要改100元券的样式”时，router 必须识别为 prototype_revision。",
  "expected": {
    "mode": "maintenance",
    "status": "可检查",
    "must_stop": true,
    "gate": "edit contract",
    "required_behaviors": [
      "operation_type=prototype_revision",
      "context_policy=inherit_locked_context",
      "minimal_gate=edit_contract"
    ],
    "forbidden_behaviors": [
      "原型局部修改重新进入 goal_mode",
      "原型局部修改重新询问 AutoDesign",
      "原型局部修改运行 pmw-controller intake"
    ]
  },
  "contract_checks": [
    {
      "path": "bin/pmw-operation-router",
      "contains": "prototype_revision"
    }
  ],
  "command_checks": [
    {
      "command": [
        "bash",
        "-lc",
        "tmp=$(mktemp -d); export PMW_HOME=\"$tmp\" PMW_PROJECT_SLUG=router-revision; bin/pmw-operation-router classify --text '在这个图的基础上修改，不要改100元券的样式' --json"
      ],
      "exit_code": 0,
      "contains": [
        "\"operation_type\": \"prototype_revision\"",
        "\"context_policy\": \"inherit_locked_context\"",
        "\"minimal_gate\": \"edit_contract\"",
        "\"must_not_run_intake\": true"
      ],
      "not_contains": [
        "\"required_controller_command\": \"pmw-controller intake\""
      ]
    }
  ]
}
