        "重出失败图片并通过审计；之后才能作为交付结果展示。",
    ),
    "复审状态": (
        "缺复审会让策略、风险、设计系统或数据可行性问题直接进入交付稿。",
        "完成 $pm-prototype-review 并清掉重出 / 拍板 / 补参考项；之后才能交付。",
    ),
    "研发可行性反问": (
        "缺能力依赖审查会让数据、接口、算法、后台或合规前提被误写成验收承诺。",
        "在 $pm-handoff 建立功能能力与研发依赖表；普通缺口可待补充，关键缺口需 D 或退回策略审查。",
    ),
}

READINESS_GUIDANCE_REQUIRED_GATES = tuple(READINESS_GATE_GUIDANCE)


def missing_guidance_for_rows(rows: list[dict]) -> list[str]:
    return sorted({str(row.get("name") or "") for row in rows if row.get("required") and row.get("name") not in READINESS_GATE_GUIDANCE})


def blocker_guidance(row: Optional[dict], target: str) -> tuple[str, str]:
    if not row:
        return "关键门槛已通过，当前证据足以支撑下一步判断。", "继续进入下一步。"
    name = str(row.get("name") or "")
    action = str(row.get("action") or "")
    default_unlock = action or ("继续进入下一步" if target == "prototype" else "继续进入交付")
    return READINESS_GATE_GUIDANCE.get(name, (f"{name} 未通过会影响当前产品判断能否继续。", default_unlock))


def readiness_verdict(project: dict, events: list[dict], target: str) -> tuple[str, str, str, str, str, str, list[dict]]:
    effective_target = auto_readiness_target(project, events) if target == "auto" else target
    rows = product_readiness_rows(project, events, effective_target)
    blockers = [row for row in rows if row["required"] and not row["passed"]]
    if blockers:
        verdict_cn = "不可出图" if effective_target == "prototype" else "不可交付"
        next_action = blockers[0]["action"]
        reason = f"{blockers[0]['name']}：{blockers[0]['status']}"
        impact, unlock = blocker_guidance(blockers[0], effective_target)
    else:
        verdict_cn = "可出图" if effective_target == "prototype" else "可交付"
        next_action = "继续进入下一步"
        reason = "关键门槛已通过"
        impact, unlock = blocker_guidance(None, effective_target)
    return effective_target, verdict_cn, reason, impact, unlock, next_action, rows


def context_diagnostics(root: pathlib.Path, project: dict, run_id: str, target: str, rows: list[dict]) -> dict:
    context = ACTIVE_CONTEXT or rt.resolve_context(project, run_id or None)
    first_blocker = next((row for row in rows if row.get("required") and not row.get("passed")), {})
    candidate_rows: list[dict] = []
    for kind in ["product_brief", "visual_baseline", "browser_evidence", "prototype_manifest", "prototype_review"]:
        for row in artifact_rows(root, kind)[-20:]:
            status = rt.row_context_status(row, context)
            if status == "current_artifact":
                continue
            candidate_rows.append(
                {
                    "source": "artifact-flow",
                    "kind": kind,
                    "title": row.get("title", ""),
                    "run_id": row.get("run_id", ""),
                    "task_digest": row.get("task_digest", ""),
                    "input_revision": row.get("input_revision", ""),
                    "context_status": status,
                    "location": artifact_location(row),
                }
            )
    for row in read_jsonl(root / "prototype-board.jsonl")[-30:]:
        if row.get("record_type", "item") != "item":
            continue
        status = rt.row_context_status(row, context)
        if status == "current_artifact":
            continue
        candidate_rows.append(
            {
                "source": "prototype-board",
                "kind": "prototype_unit",
                "title": f"{row.get('scheme', '')} / {row.get('screen', '')}",
                "run_id": row.get("run_id", ""),
                "task_digest": row.get("task_digest", ""),
                "input_revision": row.get("input_revision", ""),
                "context_status": status,
                "location": row.get("brief_path", ""),
            }
        )
    blocker_name = str(first_blocker.get("name") or "")
    if "产品简报" in blocker_name:
        recovery = "pmw-controller lock-brief --brief-path <current-brief.md> --brief-version <vN> --user-confirmed true --summary <用户确认候选简报没有问题> --json"
    elif "视觉基线" in blocker_name or "线上参考" in blocker_name:
        recovery = "pmw-artifact add --kind visual_baseline --status 已登记 --summary '<目标输出像素和基线边界>' --run <run_id>"
    elif "方案" in blocker_name or "输出单元" in blocker_name:
        recovery = "pmw-prototype-board add ... --run <run_id>"
    else:
        recovery = str(first_blocker.get("action") or "返回当前最早门槛")
    mismatch_matrix = []
    expected = {
        "run_id": context.get("run_id", ""),
        "task_digest": context.get("task_digest", ""),
        "input_revision": context.get("input_revision", ""),
    }
    for candidate in candidate_rows[:20]:
        mismatch_matrix.append(
            {
                "source": candidate.get("source"),
                "title": candidate.get("title"),
                "context_status": candidate.get("context_status"),
                "run_id_match": str(candidate.get("run_id") or "") == expected["run_id"],
                "task_digest_match": str(candidate.get("task_digest") or "") == expected["task_digest"],
                "input_revision_match": str(candidate.get("input_revision") or "") == expected["input_revision"],
            }
        )
    return {
        "expected_context": expected,
        "context_source": context.get("context_source", ""),
        "legacy_context_status": context.get("legacy_context_status", ""),
        "first_blocker_fingerprint": rt.fingerprint([target, first_blocker.get("name", ""), first_blocker.get("status", ""), expected]),
        "first_blocker": first_blocker,
        "candidate_context": candidate_rows[:20],
        "mismatch_matrix": mismatch_matrix,
        "recommended_recovery_command": recovery,
    }


def trim_clause(value: str) -> str:
    return str(value or "").strip().rstrip("。；;.")


def render_readiness_summary(run_id: Optional[str], target: str = "auto") -> str:
    global ACTIVE_CONTEXT
    project = read_json(project_dir() / "project.json")
    chosen_run, events = read_run(run_id)
    ACTIVE_CONTEXT = rt.resolve_context(project, chosen_run if run_id else None)
    effective_target, verdict_cn, reason, impact, unlock, next_action, _rows = readiness_verdict(project, events, target)
    value_label = "判断价值" if verdict_cn in {"可出图", "可交付"} else "阻断影响"
    reason = trim_clause(reason)
    impact = trim_clause(impact)
    unlock = trim_clause(unlock)
    next_action = trim_clause(next_action)
    line = (
        f"产品准备度结论：{verdict_cn}（{readiness_target_label(effective_target)}）。"
        f"{'关键门槛已通过' if verdict_cn in {'可出图', '可交付'} else f'卡在「{reason}」'}；"
        f"{value_label}：{impact}；"
        f"解锁动作：{unlock}；"
        f"下一步：{next_action}。"
    )
    if os.environ.get("PMW_DEBUG_OUTPUT") == "true":
        line += f" 调试：run={chosen_run or '暂无'}，project={current_slug()}。"
    return line + "\n"


def render_status(run_id: Optional[str]) -> str:
    global ACTIVE_CONTEXT
    root = project_dir()
    project = read_json(root / "project.json")
    chosen_run, events = read_run(run_id)
    ACTIVE_CONTEXT = rt.resolve_context(project, chosen_run if run_id else None)
    latest_status = project.get("latest_run_status") or (events[-1].get("status") if events else "暂无")
    latest_brief_path = str(project.get("latest_brief", ""))
    brief_name, brief_meta = latest_brief_summary(latest_brief_path)
    discovery_payload = discovery_gate_payload("alignment", chosen_run, latest_brief_path)
    discovery_status, discovery_gap, discovery_action, discovery_covered, discovery_gap_queue, discovery_product_advice, discovery_ia_advice, discovery_next_question = discovery_alignment_summary(discovery_payload)
    decisions = read_jsonl(root / "decisions.jsonl")[-5:]
    questions = read_jsonl(root / "questions.jsonl")[-5:]
    board = current_board_items(root, str(project.get("latest_brief", "")), str(project.get("latest_brief_version") or ""), active_run_id(project) or chosen_run, project)
    board_scores = {}
    for row in read_jsonl(root / "prototype-board.jsonl"):
        if row.get("record_type") == "score":
            board_scores[row.get("scheme", "")] = row
    prototypes = all_jsonl("prototypes/*.jsonl")
    reviews = [e for e in events if e.get("event") == "review"]
    evidence = [e for e in events if e.get("event") == "evidence"]
    artifacts = [e for e in events if e.get("event") == "artifact"]
    artifact_flow = artifact_flow_rows(root)
    browser_evidence = browser_evidence_rows(root)
    visual_baselines = visual_baseline_rows(root)
    review_specialists = review_specialist_rows(root)
    run_decisions = [e for e in events if e.get("event") == "decision"]
    tuning = read_jsonl(root / "question-tuning.jsonl")[-5:]
    delivery_facts = (read_jsonl(user_dir() / "delivery-facts.jsonl") + read_jsonl(root / "delivery-facts.jsonl"))[-8:]

    lines = [
        "# PMWorkspace 证据状态页",
        "",
        f"- 项目：{project.get('display_name') or pathlib.Path.cwd().name}",
        f"- 技术标识：{project.get('slug') or current_slug()}",
        f"- 当前 run：{chosen_run or '暂无'}",
        f"- 当前状态：{latest_status}",
        f"- 生成时间：{datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}",
        "",
        render_readiness_section(run_id, "auto", "##").rstrip(),
        "",
        "## 产品信息对齐包",
        "",
        f"- 对齐状态：{discovery_status}",
        f"- 已覆盖：{discovery_covered}",
        f"- 当前主阻断：{discovery_gap}",
        f"- 关键缺口队列：{discovery_gap_queue}",
        f"- 产品作业队列：{discovery_action}",
        f"- PMW 产品建议：{discovery_product_advice}",
        f"- PMW 信息架构建议：{discovery_ia_advice}",
        f"- 当前 Q / D：{discovery_next_question or '暂无'}",
        "",
        "## 产品简报与 Zoon",
        "",
        f"- 最新简报：{brief_name}",
        f"- 简报状态：{brief_meta}",
        f"- Zoon URL：{redact_sensitive(str(project.get('zoon_url') or '未记录'))}",
        f"- Zoon 同步状态：{project.get('last_zoon_sync_status') or '未记录'}",
        f"- 最近 Zoon 同步：{project.get('last_zoon_sync_at') or '未记录'}",
        f"- Zoon 同步本地副本：{project.get('last_zoon_sync_brief') or '未记录'}",
        f"- Zoon 同步失败原因：{project.get('last_zoon_sync_error') or '无'}",
        f"- Zoon 协作加入状态：{project.get('last_zoon_join_status') or '未记录'}",
        f"- 最近 Zoon 协作加入：{project.get('last_zoon_join_at') or '未记录'}",
        f"- Zoon 协作加入失败原因：{redact_sensitive(str(project.get('last_zoon_join_error') or '无'))}",
        "",
        "## 证据与门槛",
        "",
    ]
    lines.extend(bullet_or_empty([f"{r.get('status', '')}｜{r.get('title', '')}：{r.get('summary', '')}" for r in evidence]))
    lines.extend(["", "## 浏览器证据", ""])
    lines.extend(bullet_or_empty(browser_evidence))
    lines.extend(["", "## 视觉基线", ""])
    lines.extend(bullet_or_empty(visual_baselines))
    lines.extend(["", "## 决策与问题", ""])
    decision_rows = [f"{r.get('status', '')}｜{r.get('title', '')}：{r.get('summary', '')}" for r in run_decisions]
    decision_rows.extend([f"{r.get('title', r.get('question_id', ''))}：{r.get('body') or r.get('summary') or r.get('user_choice') or ''}" for r in decisions + questions])
    lines.extend(bullet_or_empty(decision_rows))
    lines.extend(["", "## 原型与方案板", ""])
    board_rows = [
        f"{r.get('scheme', '未命名')} / {r.get('screen', '未命名屏幕')}｜{board_scores.get(r.get('scheme', ''), {}).get('score', '未评分')}｜brief {r.get('brief_version', '未标注')}"
        for r in board[-10:]
    ]
    manifest_rows = [f"{r.get('scheme', r.get('方案名', '原型项'))}｜{r.get('screen', r.get('屏幕任务', ''))}" for r in prototypes[-10:]]
    lines.extend(bullet_or_empty(board_rows + manifest_rows))
    lines.extend(["", "## 复审结论", ""])
    lines.extend(bullet_or_empty([f"{r.get('status', '')}｜{r.get('title', '')}：{r.get('summary', '')}" for r in reviews]))
    lines.extend(["", "## 可插拔复审专家", ""])
    lines.extend(bullet_or_empty(review_specialists))
    lines.extend(["", "## 产物流动", ""])
    lines.extend(bullet_or_empty(artifact_flow))
    lines.extend(["", "## 产物清单", ""])
    lines.extend(bullet_or_empty([f"{r.get('status', '')}｜{r.get('title', '')}：{r.get('summary', '')}" for r in artifacts]))
    lines.extend(["", "## 交付资产", ""])
    lines.extend(
        bullet_or_empty(
            [
                f"{r.get('fact_type', '交付事实')}｜{r.get('target', '')}｜{r.get('scope', '')}｜{r.get('note', '')}"
                for r in delivery_facts
            ]
        )
    )
    lines.extend(["", "## 问题偏好", ""])
    lines.extend(bullet_or_empty([f"{r.get('dimension', '')}：{r.get('policy', '')}｜{r.get('reason', '')}" for r in tuning]))
    return "\n".join(lines) + "\n"


def render_status_summary(run_id: Optional[str]) -> str:
    global ACTIVE_CONTEXT
    root = project_dir()
    project = read_json(root / "project.json")
    chosen_run, events = read_run(run_id)
    ACTIVE_CONTEXT = rt.resolve_context(project, chosen_run if run_id else None)
    latest_status = project.get("latest_run_status") or (events[-1].get("status") if events else "暂无")
    latest_brief_path = str(project.get("latest_brief", ""))
    brief_name, brief_meta = latest_brief_summary(latest_brief_path)
    discovery_payload = discovery_gate_payload("alignment", chosen_run, latest_brief_path)
    discovery_status, discovery_gap, discovery_action, _discovery_covered, discovery_gap_queue, discovery_product_advice, discovery_ia_advice, discovery_next_question = discovery_alignment_summary(discovery_payload)
    target, verdict_cn, reason, impact, unlock, next_action, _rows = readiness_verdict(project, events, "auto")
    artifact_count = len(read_jsonl(root / "artifact-flow.jsonl"))
    board_count = len(current_board_items(root, str(project.get("latest_brief", "")), str(project.get("latest_brief_version") or ""), active_run_id(project) or chosen_run, project))
    review = latest_review(events)
    zoon_sync_status = str(project.get("last_zoon_sync_status") or "")
    if zoon_sync_status == "synced":
        zoon_summary = "已同步"
    elif zoon_sync_status == "disabled":
        zoon_summary = "未启用，使用本地简报"
    else:
        zoon_summary = zoon_sync_status or "未记录"
    lines = [
        "# PMWorkspace 状态摘要",
        "",
        f"- 项目：{project.get('display_name') or pathlib.Path.cwd().name}",
        f"- 当前状态：{latest_status}",
        f"- 产品简报：{brief_name}（{brief_meta}）",
        f"- 产品信息对齐：{discovery_status}",
        f"- 当前主阻断：{discovery_gap}",
        f"- 关键缺口队列：{discovery_gap_queue}",
        f"- 产品作业队列：{discovery_action}",
        f"- PMW 产品建议：{discovery_product_advice}",
        f"- PMW 信息架构建议：{discovery_ia_advice}",
        f"- 当前 Q / D：{discovery_next_question or '暂无'}",
        f"- Zoon：{zoon_summary}",
        f"- 准备度：{readiness_target_label(target)}，{verdict_cn}，{reason}",
        f"- {'判断价值' if verdict_cn in {'可出图', '可交付'} else '阻断影响'}：{impact}",
        f"- 解锁动作：{unlock}",
        f"- 下一步：{next_action}",
        f"- 产物记录：{artifact_count} 条；方案单元：{board_count} 个；复审：{review.get('status') or '未记录'}",
    ]
    if os.environ.get("PMW_DEBUG_OUTPUT") == "true":
        lines.append(f"- 调试：run={chosen_run or '暂无'}，project={current_slug()}")
    lines.append("")
    lines.append("需要完整审计表时，运行 `pmw-dashboard status --details`。")
    lines.append("")
    return "\n".join(lines)


def render_readiness_json(run_id: Optional[str], target: str = "auto") -> str:
    global ACTIVE_CONTEXT
    project = read_json(project_dir() / "project.json")
    chosen_run, events = read_run(run_id)
    ACTIVE_CONTEXT = rt.resolve_context(project, chosen_run if run_id else None)
    effective_target, verdict_cn, reason, impact, unlock, next_action, rows = readiness_verdict(project, events, target)
    first_blocker = ""
    for row in rows:
        if row.get("required") and not row.get("passed"):
            first_blocker = str(row.get("name") or "")
            break
    payload = {
        "target": effective_target,
        "target_label": readiness_target_label(effective_target),
        "run_id": active_run_id(project) or chosen_run,
        "ready": verdict_cn in {"可出图", "可交付"},
        "verdict_cn": verdict_cn,
        "reason": reason,
        "first_blocker": first_blocker,
        "impact": impact,
        "unlock": unlock,
        "next_action": next_action,
        "rows": rows,
        "diagnostics": context_diagnostics(project_dir(), project, active_run_id(project) or chosen_run, effective_target, rows),
    }
    return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n"


def main() -> int:
    global PROJECT_OVERRIDE
    parser = argparse.ArgumentParser(prog="pmw-dashboard")
    sub = parser.add_subparsers(dest="command", required=True)
    status = sub.add_parser("status")
    status.add_argument("--project")
    status.add_argument("--run")
    status.add_argument("--details", action="store_true")
    readiness = sub.add_parser("readiness")
    readiness.add_argument("--project")
    readiness.add_argument("--run")
    readiness.add_argument("--target", choices=["auto", "prototype", "handoff"], default="auto")
    readiness.add_argument("--details", action="store_true")
    readiness.add_argument("--json", action="store_true")
    args = parser.parse_args()
    if getattr(args, "project", None):
        PROJECT_OVERRIDE = resolve_project_identifier(args.project)
    elif getattr(args, "run", None):
        PROJECT_OVERRIDE = project_for_run(args.run)
    if args.command == "status":
        print(render_status(args.run) if args.details else render_status_summary(args.run), end="")
        return 0
    if args.command == "readiness":
        if args.json:
            print(render_readiness_json(args.run, args.target), end="")
        else:
            print(render_readiness_section(args.run, args.target) if args.details else render_readiness_summary(args.run, args.target), end="")
        return 0
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
