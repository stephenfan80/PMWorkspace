def current_slug() -> str:
    env_slug = os.environ.get("PMW_PROJECT_SLUG", "").strip()
    if env_slug:
        return env_slug
    try:
        return subprocess.check_output([str(SCRIPT_DIR / "pmw-slug")], text=True).strip()
    except Exception:
        return "local-project"


def project_dir() -> pathlib.Path:
    return STATE_DIR / "projects" / current_slug()


def read_json(path: pathlib.Path) -> dict[str, Any]:
    if not path.exists():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def read_jsonl(path: pathlib.Path, limit: int = 0) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    lines = path.read_text(encoding="utf-8", errors="ignore").splitlines()
    if limit > 0:
        lines = lines[-limit:]
    rows = []
    for line in lines:
        try:
            value = json.loads(line)
        except Exception:
            continue
        if isinstance(value, dict):
            rows.append(value)
    return rows


def contains_any(text: str, needles: list[str]) -> bool:
    lowered = text.lower()
    return any(needle.lower() in lowered for needle in needles)


def current_action(project: dict[str, Any]) -> dict[str, Any]:
    command = [str(SCRIPT_DIR / "pmw-controller"), "next", "--json"]
    result = subprocess.run(command, text=True, capture_output=True, check=False)
    try:
        payload = json.loads(result.stdout)
        return payload if isinstance(payload, dict) else {}
    except Exception:
        return {}


def candidate_source_images(project: dict[str, Any], limit: int = 50) -> list[str]:
    root = project_dir()
    candidates: list[str] = []
    context = rt.resolve_context(project)
    for row in read_jsonl(root / "prototype-board.jsonl", limit):
        if row.get("record_type") != "image":
            continue
        if not rt.row_matches_context(row, context):
            continue
        value = str(row.get("image") or row.get("path") or row.get("url") or "").strip()
        if value:
            candidates.append(value)
    for row in read_jsonl(root / "artifact-flow.jsonl", limit):
        if row.get("kind") not in {"prototype_image", "visual_baseline"}:
            continue
        if not rt.row_matches_context(row, context):
            continue
        value = str(row.get("path") or row.get("url") or "").strip()
        if value:
            candidates.append(value)
    unique: list[str] = []
    for item in candidates:
        if item not in unique:
            unique.append(item)
    return unique[-5:]


def classify_text(text: str, materials: str = "", skill: str = "", project: dict[str, Any] | None = None) -> tuple[str, str]:
    raw = "\n".join([text or "", materials or "", skill or ""]).strip()
    compact = re.sub(r"\s+", "", raw)
    if not compact:
        return "blocked_unknown", "输入为空，无法判断 PMW 操作类型"

    prototype_revision = contains_any(
        compact,
        ["在这个图基础上", "在这张图基础上", "基于这个图", "基于这张图", "不要改", "别改", "只改", "保留", "券样式", "100元券", "100 元券", "按钮区"],
    )
    new_workflow = contains_any(
        compact,
        ["方案及原型", "帮我思考一个方案", "我有个产品想法", "从0做", "从 0 做", "做一份prd", "产品简报", "针对", "提升转化率"],
    )
    if prototype_revision and new_workflow and contains_any(compact, ["新方案", "三个新方向", "重新做三个", "重新探索"]):
        return "blocked_unknown", "这句话同时像新方案探索和旧图修改，需要确认是重开方案还是局部重出"
    if prototype_revision:
        return "prototype_revision", "用户要求基于现有图局部修改，并出现只改 / 不改 / 保留等编辑边界"

    if contains_any(compact, ["重出", "重新生成", "重新出", "这张不对", "第3张", "第三张", "第 3 张"]):
        return "prototype_regenerate", "用户要求重出既有原型输出单元"
    if contains_any(compact, ["复审", "能不能交付", "哪里不对", "检查这张图", "评审这张图"]):
        return "prototype_review", "用户要求复审或判断原型是否可交付"
    if contains_any(compact, ["生成prd", "生成 PRD", "交付稿", "研发交付", "产品设计文档", "handoff"]):
        return "handoff_continue", "用户要求基于当前资产进入交付"
    if contains_any(compact, ["补充一张截图", "补一张截图", "上传截图", "补充截图", "补材料", "新增截图"]):
        return "attach_evidence", "用户在当前任务中补充证据材料"

    if contains_any(compact, ["目标改成", "改成提升", "主目标改", "反指标改", "承诺真实", "真实成交价", "范围改成", "用户承诺改"]):
        return "modify_brief", "用户修改目标、范围、承诺或不可虚构边界，应回到 brief 修改 / 重锁"

    if contains_any(compact, ["确认没有问题", "没问题", "同意这个brief", "确认brief", "确认简报", "锁定简报"]):
        return "lock_or_confirm_brief", "用户确认当前产品简报或要求锁定 brief"
    if re.match(r"^(确认|同意|可以|按这个|就这样|ok|OK)", compact):
        return "answer_pending_gate", "用户短确认应绑定当前 pending gate，而不是重新 intake"
    if contains_any(compact, ["看状态", "状态", "调试", "诊断", "为什么卡住", "dashboard"]):
        return "status_or_debug", "用户要求查看 PMW 状态或诊断"
    if contains_any(compact, ["出图", "原型图", "image-2", "图片方案", "多方案"]):
        return "prototype_plan", "用户要求在当前 brief 下进入原型计划或出图准备"
    if new_workflow:
        return "new_product_workflow", "用户提出新的产品目标 / 方案及原型入口"
    return "blocked_unknown", "未能稳定判断是新任务、gate 回答、原型修改、复审还是交付"


def context_blocker(operation_type: str, project: dict[str, Any], source_image: str = "") -> tuple[str, str, dict[str, Any]]:
    run_id = str(project.get("current_run_id") or "")
    digest = str(project.get("current_task_digest") or "")
    revision = str(project.get("current_input_revision") or "")
    active_context = bool(run_id and digest and revision)
    action = current_action(project) if active_context else {}
    candidates = candidate_source_images(project)
    diagnostics = {
        "active_run": bool(run_id),
        "active_context": active_context,
        "run_id": run_id,
        "task_digest": digest,
        "input_revision": revision,
        "pending_gate_id": action.get("pending_gate_id", ""),
        "source_image_candidates": candidates,
    }
    if operation_type in {"answer_pending_gate"} and not action.get("pending_gate_id"):
        return "OPERATION_CONTEXT_MISSING", "找不到当前 pending gate，短回复不能创建新任务。", diagnostics
    if operation_type in {"prototype_revision"}:
        if not active_context:
            return "OPERATION_CONTEXT_MISSING", "找不到可继承的 active run；请选择源任务或重新进入新任务。", diagnostics
        if not source_image and not candidates:
            return "OPERATION_SOURCE_IMAGE_REQUIRED", "找不到源图；请上传或选择要基于哪张图修改。", diagnostics
        if not source_image and len(candidates) > 1:
            return "OPERATION_AMBIGUOUS_SOURCE_IMAGE", "发现多张候选源图；请指定基于哪一张修改。", diagnostics
        lock = rt.latest_brief_lock(project)
        if not rt.brief_lock_is_locked(lock):
            return "OPERATION_CONTEXT_MISSING", "当前任务缺 locked brief；原型局部修改不能继承未锁定产品事实。", diagnostics
        design_spec = str(project.get("design_spec_target") or project.get("design_spec_status") or "")
        if not design_spec or design_spec == "待确认":
            return "OPERATION_CONTEXT_MISSING", "当前任务缺设计规范目标；需先确认一次，然后由后续修改继承。", diagnostics
    if operation_type in {"attach_evidence", "modify_brief", "lock_or_confirm_brief", "prototype_plan", "prototype_review", "prototype_regenerate", "handoff_continue"} and not active_context:
        return "OPERATION_CONTEXT_MISSING", "找不到可继承的当前任务；请先选择源任务或新建 PMW 工作流。", diagnostics
    return "", "", diagnostics


def route_payload(args: argparse.Namespace) -> dict[str, Any]:
    project = read_json(project_dir() / "project.json")
    operation_type, reason = classify_text(args.text, args.materials, args.skill, project)
    config = dict(ROUTE_CONFIG[operation_type])
    first_blocker, recovery_hint, diagnostics = context_blocker(operation_type, project, args.source_image)
    if operation_type == "blocked_unknown" and not first_blocker:
        first_blocker = "OPERATION_AMBIGUOUS"
        recovery_hint = reason
    confidence = float(config.get("confidence") or 0)
    if first_blocker:
        confidence = min(confidence, 0.72)
    operation_seed = [operation_type, args.text, args.materials, diagnostics.get("run_id", ""), diagnostics.get("input_revision", "")]
    return {
        "operation_type": operation_type,
        "confidence": confidence,
        "routing_reason": reason,
        "required_controller_command": config["required_controller_command"],
        "may_run_intake": bool(config["may_run_intake"]),
        "must_not_run_intake": bool(config["must_not_run_intake"]),
        "context_policy": config["context_policy"],
        "required_context": config["required_context"],
        "minimal_gate": config["minimal_gate"],
        "allowed_next_skill": config["allowed_next_skill"],
        "user_visible_action": config["user_visible_action"],
        "first_blocker": first_blocker,
        "recovery_hint": recovery_hint,
        "operation_blocker": first_blocker,
        "operation_id_hint": "op_" + rt.fingerprint(operation_seed),
        "current_context": diagnostics,
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pmw-operation-router")
    sub = parser.add_subparsers(dest="command", required=True)
    classify = sub.add_parser("classify")
    classify.add_argument("--text", default="")
    classify.add_argument("--materials", default="")
    classify.add_argument("--skill", default="pm-workspace")
    classify.add_argument("--current-run", default="")
    classify.add_argument("--source-image", default="")
    classify.add_argument("--artifact-id", default="")
    classify.add_argument("--json", action="store_true")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if args.command != "classify":
        raise SystemExit(f"Unknown command: {args.command}")
    payload = route_payload(args)
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print(payload["operation_type"])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
