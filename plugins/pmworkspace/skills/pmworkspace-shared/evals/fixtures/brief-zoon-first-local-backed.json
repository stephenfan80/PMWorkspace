{
  "id": "brief-zoon-first-local-backed",
  "title": "产品简报默认本地保存，并按用户选择同步 Zoon",
  "category": "pm-brief",
  "primary_skill": "pm-brief",
  "prompt": "生成产品简报时，默认先保存本地 Markdown；只有用户选择在线协作时才推送到 Zoon，并保持本地状态一致。",
  "expected": {
    "mode": "deep",
    "status": "待确认",
    "must_stop": false,
    "gate": "local-first 简报保存",
    "required_behaviors": [
      "先保存业务简报和完整本地审计副本",
      "本地 Markdown 保存后必须默认推荐 Zoon",
      "推荐必须说明多人协作、事实源统一、后续原型或 PRD 防漂移的好处",
      "必须提供 A/B 选择让用户决定是否同步 Zoon",
      "未启用 Zoon 时记录 disabled 且不阻断出图",
      "用户选择 Zoon 后才推送或追加在线文档",
      "同步成功后 agent 自动加入协作态",
      "记录 Zoon URL、同步状态、协作加入状态和最终本地 brief 路径",
      "同步失败时保留本地副本并记录脱敏失败原因"
    ],
    "forbidden_behaviors": [
      "未经用户选择自动创建 Zoon",
      "把 Zoon 当成每次出图的固定阻断门槛",
      "同步成功后项目状态指向临时文件",
      "暴露 token、ownerSecret 或 API 原始响应"
    ]
  },
  "contract_checks": [
    {
      "path": "bin/pmw-log",
      "contains": "Local-first, Zoon-optional"
    },
    {
      "path": "bin/pmw-log",
      "contains": "PMW_ZOON_DEFER_PROJECT_UPDATE=1"
    },
    {
      "path": "bin/pmw-log",
      "contains": "ZOON_SYNC_ORDER=explicit-online-sync"
    },
    {
      "path": "bin/pmw-log",
      "contains": "ZOON_JOIN_STATUS"
    },
    {
      "path": "bin/pmw-project",
      "contains": "last_zoon_sync_status"
    },
    {
      "path": "bin/pmw-project",
      "contains": "last_zoon_join_status"
    },
    {
      "path": "bin/pmw-dashboard",
      "contains": "Zoon 同步本地副本"
    },
    {
      "path": "bin/pmw-dashboard",
      "contains": "Zoon 协作加入状态"
    },
    {
      "path": "pm-brief/SKILL.md",
      "contains": "local-first, Zoon-optional publishing"
    },
    {
      "path": "pm-brief/SKILL.md",
      "contains": "Zoon 协作建议：这次简报适合多人评审 / 后续原型或 PRD 复用，建议同步到 Zoon；不同步也不影响继续使用本地 Markdown。"
    },
    {
      "path": "pm-brief/SKILL.md",
      "contains": "D：是否同步到在线协作文档（Zoon）？A. 先不需要，使用本地 Markdown 继续；B. 需要，同步到 Zoon 供团队在线修改。"
    },
    {
      "path": "pm-autoplan/SKILL.md",
      "contains": "不能只提示“确认后进入原型 / 交付”"
    },
    {
      "path": "pmworkspace-shared/references/zoon-workflow.md",
      "contains": "local-first，Zoon-optional"
    },
    {
      "path": "pmworkspace-shared/references/zoon-workflow.md",
      "contains": "多人协作、事实源统一、后续 image-2 原型 / PRD 防漂移"
    },
    {
      "path": "pmworkspace-shared/references/zoon-workflow.md",
      "contains": "不自动同步、不作为出图或交付阻断"
    },
    {
      "path": "pmworkspace-shared/references/zoon-drift-check.md",
      "contains": "默认先保存本地 Markdown 业务简报和完整本地审计副本"
    },
    {
      "path": "pmworkspace-shared/references/pm-eval-system.md",
      "contains": "产品简报：`pmw-log brief` 必须使用 local-first，Zoon-optional 同步"
    }
  ]
}
