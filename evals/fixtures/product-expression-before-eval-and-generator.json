{
  "id": "product-expression-before-eval-and-generator",
  "title": "产品表达必须先于 eval 和生成契约稳定",
  "category": "skill-doc-generator",
  "primary_skill": "pm-workspace",
  "prompt": "维护者准备调整 PMW 的用户心智、默认输出或产物命名，不能先改 eval 或生成区块牵着产品表达走。",
  "expected": {
    "mode": "maintenance",
    "status": "可检查",
    "must_stop": false,
    "gate": "产品表达治理顺序",
    "required_behaviors": [
      "先在 README、routing、welcome-guide 或方法 reference 中稳定产品表达",
      "再同步 skill 正文、manifest 和生成契约",
      "最后更新 eval fixture 作为防回退断言",
      "生成契约声明自己只承接稳定表达，不发明新业务规则"
    ],
    "forbidden_behaviors": [
      "先写 eval 再反向牵引产品表达",
      "把 manifest 当成第二套产品方法",
      "只改 fixture 让测试通过",
      "手写修改生成区块"
    ]
  },
  "contract_checks": [
    {
      "path": "pmworkspace-shared/references/skill-doc-template-system.md",
      "contains": "产品表达先于生成器"
    },
    {
      "path": "pmworkspace-shared/references/skill-doc-template-system.md",
      "contains": "manifest 不是第二套产品方法"
    },
    {
      "path": "pmworkspace-shared/references/pm-eval-system.md",
      "contains": "Eval 后置原则"
    },
    {
      "path": "evals/README.md",
      "contains": "eval 是后置防回退工具，不是产品表达的起点"
    },
    {
      "path": "pmworkspace-shared/skill-docs/skill-docs.manifest.json",
      "contains": "\"product_expression_source_order\""
    },
    {
      "path": "bin/pmw-gen-skill-docs",
      "contains": "product_expression_source_order"
    },
    {
      "path": "pm-workspace/SKILL.md",
      "contains": "### 产品表达真源顺序"
    },
    {
      "path": "pm-workspace/SKILL.md",
      "contains": "不要先写 eval 反向牵引产品表达"
    },
    {
      "path": "README.zh-CN.md",
      "contains": "先稳定 README / references 的产品表达，再更新生成契约，最后补 eval"
    },
    {
      "path": "README.md",
      "contains": "Evals are regression guards, not the starting point for product expression."
    }
  ],
  "command_checks": [
    {
      "command": [
        "bash",
        "-lc",
        "bin/pmw-gen-skill-docs check"
      ],
      "exit_code": 0,
      "contains": "PMWorkspace skill 文档检查通过"
    }
  ]
}
