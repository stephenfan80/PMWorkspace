#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import subprocess
import sys
from datetime import datetime, timezone


SCRIPT_DIR = pathlib.Path(__file__).resolve().parent
ROOT = SCRIPT_DIR.parent
ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def fixture_dirs() -> list[pathlib.Path]:
    candidates: list[pathlib.Path] = []
    env_dir = os.environ.get("PMW_EVAL_FIXTURES")
    if env_dir:
        candidates.append(pathlib.Path(env_dir).expanduser())
    candidates.extend(
        [
            ROOT / "evals" / "fixtures",
            ROOT / "pmworkspace-shared" / "evals" / "fixtures",
            SCRIPT_DIR.parent / "evals" / "fixtures",
            pathlib.Path.cwd() / "evals" / "fixtures",
        ]
    )
    seen = set()
    unique = []
    for path in candidates:
        resolved = path.resolve()
        if resolved in seen:
            continue
        seen.add(resolved)
        if path.exists():
            unique.append(path)
    return unique


def suite_dirs() -> list[pathlib.Path]:
    candidates: list[pathlib.Path] = []
    env_dir = os.environ.get("PMW_EVAL_SUITES")
    if env_dir:
        candidates.append(pathlib.Path(env_dir).expanduser())
    candidates.extend(
        [
            ROOT / "evals" / "suites",
            ROOT / "pmworkspace-shared" / "evals" / "suites",
            SCRIPT_DIR.parent / "evals" / "suites",
            pathlib.Path.cwd() / "evals" / "suites",
        ]
    )
    seen = set()
    unique = []
    for path in candidates:
        resolved = path.resolve()
        if resolved in seen:
            continue
        seen.add(resolved)
        if path.exists():
            unique.append(path)
    return unique


def load_fixtures() -> tuple[pathlib.Path, list[dict]]:
    dirs = fixture_dirs()
    if not dirs:
        print("未找到 eval fixture：请确认 evals/fixtures 存在，或设置 PMW_EVAL_FIXTURES。", file=sys.stderr)
        raise SystemExit(2)
    root = dirs[0]
    fixtures = []
    for path in sorted(root.glob("*.json")):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except Exception as exc:
            fixtures.append({"id": path.stem, "_path": str(path), "_load_error": str(exc)})
            continue
        if isinstance(data, dict):
            data["_path"] = str(path)
            fixtures.append(data)
    return root, fixtures


def load_suite_ids(suite: str) -> tuple[str, list[str] | None]:
    suite = (suite or "full").strip()
    if suite == "full":
        return suite, None
    if not ID_RE.match(suite):
        print("suite 必须使用小写字母、数字和连字符", file=sys.stderr)
        raise SystemExit(2)
    for root in suite_dirs():
        path = root / f"{suite}.txt"
        if not path.exists():
            continue
        ids: list[str] = []
        seen: set[str] = set()
        for lineno, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if not ID_RE.match(line):
                print(f"suite {suite} 第 {lineno} 行不是合法 fixture id：{line}", file=sys.stderr)
                raise SystemExit(2)
            if line not in seen:
                ids.append(line)
                seen.add(line)
        if not ids:
            print(f"suite 为空：{path}", file=sys.stderr)
            raise SystemExit(2)
        return suite, ids
    available = sorted(path.stem for root in suite_dirs() for path in root.glob("*.txt"))
    hint = f"可用 suite：{', '.join(available)}" if available else "未找到 eval suite；请确认 evals/suites 存在。"
    print(f"未找到 suite：{suite}。{hint}", file=sys.stderr)
    raise SystemExit(2)


def repo_path(value: str) -> pathlib.Path:
    path = pathlib.Path(value)
    if path.is_absolute():
        return path
    candidates = [ROOT / path, ROOT.parent / path]
    parts = path.parts
    if parts and parts[0] == "pmworkspace-shared":
        stripped = pathlib.Path(*parts[1:])
        candidates.extend([ROOT / stripped, ROOT.parent / stripped])
    for candidate in candidates:
        if candidate.exists():
            return candidate
    return candidates[0]


def require_string(value: dict, key: str, errors: list[str]) -> str:
    raw = value.get(key)
    if not isinstance(raw, str) or not raw.strip():
        errors.append(f"缺少字段：{key}")
        return ""
    return raw.strip()


def validate_fixture(fixture: dict) -> list[str]:
    errors: list[str] = []
    if fixture.get("_load_error"):
        return [f"JSON 读取失败：{fixture.get('_load_error')}"]
    fixture_id = require_string(fixture, "id", errors)
    if fixture_id and not ID_RE.match(fixture_id):
        errors.append("id 必须使用小写字母、数字和连字符")
    for key in ["title", "category", "primary_skill", "prompt"]:
        require_string(fixture, key, errors)
    expected = fixture.get("expected")
    if not isinstance(expected, dict):
        errors.append("expected 必须是对象")
    else:
        require_string(expected, "status", errors)
        require_string(expected, "gate", errors)
        if "must_stop" not in expected or not isinstance(expected.get("must_stop"), bool):
            errors.append("expected.must_stop 必须是布尔值")
        for key in ["required_behaviors", "forbidden_behaviors"]:
            rows = expected.get(key)
            if not isinstance(rows, list) or not all(isinstance(item, str) and item.strip() for item in rows):
                errors.append(f"expected.{key} 必须是非空字符串列表")
    checks = fixture.get("contract_checks")
    if not isinstance(checks, list) or not checks:
        errors.append("contract_checks 必须是非空列表")
    elif not all(isinstance(item, dict) for item in checks):
        errors.append("contract_checks 每项必须是对象")
    command_checks = fixture.get("command_checks", [])
    if command_checks and (not isinstance(command_checks, list) or not all(isinstance(item, dict) for item in command_checks)):
        errors.append("command_checks 必须是对象列表")
    return errors


def run_check(check: dict) -> list[str]:
    errors: list[str] = []
    path_value = check.get("path")
    if not isinstance(path_value, str) or not path_value.strip():
        return ["contract check 缺少 path"]
    path = repo_path(path_value)
    if not path.exists():
        return [f"文件不存在：{path_value}"]
    text = path.read_text(encoding="utf-8", errors="ignore")
    if "contains" in check:
        needle = check.get("contains")
        if not isinstance(needle, str) or not needle:
            errors.append(f"{path_value} contains 断言缺少文本")
        elif needle not in text:
            errors.append(f"{path_value} 缺少短语：{needle}")
    if "contains_any" in check:
        needles = check.get("contains_any")
        if not isinstance(needles, list) or not needles:
            errors.append(f"{path_value} contains_any 断言缺少候选文本")
        elif not any(isinstance(item, str) and item in text for item in needles):
            errors.append(f"{path_value} 缺少任一候选短语：{needles}")
    if "not_contains" in check:
        needle = check.get("not_contains")
        if not isinstance(needle, str) or not needle:
            errors.append(f"{path_value} not_contains 断言缺少文本")
        elif needle in text:
            errors.append(f"{path_value} 不应包含短语：{needle}")
    known = {"path", "contains", "contains_any", "not_contains", "note"}
    unknown = sorted(set(check) - known)
    if unknown:
        errors.append(f"{path_value} 包含未知断言字段：{', '.join(unknown)}")
    return errors


def run_command_check(check: dict) -> list[str]:
    errors: list[str] = []
    command = check.get("command")
    if not isinstance(command, list) or not command or not all(isinstance(item, str) for item in command):
        return ["command check 缺少 command 字符串数组"]
    stdin = check.get("stdin", "")
    if not isinstance(stdin, str):
        return ["command check stdin 必须是字符串"]
    expected_code = check.get("exit_code", 0)
    if not isinstance(expected_code, int):
        return ["command check exit_code 必须是整数"]
    try:
        result = subprocess.run(
            command,
            cwd=ROOT,
            input=stdin,
            text=True,
            capture_output=True,
            timeout=10,
            check=False,
        )
    except Exception as exc:
        return [f"command check 执行失败：{exc}"]
    output = f"{result.stdout}{result.stderr}"
    if result.returncode != expected_code:
        errors.append(f"command check 返回码 {result.returncode} != {expected_code}：{' '.join(command)}")
    contains = check.get("contains", [])
    if isinstance(contains, str):
        contains = [contains]
    if contains:
        if not isinstance(contains, list) or not all(isinstance(item, str) and item for item in contains):
            errors.append("command check contains 必须是字符串或非空字符串数组")
        else:
            for needle in contains:
                if needle not in output:
                    errors.append(f"command check 输出缺少短语：{needle}")
    not_contains = check.get("not_contains", [])
    if isinstance(not_contains, str):
        not_contains = [not_contains]
    if not_contains:
        if not isinstance(not_contains, list) or not all(isinstance(item, str) and item for item in not_contains):
            errors.append("command check not_contains 必须是字符串或非空字符串数组")
        else:
            for needle in not_contains:
                if needle in output:
                    errors.append(f"command check 输出不应包含短语：{needle}")
    count = check.get("count")
    if count is not None:
        if not isinstance(count, dict):
            errors.append("command check count 必须是对象")
        else:
            needle = count.get("text")
            expected = count.get("equals")
            if not isinstance(needle, str) or not needle:
                errors.append("command check count.text 必须是非空字符串")
            elif not isinstance(expected, int):
                errors.append("command check count.equals 必须是整数")
            else:
                actual = output.count(needle)
                if actual != expected:
                    errors.append(f"command check 输出中 `{needle}` 出现 {actual} 次 != {expected} 次")
    known = {"command", "stdin", "exit_code", "contains", "not_contains", "count", "note"}
    unknown = sorted(set(check) - known)
    if unknown:
        errors.append(f"command check 包含未知断言字段：{', '.join(unknown)}")
    return errors


def evaluate_fixture(fixture: dict) -> dict:
    schema_errors = validate_fixture(fixture)
    check_errors: list[str] = []
    if not schema_errors:
        for check in fixture.get("contract_checks", []):
            check_errors.extend(run_check(check))
        for check in fixture.get("command_checks", []):
            check_errors.extend(run_command_check(check))
    errors = schema_errors + check_errors
    return {
        "id": fixture.get("id", ""),
        "title": fixture.get("title", ""),
        "category": fixture.get("category", ""),
        "primary_skill": fixture.get("primary_skill", ""),
        "path": fixture.get("_path", ""),
        "passed": not errors,
        "errors": errors,
        "expected": fixture.get("expected", {}),
    }


def select_fixtures(fixtures: list[dict], fixture_id: str | None, suite_ids: list[str] | None = None) -> list[dict]:
    by_id = {fixture.get("id"): fixture for fixture in fixtures}
    if not fixture_id:
        if suite_ids is None:
            return fixtures
        missing = [fixture_id for fixture_id in suite_ids if fixture_id not in by_id]
        if missing:
            print(f"suite 引用了不存在的 fixture：{', '.join(missing)}", file=sys.stderr)
            raise SystemExit(2)
        return [by_id[fixture_id] for fixture_id in suite_ids]
    selected = [by_id[fixture_id]] if fixture_id in by_id else []
    if not selected:
        print(f"未找到 fixture：{fixture_id}", file=sys.stderr)
        raise SystemExit(2)
    return selected


def render_list(root: pathlib.Path, fixtures: list[dict], as_json: bool, suite_name: str = "full", full_count: int | None = None) -> int:
    rows = [
        {
            "id": fixture.get("id", ""),
            "title": fixture.get("title", ""),
            "category": fixture.get("category", ""),
            "primary_skill": fixture.get("primary_skill", ""),
        }
        for fixture in fixtures
    ]
    category_summary: dict[str, int] = {}
    for row in rows:
        category = row["category"] or "未分类"
        category_summary[category] = category_summary.get(category, 0) + 1
    if as_json:
        print(json.dumps({"fixture_dir": str(root), "suite": suite_name, "count": len(rows), "full_count": full_count or len(rows), "category_summary": category_summary, "fixtures": rows}, ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    print("# PMWorkspace eval fixtures")
    print("")
    print(f"- fixture 目录：{root}")
    print(f"- suite：{suite_name}")
    print(f"- 数量：{len(rows)} / {full_count or len(rows)}")
    print("- 分类：")
    for category, count in sorted(category_summary.items()):
        print(f"  - {category}：{count}")
    print("")
    for row in rows:
        print(f"- {row['id']}｜{row['category']}｜{row['primary_skill']}｜{row['title']}")
    return 0


def render_run(root: pathlib.Path, fixtures: list[dict], as_json: bool, suite_name: str = "full", full_count: int | None = None) -> int:
    results = [evaluate_fixture(fixture) for fixture in fixtures]
    passed = [row for row in results if row["passed"]]
    failed = [row for row in results if not row["passed"]]
    payload = {
        "tool": "pmw-eval",
        "ts": now(),
        "fixture_dir": str(root),
        "suite": suite_name,
        "total": len(results),
        "full_total": full_count or len(results),
        "passed": len(passed),
        "failed": len(failed),
        "results": results,
    }
    if as_json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print("# PMWorkspace eval 结果")
        print("")
        print(f"- fixture 目录：{root}")
        print(f"- suite：{suite_name}")
        print(f"- 总数：{len(results)} / {full_count or len(results)}")
        print(f"- 通过：{len(passed)}")
        print(f"- 失败：{len(failed)}")
        print("")
        for row in results:
            marker = "通过" if row["passed"] else "失败"
            print(f"- {marker}｜{row['id']}｜{row['title']}")
            for error in row["errors"]:
                print(f"  - {error}")
        print("")
        print("机器可读 JSON：")
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    return 0 if not failed else 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pmw-eval")
    sub = parser.add_subparsers(dest="command", required=True)
    list_cmd = sub.add_parser("list")
    list_cmd.add_argument("--suite", default="full", help="选择 eval 分层：smoke、core 或 full")
    list_cmd.add_argument("--json", action="store_true")
    run_cmd = sub.add_parser("run")
    run_cmd.add_argument("--fixture", "--id", dest="fixture")
    run_cmd.add_argument("--suite", default="full", help="选择 eval 分层：smoke、core 或 full；默认 full。与 --fixture 同时使用时必须保持默认 full。")
    run_cmd.add_argument("--json", action="store_true")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    root, fixtures = load_fixtures()
    full_count = len(fixtures)
    if args.command == "list":
        suite_name, suite_ids = load_suite_ids(args.suite)
        return render_list(root, select_fixtures(fixtures, None, suite_ids), args.json, suite_name, full_count)
    if args.command == "run":
        if args.fixture and args.suite != "full":
            print("--fixture 和 --suite 不能同时使用；单个 fixture 调试请只用 --fixture。", file=sys.stderr)
            return 2
        suite_name, suite_ids = load_suite_ids(args.suite)
        return render_run(root, select_fixtures(fixtures, args.fixture, suite_ids), args.json, suite_name if not args.fixture else "fixture", full_count)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
