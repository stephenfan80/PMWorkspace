      "contains": "不新增专用 CLI，不新增专用状态文件"
    },
    {
      "path": "pmworkspace-shared/references/browser-evidence.md",
      "contains": "pmw-artifact add --kind browser_evidence"
    },
    {
      "path": "pmworkspace-shared/references/browser-evidence.md",
      "contains": "--source-skill pm-brief"
    },
    {
      "path": "pmworkspace-shared/references/product-readiness-dashboard.md",
      "contains": "优先读取最新 `browser_evidence` 产物"
    },
    {
      "path": "pmworkspace-shared/references/production-reference-gate.md",
      "contains": "优先登记为 `browser_evidence` 产物"
    },
    {
      "path": "pmworkspace-shared/references/artifact-flow.md",
      "contains": "浏览器证据也以 `browser_evidence` 产物进入同一条 Product Artifact Flow。"
    },
    {
      "path": "bin/pmw-dashboard",
      "contains": "latest_browser_evidence"
