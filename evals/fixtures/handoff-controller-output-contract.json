{
  "id": "handoff-controller-output-contract",
  "title": "产品交付必须输出交付控制器字段",
  "category": "pm-handoff",
  "primary_skill": "pm-handoff",
  "prompt": "把已确认方向整理成 PRD / 设计 / 研发交付稿。",
  "expected": {
    "mode": "deep",
    "status": "待交付",
    "must_stop": false,
    "gate": "交付控制器",
    "required_behaviors": [
      "建立交付控制器",
      "输出交付目标、事实来源和交付前门槛",
      "输出原型复审状态、未决拍板和验收写入边界",
      "输出下一技能和证据状态"
    ],
    "forbidden_behaviors": [
      "直接输出交付稿",
      "省略原型复审状态",
      "省略未决拍板"
    ]
  },
  "contract_checks": [
    {
      "path": "pmworkspace-shared/references/delivery-handoff.md",
      "contains": "## 交付控制器"
    },
    {
      "path": "pm-handoff/SKILL.md",
      "contains": "建立交付控制器，记录 `交付目标`"
    },
    {
      "path": "pm-handoff/SKILL.md",
      "contains": "- 交付前门槛："
    },
    {
      "path": "pmworkspace-shared/references/pm-eval-system.md",
      "contains": "产品交付：必须先建立交付控制器"
    }
  ]
}
