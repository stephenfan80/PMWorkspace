{
  "id": "handoff-acceptance-boundary-and-save",
  "title": "验收标准只能写入已确认事实并保存交付资产",
  "category": "pm-handoff",
  "primary_skill": "pm-handoff",
  "prompt": "产品简报已对齐，原型复审可通过，关键 D 已拍板，请整理研发交付稿。",
  "expected": {
    "mode": "deep",
    "status": "可交付",
    "must_stop": false,
    "gate": "交付前门槛通过",
    "required_behaviors": [
      "验收标准追溯到已确认事实",
      "不可虚构项不写成验收",
      "保存 handoff 资产",
      "记录 artifact 并 finish 为可交付"
    ],
    "forbidden_behaviors": [
      "把未来方案写成验收",
      "把未验证数据写成验收",
      "不保存交付稿"
    ]
  },
  "contract_checks": [
    {
      "path": "pmworkspace-shared/references/delivery-handoff.md",
      "contains": "每条验收都能追溯到已对齐产品简报、已拍板 D、已通过复审的原型或明确的线上参考。"
    },
    {
      "path": "pmworkspace-shared/references/delivery-handoff.md",
      "contains": "pmw-log handoff"
    },
    {
      "path": "bin/pmw-log",
      "contains": "handoff)"
    },
    {
      "path": "pm-handoff/SKILL.md",
      "contains": "只有交付前门槛全部通过时才 `pmw-run finish --status \"可交付\"`"
    },
    {
      "path": "pmworkspace-shared/references/pm-eval-system.md",
      "contains": "验收标准只能来自已确认范围、已支持能力、已拍板承诺、已通过复审的原型或明确线上参考"
    }
  ]
}
