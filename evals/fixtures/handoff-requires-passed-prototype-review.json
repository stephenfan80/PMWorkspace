{
  "id": "handoff-requires-passed-prototype-review",
  "title": "依赖原型的交付必须先通过原型复审",
  "category": "pm-handoff",
  "primary_skill": "pm-handoff",
  "prompt": "原型已经出了，但复审结论是需要重出，用户要求先整理设计交付。",
  "expected": {
    "mode": "deep",
    "status": "需要重出",
    "must_stop": true,
    "gate": "原型复审未通过",
    "required_behaviors": [
      "读取原型复审状态",
      "退回 $pm-prototype-review 或 $pm-prototype-shotgun",
      "不输出最终设计交付"
    ],
    "forbidden_behaviors": [
      "未复审通过仍交付",
      "把需要重出写成待优化",
      "继续生成验收标准"
    ]
  },
  "contract_checks": [
    {
      "path": "pmworkspace-shared/references/delivery-handoff.md",
      "contains": "交付依赖原型图时，原型复审必须是 `可通过`"
    },
    {
      "path": "pm-handoff/SKILL.md",
      "contains": "如果交付依赖原型但复审不是 `可通过`"
    },
    {
      "path": "pmworkspace-shared/references/pm-eval-system.md",
      "contains": "原型复审未通过或线上参考缺失时，必须退回对应门槛"
    }
  ]
}
