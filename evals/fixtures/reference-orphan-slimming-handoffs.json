{
  "id": "reference-orphan-slimming-handoffs",
  "title": "疑似孤岛 reference 删除前必须有职责承接",
  "category": "eval-system",
  "primary_skill": "pm-workspace",
  "prompt": "维护者把 decision-gates、intake、product-methodology 和 prompt-recipes 从核心 reference 中瘦身，要求确认职责已迁移且生成体系文档不被误删。",
  "expected": {
    "mode": "maintenance",
    "status": "可检查",
    "must_stop": false,
    "gate": "孤岛 reference 职责承接",
    "required_behaviors": [
      "产品发现门槛接住 decision-gates 的核心门槛",
      "首次使用引导接住 intake 的最小上下文和输入摘要",
      "产品方法论移入 appendix 而非运行时必读",
      "启动话术移入 appendix/examples 而非运行时协议",
      "skill-doc-template-system 保留为 eval 锚定的生成体系契约"
    ],
    "forbidden_behaviors": [
      "删除旧 reference 但不迁移职责",
      "把 prompt 示例继续放在核心运行时 reference",
      "删除 skill-doc-template-system 破坏生成体系 eval",
      "让插件副本保留已经删除的孤岛 reference"
    ]
  },
  "contract_checks": [
    {
      "path": "pmworkspace-shared/references/product-discovery-gate.md",
      "contains": "## 发现维度与决策门槛映射"
    },
    {
      "path": "pmworkspace-shared/references/product-discovery-gate.md",
      "contains": "`价值交换`"
    },
    {
      "path": "pmworkspace-shared/references/first-use-onboarding.md",
      "contains": "## 最小上下文"
    },
    {
      "path": "pmworkspace-shared/references/first-use-onboarding.md",
      "contains": "## 输入摘要模板"
    },
    {
      "path": "pmworkspace-shared/references/appendix/product-methodology.md",
      "contains": "# 产品方法附录"
    },
    {
      "path": "pmworkspace-shared/references/appendix/prompt-recipes.md",
      "contains": "# 启动话术附录"
    },
    {
      "path": "pmworkspace-shared/references/skill-doc-template-system.md",
      "contains": "manifest 是共享契约源头"
    }
  ],
  "command_checks": [
    {
      "command": [
        "bash",
        "-lc",
        "test ! -e pmworkspace-shared/references/decision-gates.md && test ! -e pmworkspace-shared/references/intake.md && test ! -e pmworkspace-shared/references/product-methodology.md && test ! -e pmworkspace-shared/references/prompt-recipes.md"
      ],
      "exit_code": 0
    },
    {
      "command": [
        "bash",
        "-lc",
        "test ! -e plugins/pmworkspace/skills/pmworkspace-shared/references/decision-gates.md && test ! -e plugins/pmworkspace/skills/pmworkspace-shared/references/intake.md && test ! -e plugins/pmworkspace/skills/pmworkspace-shared/references/product-methodology.md && test ! -e plugins/pmworkspace/skills/pmworkspace-shared/references/prompt-recipes.md"
      ],
      "exit_code": 0
    }
  ]
}
