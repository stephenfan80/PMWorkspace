#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
STATE_DIR="${PMW_HOME:-$HOME/.pmworkspace}"
CONFIG_BIN="${PMW_CONFIG_BIN:-$SCRIPT_DIR/pmw-config}"
CACHE_FILE="$STATE_DIR/last-update-check"
SNOOZE_FILE="$STATE_DIR/update-snoozed"
MARKER_FILE="$STATE_DIR/just-upgraded-from"
FORCE="false"
QUICK="false"

detect_install_host() {
  case "$SCRIPT_DIR" in
    */.agents/plugins/plugins/pmworkspace/skills/pmworkspace-shared/bin|*/.codex/plugins/cache/*/pmworkspace/*/skills/pmworkspace-shared/bin|*/plugins/pmworkspace/skills/pmworkspace-shared/bin)
      echo "codex-plugin"
      ;;
    *)
      echo "codex"
      ;;
  esac
}

find_version_file() {
  for candidate in \
    "${PMW_DIR:-}/VERSION" \
    "$SCRIPT_DIR/../VERSION" \
    "$SCRIPT_DIR/../../VERSION" \
    "$SCRIPT_DIR/../../../VERSION" \
    "$HOME/.codex/skills/pmworkspace-shared/VERSION" \
    $(find "$HOME/.codex/plugins/cache" -path "*/pmworkspace/*/skills/pmworkspace-shared/VERSION" -type f 2>/dev/null | sort -r) \
    "$HOME/.agents/plugins/plugins/pmworkspace/skills/pmworkspace-shared/VERSION"; do
    if [ "$candidate" != "/VERSION" ] && [ -n "${candidate:-}" ] && [ -f "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

find_revision_file() {
  for candidate in \
    "${PMW_DIR:-}/REVISION" \
    "$SCRIPT_DIR/../REVISION" \
    "$SCRIPT_DIR/../../REVISION" \
    "$SCRIPT_DIR/../../../REVISION" \
    "$HOME/.codex/skills/pmworkspace-shared/REVISION" \
    $(find "$HOME/.codex/plugins/cache" -path "*/pmworkspace/*/skills/pmworkspace-shared/REVISION" -type f 2>/dev/null | sort -r) \
    "$HOME/.agents/plugins/plugins/pmworkspace/skills/pmworkspace-shared/REVISION"; do
    if [ "$candidate" != "/REVISION" ] && [ -n "${candidate:-}" ] && [ -f "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

short_rev() {
  rev="$1"
  case "$rev" in
    ""|"unknown") printf '' ;;
    *) printf '%s' "$rev" | cut -c1-7 ;;
  esac
}

display_id() {
  version="$1"
  rev="$2"
  short="$(short_rev "$rev")"
  if [ -n "$short" ]; then
    printf '%s@%s' "$version" "$short"
  else
    printf '%s' "$version"
  fi
}

version_gt() {
  awk -v remote="$1" -v local="$2" '
    BEGIN {
      split(remote, r, ".")
      split(local, l, ".")
      for (i = 1; i <= 4; i++) {
        rv = r[i] + 0
        lv = l[i] + 0
        if (rv > lv) exit 0
        if (rv < lv) exit 1
      }
      exit 1
    }
  '
}

is_snoozed() {
  [ -f "$SNOOZE_FILE" ] || return 1
  read -r snoozed_ver snoozed_epoch < "$SNOOZE_FILE" || return 1
  [ "$snoozed_ver" = "$1" ] || return 1
  hours="$("$CONFIG_BIN" get update_snooze_hours 2>/dev/null || echo 24)"
  case "$hours" in *[!0-9]*|"") hours=24 ;; esac
  now="$(date +%s)"
  [ "$now" -lt $((snoozed_epoch + hours * 3600)) ]
}

cache_fresh() {
  [ -f "$CACHE_FILE" ] || return 1
  ttl="$("$CONFIG_BIN" get update_check_quick_ttl_seconds 2>/dev/null || echo 300)"
  case "$ttl" in *[!0-9]*|"") ttl=300 ;; esac
  python3 - "$CACHE_FILE" "$ttl" <<'PY' >/dev/null 2>&1
import os
import sys
import time

path = sys.argv[1]
ttl = int(sys.argv[2])
sys.exit(0 if time.time() - os.path.getmtime(path) <= ttl else 1)
PY
}

cached_upgrade_remote() {
  awk '/^UPGRADE_AVAILABLE / {print $3; exit}' "$CACHE_FILE" 2>/dev/null || true
}

upgrade_available() {
  local_display="$1"
  remote_display="$2"
  host="$(detect_install_host)"
  {
    echo "UPGRADE_AVAILABLE $local_display $remote_display $host"
    case "$host" in
      codex-plugin) echo "UPGRADE_COMMAND pmw-upgrade --host codex-plugin" ;;
      *) echo "UPGRADE_COMMAND pmw-upgrade --host codex" ;;
    esac
  } > "$CACHE_FILE"
  is_snoozed "$remote_display" && exit 0
  cat "$CACHE_FILE"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --force)
      FORCE="true"
      shift
      ;;
    --quick)
      QUICK="true"
      shift
      ;;
    -h|--help)
      cat <<'EOF'
Usage: pmw-update-check [--quick] [--force]

--quick  Use a short timeout and fresh cached result when available.
--force  Ignore cached/snoozed state and check remote sources now.
EOF
      exit 0
      ;;
    *)
      echo "unknown option: $1" >&2
      exit 2
      ;;
  esac
done

if [ "$FORCE" = "true" ]; then
  rm -f "$CACHE_FILE" "$SNOOZE_FILE"
fi

UPDATE_CHECK="$("$CONFIG_BIN" get update_check 2>/dev/null || echo true)"
if [ "$UPDATE_CHECK" = "false" ]; then
  exit 0
fi

VERSION_FILE="$(find_version_file || true)"
[ -n "$VERSION_FILE" ] || exit 0
LOCAL="$(tr -d '[:space:]' < "$VERSION_FILE")"
[ -n "$LOCAL" ] || exit 0

mkdir -p "$STATE_DIR"

if [ -f "$MARKER_FILE" ]; then
  OLD="$(tr -d '[:space:]' < "$MARKER_FILE" 2>/dev/null || true)"
  rm -f "$MARKER_FILE" "$SNOOZE_FILE"
  [ -n "$OLD" ] && echo "JUST_UPGRADED $OLD $LOCAL"
fi

if [ "$QUICK" = "true" ] && [ "$FORCE" != "true" ] && cache_fresh; then
  cached_remote="$(cached_upgrade_remote)"
  if [ -n "$cached_remote" ] && ! is_snoozed "$cached_remote"; then
    cat "$CACHE_FILE"
  fi
  exit 0
fi

REVISION_FILE="$(find_revision_file || true)"
LOCAL_REV=""
LOCAL_REV_FROM_GIT="false"
SOURCE_ROOT="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd || true)"
if [ -n "$SOURCE_ROOT" ] && [ -x "$SCRIPT_DIR/pmw-revision" ] && [ -e "$SOURCE_ROOT/VERSION" ] && [ -e "$SOURCE_ROOT/pm-workspace" ]; then
  LOCAL_REV="$("$SCRIPT_DIR/pmw-revision" "$SOURCE_ROOT" 2>/dev/null || true)"
  [ -n "$LOCAL_REV" ] && LOCAL_REV_FROM_GIT="true"
elif [ -n "$REVISION_FILE" ]; then
  LOCAL_REV="$(tr -d '[:space:]' < "$REVISION_FILE" 2>/dev/null || true)"
fi
if [ -z "$LOCAL_REV" ] || [ "$LOCAL_REV" = "unknown" ]; then
  LOCAL_REV="$(git -C "$SCRIPT_DIR/.." rev-parse HEAD 2>/dev/null || true)"
  [ -n "$LOCAL_REV" ] && LOCAL_REV_FROM_GIT="true"
fi

REMOTE_URL="${PMW_REMOTE_VERSION_URL:-$("$CONFIG_BIN" get remote_version_url 2>/dev/null || true)}"
[ -n "$REMOTE_URL" ] || REMOTE_URL="https://raw.githubusercontent.com/stephenfan80/PMWorkspace/main/VERSION"
REMOTE_REVISION_URL="${PMW_REMOTE_REVISION_URL:-$("$CONFIG_BIN" get remote_revision_url 2>/dev/null || true)}"
[ -n "$REMOTE_REVISION_URL" ] || REMOTE_REVISION_URL="https://raw.githubusercontent.com/stephenfan80/PMWorkspace/main/plugins/pmworkspace/skills/pmworkspace-shared/REVISION"
REPO_URL="${PMW_REPO_URL:-$("$CONFIG_BIN" get repo_url 2>/dev/null || true)}"
[ -n "$REPO_URL" ] || REPO_URL="https://github.com/stephenfan80/PMWorkspace.git"

if [ "$QUICK" = "true" ]; then
  CURL_TIMEOUT="${PMW_UPDATE_CHECK_QUICK_TIMEOUT:-1.5}"
else
  CURL_TIMEOUT="${PMW_UPDATE_CHECK_TIMEOUT:-5}"
fi

REMOTE="$(curl -sf --max-time "$CURL_TIMEOUT" "$REMOTE_URL" 2>/dev/null | tr -d '[:space:]' || true)"
if ! printf '%s' "$REMOTE" | grep -qE '^[0-9]+(\.[0-9]+){1,3}$'; then
  REMOTE=""
fi

REMOTE_PACKAGED_REV="$(curl -sf --max-time "$CURL_TIMEOUT" "$REMOTE_REVISION_URL" 2>/dev/null | tr -d '[:space:]' || true)"
if ! printf '%s' "$REMOTE_PACKAGED_REV" | grep -qE '^[0-9a-fA-F]{7,40}$'; then
  REMOTE_PACKAGED_REV=""
fi

REMOTE_HEAD_REV=""
if [ "$QUICK" != "true" ]; then
  REMOTE_HEAD_REV="$(GIT_TERMINAL_PROMPT=0 git ls-remote "$REPO_URL" refs/heads/main 2>/dev/null | awk 'NR==1 {print $1}' || true)"
fi
REMOTE_REV="${REMOTE_PACKAGED_REV:-$REMOTE_HEAD_REV}"

REMOTE_FOR_DISPLAY="${REMOTE:-unknown}"
LOCAL_DISPLAY="$(display_id "$LOCAL" "$LOCAL_REV")"
REMOTE_DISPLAY="$(display_id "$REMOTE_FOR_DISPLAY" "$REMOTE_REV")"

REMOTE_REV_IS_NEWER="false"
if [ -n "$REMOTE_REV" ] && [ -n "$LOCAL_REV" ] && [ "$LOCAL_REV" != "unknown" ] && [ "$LOCAL_REV" != "$REMOTE_REV" ]; then
  if [ -n "$REMOTE_PACKAGED_REV" ]; then
    REMOTE_REV_IS_NEWER="true"
  elif [ "$LOCAL_REV_FROM_GIT" = "true" ]; then
    if git -C "$SCRIPT_DIR/.." merge-base --is-ancestor "$LOCAL_REV" "$REMOTE_REV" 2>/dev/null; then
      REMOTE_REV_IS_NEWER="true"
    fi
  else
    REMOTE_REV_IS_NEWER="true"
  fi
fi

if [ "$REMOTE_REV_IS_NEWER" = "true" ]; then
  upgrade_available "$LOCAL_DISPLAY" "$REMOTE_DISPLAY"
  exit 0
fi

if [ -n "$REMOTE" ] && version_gt "$REMOTE" "$LOCAL"; then
  upgrade_available "$LOCAL_DISPLAY" "$REMOTE_DISPLAY"
  exit 0
fi

echo "UP_TO_DATE $LOCAL_DISPLAY" > "$CACHE_FILE"
