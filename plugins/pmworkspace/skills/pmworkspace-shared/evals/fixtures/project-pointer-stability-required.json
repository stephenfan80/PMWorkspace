{
  "id": "project-pointer-stability-required",
  "title": "项目指针必须优先复用绑定项目，避免换目录读错资产",
  "category": "pm-workspace-runtime",
  "primary_skill": "pm-workspace",
  "prompt": "用户在不同 cwd 继续同一个业务项目，希望 dashboard 和 artifact 不切到新项目。",
  "expected": {
    "mode": "maintenance",
    "status": "可检查",
    "must_stop": false,
    "gate": "项目指针稳定",
    "required_behaviors": [
      "优先使用 PMW_PROJECT_SLUG",
      "支持 .pmworkspace-project 绑定",
      "支持 current-project 复用最近活跃项目",
      "dashboard 和 artifact 支持 --project",
      "dashboard 支持按 run 定位项目"
    ],
    "forbidden_behaviors": [
      "只根据 cwd 静默切项目",
      "换目录后读不到 latest_brief",
      "dashboard 无法指定项目"
    ]
  },
  "contract_checks": [
    {
      "path": "bin/pmw-slug",
      "contains": "PMW_PROJECT_SLUG"
    },
    {
      "path": "bin/pmw-slug",
      "contains": ".pmworkspace-project"
    },
    {
      "path": "bin/pmw-slug",
      "contains": "current-project"
    },
    {
      "path": "bin/pmw-dashboard",
      "contains": "status.add_argument(\"--project\""
    },
    {
      "path": "bin/pmw-dashboard",
      "contains": "def project_for_run"
    },
    {
      "path": "bin/pmw-artifact",
      "contains": "parser.add_argument(\"--project\")"
    }
  ]
}
