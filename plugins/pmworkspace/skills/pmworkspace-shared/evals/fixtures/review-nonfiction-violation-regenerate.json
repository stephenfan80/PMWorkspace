{
  "id": "review-nonfiction-violation-regenerate",
  "title": "原型违反不可虚构项时需要重出",
  "category": "prototype-review",
  "primary_skill": "pm-prototype-review",
  "prompt": "复审一张结果页原型，图片展示了后端并不支持的 AI 自动审核通过承诺。",
  "expected": {
    "mode": "deep",
    "status": "需要重出",
    "must_stop": false,
    "gate": "不可虚构项违规",
    "required_behaviors": [
      "标记需要重出",
      "指出违反不可虚构项",
      "输出修正方向"
    ],
    "forbidden_behaviors": [
      "因为视觉好看而通过",
      "把未支持能力当成未来扩展默认展示",
      "只给审美建议"
    ]
  },
  "contract_checks": [
    {
      "path": "pm-prototype-review/SKILL.md",
      "contains": "do not accept a pretty but misleading image"
    },
    {
      "path": "pmworkspace-shared/references/pm-eval-system.md",
      "contains": "原型复审：违反 brief、反指标、不可虚构项、线上参考或设计系统时，必须标为 `需要重出` 或 `需要 PM 拍板`。"
    }
  ]
}
