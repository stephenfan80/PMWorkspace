      "原型复审按最高严重度合并专家结论",
      "平台脚本可记录专家短结论",
      "dashboard 展示专家汇总"
    ],
    "forbidden_behaviors": [
      "把四个视角合并成一段 PM 总评",
      "只输出专家名称不输出短结论",
      "用平均分覆盖硬违规"
    ]
  },
