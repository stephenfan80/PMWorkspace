{
  "id": "eval-runner-contract",
  "title": "pmw-eval 必须提供列表、运行和 JSON 输出",
  "category": "eval-system",
  "primary_skill": "pm-workspace",
  "prompt": "维护者运行 PMWorkspace eval，验证规则契约和轻量运行时契约。",
  "expected": {
    "mode": "maintenance",
    "status": "可检查",
    "must_stop": false,
    "gate": "eval 工具可用",
    "required_behaviors": [
      "支持 list",
      "支持 run",
      "支持 run --fixture",
      "支持 --json",
      "输出分类摘要",
      "支持 command_checks 轻量运行时断言"
    ],
    "forbidden_behaviors": [
      "依赖 pytest",
      "调用真实 image-2",
      "调用 LLM-as-judge"
    ]
  },
  "contract_checks": [
    {
      "path": "bin/pmw-eval",
      "contains": "run_cmd.add_argument(\"--fixture\")"
    },
    {
      "path": "bin/pmw-eval",
      "contains": "category_summary"
    },
    {
      "path": "pmworkspace-shared/references/pm-eval-system.md",
      "contains": "对 `pmw-*` 本地脚本的关键输出可用 `command_checks` 做轻量 smoke test"
    },
    {
      "path": "bin/pmw-eval",
      "contains": "def run_command_check"
    }
  ]
}
