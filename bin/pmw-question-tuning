#!/usr/bin/env python3
import argparse
import json
import os
import pathlib
import subprocess
from datetime import datetime, timezone


SCRIPT_DIR = pathlib.Path(__file__).resolve().parent
STATE_DIR = pathlib.Path(os.environ.get("PMW_HOME", str(pathlib.Path.home() / ".pmworkspace"))).expanduser()
POLICIES = {"always_ask", "high_risk_only", "default_recommend", "avoid_unless_blocking"}


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def current_slug() -> str:
    env_slug = os.environ.get("PMW_PROJECT_SLUG")
    if env_slug:
        return env_slug
    try:
        return subprocess.check_output([str(SCRIPT_DIR / "pmw-slug")], text=True).strip()
    except Exception:
        return "local-project"


def tuning_path() -> pathlib.Path:
    root = STATE_DIR / "projects" / current_slug()
    root.mkdir(parents=True, exist_ok=True)
    return root / "question-tuning.jsonl"


def append_row(row: dict) -> None:
    path = tuning_path()
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")


def read_rows() -> list[dict]:
    path = tuning_path()
    rows = []
    if not path.exists():
        return rows
    for line in path.read_text(encoding="utf-8").splitlines():
        try:
            value = json.loads(line)
        except Exception:
            continue
        if isinstance(value, dict):
            rows.append(value)
    return rows


def command_add(args: argparse.Namespace) -> int:
    if args.policy not in POLICIES:
        print("policy must be one of: " + ", ".join(sorted(POLICIES)), file=os.sys.stderr)
        return 1
    append_row(
        {
            "ts": now(),
            "dimension": args.dimension,
            "policy": args.policy,
            "reason": args.reason,
        }
    )
    print(tuning_path())
    return 0


def command_summary(_args: argparse.Namespace) -> int:
    rows = read_rows()
    if not rows:
        print("问题偏好：暂无")
        return 0
    latest = {}
    for row in rows:
        latest[row.get("dimension", "")] = row
    print("问题偏好：")
    for dimension, row in latest.items():
        if not dimension:
            continue
        print(f"- {dimension}：{row.get('policy')}｜{row.get('reason')}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pmw-question-tuning")
    sub = parser.add_subparsers(dest="command", required=True)
    add = sub.add_parser("add")
    add.add_argument("--dimension", required=True)
    add.add_argument("--policy", required=True)
    add.add_argument("--reason", required=True)
    add.set_defaults(func=command_add)
    summary = sub.add_parser("summary")
    summary.set_defaults(func=command_summary)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
