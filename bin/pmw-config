#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${PMW_HOME:-$HOME/.pmworkspace}"
CONFIG_FILE="$STATE_DIR/config.yaml"

default_value() {
  case "$1" in
    update_check) echo "true" ;;
    auto_upgrade) echo "false" ;;
    telemetry) echo "local" ;;
    remote_telemetry) echo "false" ;;
    memory_scope) echo "artifacts-preferences" ;;
    default_canvas) echo "iphone-17-portrait-402x874" ;;
    mobile_first) echo "true" ;;
    question_mode) echo "decision-gates" ;;
    zoon_auto_create) echo "false" ;;
    zoon_sync_on_brief) echo "false" ;;
    zoon_protocol_cache_ttl) echo "300" ;;
    zoon_protocol_mode) echo "dynamic" ;;
    zoon_host) echo "https://zoon.up.railway.app" ;;
    zoon_store_url) echo "local" ;;
    project_display_name) echo "auto" ;;
    update_snooze_hours) echo "24" ;;
    remote_version_url) echo "https://raw.githubusercontent.com/stephenfan80/PMWorkspace/main/VERSION" ;;
    remote_revision_url) echo "https://raw.githubusercontent.com/stephenfan80/PMWorkspace/main/plugins/pmworkspace/skills/pmworkspace-shared/REVISION" ;;
    repo_url) echo "https://github.com/stephenfan80/PMWorkspace.git" ;;
    *) echo "" ;;
  esac
}

ensure_config() {
  mkdir -p "$STATE_DIR"
  if [ ! -f "$CONFIG_FILE" ]; then
    cat > "$CONFIG_FILE" <<'EOF'
# PMWorkspace local configuration.
# telemetry: local | off | anonymous
# remote_telemetry: false | true
# memory_scope: artifacts-preferences | artifacts-only | full-local
# update_check: true | false
# auto_upgrade: false | true
# question_mode: decision-gates | off
# zoon_auto_create: false | true
# zoon_sync_on_brief: false | true
# zoon_protocol_cache_ttl: 300
# zoon_protocol_mode: dynamic | cached | builtin
# zoon_host: https://zoon.up.railway.app
# zoon_store_url: local
# project_display_name: auto | manual
EOF
  fi
}

valid_key() {
  printf '%s' "$1" | grep -qE '^[A-Za-z0-9_]+$'
}

read_value() {
  local key="$1"
  local value=""
  if [ -f "$CONFIG_FILE" ]; then
    value="$(grep -E "^${key}:" "$CONFIG_FILE" 2>/dev/null | tail -1 | sed 's/^[^:]*:[[:space:]]*//' | tr -d '\r' || true)"
  fi
  if [ -z "$value" ]; then
    value="$(default_value "$key")"
  fi
  printf '%s' "$value"
}

case "${1:-}" in
  get)
    key="${2:?Usage: pmw-config get <key>}"
    valid_key "$key" || { echo "Invalid key" >&2; exit 1; }
    read_value "$key"
    ;;
  set)
    key="${2:?Usage: pmw-config set <key> <value>}"
    value="${3:?Usage: pmw-config set <key> <value>}"
    valid_key "$key" || { echo "Invalid key" >&2; exit 1; }
    ensure_config
    tmp="$(mktemp "${CONFIG_FILE}.XXXXXX")"
    if grep -qE "^${key}:" "$CONFIG_FILE" 2>/dev/null; then
      sed "s#^${key}:.*#${key}: ${value}#" "$CONFIG_FILE" > "$tmp"
    else
      cat "$CONFIG_FILE" > "$tmp"
      printf '%s: %s\n' "$key" "$value" >> "$tmp"
    fi
    mv "$tmp" "$CONFIG_FILE"
    ;;
  list)
    ensure_config
    cat "$CONFIG_FILE"
    echo ""
    echo "# Active values"
    for key in update_check auto_upgrade telemetry remote_telemetry memory_scope default_canvas mobile_first question_mode zoon_auto_create zoon_sync_on_brief zoon_protocol_cache_ttl zoon_protocol_mode zoon_host zoon_store_url project_display_name update_snooze_hours remote_version_url remote_revision_url repo_url; do
      printf '%-22s %s\n' "${key}:" "$(read_value "$key")"
    done
    ;;
  defaults)
    for key in update_check auto_upgrade telemetry remote_telemetry memory_scope default_canvas mobile_first question_mode zoon_auto_create zoon_sync_on_brief zoon_protocol_cache_ttl zoon_protocol_mode zoon_host zoon_store_url project_display_name update_snooze_hours remote_version_url remote_revision_url repo_url; do
      printf '%-22s %s\n' "${key}:" "$(default_value "$key")"
    done
    ;;
  *)
    echo "Usage: pmw-config {get|set|list|defaults} [key] [value]" >&2
    exit 1
    ;;
esac
