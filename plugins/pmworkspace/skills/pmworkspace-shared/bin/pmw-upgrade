#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG_BIN="${PMW_CONFIG_BIN:-$SCRIPT_DIR/pmw-config}"
STATE_DIR="${PMW_HOME:-$HOME/.pmworkspace}"
REPO_URL="${PMW_REPO_URL:-$("$CONFIG_BIN" get repo_url 2>/dev/null || echo "https://github.com/stephenfan80/PMWorkspace.git")}"
HOST="${1:---host}"
HOST_VALUE="${2:-codex}"

usage() {
  cat <<'EOF'
Usage:
  pmw-upgrade --host codex
  pmw-upgrade --host codex-plugin

Hosts:
  codex         Update legacy ~/.codex/skills installation.
  codex-plugin Add or update the local Codex plugin marketplace package.
EOF
}

if [ "$HOST" != "--host" ]; then
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
    exit 0
  fi
  usage >&2
  exit 2
fi

case "$HOST_VALUE" in
  codex|codex-plugin) ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    echo "Unsupported host: $HOST_VALUE" >&2
    usage >&2
    exit 2
    ;;
esac

tmp="$(mktemp -d "${TMPDIR:-/tmp}/pmworkspace-upgrade.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT

old=""
for version_file in \
  "$SCRIPT_DIR/../VERSION" \
  "$SCRIPT_DIR/../../VERSION" \
  "$SCRIPT_DIR/../../../VERSION" \
  "$HOME/.codex/skills/pmworkspace-shared/VERSION" \
  $(find "$HOME/.codex/plugins/cache" -path "*/pmworkspace/*/skills/pmworkspace-shared/VERSION" -type f 2>/dev/null | sort -r) \
  "$HOME/.agents/plugins/plugins/pmworkspace/skills/pmworkspace-shared/VERSION"; do
  if [ -f "$version_file" ]; then
    old="$(tr -d '[:space:]' < "$version_file")"
    break
  fi
done

git clone "$REPO_URL" "$tmp/PMWorkspace"

INSTALLED_REVISION_FILE=""

if [ "$HOST_VALUE" = "codex-plugin" ]; then
  "$tmp/PMWorkspace/bin/pmw-build-plugin"

  if command -v codex >/dev/null 2>&1; then
    MARKETPLACE_SOURCE="${PMW_MARKETPLACE_SOURCE:-$REPO_URL}"
    case "$MARKETPLACE_SOURCE" in
      file://*) MARKETPLACE_SOURCE="${MARKETPLACE_SOURCE#file://}" ;;
    esac
    if ! codex plugin marketplace upgrade pmworkspace >/dev/null 2>&1; then
      codex plugin marketplace add "$MARKETPLACE_SOURCE"
    fi
  else
    echo "codex CLI not found; writing ~/.agents fallback marketplace only." >&2
  fi

  PLUGIN_ROOT="${CODEX_PLUGINS_DIR:-$HOME/.agents/plugins}"
  PLUGIN_DEST="$PLUGIN_ROOT/plugins/pmworkspace"
  MARKETPLACE_PATH="${CODEX_MARKETPLACE_PATH:-$PLUGIN_ROOT/marketplace.json}"
  INSTALLED_REVISION_FILE="$PLUGIN_DEST/skills/pmworkspace-shared/REVISION"

  "$tmp/PMWorkspace/bin/pmw-build-plugin" --dest "$PLUGIN_DEST"
  mkdir -p "$(dirname "$MARKETPLACE_PATH")"
  python3 - "$MARKETPLACE_PATH" <<'PY'
import json
import os
import sys

path = sys.argv[1]
if os.path.exists(path):
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
else:
    data = {
        "name": "local",
        "interface": {"displayName": "Local Plugins"},
        "plugins": [],
    }

data.setdefault("name", "local")
data.setdefault("interface", {}).setdefault("displayName", "Local Plugins")
plugins = data.setdefault("plugins", [])
entry = {
    "name": "pmworkspace",
    "source": {
        "source": "local",
        "path": "./plugins/pmworkspace",
    },
    "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL",
    },
    "category": "Productivity",
}
plugins[:] = [p for p in plugins if p.get("name") != "pmworkspace"]
plugins.append(entry)

tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2)
    f.write("\n")
os.replace(tmp, path)
PY
else
  CODEX_DEST="${CODEX_SKILLS_DIR:-$HOME/.codex/skills}"
  INSTALLED_REVISION_FILE="$CODEX_DEST/pmworkspace-shared/REVISION"
  "$tmp/PMWorkspace/setup" "$HOST" "$HOST_VALUE"
fi

mkdir -p "$STATE_DIR"
[ -n "$old" ] && printf '%s' "$old" > "$STATE_DIR/just-upgraded-from"
new="$(tr -d '[:space:]' < "$tmp/PMWorkspace/VERSION")"
rev=""
if [ -n "$INSTALLED_REVISION_FILE" ] && [ -f "$INSTALLED_REVISION_FILE" ]; then
  rev="$(tr -d '[:space:]' < "$INSTALLED_REVISION_FILE" 2>/dev/null || true)"
elif [ -x "$tmp/PMWorkspace/bin/pmw-revision" ]; then
  rev="$("$tmp/PMWorkspace/bin/pmw-revision" "$tmp/PMWorkspace" 2>/dev/null || true)"
else
  rev="$(git -C "$tmp/PMWorkspace" rev-parse HEAD 2>/dev/null || true)"
fi
if [ -n "$rev" ]; then
  echo "PMWorkspace upgraded for $HOST_VALUE from ${old:-unknown} to ${new}@${rev:0:7}"
else
  echo "PMWorkspace upgraded for $HOST_VALUE from ${old:-unknown} to ${new}"
fi
