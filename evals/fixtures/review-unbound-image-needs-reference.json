{
  "id": "review-unbound-image-needs-reference",
  "title": "缺输出单元绑定的图片不能凭视觉通过",
  "category": "prototype-review",
  "primary_skill": "pm-prototype-review",
  "prompt": "用户只贴了一张漂亮截图，没有方案名、屏幕任务、brief 版本或不可虚构项，要求判断是否通过。",
  "expected": {
    "mode": "deep",
    "status": "需要补充参考",
    "must_stop": true,
    "gate": "输出单元绑定缺失",
    "required_behaviors": [
      "要求补充方案名、屏幕任务和 brief 版本",
      "标记需要补充参考",
      "不凭视觉印象通过"
    ],
    "forbidden_behaviors": [
      "只因好看通过",
      "忽略不可虚构项",
      "假装已读取 prototype-board"
    ]
  },
  "contract_checks": [
    {
      "path": "pmworkspace-shared/references/prototype-quality-review.md",
      "contains": "缺绑定时先标 `需要补充参考`，不能凭视觉印象通过。"
    },
    {
      "path": "pm-prototype-review/SKILL.md",
      "contains": "If an image is not bound to one output unit or prototype-board item, mark `需要补充参考`"
    },
    {
      "path": "pmworkspace-shared/references/pm-eval-system.md",
      "contains": "缺绑定时标记 `需要补充参考`，不能凭视觉印象通过。"
    }
  ]
}
