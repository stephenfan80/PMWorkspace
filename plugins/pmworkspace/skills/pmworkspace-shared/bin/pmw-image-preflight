#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import subprocess
import sys
from datetime import datetime, timezone
from typing import Any


SCRIPT_DIR = pathlib.Path(__file__).resolve().parent
STATE_DIR = pathlib.Path(os.environ.get("PMW_HOME", str(pathlib.Path.home() / ".pmworkspace"))).expanduser()


def current_slug() -> str:
    env_slug = os.environ.get("PMW_PROJECT_SLUG", "").strip()
    if env_slug:
        return env_slug
    try:
        return subprocess.check_output([str(SCRIPT_DIR / "pmw-slug")], text=True).strip()
    except Exception:
        return "local-project"


def project_dir() -> pathlib.Path:
    return STATE_DIR / "projects" / current_slug()


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_json(path: pathlib.Path) -> dict[str, Any]:
    if not path.exists():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def read_jsonl(path: pathlib.Path) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    if not path.exists():
        return rows
    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
        try:
            value = json.loads(line)
        except Exception:
            continue
        if isinstance(value, dict):
            rows.append(value)
    return rows


def append_jsonl(path: pathlib.Path, row: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")


def current_board_items(project: dict[str, Any]) -> list[dict[str, Any]]:
    run_id = str(project.get("current_run_id") or "")
    digest = str(project.get("current_task_digest") or "")
    revision = str(project.get("current_input_revision") or "")
    rows = [row for row in read_jsonl(project_dir() / "prototype-board.jsonl") if row.get("record_type", "item") == "item"]
    scoped = []
    for row in rows:
        if run_id and row.get("run_id") != run_id:
            continue
        if digest and row.get("task_digest") != digest:
            continue
        if revision and row.get("input_revision") != revision:
            continue
        scoped.append(row)
    return scoped


def current_board_item(project: dict[str, Any], scheme: str, screen: str) -> dict[str, Any]:
    for row in reversed(current_board_items(project)):
        if row.get("scheme") == scheme and row.get("screen") == screen:
            return row
    return {}


def permit_rows() -> list[dict[str, Any]]:
    return read_jsonl(project_dir() / "image-permits.jsonl")


def permit_used(permit_id: str) -> bool:
    for row in permit_rows():
        if row.get("record_type") == "permit_use" and row.get("image_permit_id") == permit_id:
            return True
    return False


def validate_permit(project: dict[str, Any], permit_id: str, scheme: str, screen: str) -> tuple[bool, str, dict[str, Any]]:
    if not permit_id:
        return False, "IMAGEGEN_BLOCKED_BEFORE_PERMIT: 缺少 image_permit_id；不能写 image-2 prompt 或调用 imagegen。", {}
    matches = [row for row in permit_rows() if row.get("record_type") == "permit" and row.get("image_permit_id") == permit_id]
    if not matches:
        return False, "IMAGEGEN_BLOCKED_BEFORE_PERMIT: image_permit_id 不存在或不属于当前项目。", {}
    permit = matches[-1]
    if permit_used(permit_id):
        return False, "IMAGEGEN_BLOCKED_BEFORE_PERMIT: image_permit_id 已使用；每张图必须重新签发。", permit
    expected = {
        "run_id": project.get("current_run_id", ""),
        "task_digest": project.get("current_task_digest", ""),
        "input_revision": project.get("current_input_revision", ""),
        "scheme": scheme,
        "screen": screen,
    }
    for key, value in expected.items():
        if value and str(permit.get(key) or "") != str(value):
            return False, f"IMAGEGEN_BLOCKED_BEFORE_PERMIT: image_permit_id 与当前 {key} 不匹配。", permit
    return True, "", permit


def confirmed_less_than_three(project: dict[str, Any]) -> bool:
    run_id = str(project.get("current_run_id") or "")
    digest = str(project.get("current_task_digest") or "")
    revision = str(project.get("current_input_revision") or "")
    for row in read_jsonl(project_dir() / "runs" / f"{run_id}.jsonl"):
        if digest and row.get("task_digest") != digest:
            continue
        if revision and row.get("input_revision") != revision:
            continue
        text = f"{row.get('status', '')} {row.get('title', '')} {row.get('summary', '')}"
        if "少于 3" in text and ("豁免" in text or "例外" in text) and ("已确认" in text or "已批准" in text):
            return True
    return False


def controller_preflight() -> tuple[int, dict[str, Any], str]:
    result = subprocess.run(
        [str(SCRIPT_DIR / "pmw-controller"), "preflight", "--target", "prototype", "--json"],
        text=True,
        capture_output=True,
        check=False,
    )
    try:
        payload = json.loads(result.stdout)
    except Exception:
        payload = {"ready": False, "reason": result.stdout or result.stderr or "controller preflight failed"}
    return result.returncode, payload if isinstance(payload, dict) else {}, result.stderr


def evaluate_preflight(project: dict[str, Any]) -> dict[str, Any]:
    project = read_json(project_dir() / "project.json")
    exit_code, payload, stderr = controller_preflight()
    items = current_board_items(project)
    failures = []
    if exit_code != 0 or not payload.get("ready"):
        failures.append(str(payload.get("reason") or stderr or "prototype preflight blocked"))
    if not items:
        failures.append("当前 run 没有已绑定 prototype-board 输出单元")
    if len(items) < 3 and not confirmed_less_than_three(project):
        failures.append("默认最少 3 个方案；少于 3 个必须有当前 run 的明确豁免原因")
    allowed = not failures
    return {
        "ready": allowed,
        "verdict": "ALLOW_IMAGE_PROMPT" if allowed else "BLOCKED",
        "first_blocker": failures[0] if failures else "",
        "failures": failures,
        "output_units": len(items),
        "task_digest": project.get("current_task_digest", ""),
        "input_revision": project.get("current_input_revision", ""),
    }


def command_check(args: argparse.Namespace) -> int:
    project = read_json(project_dir() / "project.json")
    result_payload = evaluate_preflight(project)
    print(json.dumps(result_payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else result_payload["verdict"])
    return 0 if result_payload["ready"] else 2


def command_issue_permit(args: argparse.Namespace) -> int:
    project = read_json(project_dir() / "project.json")
    result_payload = evaluate_preflight(project)
    item = current_board_item(project, args.scheme, args.screen)
    failures = list(result_payload.get("failures") or [])
    if not item:
        failures.append("当前 run / task revision 没有匹配的 prototype-board 输出单元，不能签发图片许可证")
    if failures:
        blocked = {
            **result_payload,
            "ready": False,
            "verdict": "BLOCKED",
            "first_blocker": failures[0],
            "failures": failures,
            "scheme": args.scheme,
            "screen": args.screen,
        }
        print(json.dumps(blocked, ensure_ascii=False, indent=2, sort_keys=True) if args.json else "BLOCKED")
        return 2
    seed = "|".join(
        [
            now(),
            str(project.get("current_run_id") or ""),
            str(project.get("current_task_digest") or ""),
            str(project.get("current_input_revision") or ""),
            args.scheme,
            args.screen,
        ]
    )
    permit_id = "imgp_" + hashlib.sha256(seed.encode("utf-8")).hexdigest()[:20]
    row = {
        "ts": now(),
        "record_type": "permit",
        "image_permit_id": permit_id,
        "run_id": project.get("current_run_id", ""),
        "task_digest": project.get("current_task_digest", ""),
        "input_revision": project.get("current_input_revision", ""),
        "scheme": args.scheme,
        "screen": args.screen,
        "brief_version": item.get("brief_version", ""),
        "design_spec_target": item.get("design_spec_target") or project.get("design_spec_target", ""),
        "task_digest_source": "current_revision",
        "status": "issued",
        "expires_after_use": True,
    }
    append_jsonl(project_dir() / "image-permits.jsonl", row)
    payload = {
        "ready": True,
        "verdict": "IMAGE_PERMIT_ISSUED",
        **row,
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else permit_id)
    return 0


def command_assert_imagegen(args: argparse.Namespace) -> int:
    project = read_json(project_dir() / "project.json")
    result_payload = evaluate_preflight(project)
    item = current_board_item(project, args.scheme, args.screen)
    failures = list(result_payload.get("failures") or [])
    if not item:
        failures.append("当前 run / task revision 没有匹配的 prototype-board 输出单元，不能写 image-2 prompt 或调用 imagegen")
    permit_ok, permit_error, permit = validate_permit(project, args.image_permit_id, args.scheme, args.screen)
    if not permit_ok:
        failures.append(permit_error)
    ready = not failures
    payload = {
        **result_payload,
        "ready": ready,
        "verdict": "IMAGEGEN_ALLOWED" if ready else "IMAGEGEN_BLOCKED_BEFORE_PERMIT",
        "first_blocker": failures[0] if failures else "",
        "failures": failures,
        "scheme": args.scheme,
        "screen": args.screen,
        "image_permit_id": args.image_permit_id,
        "permit": permit if ready else {},
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if args.json else payload["verdict"])
    return 0 if ready else 2


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pmw-image-preflight")
    sub = parser.add_subparsers(dest="command", required=True)
    check = sub.add_parser("check")
    check.add_argument("--json", action="store_true")
    check.set_defaults(func=command_check)
    permit = sub.add_parser("issue-permit")
    permit.add_argument("--scheme", required=True)
    permit.add_argument("--screen", required=True)
    permit.add_argument("--json", action="store_true")
    permit.set_defaults(func=command_issue_permit)
    assert_imagegen = sub.add_parser("assert-imagegen")
    assert_imagegen.add_argument("--scheme", required=True)
    assert_imagegen.add_argument("--screen", required=True)
    assert_imagegen.add_argument("--image-permit-id", default="")
    assert_imagegen.add_argument("--json", action="store_true")
    assert_imagegen.set_defaults(func=command_assert_imagegen)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
